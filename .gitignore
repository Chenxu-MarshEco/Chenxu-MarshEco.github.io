# 依赖与构建产物
node_modules/
dist/
.astro/

# 图片优化产物：每次构建由 tools/images/optimize.mjs 现生成，不进仓库
# （不放进来的话每张图都要多存四五份，仓库会翻好几倍）
public/img/opt/

# 本地环境
.env
.env.*
!.env.example

# pnpm
.pnpm-store/
.pnpm-debug.log*

# 编辑器本地的草稿暂存
.tmp/

# Python 字节码缓存（控制窗口跑一次就会生成，不该进仓库）
__pycache__/
*.py[cod]

# 系统垃圾
.DS_Store
Thumbs.db
desktop.ini

# 编辑器保存子版块时自动生成的备份，不进仓库
*.bak
