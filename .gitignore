# 依赖与构建产物
node_modules/
dist/
.astro/

# 图片优化产物：每次构建由 tools/images/optimize.mjs 现生成，不进仓库
# （不放进来的话每张图都要多存四五份，仓库会翻好几倍）
public/img/opt/

# 本地环境
.env
.env.*
!.env.example

# pnpm
.pnpm-store/
.pnpm-debug.log*

# 编辑器本地的草稿暂存
.tmp/

# Python 字节码缓存（控制窗口跑一次就会生成，不该进仓库）
__pycache__/
*.py[cod]

# 系统垃圾
.DS_Store
Thumbs.db
desktop.ini

# 编辑器保存子版块时自动生成的备份，不进仓库
*.bak

# 共享编辑器：**这一台机器**的身份（谁在用这个编辑器）
# （每台机器填自己的用户名，用来显示推流动态、以及判断是不是站长本人。
#   提交进仓库的话，别人的编辑器就会拿着我的名字到处跑。）
tools/editor/.editor-identity.json
# 「近期更新」用的本机记录（保存过哪几页；发布时拼进提交说明，不进仓库）
tools/editor/.editor-edits.json

# 本机外观覆盖层：只改自己这台机器的编辑器长相，不进仓库
# （local-style.css 覆盖样式，local-icons/ 是 Fugue 图标和挂载脚本。
#   提交进仓库的话，别人的编辑器会被迫换外观。）
tools/editor/local-style.css
tools/editor/local-icons/
