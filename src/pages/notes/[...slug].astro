---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entryUrl, getNotes, neighbors } from '../../utils/content';
import { formatDateFull, toISODate } from '../../utils/date';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const all = await getNotes();
const { prev, next } = neighbors(all, entry.id);
---

<BaseLayout
  title={data.title}
  description={data.mood ?? data.title}
  type="article"
  publishedTime={data.date}
  narrow
>
  <article>
    <header class="post-header">
      <h1 class="post-header__title">{data.title}</h1>
      <div class="post-header__meta">
        <time datetime={toISODate(data.date)}>{formatDateFull(data.date)}</time>
        {data.week && <span>{data.week}</span>}
        {data.mood && <span>{data.mood}</span>}
        {data.draft && <span class="tag">草稿</span>}
      </div>
      {
        data.tags.length > 0 && (
          <ul class="tag-list">
            {data.tags.map((tag: string) => (
              <li>
                <a class="tag" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      (prev || next) && (
        <nav class="post-nav" aria-label="相邻手记">
          {prev && (
            <a class="post-nav__link" href={withBase(entryUrl(prev))}>
              <span class="post-nav__label">← 更新的一条</span>
              <span class="post-nav__title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="post-nav__link" href={withBase(entryUrl(next))} style="text-align:right">
              <span class="post-nav__label">更早的一条 →</span>
              <span class="post-nav__title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
