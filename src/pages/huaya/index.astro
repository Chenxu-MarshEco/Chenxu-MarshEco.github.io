---
import BoardLayout from '../../layouts/BoardLayout.astro';
import SubGrid from '../../components/SubGrid.astro';
import site from '../../site.config';
import { getNotes, getPosts } from '../../utils/content';
import { toISODate } from '../../utils/date';

const board = site.homeBoards.find((b) => b.id === 'huaya');
if (!board) throw new Error('site.config.ts 里找不到 id 为 huaya 的大板块');

/*
  查出归到本板块各子版块下的文章。
  依据是每篇文章 frontmatter 里的 subs 字段（填子版块 id），
  在编辑器里用「所属子版块」勾选框设置。
*/
const ownSubs = new Set((board.items ?? []).map((i) => i.id).filter(Boolean));
const postsBySub: Record<string, { title: string; href: string; date: string }[]> = {};

for (const entry of [...(await getPosts()), ...(await getNotes())]) {
  for (const sub of entry.data.subs ?? []) {
    if (!ownSubs.has(sub)) continue;
    (postsBySub[sub] ??= []).push({
      title: entry.data.title,
      href: entry.collection === 'posts' ? `/posts/${entry.id}/` : `/notes/${entry.id}/`,
      date: toISODate(entry.data.date).slice(5),
    });
  }
}
---

<BoardLayout title={board.title} image={board.image}>
  <SubGrid items={board.items} postsBySub={postsBySub} />
</BoardLayout>
