---
/**
 * 冰山图页面 —— /iceberg/（首页中间那块「冰室冰山」点进来的就是它）。
 *
 * 正文由 `src/data/iceberg.json` 画出来（编辑器的「冰山图」面板写这个文件）：
 * 一层一层的深色卡片，每层有标题 / 副标题 / 背景图 / 头图 / 一堆条目，
 * 条目按分类上色，填了详细描述的条目背后垫一块粉色带栅格的完备标识。
 *
 * 数据还是空的时候（一条层级都还没有）不摆一张空页面：退回显示首页那块里
 * 传的图 + 那段介绍 + 链接 —— 也就是这一页以前的样子，编辑器「冰室冰山」
 * 面板里填的就是这三样。等冰山图里有了内容，正文自动换成那张图。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import IcebergChart from '../components/IcebergChart.astro';
import { marked } from 'marked';
import widgets from '../data/home-widgets.json';
import { iceberg } from '../utils/iceberg';
import { enhanceHtml, variantUrl } from '../utils/images';
import { withBase } from '../utils/url';

const ice = (widgets.iceberg ?? {}) as { title?: string; image?: string; text?: string; href?: string };
const title = iceberg.title || String(ice.title ?? '').trim() || '冰室冰山';

/* ---- 冰山图还是空的时候用的那一份（首页那块的大图 + 介绍 + 链接） ---- */
const imageRaw = String(ice.image ?? '').trim();
const image = imageRaw ? variantUrl(imageRaw, 1200) : '';
const href = String(ice.href ?? '').trim();
const external = /^https?:/i.test(href);
const body = enhanceHtml(marked.parse(String(ice.text ?? '').trim(), { async: false }) as string);
---

<BaseLayout
  title={title}
  description={`${title} —— 花涧堂。${iceberg.itemCount ? `共 ${iceberg.itemCount} 条，分 ${iceberg.layers.length} 层。` : ''}`}
  bodyClass="is-board is-iceberg"
>
  <article class="icePage">
    <header class="page-header">
      <h1 class="page-header__title">{title}</h1>
      {iceberg.intro && <p class="page-header__desc">{iceberg.intro}</p>}
    </header>

    {
      iceberg.hasContent ? (
        <IcebergChart />
      ) : (
        <div class="icePage__fallback">
          <figure class="icePage__fig">
            {image ? (
              <img class="icePage__img" src={image} alt="" loading="eager" decoding="async" />
            ) : (
              <div class="icePage__ph" aria-label="还没有上传图片">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M10.5 20.5V6.5M13.5 20.5V6.5M8.5 20.5h7M12 4v2.5M3.5 9h17M12 4 3.5 9M12 4l8.5 5M17.5 9v4" />
                </svg>
              </div>
            )}
            {!image && <figcaption class="icePage__cap">图还没传：编辑器「冰室冰山」面板里传一张。</figcaption>}
          </figure>

          {
            body.trim() ? (
              <div class="icePage__body" set:html={body} />
            ) : (
              <p class="icePage__empty">
                {title}还没有内容 —— 编辑器里打开「冰山图」面板，先建一个层级、往里加条目；
                或者只在「冰室冰山」面板里填一句介绍 + 传一张图。
              </p>
            )
          }

          {
            href && (
              <p class="icePage__more">
                <a
                  href={external ? href : withBase(href)}
                  {...external ? { target: '_blank', rel: 'noopener' } : {}}
                >
                  继续看 ›
                </a>
              </p>
            )
          }
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .icePage {
    padding: clamp(1.2rem, 4vh, 2.4rem) 0 4rem;
  }
  /*
    深紫底上，站里默认那套 .page-header__title 用的是 --c-text（深琥珀 #46280f），
    压在 #1e0730 上只有 1.5:1 —— 用户原话「大标题冰室冰山四个字看不清」。
    换成和 /salon/ 大标题同一套：纯白 + 粉色外发光（那页的 h1 就是白字 + 同样的光）。
    下面那行介绍、以及"还没内容时"的退回文案也一起换成浅粉白，不然同样看不见。
  */
  :global(body.is-iceberg) .page-header {
    border-bottom-color: rgba(255, 120, 190, 0.42);
  }
  :global(body.is-iceberg) .page-header__title {
    color: #fff;
    text-shadow: 0 0 18px rgba(255, 79, 163, 0.55), 0 2px 6px rgb(0 0 0 / 0.5);
  }
  :global(body.is-iceberg) .page-header__desc {
    color: rgba(255, 226, 244, 0.72);
  }
  .icePage__fig {
    margin: 0 0 1.6rem;
  }
  .icePage__img {
    display: block;
    width: 100%;
    border-radius: 16px;
    border: 1px solid rgba(255, 120, 190, 0.35);
  }
  .icePage__ph {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    border: 1px solid rgba(255, 120, 190, 0.35);
    background: linear-gradient(165deg, #d9f2ff 0%, #8fd4ff 34%, #4f9fd8 62%, #234a70 100%);
  }
  .icePage__ph svg {
    width: 84px;
    height: 84px;
    fill: none;
    stroke: #0d2438;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.65;
  }
  .icePage__cap {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: rgba(255, 226, 244, 0.6);
  }
  .icePage__body {
    line-height: 1.9;
    color: rgba(255, 236, 248, 0.9);
  }
  .icePage__empty {
    color: rgba(255, 226, 244, 0.72);
  }
  .icePage__more--none {
    color: rgba(255, 226, 244, 0.6);
    font-size: 0.85rem;
  }
  .icePage__more a {
    color: #ffb3dd;
  }
</style>
