---
/**
 * 「冰室冰山」页面 —— /iceberg/（首页中间那一块点进来的就是它）
 *
 * 用户要求：这一块「会链接到一个页面，同样预留图片和链接接口」。
 * 所以这页现在就把位置留好：
 *   · 大图（home-widgets.json 的 iceberg.image，编辑器里传）
 *   · 一段介绍（iceberg.text，支持 Markdown）
 *   · 一个"继续"链接（iceberg.href —— 首页那块和这一页共用同一个地址，
 *     之后要指向哪一页，在编辑器里填就行）
 * 没传图就先画一块冰蓝斜坡 + 塔吊的占位，免得页面空着看不出是个什么位置。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { marked } from 'marked';
import widgets from '../data/home-widgets.json';
import { enhanceHtml, variantUrl } from '../utils/images';
import { withBase } from '../utils/url';

const ice = (widgets.iceberg ?? {}) as { title?: string; image?: string; text?: string; href?: string };
const title = ice.title || '冰室冰山';
const imageRaw = String(ice.image ?? '').trim();
/** 大头图取管线里较大的一档（查不到清单就退回原图） */
const image = imageRaw ? variantUrl(imageRaw, 1200) : '';
const href = String(ice.href ?? '').trim();
const external = /^https?:/i.test(href);
const body = enhanceHtml(marked.parse(String(ice.text ?? '').trim(), { async: false }) as string);
---

<BaseLayout title={title} description={`${title} —— 花涧堂。`}>
  <article class="icePage">
    <h1 class="icePage__title">{title}</h1>

    <figure class="icePage__fig">
      {
        image ? (
          <img class="icePage__img" src={image} alt="" loading="eager" decoding="async" />
        ) : (
          <div class="icePage__ph" aria-label="还没有上传图片">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M10.5 20.5V6.5M13.5 20.5V6.5M8.5 20.5h7M12 4v2.5M3.5 9h17M12 4 3.5 9M12 4l8.5 5M17.5 9v4" />
            </svg>
          </div>
        )
      }
      {!image && <figcaption class="icePage__cap">图还没传：编辑器「冰室冰山」面板里传一张。</figcaption>}
    </figure>

    {
      body.trim() ? (
        <div class="icePage__body" set:html={body} />
      ) : (
        <p class="icePage__empty">
          {title}还没有写介绍 —— 在编辑器「冰室冰山」面板里填就行（支持 Markdown）。
        </p>
      )
    }

    {
      href ? (
        <p class="icePage__more">
          <a
            href={external ? href : withBase(href)}
            {...external ? { target: '_blank', rel: 'noopener' } : {}}
          >
            继续看 ›
          </a>
        </p>
      ) : (
        <p class="icePage__more icePage__more--none">（链接留空：编辑器里填上要指到哪一页）</p>
      )
    }
  </article>
</BaseLayout>

<style>
  .icePage {
    padding: clamp(1.2rem, 4vh, 2.4rem) 0 4rem;
  }
  .icePage__title {
    margin: 0 0 1rem;
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    letter-spacing: 0.1em;
  }
  .icePage__fig {
    margin: 0 0 1.6rem;
  }
  .icePage__img {
    display: block;
    width: 100%;
    border-radius: 16px;
    border: 1px solid rgba(255, 120, 190, 0.35);
  }
  .icePage__ph {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    border: 1px solid rgba(255, 120, 190, 0.35);
    background: linear-gradient(165deg, #d9f2ff 0%, #8fd4ff 34%, #4f9fd8 62%, #234a70 100%);
  }
  .icePage__ph svg {
    width: 84px;
    height: 84px;
    fill: none;
    stroke: #0d2438;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.65;
  }
  .icePage__cap {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--c-text-faint);
  }
  .icePage__body {
    line-height: 1.9;
  }
  .icePage__empty {
    color: var(--c-text-muted);
  }
  .icePage__more--none {
    color: var(--c-text-faint);
    font-size: 0.85rem;
  }
</style>
