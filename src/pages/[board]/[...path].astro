---
/**
 * 大板块树里任意一层子节点的页面。
 *
 * 路径由 id 推导（见 utils/boards.ts）：
 *   yongcheng-a    -> /yongcheng/a
 *   yongcheng-a-1  -> /yongcheng/a/1
 * 想加多少层都行，不用手建页面文件。
 */
import BoardLayout from '../../layouts/BoardLayout.astro';
import NodeView from '../../components/NodeView.astro';
import site from '../../site.config';
import { flattenBoards, type BoardNode } from '../../utils/boards';
import { nodePageData } from '../../utils/boardPage';
import { getTimeline, refParam } from '../../utils/timelines';

export async function getStaticPaths() {
  const all = flattenBoards(site.homeBoards as BoardNode[]);
  return all
    // 链接版块不生成页面（点了直接跳走），所以这里要排掉
    .filter((f) => f.depth > 0 && !f.external)
    .map((f) => {
      const segs = f.url.split('/').filter(Boolean);
      return {
        params: { board: segs[0], path: segs.slice(1).join('/') },
        props: { url: f.url },
      };
    });
}

const { url } = Astro.props;
const data = await nodePageData(url);
if (!data) throw new Error(`大板块数据里找不到 ${url}`);

// 「返回」回上一级，而不是一路回首页。
// 顶层大板块没有上一级（parent 是 null），那才回首页 —— 这条规则写在
// utils/boardPage.ts 里，页面只负责用。
const backHref = data.parent?.url ?? '/';
const backLabel = data.parent ? `返回 ${data.parent.title}` : '返回首页';

/*
  这一页的时间轴（没指就没有）。
  默认停在哪儿：优先这一页自己认领的时间点/时间段；
  自己没认领就看第一个认领了的成分 —— 打开时正好对着屏幕上那段内容。
*/
const timeline = getTimeline(data.timeline);
const ownsRef = { point: data.timePoint, span: data.timeSpan };
let timelineDefault = refParam(timeline, ownsRef);
if (timelineDefault === null && timeline) {
  for (const b of data.page) {
    const t = refParam(timeline, { point: b.timePoint, span: b.timeSpan });
    if (t !== null) {
      timelineDefault = t;
      break;
    }
  }
}
---

<BoardLayout
  title={data.title}
  image={data.image}
  backHref={backHref}
  backLabel={backLabel}
  timeline={timeline}
  timelineDefault={timelineDefault}
>
  <NodeView
    trail={data.trail}
    children={data.children}
    posts={data.posts}
    layout={data.layout}
    page={data.page}
    timeline={timeline}
  />
</BoardLayout>
