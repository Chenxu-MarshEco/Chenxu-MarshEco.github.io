---
/**
 * 大板块树里任意一层子节点的页面。
 *
 * 路径由 id 推导（见 utils/boards.ts）：
 *   yongcheng-a    -> /yongcheng/a
 *   yongcheng-a-1  -> /yongcheng/a/1
 * 想加多少层都行，不用手建页面文件。
 */
import BoardLayout from '../../layouts/BoardLayout.astro';
import NodeView from '../../components/NodeView.astro';
import site from '../../site.config';
import { flattenBoards, type BoardNode } from '../../utils/boards';
import { nodePageData } from '../../utils/boardPage';

export async function getStaticPaths() {
  const all = flattenBoards(site.homeBoards as BoardNode[]);
  return all
    .filter((f) => f.depth > 0)
    .map((f) => {
      const segs = f.url.split('/').filter(Boolean);
      return {
        params: { board: segs[0], path: segs.slice(1).join('/') },
        props: { url: f.url },
      };
    });
}

const { url } = Astro.props;
const data = await nodePageData(url);
if (!data) throw new Error(`大板块数据里找不到 ${url}`);

// 「返回」回上一级，而不是一路回首页。
// 顶层大板块没有上一级（parent 是 null），那才回首页 —— 这条规则写在
// utils/boardPage.ts 里，页面只负责用。
const backHref = data.parent?.url ?? '/';
const backLabel = data.parent ? `返回 ${data.parent.title}` : '返回首页';
---

<BoardLayout title={data.title} image={data.image} backHref={backHref} backLabel={backLabel}>
  <NodeView trail={data.trail} children={data.children} posts={data.posts} layout={data.layout} />
</BoardLayout>
