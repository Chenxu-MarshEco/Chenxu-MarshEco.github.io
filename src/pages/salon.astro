---
/**
 * 冰室精华（群精华）页面 —— /salon/
 *
 * 数据全在 `src/data/salon.json`（由群精华导出文件整理而来，见 utils/salon.ts）。
 *
 * 这一版（2026-11-20）按站长的要求改了四件事：
 *   1. **成员筛选栏**：顶上一根常驻栏，点一下展开所有成员的卡片
 *      （头像 + 名字 + 这个人发了多少条），卡片左侧的小眼睛就是开关 ——
 *      和冰室冰山顶栏那排分类卡一个规矩：关掉的人，他的精华就不显示；
 *      **一条精华有多个成员时，只有这些成员全被关掉才隐藏**（只要还有一个开着就显示）。
 *      电脑端屏幕够宽，不折叠 —— 直接是右边一栏，和左边那条时间轴对称。
 *   2. **电脑端正文居中加宽**：左时间轴 / 中正文 / 右成员，两栏等宽、正文自己居中。
 *   3. **分块装载**：833 条一次全渲出来要 1.67MB、2 万个元素，进来要卡好几秒。
 *      现在页面只渲**最新那一簇**（20 条），上翻 / 搜索 / 点轴跳转时才取对应的簇
 *      （`/salon/chunk/<n>.json`，标记由 utils/salon-html.ts 生成，和首屏同一份）。
 *   4. 手机端时间轴比例尺竖排 —— 那件事在 components/Timeline.astro 的窄栏模式里。
 *
 * 另外两件一直以来的要求没变：
 *   · **左边那条时间轴常驻**：`pinned + fill` 模式，不走右边滑出的抽屉、没有书签，
 *     点轴上的刻度或塔吊都跳到最近的那条精华；
 *   · **搜索保留**：按 / 聚焦，边打边筛（现在筛的是全表，命中数按全部 833 条算）。
 *
 * 观感按用户要求走**页面风格**（和「隰辰煦家」那种大板块子页面一套）：
 * 深紫底 #1e0730 + 粉边 + 渐变玻璃块 + 粉字白标题。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import {
  salonEssences,
  salonTitle,
  salonTimelineId,
  salonUpdated,
  essenceParams,
  salonMemberStats,
} from '../utils/salon';
import { salonChunkCount, salonIndexJson, salonLastChunk, chunkHtml } from '../utils/salon-html';
import { getTimeline } from '../utils/timelines';
import { variantUrl } from '../utils/images';
import { copy, text } from '../utils/site-copy';

/*
  左边那条时间轴：编辑器里选中的那一条，**原样**渲染。
  现在的规则是「点、段、塔吊、比例尺全是那条轴自己的，一个都不加不删」。
*/
const tl = salonTimelineId ? getTimeline(salonTimelineId) : undefined;
/* 没选时间轴时左栏那句话（归「文案」面板：site-copy.json 的 salon.empty；留空 = 整块不显示） */
const salonEmpty = text(copy.salon?.empty);
const params = tl ? essenceParams(tl) : new Map<string, number>();
const total = salonEssences.length;
/** 时间轴默认停在最早那一天（一进页面看到的就是开头） */
const firstParam = total && tl ? (params.get(salonEssences[0].id) ?? 0) : 0;

/* 分块：首屏只渲最新那一簇，其余由脚本按需取 */
const chunkTotal = salonChunkCount();
const lastChunk = salonLastChunk();
/** 嵌进页面的索引表：[id, 轴上的位置, 簇号]，见 utils/salon-html.ts 的 salonIndexJson */
const indexJson = salonIndexJson(params);
/** 成员卡片（有精华的那些人，顺序照成员表） */
const members = salonMemberStats;
---

<BaseLayout
  title={salonTitle}
  description={`${salonTitle}：冰室群里的精华消息，${total} 条，${salonUpdated} 前更新。`}
  bodyClass="is-board is-salon"
>
  <div
    class="salon"
    data-salon
    data-base={import.meta.env.BASE_URL}
    data-total={total}
    data-chunk-total={chunkTotal}
    data-chunk-last={lastChunk}
  >
    <aside class="salon__side">
      {tl ? (
        <div class="salon__tl" data-salon-tl data-tl-id={tl.id}>
          {/* 原样放上去：不传任何会改它的东西，只给它宽度和一个高度 */}
          <Timeline timeline={tl} pinned={true} fill={true} rail={true} defaultParam={firstParam} />
        </div>
      ) : (
        /* 没选时间轴时那句话归「文案」面板（site-copy.json 的 salon.empty；留空 = 整块不显示） */
        salonEmpty && <p class="salon__tlNone" data-copy="salon.empty">{salonEmpty}</p>
      )}
    </aside>

    <main class="salon__main">
      {/*
        页头只有标题。原来标题下面还有一行
        「共 N 条 · 成员 N 人 · 截至 …　由群精华导出文件整理：…」
        —— 用户说不需要，删掉了（连带上面那些数字也一起删）。
      */}
      <header class="salon__head">
        <h1 class="salon__title">{salonTitle}</h1>
      </header>

      {/*
        搜索栏从页头里挪出来单独一层：它要**无论怎么翻都留在屏幕里**
        （电脑和手机都要），而 sticky 只能在自己父元素的范围内粘住。
        手机端还要让开上面那根成员栏，让开多少由脚本量进 --salon-top-search。
      */}
      <div class="salon__searchBar">
        <div class="salon__searchBox">
          <input
            id="salon-q"
            class="salon__search"
            type="search"
            placeholder="搜索关键词 / 成员 / 日期…（按 / 聚焦）"
            autocomplete="off"
          />
          <span id="salon-hit" class="salon__hit" aria-live="polite"></span>
        </div>
      </div>

      <div
        class="salon__list"
        id="salon-list"
        data-chunk-first={lastChunk}
        data-chunk-last={lastChunk}
      >
        {/*
          点亮两个以上成员时，**他们共同参与**的那些精华被搬到这儿置顶（见脚本 applyPins）。
          平时是空的、不占地方；没有小标题（不许自己写文案），靠一条亮边和缩进区分。
        */}
        <div class="salon__pin" id="salon-pin" hidden></div>
        {/*
          首屏这一簇：标记由 utils/salon-html.ts 现生成（和接口取回来的那份同一套），
          所以样式全都写成 .salon__list :global(...) —— set:html 进来的元素拿不到
          Astro 的作用域属性，见下面样式区那一段说明。
        */}
        <div class="salon__chunk" data-chunk={lastChunk} set:html={chunkHtml(lastChunk, params)} />
        <p class="salon__empty" id="salon-empty" hidden>没有匹配的精华，换个词试试。</p>
      </div>
    </main>

    {/*
      成员栏（2026-11-20）。
      电脑端 = 右边一栏（和左边时间轴对称、常驻、不折叠）；
      手机端 = 顶部一根常驻栏，收起时只剩一枚没字的标签卡（`aria-label` 是它的名字），
      点开是一整片成员卡片。两种形态共用这一份标记，见样式区。
    */}
    <aside class="salon__members" data-salon-members data-open="0" aria-label="成员">
      <div class="salon__memBar">
        <button
          class="salon__memTab"
          type="button"
          data-mem-toggle
          aria-expanded="false"
          aria-controls="salon-memPanel"
          aria-label="成员"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="9" cy="8.2" r="3.1"></circle>
            <path d="M3.2 19.4c0-3.1 2.6-5.2 5.8-5.2s5.8 2.1 5.8 5.2"></path>
            <path d="M15.6 6.1a2.7 2.7 0 0 1 0 5.2"></path>
            <path d="M17 14.6c2.3.5 3.8 2.3 3.8 4.8"></path>
          </svg>
        </button>
      </div>

      <div class="salon__memPanel" id="salon-memPanel">
        <ul class="salon__memList">
          {members.map(({ member, count }) => (
            <li class="salon__memItem">
              {/*
                整张卡就是开关：点亮 = 只看这个人的精华（卡片四周泛霓虹光），
                再点一下熄灭 = 回到"所有精华"。
                左边那枚小眼睛和冰室冰山分类卡上那一枚是同一个图形。
              */}
              <button
                class="salon__memCard"
                type="button"
                data-mem={member.id}
                data-on="0"
                aria-pressed="false"
              >
                <span class="salon__memEye" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z" />
                    <circle cx="12" cy="12" r="2.6" />
                  </svg>
                </span>
                {member.avatar ? (
                  <img
                    class="salon__memFace"
                    src={variantUrl(member.avatar, 400)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="salon__memFace salon__memFace--none" aria-hidden="true">
                    {member.name.slice(0, 1)}
                  </span>
                )}
                <b class="salon__memName">{member.name}</b>
                <span class="salon__memCount">{count} 条</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>

  {/* 全表索引：点时间轴刻度时要在 833 条里找"离得最近的那条"，它可能还没被渲出来 */}
  <script type="application/json" id="salon-index" set:html={indexJson} />
</BaseLayout>

<script>
  /* ============================================================
     0. 「粘在哪儿」这件事量出来，别写死
     ------------------------------------------------------------
     页头的高度会随字号、语言、窗口宽度变（窄到一定程度导航会换行），
     左边那条轴和搜索栏的吸顶位置都得以它为准。
     量出来写进 CSS 变量：--salon-top（吸顶要让开多少）、
     --salon-top-search（手机端还要让开顶上那根成员栏）。
     ============================================================ */
  const root = document.documentElement;
  const salon = document.querySelector<HTMLElement>('[data-salon]');
  const listBox = document.getElementById('salon-list') as HTMLElement | null;
  const emptyEl = document.getElementById('salon-empty') as HTMLElement | null;
  const TOTAL = Number(salon?.dataset.total) || 0;

  const measureSticky = () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    const bar = document.querySelector<HTMLElement>('.salon__searchBar');
    const memBar = document.querySelector<HTMLElement>('.salon__memBar');
    const footer = document.querySelector<HTMLElement>('.site-footer');
    const top = Math.round((header?.getBoundingClientRect().height ?? 0) + 10);
    const barH = Math.round(bar?.getBoundingClientRect().height ?? 0);
    /* 手机端那根成员栏是普通流里的（展开的卡片是浮层，不占高度），所以量得到的是栏高 */
    const memH = Math.round(memBar?.getBoundingClientRect().height ?? 0);
    root.style.setProperty('--salon-top', `${top}px`);
    root.style.setProperty('--salon-mem-h', `${memH}px`);
    root.style.setProperty('--salon-top-search', `${top + memH}px`);
    /*
      页脚有多高：左边那条轴和右边那一栏都是 sticky 的，滚到页面最底时
      它们的活动范围只剩「视口 − 页脚」这么高 —— 两栏的高度都得减掉这一截，
      否则会被往上顶，顶上那条标题栏钻进吸顶页头底下（实测差 70px）。
    */
    const footH = Math.round(footer?.getBoundingClientRect().height ?? 0);
    root.style.setProperty('--salon-foot', `${footH}px`);
    /*
      「跳过去以后那一条要落在哪儿」= 它得从所有吸顶的东西下面露出来：
      页头 + 成员栏（手机）+ 搜索栏。轴是固定在屏幕左边那条细栏，不压在正文上方，
      所以不算进去。
    */
    root.style.setProperty('--salon-jump-gap', `${Math.round(top + memH + barH + 10)}px`);
  };
  measureSticky();
  let measureQueued = false;
  const queueMeasure = () => {
    if (measureQueued) return;
    measureQueued = true;
    requestAnimationFrame(() => {
      measureQueued = false;
      measureSticky();
    });
  };
  window.addEventListener('resize', queueMeasure);
  document.fonts?.ready?.then(queueMeasure);

  /* ============================================================
     0.4 全表索引（点轴跳转用）
     ------------------------------------------------------------
     页面上只渲一簇，可"点刻度 → 跳到离那儿最近的一条精华"要在**全部**里找最近的。
     索引表是构建期嵌进来的 `[[id, 位置, 簇号], …]`（833 行，约 20KB），
     不用请求，也不依赖已经渲出来的那些。
     ============================================================ */
  type Row = [string, number, number];
  const indexTable: Row[] = (() => {
    const el = document.getElementById('salon-index');
    if (!el) return [];
    try {
      return JSON.parse(el.textContent || '[]') as Row[];
    } catch {
      return [];
    }
  })();
  /** id → 簇号：直接读嵌进来那张表（不在浏览器里再算一遍分块规则） */
  const chunkById = new Map(indexTable.map((r) => [r[0], r[2]]));
  const chunkOfId = (id: string) => chunkById.get(id) ?? null;
  const TOTAL_CHUNKS = Number(salon?.dataset.chunkTotal) || 1;

  /* ============================================================
     0.6 分块装载
     ------------------------------------------------------------
     一簇 20 条（SALON_CHUNK）。文档里永远只有**一段连续的簇** [first, last]：
       · 首屏只有最新那一簇；
       · 往上翻到顶就取更早那一簇，**插在最前面**并把滚动位置补回来
         （内容加在视口上方，不补的话画面会突然往上跳一截）；
       · 搜索要用的簇如果不在这一段里，就单独插进来并标 data-extra ——
         搜完（清空关键词）时把这些临时簇摘掉，窗口又回到连续的那一段。
     每一簇包在一个 `.salon__chunk` 盒子里：这样"整簇插入 / 整簇摘掉"只是一个节点的事，
     跨簇的那两个头（年代 / 日期）也不会被拆散。
     ============================================================ */
  const BASE = salon?.dataset.base ?? '/';
  const chunkUrl = (n: number) => `${BASE.replace(/\/$/, '')}/salon/chunk/${n}.json`;
  const chunkData = new Map<number, string>();

  async function fetchChunk(n: number): Promise<string> {
    const hit = chunkData.get(n);
    if (hit !== undefined) return hit;
    const res = await fetch(chunkUrl(n));
    if (!res.ok) throw new Error(`chunk ${n}: ${res.status}`);
    const json = (await res.json()) as { html?: string };
    const html = String(json.html ?? '');
    chunkData.set(n, html);
    return html;
  }

  const chunkBoxes = () =>
    listBox ? Array.from(listBox.querySelectorAll<HTMLElement>('.salon__chunk')) : [];
  const chunkOfBox = (box: HTMLElement) => Number(box.dataset.chunk);
  const hasChunk = (n: number) => chunkBoxes().some((b) => chunkOfBox(b) === n);

  /** 按簇号排好位置插进去（不是简单地 append：搜索可能要求中间那些簇） */
  function placeChunk(n: number, html: string, extra: boolean) {
    if (!listBox) return null;
    const box = document.createElement('div');
    box.className = 'salon__chunk';
    box.dataset.chunk = String(n);
    if (extra) box.dataset.extra = '1';
    box.innerHTML = html;
    /*
      置顶的那些已经搬到列表最上面了。新装进来的这一簇里要是又带了一份，
      就地把这一份删掉 —— 不能让同一个 id 在文档里出现两次
      （出现两次的话，点时间轴跳转会跳到藏起来的那一个）。
    */
    if (pinnedIds.size) {
      for (const id of pinnedIds) {
        const dup = box.querySelector<HTMLElement>(`#${id}`);
        if (dup) dup.remove();
      }
    }
    const next = chunkBoxes().find((b) => chunkOfBox(b) > n);
    if (next) listBox.insertBefore(box, next);
    else listBox.insertBefore(box, emptyEl ?? null);
    return box;
  }

  /** 新进来的一簇也要过一遍：折叠判定、筛选、时间轴重算 */
  function afterChunkInsert(box: HTMLElement | null) {
    syncFolds(box ?? undefined);
    applyFilters();
    salon?.dispatchEvent(new CustomEvent('salon:chunks'));
  }

  async function loadPrev() {
    if (!listBox) return false;
    const lo = Number(listBox.dataset.chunkFirst);
    if (!Number.isFinite(lo) || lo <= 0) return false;
    const n = lo - 1;
    const html = await fetchChunk(n);
    const h0 = root.scrollHeight;
    const box = placeChunk(n, html, false);
    listBox.dataset.chunkFirst = String(n);
    /*
      先给这一簇做折叠判定（长文字裁到 8 行）**再**量高度差：
      折起来会把这一簇变矮，先量后折的话补偿量会多算一截，画面会往下坠一下
      （实测 CLS 从 0.08 涨到 0.58 就是这一下）。
    */
    if (box) syncFolds(box);
    /* 内容长在视口**上方**：把滚动位置加上新增的那截，画面才不会跳 */
    const dh = root.scrollHeight - h0;
    if (dh) window.scrollTo({ top: window.scrollY + dh, left: 0, behavior: 'instant' as ScrollBehavior });
    applyFilters();
    salon?.dispatchEvent(new CustomEvent('salon:chunks'));
    return true;
  }

  async function loadNext() {
    if (!listBox) return false;
    const hi = Number(listBox.dataset.chunkLast);
    if (!Number.isFinite(hi) || hi >= TOTAL_CHUNKS - 1) return false;
    const n = hi + 1;
    const box = placeChunk(n, await fetchChunk(n), false);
    listBox.dataset.chunkLast = String(n);
    afterChunkInsert(box);
    return true;
  }

  /**
   * 把某一条所在的簇弄进文档里（点轴跳转 / 带 hash 进来时用）。
   * 只差一簇就顺着加载；差得远就**重建窗口**成它前后各一簇 ——
   * 一下子把中间几十簇全拉下来，等于又变回"一进来就加载全部"。
   */
  async function ensureChunk(n: number) {
    if (!listBox || hasChunk(n)) return;
    const lo = Number(listBox.dataset.chunkFirst);
    const hi = Number(listBox.dataset.chunkLast);
    if (Number.isFinite(lo) && Number.isFinite(hi) && n >= lo - 1 && n <= hi + 1) {
      while (Number(listBox.dataset.chunkFirst) > n) if (!(await loadPrev())) break;
      while (Number(listBox.dataset.chunkLast) < n) if (!(await loadNext())) break;
      return;
    }
    /* 重建：清掉所有非临时的簇，换成 [n-1, n, n+1] */
    for (const b of chunkBoxes()) if (!b.dataset.extra) b.remove();
    const from = Math.max(0, n - 1);
    const to = Math.min(TOTAL_CHUNKS - 1, n + 1);
    listBox.dataset.chunkFirst = String(from);
    listBox.dataset.chunkLast = String(to);
    for (let i = from; i <= to; i += 1) placeChunk(i, await fetchChunk(i), false);
    afterChunkInsert(null);
  }

  /* 上翻到接近顶部就接着取更早的（够不到顶就一直补，但一次只补一簇） */  let loadingOlder = false;
  /*
    进页面那一会儿先别补：落地是"直接跳到最后一条"，跳之前有几个 scroll 事件
    的 scrollY 还是 0，会误判成"用户翻到顶了"，一进来就把上一簇拉下来 ——
    那正好和"只加载最新一部分"对着干。落地做完才开闸。
  */
  let bootDone = false;
  const maybeLoadOlder = async () => {
    if (!bootDone || loadingOlder || !listBox) return;
    if (window.scrollY > 900) return;
    if (Number(listBox.dataset.chunkFirst) <= 0) return;
    loadingOlder = true;
    try {
      await loadPrev();
    } catch {
      /* 取不到就先算了，滚一下还会再试 */
    } finally {
      loadingOlder = false;
      /* 还在顶部附近（这一屏没被填满）就继续补 */
      if (window.scrollY <= 900 && Number(listBox.dataset.chunkFirst) > 0) window.setTimeout(maybeLoadOlder, 180);
    }
  };
  window.addEventListener('scroll', () => void maybeLoadOlder(), { passive: true });

  /**
   * 把**全部**簇装进文档里 —— 只给验收脚本和调试用（`/salon/?all=1` 也走它）。
   *
   * 平时不需要：上翻会自己一簇一簇补。但有些验收要数全部 833 条
   * （条数、成员分布、折叠按钮个数…），那时候得一键铺满。
   * 铺完还是一段连续的簇，和用户自己滚上去滚出来的状态一模一样。
   */
  const loadAll = async () => {
    if (!listBox) return 0;
    let guard = 0;
    while (Number(listBox.dataset.chunkFirst) > 0 && guard < TOTAL_CHUNKS + 2) {
      guard += 1;
      if (!(await loadPrev())) break;
    }
    return document.querySelectorAll('.salon__item').length;
  };
  (window as unknown as { __salonLoadAll?: () => Promise<number> }).__salonLoadAll = loadAll;
  if (/[?&]all=1\b/.test(location.search)) void loadAll();

  /* ============================================================
     1. 进页面时落在哪儿：带 hash 就落在那一条，没带就落在**最新的一条**
     ------------------------------------------------------------
     带 hash（首页「每日精华」点一下就是 `/salon/#e0158`）：
       全站 `html { scroll-behavior: smooth }` 对**片段跳转**也生效 ——
       浏览器会从顶部开始"平滑"滚过去，可这一页非常高，
       实测滚了 3 秒还差 2870px 没到（等于没跳到）。所以这里在页面加载完之后
       把落点**直接做掉**（instant）。要落的那条可能还没渲出来（分块之后），
       所以先把它所在的那一簇弄进来。
     没带 hash：默认跳到最后一条（= 最新的一条），以后加了新精华自然又变成新的最后一条。
     两条都不该跟"用户自己"抢：从别的页返回时不插手，加载后那 600ms 里用户
     要是已经滚了 / 按了键，也不再把他拽回去。
     ============================================================ */
  let userTookOver = false;
  for (const ev of ['wheel', 'touchstart', 'keydown', 'mousedown'] as const) {
    window.addEventListener(ev, () => { userTookOver = true; }, { passive: true, once: true });
  }
  const cameBack = () => {
    const nav = performance.getEntriesByType?.('navigation')?.[0] as PerformanceNavigationTiming | undefined;
    return nav?.type === 'back_forward';
  };
  const latestItem = (): HTMLElement | null => {
    const items = [...document.querySelectorAll<HTMLElement>('.salon__item')].filter((el) => !el.hidden);
    return items.length ? items[items.length - 1] : null;
  };
  const land = (el: HTMLElement) =>
    el.scrollIntoView({ behavior: 'instant' as ScrollBehavior, block: 'start' });

  const landOnEntry = async () => {
    if (userTookOver || cameBack()) return;
    const raw = location.hash.replace(/^#/, '');
    if (raw) {
      let id = raw;
      try {
        id = decodeURIComponent(raw);
      } catch {
        /* 百分号写坏了就用原文 */
      }
      const n = chunkOfId(id);
      if (n !== null) await ensureChunk(n);
      const el = document.getElementById(id);
      if (el && el.classList.contains('salon__item')) land(el);
      return;
    }
    const last = latestItem();
    if (last) land(last);
  };
  window.addEventListener('load', () => {
    void landOnEntry().finally(() => {
      bootDone = true;
    });
    /* 字体分片 / 图片到位可能再挪一点位置，稍后再钉一次 */
    window.setTimeout(() => void landOnEntry(), 600);
  });
  document.fonts?.ready?.then(() => void landOnEntry());
  /* 落地那一步不管成没成都得开闸（`load` 万一没来，1.5 秒后也放开） */
  window.setTimeout(() => {
    bootDone = true;
  }, 1500);

  /* ============================================================
     2. 左边那条时间轴：点刻度 / 点塔吊 → 跳到离那儿最近的一条精华
     ------------------------------------------------------------
     用户的要求：
       「点击时间轴上的刻度，就跳到离那个日期最近的精华消息；
         点刻度即可，或是点时间轴上原本就有的塔吊图标」
     两条路都接上：
       · **刻度**：刻度是轴上一整条 SVG path，没有"哪一个"可言，
         所以由时间轴组件按坐标反推出"点到了轴上的哪个位置"，
         发一个 `tl:pick`（detail.param ∈ 0~1）；这里接住它，找 param 最近的那条。
       · **塔吊 / 名字**：那是 `.tl__item`，本身带 data-param，直接用它自己的。
     找最近用的是**全表索引**（不是已经渲出来的那些）—— 分块之后，
     想看的那条多半还没进文档，找到它所在的簇再取回来。
     ============================================================ */
  const tlBox = document.querySelector<HTMLElement>('[data-salon-tl]');

  if (tlBox && listBox && indexTable.length) {
    /** 离某个位置最近的那条精华（在全表里找） */
    const nearest = (want: number) => {
      let best: { id: string; t: number } | null = null;
      let bestD = Infinity;
      for (const [id, t] of indexTable) {
        const d = Math.abs(t - want);
        if (d < bestD) {
          bestD = d;
          best = { id, t };
        }
      }
      return best;
    };

    /**
     * 落到某条精华上：滚过去 + 闪一下 + 把地址栏的 hash 也换掉（好复制给别人）。
     * 让开多少 = 吸顶的那些东西实际占了多高（`--salon-jump-gap`，量出来的）。
     */
    const gapOf = () =>
      parseFloat(getComputedStyle(root).getPropertyValue('--salon-jump-gap')) || 88;

    const scrollToItem = (el: HTMLElement) => {
      const topOf = () => Math.max(0, el.getBoundingClientRect().top + window.scrollY - gapOf());
      window.scrollTo({ top: topOf(), behavior: 'smooth' });
      window.setTimeout(() => {
        const r = el.getBoundingClientRect();
        const want = gapOf();
        if (r.top < want - 60 || r.top > window.innerHeight * 0.5) {
          window.scrollTo({ top: topOf(), left: 0, behavior: 'instant' as ScrollBehavior });
        }
      }, 1200);
      el.classList.remove('salon__item--hit');
      void el.offsetWidth;
      el.classList.add('salon__item--hit');
      window.setTimeout(() => el.classList.remove('salon__item--hit'), 2400);
      try {
        history.replaceState(null, '', `#${el.id}`);
      } catch {
        /* 极老的浏览器不给改就算了 */
      }
    };

    const jumpTo = async (want: number) => {
      const near = nearest(want);
      if (!near) return;
      const n = chunkOfId(near.id);
      if (n !== null) await ensureChunk(n);
      const el = document.getElementById(near.id);
      if (el) scrollToItem(el);
    };

    /**
     * 手机上（没有悬停能力）点**塔吊/名字**保留原来的"两下"：
     * 第一下只弹提示卡，第二下点卡片里那行字才跳（用户当初要的）。
     * 电脑鼠标一下就跳。刻度没有卡片，两边都是一下。
     */
    const noHover = () => window.matchMedia('(hover: none)').matches;

    tlBox.addEventListener(
      'click',
      (ev) => {
        const t = ev.target as HTMLElement | null;
        const item = t?.closest?.<HTMLElement>('.tl__item');
        if (!item) return;
        const onCard = !!t?.closest?.('.tl__tipOpen');
        if (noHover() && !onCard) return; // 触屏第一下交给时间轴自己弹卡片
        const want = Number(item.dataset.param);
        if (!Number.isFinite(want)) return;
        // 抢在时间轴自己的锚点跳转之前接管（默认是跳到轴数据里那个 href）
        ev.preventDefault();
        /*
          **并且别再往下传**：时间轴上「点刻度 → 跳到最近那条」那套也挂在这一层，
          一次点击被两边都接住就会跳两次（第二次按点到的坐标算，落在别处），
          鼠标底下那一条就白点了。这一次点击归"点塔吊"这条路。
        */
        ev.stopPropagation();
        void jumpTo(want);
      },
      true
    );

    /* 刻度：时间轴把"点到了哪个位置"报上来，这里找最近的那条 */
    tlBox.addEventListener('tl:pick', (ev) => {
      const want = Number((ev as CustomEvent<{ param?: number }>).detail?.param);
      if (!Number.isFinite(want)) return;
      void jumpTo(want);
    });
  }

  /* ============================================================
     3. 搜索 + 按 / 聚焦 + 成员筛选
     ------------------------------------------------------------
     筛的是**全表**：关键词命中与否由 `/salon.json`（构建期导出的那份）现算，
     命中那条不在文档里就把它所在的簇取回来。所以"边打边筛 + 命中数"和
     分块装载不打架 —— 只是不再像以前那样 833 条全在 DOM 里等着被藏。
     成员筛选和搜索是**与**的关系：两边都允许才显示。
     ============================================================ */
  const q = document.getElementById('salon-q') as HTMLInputElement | null;
  const hit = document.getElementById('salon-hit');
  const pinBox = document.getElementById('salon-pin');

  /**
   * **点亮着的成员**（一个都没亮 = 所有精华都显示）。
   * 站长 2026-11-20 定的规矩：
   *   「默认状态下显示全部精华 而点了哪个成员头像就只显示那个成员的精华
   *     且那个成员的卡片周围会泛出霓虹光 再点一下就关闭依旧显示所有精华
   *     对于多人参与的 只要自己条目里任意一个成员的头像是亮着的状态就显示
   *     而如果点亮多个成员 会将仅这些成员共同参与的精华置顶 下翻依旧是他们分别每个人参与的」
   */
  const lit = new Set<string>();
  let keyword = '';
  let matchedIds: Set<string> | null = null; // null = 没在搜
  let searchIndex: Map<string, string> | null = null; // id → 检索文本
  let searchPending = false;
  /** id → 这条精华的成员名（置顶要用；和搜索共用 `/salon.json` 那一份） */
  let namesById: Map<string, string[]> | null = null;
  /** 置顶区里搬过去的条目（还原时按簇的缓存重画） */
  let pinnedIds = new Set<string>();

  /**
   * 一条精华现在该不该显示：
   *   · 一个成员都没点亮 → 全都显示；
   *   · 点亮了 → 这条的成员里**任意一个**亮着就显示（多人条目就是这个规矩）；
   *   · 没解析出成员的（群聊截图那种）在点亮状态下不显示 —— 它不属于任何一个人。
   */
  const memberOk = (el: HTMLElement) => {
    if (!lit.size) return true;
    const ids = (el.dataset.members || '').split(' ').filter(Boolean);
    return ids.some((id) => lit.has(id));
  };

  /** 把"该不该显示"落到每一条上，顺带收掉空掉的年代 / 日期头 */
  function applyFilters() {
    if (!listBox) return;
    let shown = 0;
    for (const el of listBox.querySelectorAll<HTMLElement>('.salon__item')) {
      const on = memberOk(el) && (!matchedIds || matchedIds.has(el.id));
      el.hidden = !on;
      if (on) shown += 1;
    }
    /* 头只在**自己那一簇里**找下面有没有可见的条目（跨簇的两个头由 chunkHtml 决定要不要出） */
    for (const box of chunkBoxes()) {
      const kids = Array.from(box.children) as HTMLElement[];
      for (let i = 0; i < kids.length; i += 1) {
        const head = kids[i];
        if (!head.matches('.salon__era, .salon__date')) continue;
        const isEra = head.classList.contains('salon__era');
        let any = false;
        for (let j = i + 1; j < kids.length; j += 1) {
          const k = kids[j];
          if (k.classList.contains('salon__era')) break;
          if (!isEra && k.classList.contains('salon__date')) break;
          if (k.classList.contains('salon__item') && !k.hidden) {
            any = true;
            break;
          }
        }
        head.hidden = !any;
      }
    }
    if (hit) {
      const n = matchedIds ? matchedIds.size : 0;
      hit.textContent = keyword ? `命中 ${n} / ${TOTAL} 条` : '';
    }
    /* 关键词一个都没命中才亮那句；命中数为 0 时下面本来也没有可见条目 */
    if (emptyEl) emptyEl.hidden = !(keyword && matchedIds && matchedIds.size === 0);
    /* 布局变了：时间轴缓存的位置作废，重排一次（它自己那条明路） */
    tlBox?.dispatchEvent(new CustomEvent('tl:reindex'));
  }

  /**
   * 把关键词命中的那些条所在的簇取回来。
   *
   * 一次最多铺 **60 条**命中：关键词太常见时（比如搜「的」能命中几百条），
   * 把它们的簇全取回来就等于又把整页拉了一遍 —— 那正是站长要避免的那件事。
   * 取的是**最近的**那些（簇号大的），因为找东西时多半是在找近期的。
   */
  const MAX_MATCH_SHOWN = 60;
  let loadingMatches = false;
  const ensureMatches = async (ids: string[]) => {
    if (loadingMatches || !listBox) return;
    const want = ids
      .map((id) => chunkOfId(id))
      .filter((n): n is number => n !== null && !hasChunk(n))
      .sort((a, b) => b - a)
      .slice(0, MAX_MATCH_SHOWN);
    if (!want.length) return;
    const need = [...new Set(want)];
    loadingMatches = true;
    try {
      for (const n of need) {
        if (hasChunk(n)) continue;
        placeChunk(n, await fetchChunk(n), true);
      }
      syncFolds();
      applyFilters();
      salon?.dispatchEvent(new CustomEvent('salon:chunks'));
    } catch {
      /* 取不到就先显示已有的那些 */
    } finally {
      loadingMatches = false;
    }
  };

  /**
   * 拿全表的检索文本 + 每条精华的成员名（第一次搜索 / 第一次点亮成员时才去取）。
   * 两个用途共用这一份 `/salon.json`，所以只请求一次：
   *   · 搜索：整段文本（成员名 + 日期 + 时刻 + 正文）里找关键词；
   *   · 置顶：判断"这条精华的参与人是不是都在点亮的那几个里"。
   */
  const loadSearchIndex = async () => {
    if (searchIndex || searchPending) return;
    searchPending = true;
    try {
      const res = await fetch(`${BASE.replace(/\/$/, '')}/salon.json`);
      if (!res.ok) return;
      const json = (await res.json()) as {
        essences?: {
          id: string; member?: string; date?: string; time?: string; text?: string;
          members?: { name?: string }[];
        }[];
      };
      const map = new Map<string, string>();
      const names = new Map<string, string[]>();
      for (const e of json.essences ?? []) {
        if (!e?.id) continue;
        map.set(e.id, [e.member ?? '', e.date ?? '', e.time ?? '', e.text ?? ''].join(' ').toLowerCase());
        names.set(e.id, (e.members ?? []).map((m) => String(m?.name ?? '')).filter(Boolean));
      }
      searchIndex = map;
      namesById = names;
    } catch {
      /* 网络不行就当没索引：只能筛已经渲出来的那些 */
    } finally {
      searchPending = false;
    }
  };

  /** 清掉搜索时临时插进来的那些簇，窗口回到连续的那一段 */
  const dropExtraChunks = () => {
    for (const b of chunkBoxes()) if (b.dataset.extra) b.remove();
  };

  const runSearch = async () => {
    keyword = q?.value.trim().toLowerCase() ?? '';
    if (!keyword) {
      matchedIds = null;
      dropExtraChunks();
      applyFilters();
      return;
    }
    await loadSearchIndex();
    const ids: string[] = [];
    if (searchIndex) {
      for (const [id, hay] of searchIndex) if (hay.includes(keyword)) ids.push(id);
    } else {
      /* 索引取不到：只能就地筛已经渲出来的（不至于一个字都搜不了） */
      for (const el of listBox?.querySelectorAll<HTMLElement>('.salon__item') ?? []) {
        if ((el.textContent || '').toLowerCase().includes(keyword)) ids.push(el.id);
      }
    }
    matchedIds = new Set(ids);
    applyFilters();
    if (ids.length) await ensureMatches(ids);
  };

  if (q) {
    q.addEventListener('input', () => void runSearch());
    q.addEventListener('search', () => void runSearch());
  }
  document.addEventListener('keydown', (e) => {
    // 按 / 聚焦搜索框（在输入框里打字时不抢）
    const t = e.target as HTMLElement | null;
    const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
    if (e.key === '/' && !typing && q) {
      e.preventDefault();
      q.focus();
      q.select();
    }
    if (e.key === 'Escape' && document.activeElement === q && q && q.value) {
      q.value = '';
      void runSearch();
    }
  });

  /**
   * 置顶区：点亮两个以上成员时，**他们共同参与**的那些精华搬到列表最上面。
   *
   * 站长的原话：「如果点亮多个成员 会将仅这些成员共同参与的精华置顶
   *              下翻依旧是他们分别每个人参与的」。
   * 所以判据是"这条精华的参与人里包含全部被点亮的成员"（共同参与），
   * 置顶的那些从下面的时间流里搬走（不是复制：复制会出两个同 id 的节点，
   * 点时间轴跳转会跳到藏起来的那一个）。
   *
   * 还原：被搬走的节点直接丢掉，然后把已经装进文档的每一簇**按缓存重画一遍** ——
   * 位置、顺序、折叠状态全都回到原样，比记住"原来挂在谁后面"稳妥得多。
   */
  const restorePins = () => {
    if (!pinBox) return;
    /* 什么都没搬过就别动：重画簇会把已经渲好的图片再走一遍，没必要 */
    if (!pinnedIds.size && !pinBox.childElementCount) return;
    pinBox.replaceChildren();
    pinBox.hidden = true;
    for (const box of chunkBoxes()) {
      const cached = chunkData.get(chunkOfBox(box));
      if (cached !== undefined) box.innerHTML = cached;
    }
    pinnedIds = new Set();
    folded.clear();
    syncFolds();
  };

  /** 把"共同参与"的那些搬进置顶区（先保证它们所在的那几簇都在文档里） */
  const applyPins = async () => {
    if (!pinBox) return;
    restorePins();
    if (lit.size < 2 || !namesById) return;
    const litNames = [...lit]
      .map((id) => memBox?.querySelector<HTMLElement>(`[data-mem="${id}"] .salon__memName`)?.textContent?.trim() ?? '')
      .filter(Boolean);
    if (litNames.length < 2) return;
    /* 共同参与 = 被点亮的每个人都在这条里 */
    const ids: string[] = [];
    for (const [id, names] of namesById) {
      if (litNames.every((n) => names.includes(n))) ids.push(id);
    }
    if (!ids.length) return;
    /* 时间顺序（索引表就是数据顺序，早的在前） */
    const order = new Map(indexTable.map((r, i) => [r[0], i]));
    ids.sort((a, b) => (order.get(a) ?? 0) - (order.get(b) ?? 0));
    /* 它们分散在各簇里：把还没装进文档的簇按"临时簇"取回来（只取，不放进时间流的意义上） */
    for (const n of new Set(ids.map((id) => chunkOfId(id)).filter((n): n is number => n !== null))) {
      if (!hasChunk(n)) placeChunk(n, await fetchChunk(n), true);
    }
    pinnedIds = new Set(ids);
    for (const id of ids) {
      const el = document.getElementById(id);
      if (el) pinBox.appendChild(el);
    }
    pinBox.hidden = pinBox.childElementCount === 0;
    syncFolds(pinBox);
  };

  /* ---- 成员栏：展开 / 收起 + 点亮某个人 ---- */
  const memBox = document.querySelector<HTMLElement>('[data-salon-members]');
  const memTab = memBox?.querySelector<HTMLButtonElement>('[data-mem-toggle]');

  const setMemOpen = (on: boolean) => {
    if (!memBox) return;
    memBox.dataset.open = on ? '1' : '0';
    memTab?.setAttribute('aria-expanded', on ? 'true' : 'false');
  };
  memTab?.addEventListener('click', () => setMemOpen(memBox?.dataset.open !== '1'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && memBox?.dataset.open === '1') setMemOpen(false);
  });
  /* 点面板外面收起（只处理手机端那片浮层；电脑端一直是开着的） */
  document.addEventListener('pointerdown', (e) => {
    if (memBox?.dataset.open !== '1') return;
    const t = e.target as Node | null;
    if (t && memBox.contains(t)) return;
    setMemOpen(false);
  });

  for (const card of memBox?.querySelectorAll<HTMLButtonElement>('[data-mem]') ?? []) {
    card.addEventListener('click', () => {
      const id = card.dataset.mem ?? '';
      if (!id) return;
      /* 点亮 / 熄灭：亮着 = 只看这个人（多人条目里任意一个亮着就显示） */
      if (lit.has(id)) lit.delete(id);
      else lit.add(id);
      const on = lit.has(id);
      card.dataset.on = on ? '1' : '0';
      card.setAttribute('aria-pressed', on ? 'true' : 'false');
      void (async () => {
        if (lit.size >= 2) await loadSearchIndex();
        await applyPins();
        applyFilters();
      })();
    });
  }

  /* ============================================================================
   * 长文字折起来
   * ---------------------------------------------------------------------------
   * 用户原话（2026-09-22，看到那 8 条几百上千字的 OCR 转录之后）：「要加折叠」。
   * 规矩：
   *   · 只有**真的溢出**（裁到 8 行以后还剩内容）才给那颗「展开」——
   *     短的那些一个按钮都不出现；
   *   · 裁剪的 CSS 挂在 `.is-clamped` 上，而这个类**只有脚本加**：
   *     没跑 JS 的浏览器看到的是全文；
   *   · 窗口变宽变窄会重新判一次；已经点开的那条不动它。
   * 分块之后每插进来一簇就只判那一簇（`scope`），不用回头把前面几百条重量一遍。
   * ========================================================================= */
  const FOLD_LINES = 8;
  const folded = new Map<HTMLElement, { btn: HTMLButtonElement; open: boolean }>();
  let syncFoldsQueued = false;

  function syncFolds(scope?: HTMLElement) {
    const boxes: HTMLElement[] = [];
    (scope ?? document).querySelectorAll<HTMLElement>('.salon__item').forEach((item) => {
      /* 被搜索 / 成员筛选藏起来的这种量不出高度，跳过；下次会补上 */
      if (item.hidden) return;
      const box = item.querySelector<HTMLElement>('.salon__text');
      if (!box || !box.textContent?.trim()) return;
      box.style.setProperty('--fold-lines', String(FOLD_LINES));
      if (folded.get(box)?.open) return;
      box.classList.add('is-clamped');
      boxes.push(box);
    });
    /* 一次读：从这里到下面那圈循环之间**不能有任何写** */
    const over = boxes.map((box) => box.scrollHeight - box.clientHeight);
    boxes.forEach((box, i) => {
      const state = folded.get(box);
      if (over[i] > 4) {
        if (state) return;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'salon__fold';
        btn.textContent = '展开';
        btn.setAttribute('aria-expanded', 'false');
        btn.addEventListener('click', () => {
          const st = folded.get(box);
          if (!st) return;
          st.open = !st.open;
          box.classList.toggle('is-clamped', !st.open);
          st.btn.textContent = st.open ? '收起' : '展开';
          st.btn.setAttribute('aria-expanded', st.open ? 'true' : 'false');
        });
        box.after(btn);
        folded.set(box, { btn, open: false });
      } else {
        box.classList.remove('is-clamped');
        if (state) {
          state.btn.remove();
          folded.delete(box);
        }
      }
    });
  }

  const queueFolds = () => {
    if (syncFoldsQueued) return;
    syncFoldsQueued = true;
    requestAnimationFrame(() => {
      syncFoldsQueued = false;
      syncFolds();
    });
  };

  syncFolds();
  applyFilters();
  /* 图 / 字体到位后行数还会变，加载完再判一次 */
  window.addEventListener('load', () => window.setTimeout(() => syncFolds(), 60));
  window.addEventListener('resize', queueFolds);
  /* 筛选变了以后有些条目重新露出来，也得判一次（藏在下面的量不出高度） */
  window.addEventListener('salon:chunks', queueFolds);

  /*
    「还在继续」的那个年代（数据里 to 写的是 2099）按**访问者当天**重算天数 ——
    构建期先按构建那天算好，打开页面时再对一次（和时间轴的实时点一个规矩）。
  */
  const syncEraDays = () => {
    const iso = (d: number) => new Date(d * 86400000).toISOString().slice(0, 10);
    const no = (s: string) => {
      const m = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(String(s ?? '').trim());
      return m ? Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3])) / 86400000 : NaN;
    };
    const now = new Date();
    const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86400000;
    document.querySelectorAll<HTMLElement>('.salon__eraDays[data-live="1"]').forEach((el) => {
      const from = no(el.dataset.eraFrom ?? '');
      const to = no(el.dataset.eraTo ?? '');
      if (!Number.isFinite(from) || !Number.isFinite(to)) return;
      const end = Math.min(to, today);
      el.textContent = `${Math.max(1, Math.round(end - from) + 1)} 天`;
      el.title = `${iso(from)} → 还在继续（按今天 ${iso(today)} 算）`;
    });
  };
  syncEraDays();
  window.addEventListener('salon:chunks', syncEraDays);
</script>

<style>
  /* ============================================================================
   *  观感：站点「大板块子页面」那一套（深紫底 + 粉边 + 渐变玻璃块）
   *  ---------------------------------------------------------------------------
   *  用户原话：「精华页面的整体风格不对，不应该使用文章风格的配色，
   *            而应该用页面风格，例如纷湖下的页面隰辰煦家那样的网站整体风格」
   * ========================================================================= */
  :global(body.is-salon) {
    background-color: #1e0730;
    /* 这一页容器的上限（下面两处选择器都用它） */
    --salon-max: 1760px;
  }
  /*
    这一页要比站里其他页**宽**（站长 2026-11-20：「让电脑精华页的精华正文内容放到正中间
    且更宽方便阅读」）。站点`.container` 的上限是 --w-page（68rem = 1088px），
    左中右三栏塞进 1088 里正文只剩 600 多 —— 所以只在这一页把容器的上限放开。
    ⚠ 整条选择器都得包在 :global() 里：`.site-main` / `.container` 是 BaseLayout 渲的，
      身上没有这一页的作用域属性，只 global 掉 body 那一段的话它匹配不上（实测无效）。
  */
  :global(body.is-salon .site-main > .container) {
    max-width: var(--salon-max);
  }
  /*
    页脚也跟着往中间让：左右那两栏是 fixed 的、整屏高，页脚滚到底时会被它们压住一截
    （页脚自己是个 68rem 的容器，正文贴到边上）。只在这一页把页脚的内容收进正文那一栏的宽度。
  */
  :global(body.is-salon) .site-footer__inner {
    padding-inline: calc(var(--salon-rail-w, 260px) + var(--salon-gap, 1.6rem) * 2);
  }

  .salon {
    /*
      两边那两栏等宽 —— 站长要的是「正文摆在正中间、右边成员栏和左边时间轴对称」。
      所以左右写成同一个变量，中间那栏自己 flex:1 吃掉剩下的，再自己居中。
    */
    --salon-rail-w: clamp(250px, 18vw, 290px);
    --salon-gap: clamp(1rem, 1.8vw, 1.8rem);
    display: flex;
    gap: var(--salon-gap);
    margin: 0 auto;
    /*
      上边距刻意给 0：左边的轴要"一屏占满"，它的起点就必须紧贴站点页头。
      左右两栏是 fixed（不占流），这里把它们的宽度让出来，正文才算得正中。
    */
    padding: 0 calc(var(--salon-rail-w) + var(--salon-gap)) 5rem;
  }

  /*
    左边那条轴：**整屏高、钉在屏幕左边**（站长 2026-11-20：「两个框都飘在半空且不一样高
    很奇怪 让左右两个框都能跨满上下屏」）。
    · 用 fixed 不用 sticky：sticky 的活动范围是**它自己那个容器**（.salon）——
      滚到页面最底下时会因为容器的下沿到了而被往上顶，顶上那截钻进吸顶页头里
      （实测差 70px）。fixed 是相对视口，从上一直到底，跨屏这件事才成立。
    · 高度由 top + bottom 定死（不写 height:100dvh，免得手机地址栏收放那一跳）。
    · 水平位置：容器是 1760 居中 + 两侧 1.5rem 内边距，轴的左沿要落在它的内容左沿上，
      所以这里把那段算出来（100% 在 fixed 里是视口宽，不含滚动条）。
  */
  .salon__side,
  .salon__members {
    position: fixed;
    top: var(--salon-top, 5.5rem);
    bottom: 0;
    width: var(--salon-rail-w);
  }
  .salon__side {
    left: calc(max(0px, (100% - var(--salon-max)) / 2) + var(--sp-5, 1.5rem));
