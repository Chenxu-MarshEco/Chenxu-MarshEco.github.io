  /* ============================================================================
   *  成员栏
   *  ---------------------------------------------------------------------------
   *  电脑端：右边一整栏，和左边那条时间轴对称（同一个宽度变量）、常驻、不折叠 ——
   *          站长原话「电脑端的成员卡片可以改为和在时间轴对称的右边新建一个竖着的框
   *          位置 竖着排列下来 不需要隐藏 因为电脑端屏幕空间足够」。
   *  手机端：顶部一根常驻栏，收起时只剩一枚没字的标签卡（见下面的 @media），
   *          点开是一整片卡片（浮层，不挤正文）。
   * ========================================================================= */
  /* 电脑端没有"收起"这回事：那枚标签卡不出现 */
  .salon__memBar {
    display: none;
  }
  /*
    面板撑满那一栏：栏本身是 fixed 的整屏高（top 到 0），面板在里面铺满，
    于是左右两个框**一样高**、都从页头底下一直到底（站长要的「跨满上下屏」）。
    人多到装不下时这一栏自己滚（`overflow-y: auto`），不把页面撑高。
  */
  .salon__memPanel {
    box-sizing: border-box;
    height: 100%;
    padding: 0.5rem 0.45rem;
    border: 1px solid rgba(255, 120, 190, 0.42);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(46, 8, 70, 0.78), rgba(20, 3, 34, 0.78));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .salon__memList {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.28rem;
    margin: 0;
    padding: 0;
    list-style: none;
    /*
      卡片把这一栏的高度分掉：人少的时候每张卡高一点、正好铺满，
      人多的时候每行回到它自己的高度、多出来的部分由面板滚动 ——
      这样右栏不会出现"下面是空的一大截"。
    */
    /* 人少时也从上往下密排（站长 2026-11-20）；人多时装不下由面板自己滚 */
    align-content: start;
    grid-auto-rows: min-content;
  }
  /*
    一张成员卡：左边小眼睛（开关），中间头像 + 名字，右边「N 条」。
    默认全都不亮 = 所有精华都显示；**点亮**某一张就只看这个人的精华，
    亮着的那张卡四周泛一圈霓虹光（粉 + 青，和站点别处的光晕一套）。
    规矩是站长 2026-11-20 定的：
      「默认状态下显示全部精华 而点了哪个成员头像就只显示那个成员的精华
        且那个成员的卡片周围会泛出霓虹光 再点一下就关闭依旧显示所有精华」。
  */
  .salon__memCard {
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.36rem;
    width: 100%;
    box-sizing: border-box;
    padding: 0.3rem 0.45rem;
    border: 1px solid rgba(255, 120, 190, 0.45);
    border-radius: 12px;
    background: linear-gradient(180deg, rgba(62, 13, 94, 0.9), rgba(28, 5, 44, 0.9));
    color: #ffe6f6;
    font: inherit;
    font-size: 0.8rem;
    text-align: left;
    cursor: pointer;
    transition: filter 0.15s ease, border-color 0.15s ease, box-shadow 0.18s ease,
      background 0.18s ease;
  }
  .salon__memCard:hover {
    filter: brightness(1.08);
  }
  .salon__memCard:focus-visible {
    outline: 2px solid rgba(255, 120, 190, 0.8);
    outline-offset: 2px;
  }
  /* 点亮的那一张：霓虹光圈（外圈粉、内一层青，两层叠出"灯管"的味道） */
  .salon__memCard[data-on='1'] {
    border-color: rgba(255, 150, 215, 0.95);
    background: linear-gradient(180deg, rgba(92, 20, 132, 0.95), rgba(40, 8, 62, 0.95));
    box-shadow:
      0 0 0 1px rgba(255, 120, 190, 0.85),
      0 0 14px rgba(255, 79, 163, 0.75),
      0 0 30px rgba(255, 79, 163, 0.45),
      0 0 44px rgba(95, 240, 255, 0.22);
  }
  .salon__memCard[data-on='1'] .salon__memName {
    color: #fff;
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.9), 0 0 22px rgba(255, 79, 163, 0.5);
  }
  .salon__memCard[data-on='1'] .salon__memEye {
    color: #fff;
  }
  .salon__memCard[data-on='1'] .salon__memFace {
    border-color: rgba(255, 190, 230, 0.95);
    box-shadow: 0 0 10px rgba(255, 79, 163, 0.8);
  }
  .salon__memEye {
    display: inline-flex;
    width: 1.05em;
    height: 1.05em;
    color: #ffb3dd;
  }
  .salon__memEye svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }
  .salon__memFace {
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 120, 190, 0.55);
    background: rgba(22, 3, 36, 0.9);
  }
  .salon__memFace--none {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffb3dd;
    font-size: 0.72rem;
  }
  .salon__memName {
    min-width: 0;
    overflow: hidden;
    font-weight: 500;
    letter-spacing: 0.03em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .salon__memCount {
    flex: none;
    color: rgba(255, 226, 244, 0.6);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  /* ============================================================================
   *  窄屏（手机）：轴固定在屏幕**左边**一条细栏里，正文在它右边，成员栏在顶上
   *  ---------------------------------------------------------------------------
   *  轴那条栏的来龙去脉见 Timeline.astro 的 .tl.is-rail。
   * ========================================================================= */
  @media (max-width: 880px) {
    .salon {
      flex-direction: column;
      /*
        左边这条轴栏占多宽。用户要「更细一点以免占用太多正文空间」，
        所以给到 390px 手机上 ≈ 70px（屏宽的 18%）：正文还剩 ~265px（约 68%）。
      */
      --salon-rail-w: clamp(64px, 18vw, 96px);
      gap: 0;
      /* 正文用 padding 让开这条栏 —— 栏是 fixed，不占 .salon 的布局位置 */
      padding-left: calc(var(--salon-rail-w) + 0.3rem);
      padding-right: 0.15rem;
    }
    /*
      **成员栏**在手机上是「顶部那根常驻栏」：订在屏幕上方（和页头同一个让开量），
      收起时只有一枚标签卡 —— 站长原话「隐藏状态下不要写字就留那种标签卡的样子」。
      sticky 而不是 fixed：它占的那点高度正好把搜索栏顶下去，两样都不叠。
    */
    .salon__members {
      order: 1;
      flex: none;
      width: 100%;
      position: sticky;
      /* 电脑端那套是 fixed + 整屏高，手机端这里全部退回来：只需要贴在顶上那一条 */
      top: var(--salon-top, 3.6rem);
      bottom: auto;
      left: auto;
      right: auto;
      z-index: 26;
      align-self: auto;
      background: #1e0730;
    }
    .salon__memBar {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      height: var(--salon-mem-h, 2.2rem);
      padding: 0 0.1rem;
    }
    /* 那枚「标签卡」：只有图形、没有一个字 */
    .salon__memTab {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 1.75rem;
      padding: 0;
      border: 1px solid rgba(255, 120, 190, 0.5);
      border-radius: 10px;
      background: linear-gradient(180deg, rgba(62, 13, 94, 0.95), rgba(28, 5, 44, 0.95));
      color: #ffb3dd;
      cursor: pointer;
    }
    .salon__memTab svg {
      width: 1.15rem;
      height: 1.15rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .salon__memTab[aria-expanded='true'] {
      border-color: rgba(255, 160, 210, 0.85);
      color: #fff;
    }
    /*
      展开的那片卡片：**浮层**（fixed），从成员栏底下一直铺到屏幕两边 ——
      手机屏幕窄，挤在正文那一栏里只能一行两个，铺满一行能放五个。
      它不占高度，所以展开 / 收起不会把下面的正文顶来顶去。
    */
    .salon__memPanel {
      display: none;
      position: fixed;
      left: 0;
      right: 0;
      top: calc(var(--salon-top, 3.6rem) + var(--salon-mem-h, 2.2rem));
      /* 电脑端那条 height:100% 是"撑满整屏高那一栏"，手机上这里要按内容走 */
      height: auto;
      z-index: 30;
      max-height: 62dvh;
      overflow-y: auto;
      /*
        浮层压在正文上面：底必须是**实色**的（上面那条共用规则是 78% 的渐变，
        正文会从缝里透出来，一眼就看出"两串字叠在一起"）。
      */
      background-color: #1e0730;
      border: 0;
      border-bottom: 1px solid rgba(255, 120, 190, 0.45);
      border-radius: 0 0 16px 16px;
      box-shadow: 0 20px 44px -22px #000;
      overscroll-behavior: contain;
    }
    .salon__members[data-open='1'] .salon__memPanel {
      display: block;
    }
    /*
      卡片排成网格：`auto-fill` + 等宽列 —— 最后一行不满时**靠左**排，
      列和上一行严格对齐（站长原话：「第三排只有三个时 第三排要靠左对齐
      不要居中导致第三排的卡片和第二排在竖直方向上不对齐」）。
      390px 上量到一行 5 个。
    */
    .salon__memList {
      grid-template-columns: repeat(auto-fill, minmax(4.4rem, 1fr));
      gap: 0.34rem;
      /* 电脑端那两行是"把一栏的高度分掉"，手机上不要（浮层按内容高就行） */
      min-height: 0;
      grid-auto-rows: auto;
    }
    /* 手机上卡片改成竖的（头像在上、名字和条数在下），一行才放得下五个 */
    .salon__memCard {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 0.16rem;
      padding: 0.42rem 0.2rem 0.34rem;
      font-size: 0.72rem;
      text-align: center;
    }
    .salon__memEye {
      position: absolute;
      left: 0.28rem;
      top: 0.28rem;
      width: 0.95em;
      height: 0.95em;
    }
    .salon__memFace {
      width: 30px;
      height: 30px;
    }
    .salon__memName {
      width: 100%;
      font-size: 0.72rem;
    }
    .salon__memCount {
      font-size: 0.66rem;
    }

    /*
      轴那一栏：钉在屏幕左边、从页头底下一直到底。
      底用实色（不是透明）：正文要从它旁边滚过去，透了就成了两串字叠在一起。
    */
    .salon__side {
      position: fixed;
      left: 0;
      top: var(--salon-top, 3.6rem);
      bottom: 0;
      z-index: 25;
      flex: none;
      width: var(--salon-rail-w);
      padding: 0 0.15rem 0.25rem 0.2rem;
      background: #1e0730;
      border-right: 1px solid rgba(255, 120, 190, 0.22);
    }
    .salon__tl {
      --tl-panel-h: calc(100dvh - var(--salon-top, 3.6rem) - 0.25rem);
      /* 弧线几何要一个「窄栏」的事实：窄栏里没有横着写的名字，弧顶居中更好看 */
      --tl-apex: 0.5;
      /* 凸出量跟着收：栏只有 60~90px 宽，凸 30px 塔吊就会被裁掉半边 */
      --tl-bulge: 12px;
      /* 塔吊不转向：转了的塔吊是横着朝外伸的，一根就横向占 26px，细栏里放不下两根 */
      --tl-crane-rot: 0;
      /* 栏有多宽告诉轴自己：手机上点塔吊弹出的提示卡要让开这一条栏 */
      --tl-rail-w: var(--salon-rail-w);
      height: 100%;
    }
    .salon__main {
      order: 2;
      max-width: none;
      padding-top: 0;
    }
    .salon__head {
      margin-top: 0.7rem;
    }
    /* 搜索栏：让开顶上那根成员栏，一直停在它下面 */
    .salon__searchBar {
      top: var(--salon-top-search, var(--salon-top, 3.6rem));
    }
  }
