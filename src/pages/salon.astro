---
/**
 * 冰室精华（群精华）页面 —— /salon/
 *
 * 数据全在 `src/data/salon.json`（由群精华导出文件整理而来，见 utils/salon.ts）。
 *
 * 三件事和用户的要求一一对应：
 *   1. **左边那条时间轴常驻**：用的是站点自己的时间轴组件，`pinned + fill` 模式 ——
 *      不走右边滑出的抽屉、没有书签、没有关闭按钮，一进页面就是开的；
 *      高度由这一页给（`--tl-panel-h`），电脑端撑到一屏几乎占满，
 *      手机端吸在屏幕上半部分。点轴上的刻度或塔吊都跳到最近的那条精华。
 *   2. **搜索保留**：按 / 聚焦，边打边筛，右上角显示命中数；两端都吸顶常驻。
 *   3. **每条精华 = 成员 + 时间 + 内容**：成员名和头像都从成员表现查
 *      （所以编辑器里给成员改名/换头像，这里和历史所有精华一起变）。
 *
 * 观感按用户要求走**页面风格**（和「隰辰煦家」那种大板块子页面一套）：
 * 深紫底 #1e0730 + 粉边 + 渐变玻璃块 + 粉字白标题，
 * 不再是文章那种「浅粉底 + 深琥珀字」的配色（那是 BaseLayout 默认那套）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import {
  salonEssences,
  salonEras,
  salonMembers,
  salonNote,
  salonTitle,
  salonTimelineId,
  salonUpdated,
  essenceIds,
  essenceParams,
  memberName,
  membersOf,
} from '../utils/salon';
import { getTimeline } from '../utils/timelines';
import { variantUrl, imageDims } from '../utils/images';

/*
  左边那条时间轴：编辑器里选中的那一条，**原样**渲染。
  以前这里是按精华日期自己生成几百个点（还写死比例尺），又卡又超出用户要求 ——
  现在的规则是「点、段、塔吊、比例尺全是那条轴自己的，一个都不加不删」。
*/
const tl = salonTimelineId ? getTimeline(salonTimelineId) : undefined;
const params = tl ? essenceParams(tl) : new Map<string, number>();
const list = salonEssences;
const eraName = new Map(salonEras.map((e) => [e.id, e.title]));
/** 只在"换了一个年代"的那条精华前面插一个年代大标题 */
const eraOf = (e: (typeof list)[number], prev: (typeof list)[number] | undefined) =>
  !prev || prev.eraId !== e.eraId ? e : null;
/** 时间轴默认停在最早那一天（一进页面看到的就是开头） */
const firstParam = list.length && tl ? (params.get(list[0].id) ?? 0) : 0;
---

<BaseLayout
  title={salonTitle}
  description={`${salonTitle}：冰室群里的精华消息，${list.length} 条，${salonUpdated} 前更新。`}
  bodyClass="is-board is-salon"
>
  <div class="salon">
    <aside class="salon__side">
      {tl ? (
        <div class="salon__tl" data-salon-tl data-tl-id={tl.id}>
          {/* 原样放上去：不传任何会改它的东西，只给它宽度和一个高度 */}
          <Timeline timeline={tl} pinned={true} fill={true} defaultParam={firstParam} />
        </div>
      ) : (
        <p class="salon__tlNone">
          这里还没有放时间轴。<br />
          编辑器的「精华」面板里可以选一条站点已有的时间轴放上来（<b>原样放，不改一个字</b>）。
        </p>
      )}
      {/*
        这行说明放在轴的**下面**：放上面会把轴往下推，一进页面（还没滚的时候）
        轴底下那条比例尺就被裁在屏幕外了 —— 实测"拖比例尺滑块"那条验收就是这么挂的。
      */}
      <p class="salon__sideNote" title={`成员 ${salonMembers.length} 人 · 精华 ${list.length} 条`}>
        {tl ? <>点<b>刻度</b>或<b>塔吊</b> → 跳到最近的一条精华</> : <>还没有选时间轴</>}
      </p>
    </aside>

    <main class="salon__main">
      <header class="salon__head">
        <h1 class="salon__title">{salonTitle}</h1>
        <p class="salon__meta">
          共 {list.length} 条 · 成员 {salonMembers.length} 人 · 截至 {salonUpdated}
          {salonNote && <span class="salon__note">　{salonNote}</span>}
        </p>
      </header>

      {/*
        搜索栏从页头里挪出来单独一层：它要**无论怎么翻都留在屏幕里**
        （电脑和手机都要），而 sticky 只能在自己父元素的范围内粘住 ——
        留在 .salon__head 里的话，页头一滚过去它就跟着走了。
      */}
      <div class="salon__searchBar">
        <div class="salon__searchBox">
          <input
            id="salon-q"
            class="salon__search"
            type="search"
            placeholder="搜索关键词 / 成员 / 日期…（按 / 聚焦）"
            autocomplete="off"
          />
          <span id="salon-hit" class="salon__hit" aria-live="polite"></span>
        </div>
      </div>

      <div class="salon__list" id="salon-list">
        {
          list.map((e, i) => {
            const prev = list[i - 1];
            const era = eraOf(e, prev);
            const people = membersOf(e);
            const name = memberName(e);
            const ids = essenceIds(e);
            return (
              <>
                {era && <h2 class="salon__era">{eraName.get(e.eraId)}</h2>}
                {(!prev || prev.date !== e.date) && <h3 class="salon__date">{e.date}</h3>}
                <article
                  class="salon__item"
                  id={e.id}
                  data-tl-param={params.get(e.id)}
                  data-members={ids.join(' ')}
                  data-kind={e.kind || 'text'}
                >
                  <div class="salon__who">
                    {/*
                      这条精华的成员**可能不止一个**（完美对话是多人一起说的）。
                      头像每个成员一个、叠着排；没传头像的成员用首字占位圆。
                      一个成员都没解析出来的（OCR 只认出游戏聊天/表格的那种）画一个"群"。
                    */}
                    <span class="salon__faces">
                      {people.length ? (
                        people.map((p) => (
                          <span class="salon__face" title={p.name}>
                            {p.avatar ? (
                              <img class="salon__avatar" src={variantUrl(p.avatar, 400)} alt="" loading="lazy" decoding="async" />
                            ) : (
                              <span class="salon__avatar salon__avatar--none" aria-hidden="true">
                                {p.name.slice(0, 1)}
                              </span>
                            )}
                          </span>
                        ))
                      ) : (
                        <span class="salon__face" title="这条没解析出成员（OCR 是游戏聊天/表格截图）">
                          <span class="salon__avatar salon__avatar--none" aria-hidden="true">
                            群
                          </span>
                        </span>
                      )}
                    </span>
                    <b class="salon__name">{name}</b>
                    {e.ocr && (
                      <span class="salon__badge" title="这条的正文是截图 OCR 自动转录的，尚未人工校对">
                        OCR 转录
                      </span>
                    )}
                    <time class="salon__time" datetime={`${e.date}T${e.time || '00:00'}`}>
                      {e.date}
                      {e.time && ` ${e.time}`}
                    </time>
                  </div>

                  {e.text && <blockquote class="salon__text">{e.text}</blockquote>}

                  {e.images.map((src) => {
                    /*
                      宽高一定要写（`imageDims` 从图片管线的清单里取，连"原样发"的小图也有）：
                      浏览器拿到宽高就会先把位置留出来，图到位的时候不会把
                      下面的几百条一起顶下去 —— 页面一边滚一边跳版就是这么来的。
                    */
                    const dim = imageDims(src);
                    return (
                      /* aria-label：图片本身 alt 是空的（截图内容说不清），
                         链接又只有一张图，读屏会只念"链接"—— 补一句人能听懂的 */
                      <a
                        class="salon__pic"
                        href={src}
                        target="_blank"
                        rel="noopener"
                        aria-label={`查看大图：${name} ${e.date}`}
                      >
                        <img
                          src={variantUrl(src, 800)}
                          width={dim?.w}
                          height={dim?.h}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    );
                  })}
                </article>
              </>
            );
          })
        }
        <p class="salon__empty" id="salon-empty" hidden>没有匹配的精华，换个词试试。</p>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  /* ============================================================
     0. 「粘在哪儿」这件事量出来，别写死
     ------------------------------------------------------------
     页头的高度会随字号、语言、窗口宽度变（窄到一定程度导航会换行），
     左边那条轴和搜索栏的吸顶位置都得以它为准。
     量出来写进 CSS 变量：--salon-top（吸顶要让开多少）、
     --salon-note（轴上面那行说明占多高，轴的高度要把它减掉）。
     ============================================================ */
  const root = document.documentElement;
  const sideNote = document.querySelector<HTMLElement>('.salon__sideNote');

  const measureSticky = () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    const bar = document.querySelector<HTMLElement>('.salon__searchBar');
    const axis = document.querySelector<HTMLElement>('.salon__tl');
    const mobile = window.matchMedia('(max-width: 880px)').matches;
    const top = Math.round((header?.getBoundingClientRect().height ?? 0) + 10);
    const note = Math.round(sideNote?.getBoundingClientRect().height ?? 0);
    const barH = Math.round(bar?.getBoundingClientRect().height ?? 0);
    const axisH = Math.round(axis?.getBoundingClientRect().height ?? 0);
    root.style.setProperty('--salon-top', `${top}px`);
    root.style.setProperty('--salon-note', `${note}px`);
    /*
      「跳过去以后那一条要落在哪儿」= 它得从所有吸顶的东西下面露出来：
      页头 + 搜索栏（两端都有），手机端还要加轴上那一块。
    */
    root.style.setProperty('--salon-jump-gap', `${Math.round(top + barH + (mobile ? axisH : 0) + 10)}px`);
  };
  measureSticky();
  /* 尺寸一变就重量（防抖到下一帧，免得拖窗口时连着量几十遍） */
  let measureQueued = false;
  const queueMeasure = () => {
    if (measureQueued) return;
    measureQueued = true;
    requestAnimationFrame(() => {
      measureQueued = false;
      measureSticky();
    });
  };
  window.addEventListener('resize', queueMeasure);
  document.fonts?.ready?.then(queueMeasure);

  /* ============================================================
     1. 左边那条时间轴：点刻度 / 点塔吊 → 跳到离那儿最近的一条精华
     ------------------------------------------------------------
     用户的要求：
       「点击时间轴上的刻度，就跳到离那个日期最近的精华消息；
         点刻度即可，或是点时间轴上原本就有的塔吊图标」

     两条路都接上：
       · **刻度**：刻度是轴上一整条 SVG path，没有"哪一个"可言，
         所以由时间轴组件按坐标反推出"点到了轴上的哪个位置"，
         发一个 `tl:pick`（detail.param ∈ 0~1）；这里接住它，找 param 最近的那条。
       · **塔吊 / 名字**：那是 `.tl__item`，本身带 data-param，直接用它自己的。
     两边都靠「位置」比而不是比日期：轴上可能有没有日期的「难以考据」点，
     比位置对它们也成立。
     ============================================================ */
  const tlBox = document.querySelector<HTMLElement>('[data-salon-tl]');
  const tlList = document.getElementById('salon-list');

  if (tlBox && tlList) {
    const rows = Array.from(tlList.querySelectorAll<HTMLElement>('.salon__item'));
    const params = rows
      .map((el) => ({ el, t: Number(el.dataset.tlParam) }))
      .filter((r) => Number.isFinite(r.t));

    /** 离某个位置最近的那条精华 */
    const nearest = (want: number) => {
      let best: (typeof params)[number] | null = null;
      let bestD = Infinity;
      for (const p of params) {
        const d = Math.abs(p.t - want);
        if (d < bestD) {
          bestD = d;
          best = p;
        }
      }
      return best;
    };

    /**
     * 落到某条精华上：滚过去 + 闪一下 + 把地址栏的 hash 也换掉（好复制给别人）。
     *
     * 让开多少 = 吸顶的那些东西实际占了多高（`--salon-jump-gap`，量出来的）：
     *   电脑端是页头 + 搜索栏；手机端还要加上面那条轴。
     * 写死一个数字在手机上会正好把落点压在轴底下（等于"点了没反应"）。
     */
    const gapOf = () =>
      parseFloat(getComputedStyle(root).getPropertyValue('--salon-jump-gap')) || 88;

    const jumpTo = (el: HTMLElement) => {
      /*
        自己算目标位置再 scrollTo，比 scrollIntoView 可控。
        平滑滚动偶尔会被打断（这条轴自己也在跟着页面滚），所以 1.2 秒后检查一次 ——
        还没到就把"到位"这件事直接做掉，绝不留下"点了但停在半路"。
      */
      const topOf = () => Math.max(0, el.getBoundingClientRect().top + window.scrollY - gapOf());
      window.scrollTo({ top: topOf(), behavior: 'smooth' });
      window.setTimeout(() => {
        const r = el.getBoundingClientRect();
        const want = gapOf();
        if (r.top < want - 60 || r.top > window.innerHeight * 0.5) {
          window.scrollTo({ top: topOf(), left: 0, behavior: 'instant' as ScrollBehavior });
        }
      }, 1200);
      el.classList.remove('salon__item--hit');
      // 重新触发一次动画：先把类摘掉、读一下布局、再加回去
      void el.offsetWidth;
      el.classList.add('salon__item--hit');
      window.setTimeout(() => el.classList.remove('salon__item--hit'), 2400);
      try {
        history.replaceState(null, '', `#${el.id}`);
      } catch {
        /* 极老的浏览器不给改就算了 */
      }
    };

    /**
     * 手机上（没有悬停能力）点**塔吊/名字**保留原来的"两下"：
     * 第一下只弹提示卡，第二下点卡片里那行字才跳（用户当初要的）。
     * 电脑鼠标一下就跳。刻度没有卡片，两边都是一下。
     */
    const noHover = () => window.matchMedia('(hover: none)').matches;

    tlBox.addEventListener(
      'click',
      (ev) => {
        const t = ev.target as HTMLElement | null;
        const item = t?.closest?.<HTMLElement>('.tl__item');
        if (!item || !params.length) return;
        const onCard = !!t?.closest?.('.tl__tipOpen');
        if (noHover() && !onCard) return; // 触屏第一下交给时间轴自己弹卡片
        const want = Number(item.dataset.param);
        if (!Number.isFinite(want)) return;
        // 抢在时间轴自己的锚点跳转之前接管（默认是跳到轴数据里那个 href）
        ev.preventDefault();
        const best = nearest(want);
        if (best) jumpTo(best.el);
      },
      true
    );

    /* 刻度：时间轴把"点到了哪个位置"报上来，这里找最近的那条 */
    tlBox.addEventListener('tl:pick', (ev) => {
      const want = Number((ev as CustomEvent<{ param?: number }>).detail?.param);
      if (!Number.isFinite(want) || !params.length) return;
      const best = nearest(want);
      if (best) jumpTo(best.el);
    });
  }

  /* ============================================================
     2. 搜索 + 按 / 聚焦
     ------------------------------------------------------------
     纯前端筛：精华是一次性静态渲染出来的（搜索引擎也看得到），
     这里只是给它加一层"边打边筛"。用 textContent 当检索文本 ——
     成员名、日期、时刻、正文都在里面，不用另外维护一份索引。
     ============================================================ */
  const q = document.getElementById('salon-q') as HTMLInputElement | null;
  const list = document.getElementById('salon-list');
  const hit = document.getElementById('salon-hit');
  const empty = document.getElementById('salon-empty');

  if (q && list) {
    const items = Array.from(list.querySelectorAll<HTMLElement>('.salon__item'));
    const groups = Array.from(list.querySelectorAll<HTMLElement>('.salon__date'));
    const eras = Array.from(list.querySelectorAll<HTMLElement>('.salon__era'));
    // 每条精华预先算好检索文本，省得每敲一个字就把 textContent 取一遍
    const hay = items.map((el) => (el.textContent || '').toLowerCase());

    /**
     * 筛完告诉时间轴"布局变了"：它缓存了一份各条精华的位置用来联动弧顶，
     * 藏掉几百条之后那份缓存就过期了。
     */
    const askReindex = () => {
      tlBox?.dispatchEvent(new CustomEvent('tl:reindex'));
    };

    const apply = () => {
      const kw = q.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((el, i) => {
        const ok = !kw || hay[i].includes(kw);
        el.hidden = !ok;
        if (ok) shown++;
      });
      // 只留下"还有内容"的日期小标题和年代大标题
      groups.forEach((h) => {
        let n = h.nextElementSibling;
        let any = false;
        while (n && !n.classList.contains('salon__date') && !n.classList.contains('salon__era')) {
          if (n.classList.contains('salon__item') && !n.hidden) any = true;
          n = n.nextElementSibling;
        }
        h.hidden = !any;
      });
      eras.forEach((h) => {
        let n = h.nextElementSibling;
        let any = false;
        while (n && !n.classList.contains('salon__era')) {
          if (((n.classList.contains('salon__item') && !n.hidden) || (n.classList.contains('salon__date') && !n.hidden))) any = true;
          n = n.nextElementSibling;
        }
        h.hidden = !any;
      });
      if (hit) hit.textContent = kw ? `命中 ${shown} / ${items.length} 条` : '';
      if (empty) empty.hidden = !(kw && shown === 0);
      askReindex();
    };

    q.addEventListener('input', apply);
    q.addEventListener('search', apply);
    document.addEventListener('keydown', (e) => {
      // 按 / 聚焦搜索框（在输入框里打字时不抢）
      const t = e.target as HTMLElement | null;
      const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
      if (e.key === '/' && !typing) {
        e.preventDefault();
        q.focus();
        q.select();
      }
      if (e.key === 'Escape' && document.activeElement === q && q.value) {
        q.value = '';
        apply();
      }
    });
    apply();
  }
</script>

<style>
  /* ============================================================================
   *  观感：站点「大板块子页面」那一套（深紫底 + 粉边 + 渐变玻璃块）
   *  ---------------------------------------------------------------------------
   *  用户原话：「精华页面的整体风格不对，不应该使用文章风格的配色，
   *            而应该用页面风格，例如纷湖下的页面隰辰煦家那样的网站整体风格」
   *  所以这里不再用 BaseLayout 那套「浅粉底 #e8d0dd + 深琥珀字 #46280f」的文章配色，
   *  换成和 /huaya/years/fenhu/xichenxuhome 一样的：底 #1e0730、
   *  块 = linear-gradient(rgba(46,8,70,.78), rgba(20,3,34,.78)) + 1px 粉边 +
   *  14px 圆角，正文 rgba(255,236,248,.9)，链接/日期 #ffb3dd，
   *  标题纯白 + 粉色外发光（数值都是从那一页量出来的）。
   *  另外给 body 一个兜底底色（和 BoardLayout 里那句同理：背景图之外的地方也得是深的）。
   * ========================================================================= */
  :global(body.is-salon) {
    background-color: #1e0730;
  }

  .salon {
    display: flex;
    gap: clamp(1.2rem, 2.6vw, 2.6rem);
    align-items: flex-start;
    max-width: 1240px;
    margin: 0 auto;
    /*
      上边距刻意给 0：左边的轴要"一屏几乎占满"，它的起点就必须紧贴站点页头 ——
      页头自己（sticky）已经占了一段高度，这里再加一截留白，
      轴就会被推到屏幕外一截（底部的比例尺看不见）。留白改加在右栏上。
    */
    padding: 0 clamp(0.9rem, 2.4vw, 1.6rem) 5rem;
  }

  /* 左边那条轴常驻：滚页面时它跟着停住，不用滚回去看 */
  .salon__side {
    flex: 0 0 clamp(260px, 27vw, 330px);
    position: sticky;
    top: var(--salon-top, 5.5rem);
    align-self: flex-start;
  }
  /*
    放所选时间轴的框。
    高度**由这一页给死**：`.tl.is-pinned.is-fill` 读 `--tl-panel-h`，
    轴的弧线几何是按 .tl__body 的实际高度算的（measure() 里 H = body.clientHeight），
