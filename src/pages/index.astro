---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../site.config';
import { withBase } from '../utils/url';
import { flattenBoards, type BoardNode } from '../utils/boards';
import { editVars } from '../utils/layout';

const skyline = withBase('/img/home/skyline.png');

/*
  大板块的地址由数据推导（用户选了「自动生成页面」），
  数据里不再写 href。推导规则只有一处：utils/boards.ts。
*/
const flatBoards = flattenBoards(site.homeBoards as BoardNode[]);
const boardUrl = (id: string) =>
  flatBoards.find((f) => f.depth === 0 && f.node.id === id)?.url ?? '/';

/** 首页各元素的排版微调值（编辑器「排版」模式写入 src/data/layout.json） */
const styleOf = (key: string) => editVars('home', key) ?? undefined;
---

<BaseLayout description={site.description} bodyClass="is-home" layoutPage="home">
  {/*
    蒸汽波背景，分四层叠（而不是烘焙成一张图）。

    选分层是刻意的：后面要加动效，分层能让每层独立动 ——
      扫描线层  滚动 background-position  → CRT 扫描
      落日层    呼吸式辉光 / 缓缓下沉
      天际线层  视差位移
      天空层    色相缓慢漂移
    烘焙成一张图就只能整体缩放平移，做不了这些。

    层次（由后到前）：天空渐变 → 落日 → 扫描线 → 天际线（挡住落日下半部）

    剪影里宁波中心大厦（最高那栋）被裁到画面正中，这样无论屏幕多宽，
    它都会落在两个板块之间的缝隙上，不会被挡住。顶部那个 V 形分叉是
    那栋楼的标志，提取时特意保住了。
  */}
  <div class="vapor" aria-hidden="true">
    <div class="vapor__sky"></div>

    <div class="vapor__sun" data-edit="sun" style={styleOf('sun')}>
      <svg viewBox="0 0 200 200" role="presentation">
        <defs>
          <linearGradient id="sunGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#fff6b0"></stop>
            <stop offset="28%" stop-color="#ffd23f"></stop>
            <stop offset="60%" stop-color="#ff9d2e"></stop>
            <stop offset="100%" stop-color="#ff5200"></stop>
          </linearGradient>
          {/*
            蒸汽波落日的关键：下半部分被横条切开，越往下条纹越粗。
            用 mask 挖空，露出的是背后天空本身，而不是画上去的颜色。
          */}
          <mask id="sunMask">
            <rect width="200" height="200" fill="#fff"></rect>
            <g fill="#000">
              <rect y="102" width="200" height="3"></rect>
              <rect y="112" width="200" height="4"></rect>
              <rect y="123" width="200" height="5"></rect>
              <rect y="135" width="200" height="7"></rect>
              <rect y="148" width="200" height="9"></rect>
              <rect y="162" width="200" height="11"></rect>
              <rect y="177" width="200" height="14"></rect>
            </g>
          </mask>
        </defs>
        <circle cx="100" cy="100" r="100" fill="url(#sunGrad)" mask="url(#sunMask)"></circle>
      </svg>
    </div>

    <div class="vapor__scan"></div>

    <div class="vapor__sea">
      <div class="vapor__skyline" style={`background-image:url(${skyline})`}></div>
      <div class="vapor__reflectWrap">
        <div class="vapor__reflect" style={`background-image:url(${skyline})`}></div>
      </div>
    </div>
  </div>

  <div class="home">
    <header class="brand">
      <img
        class="brand__logo"
        data-edit="logo"
        style={styleOf('logo')}
        src={withBase('/img/home/logo.png')}
        alt="花涧堂徽记：龙环与塔吊艺术字"
        width="512"
        height="512"
        decoding="async"
      />
      <div class="brand__text">
        <h1 class="brand__title" data-text="花涧堂" data-edit="title" style={styleOf('title')}>
          花涧堂
        </h1>
        <p class="brand__tagline">{site.tagline}</p>
      </div>
    </header>

    <div class="boards" data-edit="boards" style={styleOf('boards')}>
      {
        site.homeBoards.map((board) => (
          <a class="board" href={withBase(boardUrl(board.id))} id={board.id}>
            <div
              class="board__bg"
              style={`background-image:url(${withBase(board.image)})`}
            />
            <div class="board__veil" />
            <div class="board__body">
              <h2 class="board__title">{board.title}</h2>
              <p class="board__sub">{board.subtitle}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* ============================================================
     蒸汽波背景
     每一层都是独立的元素 / 独立的重绘属性，方便以后各自加动效
     ============================================================ */

  .vapor {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  /* 【可动效】天空：慢速色相漂移 */
  .vapor__sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      #1b0733 0%,
      #3a0c56 12%,
      #6a0f75 26%,
      #a8007e 40%,
      #d4007b 52%,
      #f4557f 62%,
      #ff9a5c 72%,
      #ffc06a 78%,
      #c23a6a 86%,
      #5e1147 94%,
      #2a0a35 100%
    );
  }

  /*
    【可动效】落日：呼吸式辉光、缓慢下沉。
    位置要避开两样东西：右边的宁波中心大厦（53.8% 处），
    以及左边标题所在的板块 —— 板块下移后落日只在它上方那一带露得出来，
    所以整体抬高、贴左。
  */
  .vapor__sun {
    position: absolute;
    left: 2%;
    width: 24vw;
    bottom: 38vh;
  }
  .vapor__sun svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 3vw rgba(255, 160, 60, 0.55));
  }

  /* 【可动效】CRT 扫描线：滚动 background-position 即可做成扫描动画 */
  .vapor__scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.22) 0 1px,
      rgba(0, 0, 0, 0) 1px 3px
    );
    mix-blend-mode: multiply;
  }

  .vapor__sea {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }

  /*
    【可动效】天际线：视差位移。
    剪影宽高比 1773:526，宁波中心大厦在宽度 53.8% 处（比正中略偏右，
    和用户那张照片的取景一致）。板块之间留了很宽的缝，位置正好对上它，
    楼的下半部分就从缝隙里露出来。
  */
  .vapor__skyline {
    width: 100%;
    aspect-ratio: 1773 / 526;
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 100% 100%;
    /* 屏幕很宽时别让楼群高得离谱 */
    max-height: 62vh;
  }

  /* 水面倒影：整体上下翻转，容器裁短并向下淡出 */
  .vapor__reflectWrap {
    height: clamp(56px, 10vh, 120px);
    overflow: hidden;
    mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
  }
  .vapor__reflect {
    width: 100%;
    aspect-ratio: 1773 / 526;
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 100% 100%;
    transform: scaleY(-1);
    opacity: 0.3;
  }

  /* ============================================================
     内容
     ============================================================ */

  .home {
    position: relative;
    padding: clamp(2rem, 6vh, 5rem) 0 clamp(3rem, 10vh, 7rem);
    /* 给底部的天际线让出位置，正文不要压在楼群上 */
    min-height: 78vh;
  }

  /*
    标题与 LOGO 靠左放，把画面中轴让给宁波中心大厦。
    居中摆放时标题正好压在那栋楼上，把它整个盖住了。
  */
  .brand {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: clamp(1rem, 2.4vw, 2.2rem);
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 5vh, 3.6rem);
    /* 左侧留出容器内边距，别贴着屏幕边 */
    padding-left: clamp(0px, 2vw, 2.5rem);
  }

  .brand__logo {
    width: clamp(96px, 13vw, 190px);
    height: auto;
    filter: drop-shadow(0 0 22px rgba(255, 90, 170, 0.5));
  }

  .brand__text {
    text-align: left;
  }

  /*
    霓虹标题。用多层 text-shadow 叠出辉光：内层亮、外层散。
    字形本身来自汉仪文黑，靠辉光和两侧的描边做出霓虹灯管的感觉。
  */
  .brand__title {
    position: relative;
    margin: 0;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 1.05;
    letter-spacing: 0.06em;
    color: #fff;
    text-shadow:
      0 0 4px #fff,
      0 0 11px #ffd9ef,
      0 0 22px #ff4fa3,
      0 0 40px #ff2e8b,
      0 0 70px #d4007b,
      0 0 110px #8a0f75;
  }
  /* 底下再压一层错位的青色描边，做出灯管的立体感 */
  .brand__title::before {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(95, 240, 255, 0.55);
    transform: translate(3px, 3px);
    z-index: -1;
    filter: blur(0.4px);
  }

  .brand__tagline {
    margin: 0.9rem 0 0;
    font-size: clamp(0.9rem, 1.6vw, 1.15rem);
    letter-spacing: 0.22em;
    color: #ffd9ef;
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.8);
  }

  /* ---------- 两个大板块 ---------- */

  /*
    两个大板块之间刻意留出很宽的缝。
    宁波中心大厦在画面 53.8% 处（略偏右），这条缝正好对上它，
    让楼的下半部分能从中间露出来。缝隙宽度按容器宽度取百分比，
    这样不同屏宽下都稳定对准同一个位置。
  */
  .boards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13%;
  }

  .board {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(255, 120, 190, 0.42);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.35) inset,
      0 18px 50px rgba(10, 0, 20, 0.55);
    min-height: clamp(260px, 34vh, 400px);
    display: flex;
    align-items: flex-end;
    /* 整个板块是一个链接 */
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .board:hover,
  .board:focus-visible {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px rgba(255, 160, 210, 0.5) inset,
      0 0 34px rgba(255, 62, 165, 0.45),
      0 22px 60px rgba(10, 0, 20, 0.6);
  }
  .board:focus-visible {
    outline: 2px solid #5ff0ff;
    outline-offset: 3px;
  }

  .board__bg,
  .board__veil {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .board__bg {
    transition: transform 0.5s ease;
  }
  .board:hover .board__bg {
    transform: scale(1.045);
  }
  /* 从下往上压暗，保证文字在任何底图上都读得清 */
  .board__veil {
    background-image: none;
    background: linear-gradient(
      180deg,
      rgba(20, 2, 30, 0.15) 0%,
      rgba(20, 2, 30, 0.55) 46%,
      rgba(12, 0, 20, 0.9) 100%
    );
  }

  .board__body {
    position: relative;
    padding: clamp(1.1rem, 2.4vw, 1.8rem);
    width: 100%;
  }

  .board__title {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    letter-spacing: 0.1em;
    color: #fff;
    text-shadow:
      0 0 10px rgba(255, 79, 163, 0.9),
      0 0 26px rgba(212, 0, 123, 0.7);
  }

  .board__sub {
    margin: 0.35rem 0 1rem;
    font-size: 0.86rem;
    letter-spacing: 0.08em;
    color: rgba(255, 226, 244, 0.82);
  }

  /* ---------- 小屏 ---------- */

  @media (max-width: 760px) {
    .boards {
      grid-template-columns: minmax(0, 1fr);
      /* 变成单列后 13% 会变成巨大的行间距，改回正常值 */
      gap: 1.2rem;
    }
    .brand {
      flex-direction: column;
      text-align: center;
    }
    .brand__text {
      text-align: center;
    }
    /* 落日已经烘焙进背景图，这里不用再单独调位置了 */
  }

  /* 关掉动画偏好 */
  @media (prefers-reduced-motion: reduce) {
    .board,
    .board__bg {
      transition: none;
    }
    .board:hover {
      transform: none;
    }
    .board:hover .board__bg {
      transform: none;
    }
  }

  /* ============================================================
     首页专属：兜底底色与导航隐藏
     页头页脚本身的深色适配在 global.css 里（首页和板块页共用）
     ============================================================ */

  /*
    给 body 一个深色兜底。
    两个作用：
      1. 背景图没加载出来时（弱网、图挂了）页面还是深色，文字仍然读得清
      2. 无障碍检测工具只认祖先链上的 background-color，固定定位的
         背景层是兄弟节点、它看不到，会把深底浅字误判成 1.12:1 的低对比度
  */
  :global(body.is-home) {
    background-color: #2a0a3a;
  }
</style>
