---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeCranes from '../components/HomeCranes.astro';
import HomeBirds from '../components/HomeBirds.astro';
import HomeWidgets from '../components/HomeWidgets.astro';
import Img from '../components/Img.astro';
import site from '../site.config';
import { withBase } from '../utils/url';
import { flattenBoards, visibleBoards, type BoardNode } from '../utils/boards';
import { editVars } from '../utils/layout';
import { bgStyle, coverUrl, variantUrl } from '../utils/images';

/*
  天际线走图片管线出的**无损 WebP**：颜色逐位不变（塔吊的 --ink #08020c
  和剪影图的墨色严丝合缝，这点不能有损），体积 30.2KB → 3KB 上下。

  两处用**不同的档**（这是"剪影加载慢/出现晚"的优化之一）：
    · 城市本体 background-size:100% 100% 铺满，取 1600 档（2.8KB）
    · 倒影整幅被压进 72px 的水面带、还带半透明和遮罩，取 800 档就够（1.3KB）
      —— 它的纹理从 1773×526 降到 800×237，GPU 上传/解码量少 5 倍
  另外把城市本体这一档**在 <head> 里 preload**（地址必须跟 CSS 里用的完全一致，
  否则会各下一份），这样它跟首屏一起出现，而不是"内容先出来、城市后补上"。
*/
const skylineUrl = variantUrl('/img/home/skyline.png', 1600);
const skyline = `url(${skylineUrl})`;
const skylineReflect = `url(${variantUrl('/img/home/skyline.png', 800)})`;

/*
  大板块的地址由数据推导（用户选了「自动生成页面」），
  数据里不再写 href。推导规则只有一处：utils/boards.ts。
*/
const flatBoards = flattenBoards(site.homeBoards as BoardNode[]);
const boardUrl = (id: string) =>
  flatBoards.find((f) => f.depth === 0 && f.node.id === id)?.url ?? '/';

/** 首页各元素的排版微调值（编辑器「排版」模式写入 src/data/layout.json） */
const styleOf = (key: string) => editVars('home', key) ?? undefined;
---

<BaseLayout description={site.description} bodyClass="is-home" layoutPage="home" preloadHref={skylineUrl}>
  {/*
    蒸汽波背景，分五层叠（而不是烘焙成一张图）。

    选分层是刻意的：每一层各自动，互不牵制 ——
      天空层    色带缓慢上下流动 + 色相缓慢漂移
      落日层    条纹微颤、辉光呼吸、整体缓缓浮动
      扫描线层  按一个条纹周期滚动 → CRT 扫描
      天际线层  三台塔吊的横臂各自缓慢回转
      水面层    倒影被切成横向条带左右错动 + 日光柱碎金闪烁
    烘焙成一张图就只能整体缩放平移，这些全做不了。

    层次（由后到前）：天空渐变 → 天空染色 → 落日 → 扫描线
                      → 天际线（含塔吊）→ 水面倒影

    剪影里宁波中心大厦（最高那栋）被裁到画面正中，这样无论屏幕多宽，
    它都会落在两个板块之间的缝隙上，不会被挡住。顶部那个 V 形分叉是
    那栋楼的标志，提取时特意保住了。
  */}
  {/*
    天际线的滚动视差：页面滚动时整片「城市 + 倒影 + 水天分界线」一起轻微下沉，
    用 CSS 滚动驱动动画做，不需要 JS。浏览器不支持时整块不生效，
    天际线就还是钉在底部 —— 页面本身完全不受影响。

    ⚠ 视差必须挂在 .vapor__sea（整片水陆）上，不能挂在 .vapor__horizon 上。
    倒影和水天分界线（.vapor__shore）是 horizon 的**兄弟节点**，不跟着它动：
    只动 horizon 的话，城市会从自己的倒影和水线上「飘走」—— 滚一下就是两个图层，
    倒影对不上楼、楼底也对不上水面。挂在共同祖先上，三者才是刚性的一块。
    另外 translateY 的百分比是按**元素自身高度**算的，所以也不能把三个节点
    写进同一个选择器列表里（72px 的倒影带和 2px 的水线算出来完全不是同一个位移）。

    ⚠ 这段必须写在 is:inline 里，不能并进下面的 <style>。
    构建时 Lightning CSS 会把 animation-timeline 合并进 animation 简写
    （animation: linear both coast-parallax scroll(root)），
    而 Chrome 到现在还不接受简写里的时间线 —— 那条声明会被整条判为无效，
    动画静默失效：不报错、也不动，事后极难查。
    is:inline 的样式不经过压缩器，长写形式能原样送到浏览器。
  */}
  <style is:inline>
    @supports (animation-timeline: scroll()) {
      @media (prefers-reduced-motion: no-preference) {
        .vapor__sea {
          animation-name: coast-parallax;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: scroll(root block);
        }
        @keyframes coast-parallax {
          from {
            transform: translateY(0);
          }
          to {
            /* 2.4% × 这片的自身高度 ≈ 11px。往下沉，水面的下缘出画，
               不会在屏幕底部露出缝 */
            transform: translateY(2.4%);
          }
        }
      }
    }
  </style>

  <div class="vapor" aria-hidden="true">
    {/* 渐变画在比容器高一截的层上，平移这一层就等于让色带慢慢流动 */}
    <div class="vapor__sky">
      <div class="vapor__skyBands"></div>
    </div>
    <div class="vapor__skyTint"></div>

    <div class="vapor__sun" data-edit="sun" style={styleOf('sun')}>
      {/* 呼吸的辉光。用单独一层来做，而不是动画 filter：
          滤镜每帧都要重算，径向渐变只改透明度，便宜得多 */}
      <div class="vapor__sunHalo"></div>
      <svg viewBox="0 0 200 200" role="presentation">
        <defs>
          <linearGradient id="sunGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#fff6b0"></stop>
            <stop offset="28%" stop-color="#ffd23f"></stop>
            <stop offset="60%" stop-color="#ff9d2e"></stop>
            <stop offset="100%" stop-color="#ff5200"></stop>
          </linearGradient>
          {/*
            蒸汽波落日的关键：下半部分被横条切开，越往下条纹越粗。
            用 mask 挖空，露出的是背后天空本身，而不是画上去的颜色。

            这些横条会各自缓慢上下游移几个单位（见样式里的 sun-stripes），
            模拟热气把落日切碎时那种抖动。每条给一点相位差，
            整片条纹就是流动的，而不是一块板在平移。
          */}
          <mask id="sunMask">
            <rect width="200" height="200" fill="#fff"></rect>
            <g class="sunStripes" fill="#000">
              {[
                { y: 102, h: 3 },
                { y: 112, h: 4 },
                { y: 123, h: 5 },
                { y: 135, h: 7 },
                { y: 148, h: 9 },
                { y: 162, h: 11 },
                { y: 177, h: 14 },
              ].map((s, i) => (
                <rect
                  y={s.y}
                  width="200"
                  height={s.h}
                  style={`animation-delay:${(-i * 0.9).toFixed(1)}s`}
                />
              ))}
            </g>
          </mask>
        </defs>
        <circle cx="100" cy="100" r="100" fill="url(#sunGrad)" mask="url(#sunMask)"></circle>
      </svg>
    </div>

    <div class="vapor__scan"></div>

    <div class="vapor__sea">
      {/*
        鸟群写在楼群**前面**（DOM 顺序在前 = 先绘制）：
        这样鸟从楼群后面穿过时是同一片墨，而不是浮在天上。
        它又是 .vapor__sea 的子节点，所以会跟着那片一起做滚动视差。
      */}
      <HomeBirds />

      {/*
        天际线和塔吊共用一个容器，塔吊写在前面 ——
        楼群因此会自然地挡住塔吊的下半截（这正是想要的效果）
      */}
      <div class="vapor__horizon">
        <HomeCranes />
        <div class="vapor__skyline" style={`background-image:${skyline}`}></div>
      </div>

      <div class="vapor__reflectWrap">
        <div class="vapor__reflect" style={`background-image:${skylineReflect}`}></div>
        {/* 水面上的横向微光 */}
        <div class="vapor__shimmer"></div>
        {/* 落日正下方的碎金 */}
        <div class="vapor__glitter"></div>
      </div>

      {/* 水天交界那一道暖光 */}
      <div class="vapor__shore"></div>
    </div>

    {/* 像老录像带那样偶尔扫过一道很淡的亮带 */}
    <div class="vapor__sweep"></div>
  </div>

  <div class="home">
    <header class="brand">
      <Img
        class="brand__logo"
        data-edit="logo"
        style={styleOf('logo')}
        src="/img/home/logo.png"
        alt="花涧堂徽记：龙环与塔吊艺术字"
        sizes="(max-width: 760px) 42vw, 240px"
        loading="eager"
      />
      <div class="brand__text">
        <h1 class="brand__title" data-text="花涧堂" data-edit="title" style={styleOf('title')}>
          花涧堂
        </h1>
        <p class="brand__tagline">{site.tagline}</p>
      </div>
    </header>

    <div class="boards" data-edit="boards" style={styleOf('boards')}>
      {/*
        只画**非独立页面**的顶层节点。独立页面和两大板块平级躺在数据里
        （借用同一套地址推导与页面生成），但它按定义不该出现在任何列表里 ——
        见 utils/boards.ts 的 isStandalone。
      */}
      {
        visibleBoards(site.homeBoards as BoardNode[]).map((board) => (
          <a class="board" href={withBase(boardUrl(board.id))} id={board.id}>
            <div
              class="board__bg"
              style={bgStyle(board.image, { w: 800, w2: 1600 })}
            />
            <div class="board__veil" />
            <div class="board__body">
              <h2 class="board__title">{board.title}</h2>
              <p class="board__sub">{board.subtitle}</p>
            </div>
          </a>
        ))
      }
    </div>

    {/*
      本轮新增的一屏：日历（在「甬城晴雨」正下方）、冰室冰山、每日精华。

      ⚠ 用户明确要求："不要挤压或挪动原来已有的首页元素的位置"。
      所以它接在 .boards **后面**（同一层缩进、同样的容器宽度）而不是塞进
      上面那块版心里 —— 已有的元素位置一个像素都不动，首页只是因此变高，
      滚轮能往下滚（背景是 fixed 的，滚下去还是同一片落日）。
      位置有没有真的没动，有实测：.tmp/home-geom.mjs 会逐项对比基线。
    */}
    <HomeWidgets />
  </div>
</BaseLayout>

<style>
  /* ============================================================
     蒸汽波背景
     每一层都是独立的元素 / 独立的重绘属性，各自加自己的动效

     动效基本只碰 transform / opacity —— 这两个属性走合成层，
     不会每帧重算整屏渐变或重新布局。唯一的例外是扫描线，
     它动的是 background-position，理由写在下面「扫描线」那一节。
     ============================================================ */

  .vapor {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;

    /* 落日中心（横向）和水面上那道日光柱共用这一个值：
       改这里，两边一起跟着动，不会各走各的。 */
    --sun-cx: 14vw;
    --sun-w: 24vw;
    /* 水面那一带的高度。倒影带和岸线的位置都以它为准 */
    --water-h: clamp(56px, 10vh, 120px);
    /* 剪影的墨色，取自 skyline.png 的实测像素（见 _setup/skyline-survey.ps1）。
       塔吊用同一个值，才会和楼群糊成同一片剪影，而不是浮在上面的一层黑 */
    --ink: #08020c;
    /* 扫描线的一个条纹周期。贴图里暗线只占 1/4，线宽 = 周期 / 4；
       换周期就等于换条纹粗细，但等宽这件事不受影响（见「扫描线」一节） */
    --scan-period: 16px;
    /* 扫描线滚过一个周期的时间，越小越快 */
    --scan-speed: 1.1s;
  }

  /* ------------------------------------------------------------
     天空
     ------------------------------------------------------------ */

  .vapor__sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* 渐变层没铺满时的兜底色 */
    background: #2a0a35;
  }

  /*
    【动效】色带缓慢上下流动。
    渐变画在比容器高一截的层上再平移它 —— 直接动 background-position
    会让整屏渐变每帧重绘，平移合成层则几乎不花代价。
    起点 -15%、终点 +7% 都还在容器外面，所以永远不会露边。
  */
  .vapor__skyBands {
    position: absolute;
    left: 0;
    right: 0;
    top: -15%;
    height: 130%;
    background: linear-gradient(
      180deg,
      #1b0733 0%,
      #3a0c56 12%,
      #6a0f75 26%,
      #a8007e 40%,
      #d4007b 52%,
      #f4557f 62%,
      #ff9a5c 72%,
      #ffc06a 78%,
      #c23a6a 86%,
      #5e1147 94%,
      #2a0a35 100%
    );
    animation: sky-flow 78s ease-in-out infinite alternate;
  }

  @keyframes sky-flow {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(7%);
    }
  }

  /* 【动效】天空染色：一层很淡的品红→青紫，慢慢明灭，天色就有了呼吸 */
  .vapor__skyTint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(96, 52, 214, 0.2) 0%,
      rgba(255, 64, 164, 0.16) 58%,
      rgba(255, 168, 88, 0.14) 100%
    );
    mix-blend-mode: screen;
    animation: sky-tint 34s ease-in-out infinite alternate;
  }

  @keyframes sky-tint {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 1;
    }
  }

  /* ------------------------------------------------------------
     落日
     ------------------------------------------------------------ */

  /*
    位置要避开两样东西：右边的宁波中心大厦（53.8% 处），
    以及左边标题所在的板块 —— 板块下移后落日只在它上方那一带露得出来，
    所以整体抬高、贴左。
  */
  .vapor__sun {
    position: absolute;
    left: calc(var(--sun-cx) - var(--sun-w) / 2);
    width: var(--sun-w);
    bottom: 38vh;
    /* 【动效】整体极缓慢地上下浮动（1.1vh ≈ 10px），
       像地平线上那口气。幅度再大就变成「太阳在跳」了 */
    animation: sun-float 21s ease-in-out infinite alternate;
  }

  @keyframes sun-float {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-1.1vh);
    }
  }

  /* 注意：这里用 transform 平移，不会碰到 [data-edit] 写下的
     translate / scale —— 它们是不同的属性，会叠加而不是互相覆盖 */

  .vapor__sun svg {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 3vw rgba(255, 160, 60, 0.55));
  }

  /* 【动效】辉光呼吸。单独一层径向渐变，只改透明度和缩放 */
  .vapor__sunHalo {
    position: absolute;
    inset: -22%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 150, 64, 0.5) 0%,
      rgba(255, 90, 60, 0.18) 45%,
      transparent 72%
    );
    mix-blend-mode: screen;
    animation: sun-halo 8.5s ease-in-out infinite alternate;
  }

  @keyframes sun-halo {
    from {
      opacity: 0.55;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  /*
    【动效】落日条纹上下游移。
    幅度只有 4.5 个用户单位（≈ 落日渐变高度的 2%）：
    快了像故障，慢了才像地平面上的热气。
    每条的相位差在标签上给（见 index.astro 里的 animation-delay）。
  */
  .sunStripes rect {
    animation: sun-stripes 9.5s ease-in-out infinite alternate;
  }

  @keyframes sun-stripes {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(4.5px);
    }
  }

  /* ------------------------------------------------------------
     扫描线
     ------------------------------------------------------------ */

  /*
    一块 8×32 的无缝贴图：暗线占前 8 行 = 恰好 1/4，其余全透明。
    贴图高度给一个周期（16px），暗线就是 16 / 4 = 4 CSS px。

    等宽是怎么保证的：在 1x / 1.25x / 1.5x / 2x / 2.5x / 3x 屏上，
    4 × DPR = 4 / 5 / 6 / 8 / 10 / 12，全是整数 —— 暗线永远落在
    整数个设备像素上，不会出现「有的 2px 有的 3px」那种粗细混排。

    为什么不再用 repeating-linear-gradient（原先那版）：
    渐变在非整数 DPR 下会被抗锯齿，边缘发灰；而原先周期取 3px，
    在 125% 缩放的屏上正好排成 2px / 3px 交错，看着就不干净。
    位图贴图配 image-rendering:pixelated 是硬边，线宽只由周期决定。

    贴图内联成 base64（153 字节的 PNG）：不产生额外请求，也没有路径问题。
    暗线本身是 rgba(0,0,0,0.22)，浓度烘焙在贴图里，所以不再需要
    mix-blend-mode —— 纯黑先 multiply 再按 alpha 合成，结果就是
    base × (1 - 0.22)，和直接叠一层半透明黑逐像素相同，
    反倒省掉了一次混合，这层画起来就只是一次普通的贴图覆盖。
  */
  .vapor__scan {
    position: absolute;
    inset: 0;
    background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAgCAYAAAAv8DnQAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsMAAA7DAcdvqGQAAAAuSURBVDhP7cjBCQAwDMNAj9X9J0ufCgiygAX3UX7voJN0kk7SSTpJJ+mk1toqGXoODgG0rk4hAAAAAElFTkSuQmCC');
    background-repeat: repeat;
    background-size: 8px var(--scan-period);
    image-rendering: pixelated;
    animation: scan-roll var(--scan-speed) linear infinite;
    will-change: background-position;
  }

  /*
    【动效】CRT 扫描：向下走一个周期。
    位移正好等于一个周期 → 结束帧与起始帧的像素完全重合，循环点看不出来。

    这里动 background-position 而不是 translateY 是刻意的：
    位移若交给合成层，贴图会被合成器按双线性重采样，硬边当场糊掉，
    pixelated 也救不回来（它只管光栅化那一步，管不到合成）。
    宁可让这 153 字节的贴图每帧重绘一次，也要保住硬边。
  */
  @keyframes scan-roll {
    from {
      background-position-y: 0;
    }
    to {
      background-position-y: var(--scan-period);
    }
  }

  /* ------------------------------------------------------------
     天际线（含塔吊）
     ------------------------------------------------------------ */

  .vapor__sea {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }

  /*
    天际线和塔吊的共同容器。塔吊写在前面、天际线写在后面，
    楼群于是挡住塔吊的下半截。
  */
  .vapor__horizon {
    position: relative;
  }

  /*
    剪影宽高比 1773:526，宁波中心大厦在宽度 53.8% 处（比正中略偏右，
    和用户那张照片的取景一致）。板块之间留了很宽的缝，位置正好对上它，
    楼的下半部分就从缝隙里露出来。
  */
  .vapor__skyline {
    width: 100%;
    aspect-ratio: 1773 / 526;
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 100% 100%;
    /* 屏幕很宽时别让楼群高得离谱 */
    max-height: 62vh;
  }

  /* ------------------------------------------------------------
     水面
     ------------------------------------------------------------ */

  /* 倒影：整幅剪影压进水面那一条带里，再上下翻转。
     淡出遮罩必须留在容器上（不能挪到倒影自己身上）——
     遮罩是在 transform 之后才应用的，跟着翻转的话就该从下往上亮了。

     【为什么倒影必须整幅压进带子里】剪影图高 526、其中下面 246 行才是实墨，
     按原比例落到屏上，楼群有 178 CSS px 高；而水面带只有 --water-h（约 72px）。
     倒影若照原比例画（aspect-ratio + 100% 100%），露出来的永远是图里**最下面**
     那一小截 —— 也就是楼群脚下那块全宽的实底。实测证实了这一点：旧写法下
     「有倒影 / 去掉倒影」两张图的差在 y648..701 上是一条由 40 亮差平滑衰减到 4 的
     纯渐变，逐行标准差几乎为 0，等于水面上糊了一层灰影子，看不出任何楼形。
     改成 inset:0 让倒影铺满水面带，整幅剪影等比压进 72px，倒影里就能认出楼群，
     再由容器的遮罩向下淡出。 */
  .vapor__reflectWrap {
    position: relative;
    height: var(--water-h);
    overflow: hidden;
    mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.62) 46%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.62) 46%, transparent 100%);
  }
  .vapor__reflect {
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 100% 100%;
    transform: scaleY(-1);
    opacity: 0.38;
  }

  /*
    【动效】倒影被水切成横向条带，条带整体左右错动。
    做法：在倒影上再叠一份同样的图，用重复渐变当遮罩只留条带，
    再让这一份缓慢左右平移。这是水面倒影最标志性的那种「碎」。
  */
  .vapor__reflect::after {
    content: '';
    position: absolute;
    inset: 0;
    background: inherit;
    mask-image: repeating-linear-gradient(180deg, #000 0 3px, transparent 3px 9px);
    -webkit-mask-image: repeating-linear-gradient(180deg, #000 0 3px, transparent 3px 9px);
    opacity: 0.5;
    animation: reflect-chop 11s ease-in-out infinite alternate;
  }

  @keyframes reflect-chop {
    from {
      transform: translateX(-1.6%);
    }
    to {
      transform: translateX(1.6%);
    }
  }

  /* 【动效】水面横向微光：一条条极淡的亮线慢慢上下浮动 */
  .vapor__shimmer {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      180deg,
      rgba(255, 186, 140, 0) 0 7px,
      rgba(255, 186, 140, 0.1) 7px 8px,
      rgba(255, 186, 140, 0) 8px 15px
    );
    animation: water-shift 7.5s ease-in-out infinite alternate;
  }

  @keyframes water-shift {
    from {
      transform: translateY(-3px);
    }
    to {
      transform: translateY(3px);
    }
  }

  /*
    【动效】日光柱：落日正下方那一道碎金。
    两层条纹周期不同、反向移动，叠起来才像水面在闪；
    只做一层的话就是一块规规矩矩的百叶窗。
    横向位置跟着 --sun-cx 走，和落日是同一套坐标。
  */
  .vapor__glitter {
    position: absolute;
    bottom: 0;
    left: calc(var(--sun-cx) - 5vw);
    width: 10vw;
    height: 100%;
    mix-blend-mode: screen;
    mask-image: radial-gradient(70% 100% at 50% 0%, #000 0%, transparent 80%);
    -webkit-mask-image: radial-gradient(70% 100% at 50% 0%, #000 0%, transparent 80%);
  }
  .vapor__glitter::before,
  .vapor__glitter::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      180deg,
      rgba(255, 214, 150, 0.85) 0 2px,
      rgba(255, 214, 150, 0) 2px 7px
    );
  }
  .vapor__glitter::before {
    animation: glitter-a 4.6s ease-in-out infinite alternate;
  }
  .vapor__glitter::after {
    background: repeating-linear-gradient(
      180deg,
      rgba(255, 236, 200, 0.7) 0 1px,
      rgba(255, 236, 200, 0) 1px 11px
    );
    animation: glitter-b 6.9s ease-in-out infinite alternate;
  }

  @keyframes glitter-a {
    from {
      transform: translateY(-4px) scaleY(0.96);
      opacity: 0.75;
    }
    to {
      transform: translateY(4px) scaleY(1.05);
      opacity: 1;
    }
  }

  @keyframes glitter-b {
    from {
      transform: translateY(5px);
      opacity: 0.5;
    }
    to {
      transform: translateY(-5px);
      opacity: 0.95;
    }
  }

  /*
    【动效】水天交界那一道暖光，慢慢明灭。
    蒸汽波里水面总是先亮起这一条线，倒影的层次才有落点。
  */
  .vapor__shore {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--water-h);
    height: 2px;
    background: linear-gradient(
      90deg,
      rgba(255, 200, 130, 0) 0%,
      rgba(255, 214, 150, 0.55) 16%,
      rgba(255, 236, 196, 0.85) 50%,
      rgba(255, 150, 200, 0.5) 84%,
      rgba(255, 150, 200, 0) 100%
    );
    filter: blur(0.6px);
    animation: shore-glow 6.2s ease-in-out infinite alternate;
  }

  @keyframes shore-glow {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }

  /* 【动效】老录像带那样，隔一阵从上往下扫过一道很淡的亮带。
     走到画面外之后停一会儿再来，才像「偶发」而不是节拍器。 */
  .vapor__sweep {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 26vh;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(255, 226, 255, 0.05) 45%,
      transparent 100%
    );
    mix-blend-mode: screen;
    animation: vhs-sweep 19s linear infinite;
  }

  @keyframes vhs-sweep {
    0% {
      transform: translateY(-32vh);
    }
    55% {
      transform: translateY(104vh);
    }
    100% {
      transform: translateY(104vh);
    }
  }

  /* ============================================================
     内容
     ============================================================ */

  .home {
    position: relative;
    padding: clamp(2rem, 6vh, 5rem) 0 clamp(3rem, 10vh, 7rem);
    /* 给底部的天际线让出位置，正文不要压在楼群上 */
    min-height: 78vh;
  }

  /*
    标题与 LOGO 靠左放，把画面中轴让给宁波中心大厦。
    居中摆放时标题正好压在那栋楼上，把它整个盖住了。
  */
  .brand {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: clamp(1rem, 2.4vw, 2.2rem);
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 5vh, 3.6rem);
    /* 左侧留出容器内边距，别贴着屏幕边 */
    padding-left: clamp(0px, 2vw, 2.5rem);
  }

  .brand__logo {
    width: clamp(96px, 13vw, 190px);
    height: auto;
    filter: drop-shadow(0 0 22px rgba(255, 90, 170, 0.5));
  }

  .brand__text {
    text-align: left;
  }

  /*
    霓虹标题。用多层 text-shadow 叠出辉光：内层亮、外层散。
    字形本身来自汉仪文黑，靠辉光和两侧的描边做出霓虹灯管的感觉。
  */
  .brand__title {
    position: relative;
    margin: 0;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 1.05;
    letter-spacing: 0.06em;
    color: #fff;
    text-shadow:
      0 0 4px #fff,
      0 0 11px #ffd9ef,
      0 0 22px #ff4fa3,
      0 0 40px #ff2e8b,
      0 0 70px #d4007b,
      0 0 110px #8a0f75;
  }
  /* 底下再压一层错位的青色描边，做出灯管的立体感 */
  .brand__title::before {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(95, 240, 255, 0.55);
    transform: translate(3px, 3px);
    z-index: -1;
    filter: blur(0.4px);
  }

  .brand__tagline {
    margin: 0.9rem 0 0;
    font-size: clamp(0.9rem, 1.6vw, 1.15rem);
    letter-spacing: 0.22em;
    color: #ffd9ef;
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.8);
  }

  /* ---------- 两个大板块 ---------- */

  /*
    两个大板块之间刻意留出很宽的缝。
    宁波中心大厦在画面 53.8% 处（略偏右），这条缝正好对上它，
    让楼的下半部分能从中间露出来。缝隙宽度按容器宽度取百分比，
    这样不同屏宽下都稳定对准同一个位置。
  */
  .boards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13%;
  }

  .board {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(255, 120, 190, 0.42);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.35) inset,
      0 18px 50px rgba(10, 0, 20, 0.55);
    min-height: clamp(260px, 34vh, 400px);
    display: flex;
    align-items: flex-end;
    /* 整个板块是一个链接 */
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .board:hover,
  .board:focus-visible {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px rgba(255, 160, 210, 0.5) inset,
      0 0 34px rgba(255, 62, 165, 0.45),
      0 22px 60px rgba(10, 0, 20, 0.6);
  }
  .board:focus-visible {
    outline: 2px solid #5ff0ff;
    outline-offset: 3px;
  }

  .board__bg,
  .board__veil {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .board__bg {
    transition: transform 0.5s ease;
  }
  .board:hover .board__bg {
    transform: scale(1.045);
  }
  /* 从下往上压暗，保证文字在任何底图上都读得清 */
  .board__veil {
    background-image: none;
    background: linear-gradient(
      180deg,
      rgba(20, 2, 30, 0.15) 0%,
      rgba(20, 2, 30, 0.55) 46%,
      rgba(12, 0, 20, 0.9) 100%
    );
  }

  .board__body {
    position: relative;
    padding: clamp(1.1rem, 2.4vw, 1.8rem);
    width: 100%;
  }

  .board__title {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    letter-spacing: 0.1em;
    color: #fff;
    text-shadow:
      0 0 10px rgba(255, 79, 163, 0.9),
      0 0 26px rgba(212, 0, 123, 0.7);
  }

  .board__sub {
    margin: 0.35rem 0 1rem;
    font-size: 0.86rem;
    letter-spacing: 0.08em;
    color: rgba(255, 226, 244, 0.82);
  }

  /* ---------- 小屏 ---------- */

  @media (max-width: 760px) {
    .boards {
      grid-template-columns: minmax(0, 1fr);
      /* 变成单列后 13% 会变成巨大的行间距，改回正常值 */
      gap: 1.2rem;
    }
    .brand {
      flex-direction: column;
      text-align: center;
    }
    .brand__text {
      text-align: center;
    }
    /* 落日已经烘焙进背景图，这里不用再单独调位置了 */
  }

  /* 关掉动画偏好 */
  @media (prefers-reduced-motion: reduce) {
    .board,
    .board__bg {
      transition: none;
    }
    .board:hover {
      transform: none;
    }
    .board:hover .board__bg {
      transform: none;
    }
    /*
      整层背景一律停住。
      global.css 里那条全局规则已经把时长压到 0.01ms，
      但那些是 infinite 的动画，压到 0.01ms 之后反而会每帧在关键帧之间跳，
      看起来像闪。所以这里直接停掉，元素回到各自的静止状态 ——
      也就是「没有动效时本来的样子」。

      注意：塔吊在 HomeCranes 组件里，Astro 的作用域选择器管不到它的内部
      元素，所以组件里自带了一条同样的规则。
    */
    .vapor,
    .vapor *,
    .vapor *::before,
    .vapor *::after {
      animation: none !important;
    }
  }

  /* ============================================================
     首页专属：兜底底色与导航隐藏
     页头页脚本身的深色适配在 global.css 里（首页和板块页共用）
     ============================================================ */

  /*
    给 body 一个深色兜底。
    两个作用：
      1. 背景图没加载出来时（弱网、图挂了）页面还是深色，文字仍然读得清
      2. 无障碍检测工具只认祖先链上的 background-color，固定定位的
         背景层是兄弟节点、它看不到，会把深底浅字误判成 1.12:1 的低对比度
  */
  :global(body.is-home) {
    background-color: #2a0a3a;
  }
</style>
