---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../site.config';
import { withBase } from '../utils/url';
---

<BaseLayout description={site.description} bodyClass="is-home">
  {/*
    整屏背景是一张合成好的图片（2400x1350，228 KB）：
    天空渐变、带横格栅的落日、宁波天际线、水面倒影、扫描线全在里面。

    早先这里是四层实时叠加（渐变背景 + 带 drop-shadow 的落日 SVG +
    整屏 mix-blend-mode 的扫描线 + 两张定位背景图）。实测那种做法
    首屏要做混合与阴影计算，观感上"背景加载很慢"，而其实天际线图片
    只有 29 KB。合成成一张平铺图片后渲染是瞬时的。

    图片里的天际线取自用户提供的宁波照片，最高那栋（宁波中心大厦）
    顶部的 V 形分叉是特意保留下来的 —— 那栋楼最有辨识度的就是这个轮廓。
  */}
  <div class="vapor" aria-hidden="true"></div>

  <div class="home">
    <header class="brand">
      <img
        class="brand__logo"
        src={withBase('/img/home/logo.png')}
        alt="花涧堂徽记：龙环与塔吊艺术字"
        width="512"
        height="512"
        decoding="async"
      />
      <div class="brand__text">
        <h1 class="brand__title" data-text="花涧堂">花涧堂</h1>
        <p class="brand__tagline">{site.tagline}</p>
      </div>
    </header>

    <div class="boards">
      {
        site.homeBoards.map((board) => (
          <a class="board" href={withBase(board.href)} id={board.id}>
            <div
              class="board__bg"
              style={`background-image:url(${withBase(board.image)})`}
            />
            <div class="board__veil" />
            <div class="board__body">
              <h2 class="board__title">{board.title}</h2>
              <p class="board__sub">{board.subtitle}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* ============================================================
     蒸汽波背景 —— 一张合成图，不再分层实时叠加
     ============================================================ */

  .vapor {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: url('/img/home/home-bg.jpg');
    background-repeat: no-repeat;
    /* 底边对齐：天际线和水面始终贴着视口底部，上方天空随屏幕高度伸缩 */
    background-position: center bottom;
    background-size: cover;
  }

  /* ============================================================
     内容
     ============================================================ */

  .home {
    position: relative;
    padding: clamp(2rem, 6vh, 5rem) 0 clamp(3rem, 10vh, 7rem);
    /* 给底部的天际线让出位置，正文不要压在楼群上 */
    min-height: 78vh;
  }

  .brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2.4rem);
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 7vh, 5rem);
  }

  .brand__logo {
    width: clamp(96px, 13vw, 190px);
    height: auto;
    filter: drop-shadow(0 0 22px rgba(255, 90, 170, 0.5));
  }

  .brand__text {
    text-align: left;
  }

  /*
    霓虹标题。用多层 text-shadow 叠出辉光：内层亮、外层散。
    字形本身来自汉仪文黑，靠辉光和两侧的描边做出霓虹灯管的感觉。
  */
  .brand__title {
    position: relative;
    margin: 0;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 1.05;
    letter-spacing: 0.06em;
    color: #fff;
    text-shadow:
      0 0 4px #fff,
      0 0 11px #ffd9ef,
      0 0 22px #ff4fa3,
      0 0 40px #ff2e8b,
      0 0 70px #d4007b,
      0 0 110px #8a0f75;
  }
  /* 底下再压一层错位的青色描边，做出灯管的立体感 */
  .brand__title::before {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(95, 240, 255, 0.55);
    transform: translate(3px, 3px);
    z-index: -1;
    filter: blur(0.4px);
  }

  .brand__tagline {
    margin: 0.9rem 0 0;
    font-size: clamp(0.9rem, 1.6vw, 1.15rem);
    letter-spacing: 0.22em;
    color: #ffd9ef;
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.8);
  }

  /* ---------- 两个大板块 ---------- */

  .boards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .board {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(255, 120, 190, 0.42);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.35) inset,
      0 18px 50px rgba(10, 0, 20, 0.55);
    min-height: clamp(260px, 34vh, 400px);
    display: flex;
    align-items: flex-end;
    /* 整个板块是一个链接 */
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .board:hover,
  .board:focus-visible {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px rgba(255, 160, 210, 0.5) inset,
      0 0 34px rgba(255, 62, 165, 0.45),
      0 22px 60px rgba(10, 0, 20, 0.6);
  }
  .board:focus-visible {
    outline: 2px solid #5ff0ff;
    outline-offset: 3px;
  }

  .board__bg,
  .board__veil {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .board__bg {
    transition: transform 0.5s ease;
  }
  .board:hover .board__bg {
    transform: scale(1.045);
  }
  /* 从下往上压暗，保证文字在任何底图上都读得清 */
  .board__veil {
    background-image: none;
    background: linear-gradient(
      180deg,
      rgba(20, 2, 30, 0.15) 0%,
      rgba(20, 2, 30, 0.55) 46%,
      rgba(12, 0, 20, 0.9) 100%
    );
  }

  .board__body {
    position: relative;
    padding: clamp(1.1rem, 2.4vw, 1.8rem);
    width: 100%;
  }

  .board__title {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    letter-spacing: 0.1em;
    color: #fff;
    text-shadow:
      0 0 10px rgba(255, 79, 163, 0.9),
      0 0 26px rgba(212, 0, 123, 0.7);
  }

  .board__sub {
    margin: 0.35rem 0 1rem;
    font-size: 0.86rem;
    letter-spacing: 0.08em;
    color: rgba(255, 226, 244, 0.82);
  }

  /* ---------- 小屏 ---------- */

  @media (max-width: 760px) {
    .boards {
      grid-template-columns: minmax(0, 1fr);
    }
    .brand {
      flex-direction: column;
      text-align: center;
    }
    .brand__text {
      text-align: center;
    }
    /* 落日已经烘焙进背景图，这里不用再单独调位置了 */
  }

  /* 关掉动画偏好 */
  @media (prefers-reduced-motion: reduce) {
    .board,
    .board__bg {
      transition: none;
    }
    .board:hover {
      transform: none;
    }
    .board:hover .board__bg {
      transform: none;
    }
  }

  /* ============================================================
     首页专属：兜底底色与导航隐藏
     页头页脚本身的深色适配在 global.css 里（首页和板块页共用）
     ============================================================ */

  /*
    给 body 一个深色兜底。
    两个作用：
      1. 背景图没加载出来时（弱网、图挂了）页面还是深色，文字仍然读得清
      2. 无障碍检测工具只认祖先链上的 background-color，固定定位的
         背景层是兄弟节点、它看不到，会把深底浅字误判成 1.12:1 的低对比度
  */
  :global(body.is-home) {
    background-color: #2a0a3a;
  }
</style>
