---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrtScreen from '../../components/CrtScreen.astro';
import PostItem from '../../components/PostItem.astro';
import { groupByYear, getPosts } from '../../utils/content';
/*
  页头那句说明是「文案」面板里的（src/data/site-copy.json 的 posts.lead，留空 = 只剩"共 N 篇。"）。
  这一页只留数字，句子归站长 —— 2026-10-10 之前它写死在这里。
*/
import { copy, text } from '../../utils/site-copy';

const posts = await getPosts();
const groups = groupByYear(posts);
const lead = text(copy.posts?.lead);
const empty = text(copy.posts?.empty);
---

<BaseLayout title="文章" description="全部文章列表"
  bodyClass="is-crt"
  layoutPage="list">
  <CrtScreen />
  <div class="crt-screen">
    <header class="page-header">
      <h1 class="page-header__title" data-edit="heading">文章</h1>
      <p class="page-header__desc" data-copy="posts.lead">
        共 {posts.length} 篇。{lead}
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty" data-copy="posts.empty">{empty}</p>
      ) : (
        groups.map((group) => (
          <section class="archive-year">
            <h2 class="archive-year__label">{group.year}</h2>
            <ul class="post-list">
              {group.items.map((entry) => (
                <PostItem entry={entry} />
              ))}
            </ul>
          </section>
        ))
      )
    }
  </div>
</BaseLayout>
