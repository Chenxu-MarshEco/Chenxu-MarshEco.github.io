---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import site from '../site.config';
import { withBase } from '../utils/url';
---

<BaseLayout title="友链" description="朋友们的地方" narrow
  layoutPage="list">
  <header class="page-header">
    <h1 class="page-header__title" data-edit="heading">友链</h1>
    <p class="page-header__desc">
      这里放一些我常看的站点。想交换链接的话，写信告诉我你的站名、地址和一句话介绍。
    </p>
  </header>

  {
    site.friends.length === 0 ? (
      /* 2026-10-10：原来这里写的是「打开 src/site.config.ts，往 friends 数组里加就行」——
         那是给站长看的操作说明，却会显示在**访客**眼前。按用户要求（别留生造句）改成一句人话。 */
      <p class="empty">还没有友链。</p>
    ) : (
      <ul class="friend-grid">
        {site.friends.map((f) => (
          <li>
            <a class="friend-card" href={f.href} target="_blank" rel="noopener noreferrer">
              {f.image && <Img class="friend-card__img" src={f.image} alt="" sizes="88px" />}
              <span>
                <span class="friend-card__name">{f.name}</span>
                {f.description && <span class="friend-card__desc">{f.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
