---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import site from '../site.config';
import { withBase } from '../utils/url';
/* 页头那句和"还没有友链。"都归「文案」面板（site-copy.json 的 friends.lead / friends.empty） */
import { copy, text } from '../utils/site-copy';

const lead = text(copy.friends?.lead);
const empty = text(copy.friends?.empty);
---

<BaseLayout title="友链" description="朋友们的地方" narrow
  layoutPage="list">
  <header class="page-header">
    <h1 class="page-header__title" data-edit="heading">友链</h1>
    {lead && <p class="page-header__desc" data-copy="friends.lead">{lead}</p>}
  </header>

  {
    site.friends.length === 0 ? (
      /* 空着时那一句也归站长写（留空 = 什么都不显示） */
      empty && <p class="empty" data-copy="friends.empty">{empty}</p>
    ) : (
      <ul class="friend-grid">
        {site.friends.map((f) => (
          <li>
            <a class="friend-card" href={f.href} target="_blank" rel="noopener noreferrer">
              {f.image && <Img class="friend-card__img" src={f.image} alt="" sizes="88px" />}
              <span>
                <span class="friend-card__name">{f.name}</span>
                {f.description && <span class="friend-card__desc">{f.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
