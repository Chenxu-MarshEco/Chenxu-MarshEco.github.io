---
import '../styles/fonts.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BoardDrawer from '../components/BoardDrawer.astro';
import site from '../site.config';
import { absoluteUrl, withBase } from '../utils/url';

interface Props {
  /** 页面标题，会拼在站点名前面。首页留空即可 */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  /** 设为 true 时告诉搜索引擎不要收录（草稿页、404 用） */
  noindex?: boolean;
  /** 页面主区域是否使用更窄的宽度（文章页用） */
  narrow?: boolean;
  /** 挂到 <body> 上的 class，首页用它切换整屏背景 */
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  updatedTime,
  noindex = false,
  narrow = false,
  bodyClass = '',
} = Astro.props;

const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.tagline}`;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const ogImage = absoluteUrl('/og-default.svg', Astro.site);

/** 目录栏用它高亮「当前在哪」，并自动展开到这一层 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rawPath = Astro.url.pathname;
const withoutBase =
  base && rawPath.startsWith(base) ? rawPath.slice(base.length) || '/' : rawPath;
// 归一化：Astro 生成的目录式地址带尾斜杠（/yongcheng/），
// 而节点地址是 /yongcheng，不处理的话「当前项」永远匹配不上。
const currentPath = withoutBase.length > 1 ? withoutBase.replace(/\/+$/, '') : '/';
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {/* 站点字体 565 KB，提前拉起来，否则首屏会闪一下系统字体 */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBase('/fonts/huajiantang.woff2')}
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={withBase('/rss.xml')}
    />

    <!-- 分享卡片 -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />

    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}

    <!-- 主题色：影响手机浏览器地址栏颜色，改 tokens.css 时记得同步 -->
    <meta name="theme-color" content="#e8d0dd" />

    <!-- 站点固定亮色主题，data-theme 供 tokens.css 的选择器使用 -->
    <script is:inline>
      document.documentElement.dataset.theme = 'light';
    </script>
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteHeader />
    {/* 右上角目录栏（三条杠）。全站都要有，所以挂在布局里 */}
    <BoardDrawer current={currentPath} />

    <main id="main" class="site-main">
      <div class:list={['container', narrow && 'container--narrow']}>
        <slot />
      </div>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .container--narrow {
    max-width: 52rem;
  }
</style>
