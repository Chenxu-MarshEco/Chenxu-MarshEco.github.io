---
import '../styles/fonts.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BoardDrawer from '../components/BoardDrawer.astro';
import Timeline from '../components/Timeline.astro';
import site from '../site.config';
import { absoluteUrl, withBase } from '../utils/url';
import { preloadFor } from '../utils/images';
import { editStyleBlock, type PageKey } from '../utils/layout';
import { refParam, type Timeline as TimelineData } from '../utils/timelines';

interface Props {
  /** 页面标题，会拼在站点名前面。首页留空即可 */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  /** 设为 true 时告诉搜索引擎不要收录（草稿页、404 用） */
  noindex?: boolean;
  /** 页面主区域是否使用更窄的宽度（文章页用） */
  narrow?: boolean;
  /** 挂到 <body> 上的 class，首页用它切换整屏背景 */
  bodyClass?: string;
  /**
   * 这一页属于哪种页面类型，决定「排版」模式调的是哪一组值。
   * 不填就没有排版微调（比如 404 页）。
   */
  layoutPage?: PageKey;
  /**
   * 这一页用的时间轴。不传就是没有时间轴 —— 右边沿不会出现那个书签。
   * defaultParam 是「打开时默认停在哪」（页面自己认领的时间点/时间段）。
   */
  timeline?: TimelineData;
  timelineDefault?: number | null;
  /**
   * 首屏最大的那张图（文章封面这类）。给了就在这里发一条 preload，
   * 让浏览器在解析 body 之前就开始拉它 —— 这是 LCP 最直接的一刀。
   * imagesrcset + imagesizes 必须跟 <img> 上那套一致，
   * 否则会下两份（preload 一份、img 自己再挑一份）。
   */
  preloadImage?: string;
  preloadImageSizes?: string;
  /**
   * 直接给一个确定的图片地址去 preload（不带 srcset / sizes）。
   * 用在「CSS 背景图 + preload」这种场合：地址必须跟 CSS 里那一份**完全一致**，
   * 否则浏览器当成两个资源各下一份。首页的城市剪影就是这么做的。
   */
  preloadHref?: string;
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  updatedTime,
  noindex = false,
  narrow = false,
  bodyClass = '',
  layoutPage,
  timeline,
  timelineDefault = null,
  preloadImage,
  preloadImageSizes = '100vw',
  preloadHref,
} = Astro.props;

/** 首屏大图的 preload（图片管线里查得到才发） */
const preload = preloadImage ? preloadFor(preloadImage, preloadImageSizes) : null;

/** 这一页的排版微调样式；全是默认值时为 null，不输出 */
const layoutCss = layoutPage ? editStyleBlock(layoutPage) : null;

const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.tagline}`;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const ogImage = absoluteUrl('/og-default.svg', Astro.site);

/** 目录栏用它高亮「当前在哪」，并自动展开到这一层 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rawPath = Astro.url.pathname;
const withoutBase =
  base && rawPath.startsWith(base) ? rawPath.slice(base.length) || '/' : rawPath;
// 归一化：Astro 生成的目录式地址带尾斜杠（/yongcheng/），
// 而节点地址是 /yongcheng，不处理的话「当前项」永远匹配不上。
const currentPath = withoutBase.length > 1 ? withoutBase.replace(/\/+$/, '') : '/';
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {/*
      首屏大图提前拉：imagesrcset/imagesizes 要跟下面 <img> 上的完全一致，
      不一致的话浏览器会当成两张不同的图，各下一份。
      type 写上，浏览器不支持这种格式时这条 preload 直接跳过（不会白下）。
    */}
    {preload && (
      <link
        rel="preload"
        as="image"
        type={preload.type}
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes}
        fetchpriority="high"
      />
    )}
    {/* CSS 背景图那一种：地址与样式里用的是同一个变量，一 byte 都不会下重 */}
    {preloadHref && <link rel="preload" as="image" href={preloadHref} fetchpriority="high" />}
    {/*
      字体分片之后，只需要预拉「第 01 片」——切片脚本按站点真实用字频率排的，
      第 01 片永远是最高频的那 300 字，任何一页都用得到，约 40KB。
      以前这里预拉的是 1040KB 的母本整份：页面其实只需要其中三四片，
      这一条 preload 等于把省下来的又全下回来了（实测首页总下载 1306KB，
      其中 1040KB 就是它）。
      preload 字体的 crossorigin 不能省：字体走 CORS 模式取，少了这个属性
      浏览器会当成两份不同的资源，白白下两遍。
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBase('/fonts/huajiantang-01.woff2')}
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={withBase('/rss.xml')}
    />

    <!-- 分享卡片 -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />

    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}

    <!-- 主题色：影响手机浏览器地址栏颜色，改 tokens.css 时记得同步 -->
    <meta name="theme-color" content="#e8d0dd" />

    <!-- 站点固定亮色主题，data-theme 供 tokens.css 的选择器使用 -->
    <script is:inline>
      document.documentElement.dataset.theme = 'light';
    </script>
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到正文</a>
    {/* 排版微调：把这一页各元素的偏移/缩放变量输出成规则，
        配合 global.css 里的 [data-edit] 生效。 */}
    {layoutCss && <style is:inline set:html={layoutCss} />}
    <SiteHeader />
    {/* 右上角目录栏（三条杠）。全站都要有，所以挂在布局里 */}
    <BoardDrawer current={currentPath} />
    {/* 时间轴：只有指了时间轴的页面才有，挂在右边沿（关着时只露一个书签） */}
    {timeline && <Timeline timeline={timeline} defaultParam={timelineDefault} />}

    <main id="main" class="site-main">
      <div class:list={['container', narrow && 'container--narrow']}>
        <slot />
      </div>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .container--narrow {
    max-width: 52rem;
  }
</style>
