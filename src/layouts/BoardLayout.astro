---
/**
 * 大板块页面（甬城晴雨 / 花娅陌域，以及它们的子页面）的外壳。
 *
 * 首页只放大板块本身，点进来才在这里展开子版块。
 * 背景沿用该板块在首页的那张蒸汽波调色图，保持连续感。
 */
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/url';
import type { Timeline as TimelineData } from '../utils/timelines';

interface Props {
  /** 页面标题，同时显示在 hero 上 */
  title: string;
  /** 板块背景图；不传就用纯渐变 */
  image?: string;
  /** 返回链接的目标，默认回首页 */
  backHref?: string;
  backLabel?: string;
  /** 这一页用的时间轴；不传就没有 */
  timeline?: TimelineData;
  /** 打开时间轴时默认停在哪（页面自己认领的时间点/时间段） */
  timelineDefault?: number | null;
}

const {
  title,
  image,
  backHref = '/',
  backLabel = '返回',
  timeline,
  timelineDefault = null,
} = Astro.props;
---

<BaseLayout
  title={title}
  bodyClass="is-board"
  layoutPage="board"
  timeline={timeline}
  timelineDefault={timelineDefault}
>
  <div class="bp">
    {/* data-edit 是排版模式的锚点，配合 layout.json 的 board 组生效 */}
    <header class="bp__hero" data-edit="hero">
      {image && <div class="bp__bg" style={`background-image:url(${withBase(image)})`} />}
      <div class="bp__veil"></div>
      <div class="bp__heroInner">
        <a class="bp__back" href={withBase(backHref)}>← {backLabel}</a>
        <h1 class="bp__title" data-edit="title">{title}</h1>
      </div>
    </header>

    <div class="bp__body">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .bp {
    position: relative;
  }

  .bp__hero {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(255, 120, 190, 0.42);
    min-height: clamp(180px, 26vh, 280px);
    display: flex;
    align-items: flex-end;
    box-shadow: 0 18px 50px rgba(10, 0, 20, 0.55);
  }

  .bp__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }

  .bp__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 2, 28, 0.35) 0%,
      rgba(18, 2, 28, 0.62) 55%,
      rgba(10, 0, 18, 0.92) 100%
    );
  }

  .bp__heroInner {
    position: relative;
    padding: clamp(1.1rem, 2.6vw, 2rem);
    width: 100%;
  }

  .bp__back {
    display: inline-block;
    margin-bottom: 0.7rem;
    font-size: 0.84rem;
    letter-spacing: 0.06em;
    color: #ffb3dd;
    text-decoration: none;
  }
  .bp__back:hover {
    color: #fff;
  }

  .bp__title {
    margin: 0;
    font-size: clamp(1.7rem, 3.6vw, 2.7rem);
    letter-spacing: 0.12em;
    color: #fff;
    text-shadow:
      0 0 10px rgba(255, 79, 163, 0.9),
      0 0 28px rgba(212, 0, 123, 0.7);
  }

  .bp__body {
    margin-top: clamp(1.4rem, 3vh, 2.4rem);
  }

  /* 这一页也是深色底，给 body 一个兜底色，理由同首页 */
  :global(body.is-board) {
    background-color: #1e0730;
  }
</style>
