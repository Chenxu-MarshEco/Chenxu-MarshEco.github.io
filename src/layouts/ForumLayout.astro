---
/**
 * 「黎语堂」自己的外壳（2026-10-06 起）。
 *
 * 用户对这一页的要求（第一版）：
 *   「点进去以后是一个全新的黎语堂的首页 地址是 /liyutang 先暂时套用文章和笔记的背景
 *    其他什么都不要放 只留左上角的花涧堂logo以便回到花涧堂 别的都不要有 之后再来详细构筑」
 *
 * 所以这里**故意不是** BaseLayout：
 *   · 没有页头页脚、没有右上角那排控件、没有目录栏、没有歌单、没有时间轴、没有成员名片；
 *   · 只有文章 / 手记那一套 CRT 背景（CrtScreen，样式全在 src/styles/crt.css）
 *     和顶上那条黎语堂自己的常驻栏（LiyutangTopBar：回花涧堂 + 当前登录的人）。
 *
 * 常驻栏 2026-10-09 晚上接进来的，它接手了原来那颗固定定位在左上角的徽记 ——
 * 徽记和「花涧堂」三个字现在住在栏的最左边（用户要求"所有黎语堂页面都有一条常驻栏"）。
 *
 * 为什么另起一个 Layout 而不是给 BaseLayout 加开关：黎语堂以后是一个**静态论坛**，
 * 它自己会长出一整套壳（版块列表、帖子页、评论挂载点、自己的搜索和分页），
 * 和花涧堂那套文章 / 版块的 chrome 不是一回事。现在把边界划清楚，
 * 以后往里长出多少东西都不会和主站互相牵扯。
 *
 * ⚠ 这一页没有 .site-header，所以 tools/checks/site-smoke.mjs 里把它列进了
 * 「整页自带一套、不查站点外框」的名单（和 /secret/ 那几页一个待遇）。
 */
import '../styles/fonts.css';
import '../styles/global.css';
/* 论坛自己的样式（版块卡、帖子列表、正文卡…），和主站分开一份 */
import '../styles/forum.css';
import CrtScreen from '../components/CrtScreen.astro';
import LiyutangTopBar from '../components/LiyutangTopBar.astro';
import site from '../site.config';
import { absoluteUrl, withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /**
   * 这一页要更宽的外壳（2026-10-10 加，给茶绘用）。
   * 茶绘右边接了一个聊天栏之后，按原来的 --w-page（68rem）算，画板那一栏会被挤掉 22rem ——
   * 用户要的是「将茶绘当前UI全部向左挪一些」，也就是"整页更宽、画板从左边缘开始"，
   * 不是把画板压小。所以那一页传 wide，正文区放宽到 104rem（其它页一个字都不动）。
   */
  wide?: boolean;
}

const { title, description = site.description, noindex = false, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="theme-color" content="#120a20" />

    {/* 和主站一样：固定亮色令牌 + is-crt 那套深紫配色（见 tokens.css / crt.css） */}
    <script is:inline>
      document.documentElement.dataset.theme = 'light';
    </script>
    {/* 字体分片：第一片是最高频那 300 字，任何一页都用得到 */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBase('/fonts/huajiantang-01.woff2')}
      crossorigin
    />
  </head>

  <body class="is-crt is-forum">
    {/* 文章 / 手记那一套背景（蒸汽波落日 + 透视栅格 + CRT 三件套） */}
    <CrtScreen />

    {/*
      常驻栏（2026-10-09 晚上）：徽记 + 「花涧堂」（点回首页）在最左，当前登录的人在最右。
      ⚠ 它**取代**了原来那颗固定定位在左上角的徽记 —— 两个都在的话左上角会叠出两个 logo。
      原来那颗的 `.forum__brand` 这个名字搬进了常驻栏（见 LiyutangTopBar.astro），
      tools/checks/announce-liyutang-check.mjs 认的就是这个名字。
    */}
    <LiyutangTopBar />

    <main class:list={['forum__main', wide && 'forum__main--wide']} id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  /*
    正文区：和主站页面同一个最大宽度和左右内边距。
    顶部内边距 2026-10-09 晚上调小了：常驻栏是 sticky 的，它自己占着文档流里那一段高度，
    正文不用再为"固定定位的徽记"让出一整块（原来是 clamp(58px, 7vw, 82px) + 2.2rem）。
  */
  .forum__main {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--w-page);
    margin-inline: auto;
    padding: 1.8rem var(--sp-5) var(--sp-8);
    min-height: 100vh;
  }
  /* 宽版：给茶绘那种"左边画、右边聊"的页面（见 Props 里 wide 那段） */
  .forum__main--wide {
    max-width: min(100%, 104rem);
  }
</style>
