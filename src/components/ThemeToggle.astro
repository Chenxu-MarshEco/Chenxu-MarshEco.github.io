---
/**
 * 明暗主题切换。
 *
 * 三种状态循环：跟随系统 → 亮色 → 暗色。
 * 选择存在浏览器 localStorage 里，下次访问自动生效。
 *
 * 不想要这个按钮：删掉 SiteHeader.astro 里的 <ThemeToggle /> 即可。
 */
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="切换明暗主题"
  title="切换明暗主题"
>
  <span class="theme-toggle__icon" aria-hidden="true"></span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--r-full);
    color: var(--c-text-muted);
    border: 1px solid transparent;
    transition:
      color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .theme-toggle:hover {
    color: var(--c-text);
    border-color: var(--c-border);
  }

  /* 图标用纯 CSS 画，不依赖任何图片或图标字体 */
  .theme-toggle__icon {
    position: relative;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: var(--r-full);
    box-shadow: inset -0.3rem -0.3rem 0 0 currentColor;
  }
  :global(:root[data-theme='dark']) .theme-toggle__icon {
    box-shadow: none;
    background: currentColor;
  }
  :global(:root[data-theme='dark']) .theme-toggle__icon::after {
    content: '';
    position: absolute;
    inset: -0.22rem;
    border-radius: var(--r-full);
    border: 1.5px dashed currentColor;
    opacity: 0.55;
  }
</style>

<script>
  type Mode = 'auto' | 'light' | 'dark';
  const MODES: Mode[] = ['auto', 'light', 'dark'];
  const LABEL: Record<Mode, string> = {
    auto: '跟随系统',
    light: '亮色',
    dark: '暗色',
  };

  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');

  const systemTheme = () =>
    window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

  const stored = (): Mode => {
    const value = localStorage.getItem('theme') as Mode | null;
    return value && MODES.includes(value) ? value : 'auto';
  };

  const apply = (mode: Mode) => {
    const resolved = mode === 'auto' ? systemTheme() : mode;
    root.dataset.theme = resolved;
    root.dataset.themeMode = mode;

    // 同步手机浏览器地址栏的颜色
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      const media = meta.getAttribute('media') ?? '';
      if (media.includes('dark') === (resolved === 'dark')) {
        meta.content = resolved === 'dark' ? '#16151a' : '#fbfaf8';
      }
    }

    if (button) button.title = `主题：${LABEL[mode]}（点击切换）`;
  };

  apply(stored());

  button?.addEventListener('click', () => {
    const next = MODES[(MODES.indexOf(stored()) + 1) % MODES.length];
    localStorage.setItem('theme', next);
    apply(next);
  });

  // 处于"跟随系统"时，系统切换了要跟着变
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (stored() === 'auto') apply('auto');
    });
</script>
