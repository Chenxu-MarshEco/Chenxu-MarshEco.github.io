---
/**
 * 首页「涣愿终池」卡（2026-11-17 加，2026-11-18 挪进大卡那一格）。
 *
 * 站长原话：
 *   「在冰室冰山和每日精华下方也加两个同尺寸的卡片 左边是涣愿终池的入口
 *    和冰室冰山一样可以传封面图」
 *   「把涣愿终池挪到它左边那个大卡片上 后面要给这张卡片做特效 稍后再说
 *    原位置的小卡就留占位符」
 *
 * 2026-11-18 第二次，站长看完复刻的水族缸之后：
 *   「你暂时先把涣愿终池的框恢复到只是可以放图片的样子
 *    然后给它蒙上一层水光波纹的滤镜即可
 *    水光可以打在我上传的图片上并且有那种微微的水体扭曲感」
 *
 * 所以这张卡现在只有两样东西：
 *   ① 站长自己传的封面图（没传就空着，一个字都不写）；
 *   ② 盖在图上的一层水光 —— 图本身先过一道 SVG 位移滤镜（微微扭），
 *      再叠两层慢慢漂的白焦散和一道扫光。
 * 原来那个 canvas 水族缸（HomeAquarium.astro）暂时从这张卡上撤下来了，
 * 组件和贴图都还在，没有删。
 *
 * 跳转地址：面板里填了就用填的；留空就**按版块 id 去版块树里找那一页**
 * （`page-mwt0cistern`）—— 站长在编辑器里改了那一页的地址，这里跟着变。
 */
import widgets from '../data/home-widgets.json';
import site from '../site.config';
import { flattenBoards, type BoardNode } from '../utils/boards';
import { variantUrl } from '../utils/images';
import { withBase } from '../utils/url';

const CISTERN_ID = 'page-mwt0cistern';

const cfg = ((widgets as Record<string, unknown>).cistern ?? {}) as {
  title?: string;
  image?: string;
  text?: string;
  href?: string;
};

const title = String(cfg.title ?? '').trim() || '涣愿终池';
const text = String(cfg.text ?? '').trim();
const imgRaw = String(cfg.image ?? '').trim();
const img = imgRaw ? variantUrl(imgRaw, 800) : '';

/** 面板里填了地址就用它；没填就按 id 找那一页（找不到就退回默认地址） */
const rawHref =
  String(cfg.href ?? '').trim() ||
  flattenBoards(site.homeBoards as BoardNode[]).find((f) => f.node.id === CISTERN_ID)?.url ||
  '/memoriterminalcistern';
const external = /^https?:/i.test(rawHref);
const url = external ? rawHref : withBase(rawHref);
---

<a
  class="cistcard"
  id="home-cistern"
  href={url}
  title={title}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <span class="cistcard__art">
    {
      img ? (
        <>
          <img class="cistcard__img" src={img} alt="" loading="lazy" decoding="async" />
          <span class="cistcard__veil" aria-hidden="true" />
          <span class="cistcard__water" aria-hidden="true" />
          <span class="cistcard__water cistcard__water--far" aria-hidden="true" />
          <span class="cistcard__sheen" aria-hidden="true" />
          <canvas class="cistcard__bubbles" aria-hidden="true"></canvas>
        </>
      ) : null
    }
  </span>

  <span class="cistcard__body">
    <b class="cistcard__title">{title}</b>
    {text && <span class="cistcard__text">{text}</span>}
  </span>
</a>

{/*
  水体扭曲：位移量跟着一张噪声图走，scale 在 6~10 之间慢慢呼吸。
  位移会把边缘拉出画框，所以 .cistcard__img 恒常放大 1.06 倍兜住。
*/}
<svg class="cistcard__defs" aria-hidden="true" focusable="false">
  <filter
    id="ci-water"
    x="-10%"
    y="-10%"
    width="120%"
    height="120%"
    color-interpolation-filters="sRGB"
  >
    <feTurbulence
      type="fractalNoise"
      baseFrequency="0.012 0.021"
      numOctaves="2"
      seed="9"
      result="ciNoise"
    ></feTurbulence>
    <feDisplacementMap
      in="SourceGraphic"
      in2="ciNoise"
      scale="5"
      xChannelSelector="R"
      yChannelSelector="G"
    >
      <animate attributeName="scale" values="4.5;6.5;4.5" dur="21s" repeatCount="indefinite" />
    </feDisplacementMap>
    <feGaussianBlur stdDeviation="0.25"></feGaussianBlur>
  </filter>
</svg>

<style>
  /*
    大卡那一套（和「冰室冰山」/ 预留卡同一个骨架）：图铺满整张卡，
    标题压在底下的渐变上。整张卡可点。
  */
  .cistcard {
    position: relative;
    display: flex;
    /*
      标题在**左下角**，和「黎语堂」那张卡同一个位置（站长 2026-11-21：
      「修改涣愿终池四个字的位置 使其和黎语堂相对自己页面卡片的位置一样
       黎语堂和涣愿终池标题字位置一致大小一致只是风格颜色不同」）。
    */
    align-items: flex-end;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 120, 190, 0.4);
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(38, 6, 54, 0.86), rgba(20, 3, 32, 0.9));
    box-shadow: 0 14px 40px -22px rgb(0 0 0 / 0.8);
    text-decoration: none;
    color: inherit;
    transition: transform 0.16s ease, border-color 0.16s ease;
  }
  .cistcard:hover,
  .cistcard:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(255, 120, 190, 0.8);
  }

  /*
    板块的底色（2026-11-19 改）：站长传的是**透明底**的图，所以这一层就是卡片的
    "底色"。按他说的换成 Frutiger Aero 那套天蓝 —— 上面一层白到透明的顶光（Aero
    的招牌），下面是天蓝到海蓝的竖渐变。图不透明时它只露出一圈边，透明底时整块都是它。
  */
  .cistcard__art {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background:
      radial-gradient(132% 68% at 50% -12%, rgba(255, 255, 255, 0.74) 0%, rgba(255, 255, 255, 0) 62%),
      linear-gradient(180deg, #a7e7fb 0%, #6dcdf1 38%, #35a6db 74%, #1b7fb5 100%);
  }

  /*
    和「甬城晴雨 / 花娅陌域」那两块大板一样的滤镜蒙版（`.board__veil` 那一套），
    只是换成水色的。2026-11-19 标题挪到左上角之后，上头也压一点，标题才压得住。
  */
  .cistcard__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(12, 74, 108, 0.44) 0%,
      rgba(38, 122, 164, 0.12) 20%,
      rgba(96, 196, 234, 0.12) 54%,
      rgba(20, 96, 140, 0.5) 100%
    );
  }

  /*
    图本身微微扭。1.06 是给位移留的余量 —— 不放大，被拉出去的那一圈就是空的。
    filter 里那个 url 指到下面 <svg> 的 #ci-water。
  */
  .cistcard__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    filter: url(#ci-water);
    transition: transform 0.5s ease;
  }
  .cistcard:hover .cistcard__img {
    transform: scale(1.1);
  }

  /*
    两层焦散：都是白色细纹的透明贴图（我自己算的 Voronoi，不是屏保里的东西），
    screen 叠在图上只加光不减光。inset 给到 -50% 是为了让它一直在画框外有余量，
    平移只走 transform（合成器就能干，不用重绘）。
    位移的距离 = 贴图的边长，走完一整张正好接回原点，看不出接缝。
  */
  .cistcard__water {
    position: absolute;
    inset: -50%;
    pointer-events: none;
    background-image: url('/img/aquarium/water-light.webp');
    background-repeat: repeat;
    background-size: 132px 132px;
    mix-blend-mode: screen;
    opacity: 0.26;
    will-change: transform;
    animation: ci-drift-a 47s linear infinite;
  }
  .cistcard__water--far {
    background-size: 208px 208px;
    opacity: 0.15;
    animation: ci-drift-b 71s linear infinite;
  }

  @keyframes ci-drift-a {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-132px, 132px, 0);
    }
  }
  @keyframes ci-drift-b {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(208px, -208px, 0);
    }
  }

  /* 一道很淡的光斜着扫过去，隔十几秒来一次 */
  .cistcard__sheen {
    position: absolute;
    inset: -40%;
    pointer-events: none;
    background: linear-gradient(
      112deg,
      transparent 40%,
      rgba(170, 235, 255, 0.14) 47%,
      rgba(255, 255, 255, 0.1) 51%,
      transparent 60%
    );
    mix-blend-mode: screen;
    opacity: 0;
    will-change: transform, opacity;
    animation: ci-sheen 17s ease-in-out infinite;
  }

  @keyframes ci-sheen {
    0%,
    24% {
      opacity: 0;
      transform: translate3d(-14%, 0, 0);
    }
    38% {
      opacity: 1;
    }
    62% {
      opacity: 0.55;
    }
    76%,
    100% {
      opacity: 0;
      transform: translate3d(14%, 0, 0);
    }
  }

  .cistcard__defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* 气泡那一层：和焦散一样铺满整张卡，不吃点击 */
  .cistcard__bubbles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /*
    标题这一行的内边距和「黎语堂」那张卡一致（同一个 clamp）——
    两张卡并排时标题离左边 / 底边的距离必须一样。
  */
  .cistcard__body {
    position: relative;
    display: block;
    width: 100%;
    padding: clamp(0.85rem, 2vw, 1.3rem);
    background: none;
  }
  /*
    千禧风「塑料绿」的字（2026-11-19 站长要的；他没给色号，说的是"去网上找点资料就能
    看到那种风格"）。千禧年那批东西是**透明/糖果塑料**：iMac G3 的 Lime（1999）、
    Nokia 那种酸性绿、Y2K 色卡里的"有毒绿"，共同点是 —— 上沿一道近白的高光、
    中间是偏黄的饱和青柠绿、下沿压暗成塑料的厚度。
    所以这里是**三层**：左上一点白色高光 + 白→青柠→深绿的竖渐变，全填进笔画里
    （background-clip: text）。注意不能用 text-shadow：字是 transparent 的，
    阴影会透进笔画糊成一团，所以改用 drop-shadow 垫一道白边一道深影。
  */
  .cistcard__title {
    display: block;
    /* 字号和字距跟「黎语堂」的标题一模一样，只是颜色 / 材质是千禧绿那套 */
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    background:
      radial-gradient(120% 90% at 22% 4%, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 46%),
      linear-gradient(180deg, #f7ffe1 0%, #ddff9b 24%, #b0f640 50%, #86d314 74%, #4e8f0c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.5)) drop-shadow(0 2px 5px rgba(6, 44, 26, 0.62));
  }
  .cistcard__text {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: rgba(255, 236, 248, 0.72);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 不想看动的东西就把漂和扫光都停掉，图上的静态水纹留着 */
  @media (prefers-reduced-motion: reduce) {
    .cistcard__water,
    .cistcard__sheen {
      animation: none;
    }
    .cistcard__sheen {
      display: none;
    }
  }

  /*
    手机上是单列，桌面那套「和日历一样高」的脚本不写高度（见 HomeWidgets），
    这张卡里又只有一块铺满的图 + 一行标题 —— 不给个下限就只剩标题那一条。
  */
  @media (max-width: 760px) {
    .cistcard {
      min-height: 180px;
    }
  }
</style>

<script>
  /*
    气泡（2026-11-19 搬过来的，不是新做的）。

    画法原样沿用 `HomeAquarium.astro` 里那一段（站长：「你之前做好过 直接搬过来就行
    不要重新做」）：先把一颗气泡画进离屏画布（外圈亮环、中间透、左上一点高光），
    运行时只是按不同速度往上挪 + 横向轻摆 —— 24 次 drawImage，不每帧建渐变。

    这里只剩这一层，所以没有整缸那套：滚出屏幕就停、页面隐藏也停。
  */
  (() => {
    const cv = document.querySelector<HTMLCanvasElement>('.cistcard__bubbles');
    if (!cv) return;
    const ctx = cv.getContext('2d');
    if (!ctx) return;

    const less = window.matchMedia('(prefers-reduced-motion: reduce)');
    let cw = 0;
    let ch = 0;
    let dpr = 0;
    let raf = 0;
    let t0 = 0;
    let shown = false;

    let sprite: HTMLCanvasElement | null = null;
    function makeBubble() {
      const S = 64;
      const c = document.createElement('canvas');
      c.width = S;
      c.height = S;
      const g = c.getContext('2d')!;
      // 外圈亮环
      const grad = g.createRadialGradient(S * 0.42, S * 0.38, S * 0.06, S / 2, S / 2, S / 2);
      grad.addColorStop(0, 'rgba(255,255,255,0.15)');
      grad.addColorStop(0.55, 'rgba(226,246,255,0.10)');
      grad.addColorStop(0.86, 'rgba(236,250,255,0.62)');
      grad.addColorStop(0.97, 'rgba(255,255,255,0.30)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      g.fillStyle = grad;
      g.beginPath();
      g.arc(S / 2, S / 2, S / 2 - 1, 0, Math.PI * 2);
      g.fill();
      // 高光
      const hi = g.createRadialGradient(S * 0.36, S * 0.30, 0, S * 0.36, S * 0.30, S * 0.20);
      hi.addColorStop(0, 'rgba(255,255,255,0.95)');
      hi.addColorStop(1, 'rgba(255,255,255,0)');
      g.fillStyle = hi;
      g.beginPath();
      g.arc(S * 0.36, S * 0.30, S * 0.2, 0, Math.PI * 2);
      g.fill();
      sprite = c;
    }

    /** 一串泡泡往上冒：x 按 sin 摆，越往上越小、越淡 */
    function draw(time: number) {
      if (!sprite) makeBubble();
      const spr = sprite!;
      const COUNT = 24;
      ctx.save();
      for (let i = 0; i < COUNT; i++) {
        const ph = i * 0.618;
        const spd = 0.038 + (i % 6) * 0.007;
        const life = (time * spd + ph) % 1;
        const baseX = 0.12 + ((i * 0.37) % 1) * 0.78;
        const wob = Math.sin(time * 1.7 + ph * 6.283) * cw * 0.014;
        const px = (baseX + wob / cw) * cw;
        const py = ch * (1.04 - life * 1.1);
        const r = (1.2 + ((i * 7) % 10) * 0.36) * (cw / 452) * (1.3 - life * 0.5);
        const fade = Math.min(1, life * 8) * (1 - Math.max(0, life - 0.82) / 0.18);
        ctx.globalAlpha = 0.85 * fade;
        ctx.drawImage(spr, px - r, py - r, r * 2, r * 2);
      }
      ctx.restore();
    }

    function resize() {
      const r = cv!.getBoundingClientRect();
      const d = Math.min(2, window.devicePixelRatio || 1);
      const w = Math.max(1, Math.round(r.width));
      const h = Math.max(1, Math.round(r.height));
      if (w === cw && h === ch && d === dpr) return;
      cw = w;
      ch = h;
      dpr = d;
      cv!.width = Math.round(w * d);
      cv!.height = Math.round(h * d);
      ctx!.setTransform(d, 0, 0, d, 0, 0);
    }

    function frame(now: number) {
      raf = 0;
      if (!t0) t0 = now;
      resize();
      ctx!.clearRect(0, 0, cw, ch);
      draw((now - t0) / 1000);
      if (shown && !less.matches) raf = requestAnimationFrame(frame);
    }

    function start() {
      if (raf) return;
      if (less.matches) {
        // 不动的时候也画一帧，静态的泡泡总比一块空的好
        resize();
        ctx!.clearRect(0, 0, cw, ch);
        draw(0);
        return;
      }
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }

    const io = new IntersectionObserver(
      (list) => {
        shown = list.some((e) => e.isIntersecting);
        if (shown) start();
        else stop();
      },
      { rootMargin: '120px' },
    );
    io.observe(cv);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (shown) start();
    });
  })();
</script>
