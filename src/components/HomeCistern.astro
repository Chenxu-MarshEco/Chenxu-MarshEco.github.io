---
/**
 * 首页「涣愿终池」卡（2026-11-17 加，2026-11-18 挪进大卡那一格）。
 *
 * 站长原话：
 *   「在冰室冰山和每日精华下方也加两个同尺寸的卡片 左边是涣愿终池的入口
 *    和冰室冰山一样可以传封面图」
 *   「把涣愿终池挪到它左边那个大卡片上 后面要给这张卡片做特效 稍后再说
 *    原位置的小卡就留占位符」
 *
 * 2026-11-18 第二次，站长看完复刻的水族缸之后：
 *   「你暂时先把涣愿终池的框恢复到只是可以放图片的样子
 *    然后给它蒙上一层水光波纹的滤镜即可
 *    水光可以打在我上传的图片上并且有那种微微的水体扭曲感」
 *
 * 所以这张卡现在只有两样东西：
 *   ① 站长自己传的封面图（没传就空着，一个字都不写）；
 *   ② 盖在图上的一层水光 —— 图本身先过一道 SVG 位移滤镜（微微扭），
 *      再叠两层慢慢漂的白焦散和一道扫光。
 * 原来那个 canvas 水族缸（HomeAquarium.astro）暂时从这张卡上撤下来了，
 * 组件和贴图都还在，没有删。
 *
 * 跳转地址：面板里填了就用填的；留空就**按版块 id 去版块树里找那一页**
 * （`page-mwt0cistern`）—— 站长在编辑器里改了那一页的地址，这里跟着变。
 */
import widgets from '../data/home-widgets.json';
import site from '../site.config';
import { flattenBoards, type BoardNode } from '../utils/boards';
import { variantUrl } from '../utils/images';
import { withBase } from '../utils/url';

const CISTERN_ID = 'page-mwt0cistern';

const cfg = ((widgets as Record<string, unknown>).cistern ?? {}) as {
  title?: string;
  image?: string;
  text?: string;
  href?: string;
};

const title = String(cfg.title ?? '').trim() || '涣愿终池';
const text = String(cfg.text ?? '').trim();
const imgRaw = String(cfg.image ?? '').trim();
const img = imgRaw ? variantUrl(imgRaw, 800) : '';

/** 面板里填了地址就用它；没填就按 id 找那一页（找不到就退回默认地址） */
const rawHref =
  String(cfg.href ?? '').trim() ||
  flattenBoards(site.homeBoards as BoardNode[]).find((f) => f.node.id === CISTERN_ID)?.url ||
  '/memoriterminalcistern';
const external = /^https?:/i.test(rawHref);
const url = external ? rawHref : withBase(rawHref);
---

<a
  class="cistcard"
  id="home-cistern"
  href={url}
  title={title}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <span class="cistcard__art">
    {
      img ? (
        <>
          <img class="cistcard__img" src={img} alt="" loading="lazy" decoding="async" />
          <span class="cistcard__water" aria-hidden="true" />
          <span class="cistcard__water cistcard__water--far" aria-hidden="true" />
          <span class="cistcard__sheen" aria-hidden="true" />
        </>
      ) : null
    }
  </span>

  <span class="cistcard__body">
    <b class="cistcard__title">{title}</b>
    {text && <span class="cistcard__text">{text}</span>}
  </span>
</a>

{/*
  水体扭曲：位移量跟着一张噪声图走，scale 在 6~10 之间慢慢呼吸。
  位移会把边缘拉出画框，所以 .cistcard__img 恒常放大 1.06 倍兜住。
*/}
<svg class="cistcard__defs" aria-hidden="true" focusable="false">
  <filter
    id="ci-water"
    x="-10%"
    y="-10%"
    width="120%"
    height="120%"
    color-interpolation-filters="sRGB"
  >
    <feTurbulence
      type="fractalNoise"
      baseFrequency="0.012 0.021"
      numOctaves="2"
      seed="9"
      result="ciNoise"
    ></feTurbulence>
    <feDisplacementMap
      in="SourceGraphic"
      in2="ciNoise"
      scale="5"
      xChannelSelector="R"
      yChannelSelector="G"
    >
      <animate attributeName="scale" values="4.5;6.5;4.5" dur="21s" repeatCount="indefinite" />
    </feDisplacementMap>
    <feGaussianBlur stdDeviation="0.25"></feGaussianBlur>
  </filter>
</svg>

<style>
  /*
    大卡那一套（和「冰室冰山」/ 预留卡同一个骨架）：图铺满整张卡，
    标题压在底下的渐变上。整张卡可点。
  */
  .cistcard {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 120, 190, 0.4);
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(38, 6, 54, 0.86), rgba(20, 3, 32, 0.9));
    box-shadow: 0 14px 40px -22px rgb(0 0 0 / 0.8);
    text-decoration: none;
    color: inherit;
    transition: transform 0.16s ease, border-color 0.16s ease;
  }
  .cistcard:hover,
  .cistcard:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(255, 120, 190, 0.8);
  }

  .cistcard__art {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(30, 8, 48, 0.9), rgba(10, 2, 18, 0.9));
  }

  /*
    图本身微微扭。1.06 是给位移留的余量 —— 不放大，被拉出去的那一圈就是空的。
    filter 里那个 url 指到下面 <svg> 的 #ci-water。
  */
  .cistcard__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    filter: url(#ci-water);
    transition: transform 0.5s ease;
  }
  .cistcard:hover .cistcard__img {
    transform: scale(1.1);
  }

  /*
    两层焦散：都是白色细纹的透明贴图（我自己算的 Voronoi，不是屏保里的东西），
    screen 叠在图上只加光不减光。inset 给到 -50% 是为了让它一直在画框外有余量，
    平移只走 transform（合成器就能干，不用重绘）。
    位移的距离 = 贴图的边长，走完一整张正好接回原点，看不出接缝。
  */
  .cistcard__water {
    position: absolute;
    inset: -50%;
    pointer-events: none;
    background-image: url('/img/aquarium/water-light.webp');
    background-repeat: repeat;
    background-size: 132px 132px;
    mix-blend-mode: screen;
    opacity: 0.26;
    will-change: transform;
    animation: ci-drift-a 47s linear infinite;
  }
  .cistcard__water--far {
    background-size: 208px 208px;
    opacity: 0.15;
    animation: ci-drift-b 71s linear infinite;
  }

  @keyframes ci-drift-a {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-132px, 132px, 0);
    }
  }
  @keyframes ci-drift-b {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(208px, -208px, 0);
    }
  }

  /* 一道很淡的光斜着扫过去，隔十几秒来一次 */
  .cistcard__sheen {
    position: absolute;
    inset: -40%;
    pointer-events: none;
    background: linear-gradient(
      112deg,
      transparent 40%,
      rgba(170, 235, 255, 0.14) 47%,
      rgba(255, 255, 255, 0.1) 51%,
      transparent 60%
    );
    mix-blend-mode: screen;
    opacity: 0;
    will-change: transform, opacity;
    animation: ci-sheen 17s ease-in-out infinite;
  }

  @keyframes ci-sheen {
    0%,
    24% {
      opacity: 0;
      transform: translate3d(-14%, 0, 0);
    }
    38% {
      opacity: 1;
    }
    62% {
      opacity: 0.55;
    }
    76%,
    100% {
      opacity: 0;
      transform: translate3d(14%, 0, 0);
    }
  }

  .cistcard__defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .cistcard__body {
    position: relative;
    display: block;
    width: 100%;
    padding: 0.6rem 0.75rem 0.65rem;
    background: linear-gradient(180deg, rgba(12, 0, 20, 0), rgba(12, 0, 20, 0.88));
  }
  .cistcard__title {
    display: block;
    font-size: 0.98rem;
    letter-spacing: 0.12em;
    color: #ffd9ef;
  }
  .cistcard__text {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: rgba(255, 236, 248, 0.72);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 不想看动的东西就把漂和扫光都停掉，图上的静态水纹留着 */
  @media (prefers-reduced-motion: reduce) {
    .cistcard__water,
    .cistcard__sheen {
      animation: none;
    }
    .cistcard__sheen {
      display: none;
    }
  }

  /*
    手机上是单列，桌面那套「和日历一样高」的脚本不写高度（见 HomeWidgets），
    这张卡里又只有一块铺满的图 + 一行标题 —— 不给个下限就只剩标题那一条。
  */
  @media (max-width: 760px) {
    .cistcard {
      min-height: 180px;
    }
  }
</style>
