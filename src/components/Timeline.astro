---
/**
 * 右侧的时间轴。
 *
 * 一条蒸汽波落日配色的弧线竖在网页最右边，向左边微微凸出；弧顶（最突出的
 * 那一点）永远是「当前」刻度。滚轮在面板里滚，刻度就上下走，事件跟着经过弧顶。
 *
 * 几个关键决定：
 *
 * 1. **左右两侧各一条线**。同一个刻度上可以左边挂一个事件、右边挂一个，
 *    双线叙事用（左边记花娅历、右边记冰室历）。
 * 2. **图钉是垂直于弧线长出来的塔吊**。所以它不是「贴」在轴上，而是从轴上
 *    朝外伸出去 —— 位置在弧上，方向是那一点的径向。
 * 3. **位置只存 0~1 的参数**（在这条轴的时间范围里的相对位置），
 *    屏幕上落在哪儿由脚本按弧长算。这样面板高度一变，弧线和事件一起重排，
 *    不用回改数据。
 * 4. 关着的时候只在右边沿露一个书签。开合状态记在 sessionStorage 里，
 *    按**时间轴的 id** 记：连着翻几个用同一条轴的页面，它一直开着；
 *    进了用别的轴（或没有轴）的页面，自然就是关着的。
 */
import type { Timeline as TimelineData } from '../utils/timelines';
import { pointParam, spanEdges, spanParam, rangeOf, dayOf } from '../utils/timelines';

interface Props {
  timeline: TimelineData;
  /**
   * 打开时默认停在哪（0~1）。页面自己被认领了时间点/时间段就传它，
   * 没有的话传 null，脚本会退回到「当前屏幕上那个成分」或者第一个时间点。
   */
  defaultParam?: number | null;
}

const { timeline: tl, defaultParam = null } = Astro.props;

const range = rangeOf(tl);
const spanMin = Math.min(range.min, range.max);
const spanMax = Math.max(range.min, range.max);

/** 时间点：位置、左右、名字、日期都写进 data-*，脚本照着摆 */
const points = tl.points
  .map((p) => ({ ...p, t: pointParam(tl, p) }))
  .sort((a, b) => a.t - b.t);

/**
 * 时间段：带子画在哪一侧，跟它起点那个时间点走
 * （两端通常在同一个历法上，不同侧的话按起点算）。
 */
const spans = tl.spans.map((s) => {
  const from = tl.points.find((p) => p.id === s.from);
  const edges = spanEdges(tl, s);
  return {
    ...s,
    t: spanParam(tl, s),
    fromT: Math.min(edges.from, edges.to),
    toT: Math.max(edges.from, edges.to),
    side: from?.side ?? 'left',
  };
});

const gradId = `tl-arc-${tl.id}`;
---

<div
  class="tl"
  data-tl
  data-tl-id={tl.id}
  data-tl-min={spanMin}
  data-tl-max={spanMax}
  data-tl-default={defaultParam === null ? '' : String(defaultParam)}
>
  {/*
    关着的时候只在右边沿露出来的那个书签。
    上面写的是**这条时间轴自己的名字**（比如「花娅年代记」），不是「时间轴」
    三个字 —— 一个页面挂着哪条轴，光看书签就该知道，不用点开。
  */}
  <button
    class="tl__tab"
    type="button"
    data-tl-toggle
    aria-expanded="false"
    aria-controls={`tl-panel-${tl.id}`}
    title={`打开${tl.title}`}
  >
    <span class="tl__tabText">{tl.title}</span>
  </button>

  <aside class="tl__panel" id={`tl-panel-${tl.id}`} data-tl-panel hidden aria-label={tl.title}>
    <div class="tl__head">
      <span class="tl__title">{tl.title}</span>
      <button class="tl__close" type="button" data-tl-close aria-label="收起时间轴">×</button>
    </div>

    <div class="tl__body" data-tl-body>
      <svg class="tl__svg" data-tl-svg aria-hidden="true">
        <defs>
          <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#fff2b8"></stop>
            <stop offset="30%" stop-color="#ffd447"></stop>
            <stop offset="66%" stop-color="#ff9d2e"></stop>
            <stop offset="100%" stop-color="#e04a08"></stop>
          </linearGradient>
        </defs>
        {/* 时间段的带子：脚本按弧线生成，一个时间段一条 */}
        {spans.map((s) => (
          <path class="tl__band" data-tl-band={s.id} stroke={`url(#${gradId})`}></path>
        ))}
        {/* 主弧线 */}
        <path class="tl__arcLine" data-tl-arc stroke={`url(#${gradId})`}></path>
        {/* 刻度：整条刻度尺用一个 path 画，滚动时只改一个 d，便宜 */}
        <path class="tl__rulerPath" data-tl-ruler stroke={`url(#${gradId})`}></path>
      </svg>

      {/* 弧顶那一点：当前所在的日期 */}
      <div class="tl__now" data-tl-now aria-hidden="true">
        <span class="tl__nowDot"></span>
        <span class="tl__nowDate" data-tl-nowdate></span>
      </div>

      {spans.map((s) => (
        <div
          class="tl__spanName"
          data-tl-spanName={s.id}
          data-side={s.side}
          data-tl-from={s.fromT}
          data-tl-to={s.toT}
        >
          {s.name}
        </div>
      ))}

      {points.map((p) => (
        <div
          class="tl__item"
          data-tl-item
          data-side={p.side}
          data-param={p.t}
          data-label={p.label}
          data-date={p.date}
          data-point={p.id}
        >
          <span class="tl__crane" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M10.5 20.5V6.5M13.5 20.5V6.5M8.5 20.5h7M12 4v2.5M3.5 9h17M12 4 3.5 9M12 4l8.5 5M17.5 9v4"></path>
            </svg>
          </span>
          {/* 名字常驻显示；鼠标移上去再补一个日期 */}
          <span class="tl__name">{p.label}</span>
          <span class="tl__tip" role="tooltip">
            <b>{p.label}</b>
            <em>{p.date}</em>
          </span>
        </div>
      ))}
    </div>

    <div class="tl__foot">
      <div class="tl__footNames">
        <span class="tl__side tl__side--left">{tl.leftName}</span>
        <span class="tl__side tl__side--right">{tl.rightName}</span>
      </div>

      {/*
        时间轴比例：一根横着的刻度尺，上面的塔吊当滑块，左右拖就改比例尺。
        往左 = 放大（一刻度代表的天数变少，最左是一天一格），
        往右 = 缩小（最右是一年一格）。位置记在 sessionStorage 里，见脚本。
      */}
      <div class="tl__scale">
        <span class="tl__scaleLabel" id={`tl-scale-label-${tl.id}`}>时间轴比例</span>
        <div class="tl__scaleTrack" data-tl-track>
          <span class="tl__scaleRail" data-tl-rail>
            <span
              class="tl__scaleKnob"
              data-tl-knob
              role="slider"
              tabindex="0"
              aria-labelledby={`tl-scale-label-${tl.id}`}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="50"
              aria-valuetext="一刻度约 19 天"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M10.5 20.5V6.5M13.5 20.5V6.5M8.5 20.5h7M12 4v2.5M3.5 9h17M12 4 3.5 9M12 4l8.5 5M17.5 9v4"></path>
              </svg>
            </span>
          </span>
        </div>
        <span class="tl__scaleValue" data-tl-scaleval aria-hidden="true"></span>
      </div>
    </div>
  </aside>
</div>

<style>
  /*
    面板固定在最右边，关着的时候整块推到画面外，只留左边沿露出的书签。
    用 transform 推走而不是 display:none —— 推开才有那一下滑动。

    配色分两套：
      · 面板这一圈「外框」（底、边框、标题、页脚、书签、文字）走站点的粉色，
        和右侧抽屉 BoardDrawer 那一套同色（深紫底 #1e0730 + 粉边 + #ffd9ef 字），
        这样它看着就是网页的一部分，而不是镶上去的一块落日贴纸。
      · 只有**轴本身**（弧线、刻度尺、时间段带子、塔吊、弧顶那颗点）保留
        蒸汽波落日渐变。粉的框 + 落日的轴，是这一版特意定下来的关系。
  */
  .tl__panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 62;
    width: min(430px, 92vw);
    height: 100%;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, rgba(38, 6, 54, 0.97), rgba(20, 3, 32, 0.98));
    border-left: 1px solid rgba(255, 120, 190, 0.42);
    box-shadow: -18px 0 50px -20px rgb(0 0 0 / 0.7);
    transform: translateX(101%);
    transition: transform 0.26s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .tl.is-open .tl__panel {
    transform: translateX(0);
  }

  /*
    书签：贴在右边缘、竖向居中。开面板时它退到画面外 ——
    面板自己头上有收起按钮，不用两个入口。
  */
  .tl__tab {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 61;
    transform: translateY(-50%);
    padding: 0.85rem 0.42rem;
    border: 1px solid rgba(255, 120, 190, 0.55);
    border-right: 0;
    border-radius: 12px 0 0 12px;
    background: linear-gradient(90deg, rgba(60, 8, 40, 0.92), rgba(30, 4, 44, 0.92));
    color: #ffd9ef;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    writing-mode: vertical-rl;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .tl__tab:hover {
    color: #fff;
    transform: translateY(-50%) translateX(-3px);
  }
  .tl.is-open .tl__tab {
    transform: translateY(-50%) translateX(140%);
    pointer-events: none;
  }

  .tl__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255, 120, 190, 0.3);
  }
  .tl__title {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.14em;
    color: #ffd9ef;
    text-shadow: 0 0 12px rgba(255, 79, 163, 0.7);
  }
  .tl__close {
    border: 0;
    background: none;
    color: rgba(255, 217, 239, 0.8);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.3rem;
  }
  .tl__close:hover {
    color: #fff;
  }

  /*
    弧线所在的这一块：它就是「一屏」，弧顶在竖直正中。
    从这里往下到塔吊为止都是**轴本身** —— 只有这一部分是落日配色。
  */
  .tl__body {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    touch-action: none;
  }
  .tl__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .tl__arcLine {
    fill: none;
    stroke-width: 2.5;
    filter: drop-shadow(0 0 6px rgba(255, 170, 60, 0.85));
  }
  .tl__rulerPath {
    fill: none;
    stroke-width: 1.4;
    opacity: 0.75;
  }
  .tl__band {
    fill: none;
    stroke-width: 9;
    opacity: 0.28;
    stroke-linecap: round;
  }

  /*
    弧顶那一点：一个小圆点 + 当前日期。

    日期摆在圆点**左边**（右对齐、贴着轴）。原来是摆在右边，而右边正是
    事件名字常驻的那一列 —— 只要有事件刚好滚到弧顶，两串字就叠在一起，
    读出来是「2023-07-16SSW加入冰室」。左边一般是空的（用户这条轴的事件
    全在右侧），只有偶尔有个左侧事件经过时才会碰一下，比天天撞右侧划算。
    整个盒子以弧顶为右边缘，圆点再往右挪半个身位，正好压在轴上。
  */
  .tl__now {
    position: absolute;
    transform: translate(calc(-100% + 4.5px), -50%);
    display: flex;
    /* 源码里是「圆点、日期」，倒过来摆 → 日期在左、圆点贴轴 */
    flex-direction: row-reverse;
    align-items: center;
    gap: 0.4rem;
    pointer-events: none;
    white-space: nowrap;
  }
  .tl__nowDot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #fff2b8;
    box-shadow: 0 0 10px rgba(255, 210, 80, 0.95);
  }
  .tl__nowDate {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(255, 217, 239, 0.85);
    font-variant-numeric: tabular-nums;
  }

  /*
    一个事件。外层是零尺寸的锚点，落在弧线上那一点；
    里面的塔吊以「底边中点」为原点旋转 —— 那个点就是锚点，
    所以不管转到什么角度，塔吊的根都长在轴上。
  */
  .tl__item {
    position: absolute;
    width: 0;
    height: 0;
  }
  .tl__crane {
    position: absolute;
    left: -13px;
    bottom: 0;
    width: 26px;
    height: 26px;
    transform-origin: bottom center;
    color: #ffc857;
    filter: drop-shadow(0 0 4px rgba(255, 150, 40, 0.8));
  }
  .tl__crane svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /*
    名字常驻显示，横着写（转着写就没法读了）。
    它是面板上的字，所以跟着外框走粉色；塔吊才是轴上的落日色。
    上下位置由脚本给：同一个刻度上挤了好几个事件时，它们会
    以此为基准上下错开（见脚本里的 groupItems）。
  */
  .tl__name {
    position: absolute;
    top: 0;
    transform: translateY(-50%);
    max-width: 8.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: #ffd9ef;
    text-shadow: 0 1px 5px rgba(20, 0, 10, 0.9);
  }
  .tl__item[data-side='left'] .tl__name {
    right: 40px;
  }
  .tl__item[data-side='right'] .tl__name {
    left: 40px;
  }

  /* 鼠标移上去补日期 */
  .tl__tip {
    position: absolute;
    top: 0;
    transform: translate(-50%, -140%);
    padding: 0.2rem 0.55rem;
    border-radius: 7px;
    border: 1px solid rgba(255, 120, 190, 0.6);
    background: rgba(24, 3, 36, 0.96);
    color: #ffd9ef;
    font-size: 0.76rem;
    line-height: 1.5;
    white-space: nowrap;
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.14s ease, visibility 0.14s ease;
  }
  .tl__tip b {
    font-weight: 700;
  }
  .tl__tip em {
    font-style: normal;
    color: rgba(255, 190, 220, 0.85);
    font-variant-numeric: tabular-nums;
  }
  .tl__item:hover .tl__tip {
    opacity: 1;
    visibility: visible;
  }
  .tl__item:hover .tl__crane {
    color: #fff2b8;
  }

  /*
    时间段的名字，跟着带子一起走（同样算面板上的字，用粉色）。

    注意它**没有** [data-side] 的左右列规则：这几个字的横坐标是脚本按
    「贴着弧线往两边让开 40px」直接写进 left 的（右边那列用
    translateX(-100%) 把文字右对齐过去）。以前这里另外写过 left/right
    两条 CSS，结果脚本一写行内 left 就把 CSS 的 right 顶掉了，名字其实是
    压在轴上起步的 —— 一挪到另一侧就露馅。
  */
  .tl__spanName {
    position: absolute;
    top: 0;
    transform: translateY(-50%);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: rgba(255, 190, 220, 0.8);
    white-space: nowrap;
    pointer-events: none;
  }

  .tl__foot {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.6rem 1rem 0.65rem;
    border-top: 1px solid rgba(255, 120, 190, 0.3);
    font-size: 0.76rem;
  }
  .tl__footNames {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .tl__side {
    letter-spacing: 0.1em;
    color: #ffd9ef;
  }

  /* ---------------- 时间轴比例 ---------------- */
  .tl__scale {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tl__scaleLabel {
    flex: none;
    color: rgba(255, 217, 239, 0.72);
    letter-spacing: 0.04em;
  }
  /*
    轨道本身不画东西，只是给「左右各留半个滑块」留出位置：
    尺子（rail）左右各缩进 13px，滑块就永远不会跑出面板。
  */
  .tl__scaleTrack {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    height: 26px;
  }
  .tl__scaleRail {
    --p: 0.5;
    position: absolute;
    left: 13px;
    right: 13px;
    top: 50%;
    height: 4px;
    margin-top: -2px;
    border-radius: 999px;
    background: rgba(255, 120, 190, 0.26);
    cursor: pointer;
    /* 手机上手指按着横拖是改比例尺，不要变成滚页面 */
    touch-action: none;
  }
  /* 横着的刻度：一道道上下的细线铺过去，看着就是把尺子 */
  .tl__scaleRail::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 12px;
    transform: translateY(-50%);
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 120, 190, 0.5) 0 1px,
      transparent 1px 9px
    );
    pointer-events: none;
  }
  /*
    滑块：一颗塔吊，和轴上的塔吊同一个图形。
    底盘和读数走粉色（它属于面板外框），塔吊本身保持落日色（塔吊就是塔吊）。
  */
  .tl__scaleKnob {
    position: absolute;
    left: calc(var(--p, 0.5) * 100%);
    top: 50%;
    width: 26px;
    height: 26px;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 120, 190, 0.55);
    background: rgba(24, 3, 36, 0.95);
    color: #ffc857;
    cursor: grab;
    touch-action: none;
    transition: border-color 0.14s ease, color 0.14s ease;
  }
  .tl__scaleKnob svg {
    display: block;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 3px rgba(255, 150, 40, 0.75));
  }
  .tl__scaleKnob:hover {
    color: #fff2b8;
    border-color: rgba(255, 120, 190, 0.9);
  }
  .tl__scaleKnob:active {
    cursor: grabbing;
  }
  .tl__scaleKnob:focus-visible {
    outline: 2px solid #5ff0ff;
    outline-offset: 2px;
  }
  .tl__scaleValue {
    flex: none;
    min-width: 5.6em;
    text-align: right;
    color: rgba(255, 217, 239, 0.72);
    font-variant-numeric: tabular-nums;
  }

  /* 窄屏：面板占满，字小一档 */
  @media (max-width: 34rem) {
    .tl__panel {
      width: 100vw;
    }
    .tl__name {
      max-width: 5.5rem;
      font-size: 0.74rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl__panel,
    .tl__tab,
    .tl__tip {
      transition: none;
    }
  }
</style>

<script>
  /* ============================================================
     时间轴：弧线几何 + 刻度滚动 + 和页面内容联动

     坐标怎么来的：
       弧线是一段圆弧，圆心在面板右侧某处，弧顶（最左那一点）落在
       竖直正中。半径 R 由「面板高度」和「想凸出多少」反推：
           R = ((H/2)² + bulge²) / (2·bulge)
       于是弧上任意高度 y 的横坐标是 x(y) = cx - √(R² - (y-cy)²)。

     位置参数 t（0~1）是「在这条轴的时间范围里的相对位置」；
       屏幕上纵坐标 = H/2 + (t - cur) · V
       其中 cur 是弧顶对应的参数，V 是整条轴的像素长度。
       滚轮滚的就是 cur —— 刻度、事件、时间段一起动。

     比例尺（面板底部那根横尺）改的是 V：
       一刻度固定 26px，整条轴 V = 26 × 总天数 ÷ 一刻度多少天。
       所以「一刻度 = 一天」时 V 很大（放得开），「一刻度 = 一年」时 V 很小
       （缩到能一眼看完）。缩放以**弧顶那天**为轴心 —— 改 V 不动 cur，
       当前日期就钉在弧顶上，前后的事件向两边散开或收拢。
     ============================================================ */
  const KEY = 'tl-open-id';

  /** 弧顶比两端向左凸出多少（px） */
  const BULGE = 30;
  /** 弧顶在面板里横向的位置（占面板宽度的比例）：右边留出给右侧标签的余地 */
  const APEX_RATIO = 0.62;
  /** 刻度线长度（从弧上朝外画） */
  const TICK = 7;
  /** 刻度间隔（px，沿轴） */
  const TICK_STEP = 26;

  /** 比例尺的两个端点：最左一刻度 = 一天，最右一刻度 = 一年 */
  const SCALE_MIN_DAYS = 1;
  const SCALE_MAX_DAYS = 365;
  /** 打开时的默认位置：正中间 */
  const SCALE_MID = 0.5;
  /**
   * 存滑块位置用的 key。内容和开合状态一样要带上是「哪条时间轴」：
   * 翻到用别的轴（或没有轴）的页面时，这份记录就对不上了，自然回到默认；
   * 但只要还在用同一条轴的页面上，**不管面板开过还是关过**，位置都留着。
   */
  const SCALE_KEY = 'tl-scale';

  /**
   * 同一侧、在轴上相距不到这么多像素的两个时间点，算「挤在一起」，合并成一个塔吊。
   *
   * 为什么按像素而不是按天：一条轴的时间跨度可能是一年，也可能是十年，
   * 「差两天」在一年轴上是 7px（糊成一团），在十年轴上却是看不见的。
   * 真正决定读不读得出来的是屏幕上的距离，所以判据就用屏幕距离。
   * 一天的日期天然是 0px，必然合并 —— 这正是「同一天要合成一个」那条要求。
   *
   * 取 22 而不是更大：事件名字号 0.8rem，行高约 15px，所以两点相隔 22px 以上
   * 文字就不会叠；再往大放会把本来分得开的邻居也吸进来（比如相隔 29px 的
   * 「虹星开服」和「桑芙加入」，它们是读得清的，不该并）。
   */
  const MERGE_GAP = 22;

  /** 合并后组内相邻两条文字上下错开多少像素（「旁边稍微上下间隔」） */
  const LABEL_GAP = 18;

  /** 文字（事件名、时间段名）离弧线让开多少像素 —— 和 .tl__name 的 40px 对齐 */
  const SPAN_GAP = 40;

  /**
   * 一组合并事件。
   *
   * 一组共用**组头**那个点的弧上位置（anchor），组内每个成员只有一个
   * 上下偏移量 off —— 图标画在组头那儿，其余成员的图标藏起来，
   * 文字按 off 排开。这样既只有「一个塔吊」，两条事件又都看得见。
   */
  type ItemGroup = { anchor: HTMLElement; members: HTMLElement[]; off: number[] };

  for (const root of document.querySelectorAll<HTMLElement>('[data-tl]')) {
    const panel = root.querySelector<HTMLElement>('[data-tl-panel]');
    const body = root.querySelector<HTMLElement>('[data-tl-body]');
    const arcPath = root.querySelector<SVGPathElement>('[data-tl-arc]');
    const rulerPath = root.querySelector<SVGPathElement>('[data-tl-ruler]');
    const tab = root.querySelector<HTMLButtonElement>('[data-tl-toggle]');
    const nowBox = root.querySelector<HTMLElement>('[data-tl-now]');
    const nowDate = root.querySelector<HTMLElement>('[data-tl-nowdate]');
    if (!panel || !body || !arcPath || !rulerPath || !tab) continue;

    const tlId = root.dataset.tlId ?? '';
    const dayMin = Number(root.dataset.tlMin) || 0;
    const dayMax = Number(root.dataset.tlMax) || 1;
    /** 这条轴一共跨多少天（带 padding 的完整范围）；比例尺算 V 要用 */
    const totalDays = Math.max(1e-6, dayMax - dayMin);

    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-tl-item]'));
    const bands = Array.from(root.querySelectorAll<SVGPathElement>('[data-tl-band]'));
    const spanNames = Array.from(root.querySelectorAll<HTMLElement>('[data-tl-spanName]'));

    /**
     * 打开时弧顶停在哪儿。
     *
     * 页面认领了时间点/时间段就停在那儿（data-tl-default 有值）；
     * 没认领（属性是空的）就停在**这条轴的最开头** —— 于是最早那几件事正好
     * 落在弧顶下方，往下滚就是顺着时间往前走。
     *
     * 这里不直接 Number()：Number('') 是 0、Number(undefined) 是 NaN，
     * 两个都表示「没值」的输入会走到两条完全不同的分支上，写明白更稳。
     */
    const defAttr = root.dataset.tlDefault;
    let cur = defAttr === undefined || defAttr === '' ? 0 : Number(defAttr);
    // 实在解析不出来（属性被写坏了）也得给个能用的值，
    // 免得打开之前那一次 paint 拿 NaN 去算坐标
    if (!Number.isFinite(cur)) cur = 0.5;

    let open = false;
    /* 几何：每次重排时算一次 */
    let H = 0;
    let apexX = 0;
    let R = 1;
    let cx = 0;
    let cy = 0;
    let V = 0;

    /* ---------------- 比例尺（面板底部那根横尺） ---------------- */

    /**
     * 滑块位置（0~1）→ 一刻度代表多少天。
     *
     * 用**等比**插值（也就是「先取对数，再线性插值」），不是直接线性。
     * 直接线性的话，一天 → 一年这条行程里，前 10% 就走完了所有看得出
     * 区别的档位，剩下 90% 全是「什么都糊成一团」；等比插值下，滑块每走
     * 同样一格，比例尺乘同样的倍数 —— 这才是比例尺该有的手感，
     * 也是从一天到一年这段处处都用得上的唯一分法。
     * 两端仍然是用户要的那两个点：最左一天一格，最右一年一格，中间连续无级。
     */
    const daysPerTick = (s: number) => {
      const t = Math.max(0, Math.min(1, s));
      return SCALE_MIN_DAYS * Math.pow(SCALE_MAX_DAYS / SCALE_MIN_DAYS, t);
    };

    /** 一刻度多少天 → 给人看的读数 */
    const scaleText = (s: number) => {
      const d = daysPerTick(s);
      return d < 10 ? `1 格 ≈ ${d.toFixed(1)} 天` : `1 格 ≈ ${Math.round(d)} 天`;
    };

    /*
      从 sessionStorage 里捞上一次拖到的位置。
      记录里带着「是哪条时间轴」，对不上就当没存过 —— 于是换了一条轴（或
      进了没挂轴的页面）会回到默认的正中间；还在同一条轴的页面上时，
      不管面板开过还是关过，位置都还在。
    */
    let scale = SCALE_MID;
    try {
      const raw = sessionStorage.getItem(SCALE_KEY);
      if (raw) {
        const saved = JSON.parse(raw) as { id?: string; v?: number };
        if (saved && saved.id === tlId && Number.isFinite(saved.v)) {
          scale = Math.max(0, Math.min(1, saved.v as number));
        }
      }
    } catch {
      /* 私密模式等场景下不可用，忽略 */
    }

    const rail = root.querySelector<HTMLElement>('[data-tl-rail]');
    const knob = root.querySelector<HTMLElement>('[data-tl-knob]');
    const scaleVal = root.querySelector<HTMLElement>('[data-tl-scaleval]');
    /** 正在拖滑块的指针 id（没有就是 null） */
    let scaleDrag: number | null = null;

    /** 只刷滑块的外观和读数，不重排 */
    function paintScale() {
      rail?.style.setProperty('--p', String(scale));
      if (scaleVal) scaleVal.textContent = scaleText(scale);
      if (knob) {
        knob.setAttribute('aria-valuenow', String(Math.round(scale * 100)));
        knob.setAttribute('aria-valuetext', scaleText(scale));
      }
    }

    function rememberScale() {
      try {
        sessionStorage.setItem(SCALE_KEY, JSON.stringify({ id: tlId, v: scale }));
      } catch {
        /* 忽略 */
      }
    }

    /**
     * 改比例尺。
     * 缩放以弧顶那天为轴心：只重算 V（每刻度多少像素），不动 cur ——
     * 于是「当前日期」还钉在弧顶上，前后的事件向两边散开或收拢。
     */
    function setScale(v: number, save = true) {
      scale = Math.max(0, Math.min(1, v));
      paintScale();
      measure();
      paint();
      if (save) rememberScale();
    }

    /* 合并结果：每次 measure 之后重算一次 */
    let groups: ItemGroup[] = [];
    /** 每个成员 → 所在组的组头（用来决定它画在哪儿） */
    const anchorOf = new Map<HTMLElement, HTMLElement>();
    /** 每个成员 → 组内上下偏移 */
    const offsetOf = new Map<HTMLElement, number>();

    /**
     * 把时间点按「同一侧 + 轴上离得太近」聚成组。
     *
     * 只合并**同一侧**的：左右两侧本来就是两条历法（比如花娅历 / 冰室历），
     * 同一天各挂一个事件时，两个塔吊是朝相反方向长的，文字也各在一边，
     * 根本不会打架 —— 合成一个反而把「这天两边都发生了事」这层意思弄丢了。
     * 真正会糊在一起的是同一侧挨着的几个，所以只处理它们。
     *
     * 判据从组里**上一个**成员算（链式）：三个点两两相距 20px 时，
     * 首尾相差 40px 其实已经拉开了，但它们中间那个仍然和谁都挤，
     * 所以还是一起并掉更清楚。
     */
    function groupItems() {
      groups = [];
      anchorOf.clear();
      offsetOf.clear();

      for (const side of ['left', 'right']) {
        const list = items
          .filter((el) => (el.dataset.side === 'left' ? 'left' : 'right') === side)
          .map((el) => ({ el, t: Number(el.dataset.param) }))
          .filter((o) => Number.isFinite(o.t))
          .sort((a, b) => a.t - b.t);

        let run: { el: HTMLElement; t: number }[] = [];
        const flush = () => {
          if (!run.length) return;
          const n = run.length;
          groups.push({
            anchor: run[0].el,
            members: run.map((o) => o.el),
            // 以组头那点为中轴，整组文字上下对称排开：早的在上、晚的在下
            off: run.map((_, i) => (i - (n - 1) / 2) * LABEL_GAP),
          });
          run = [];
        };

        let lastT = Number.NEGATIVE_INFINITY;
        for (const o of list) {
          if (run.length && (o.t - lastT) * V > MERGE_GAP) flush();
          run.push(o);
          lastT = o.t;
        }
        flush();
      }

      for (const g of groups) {
        g.members.forEach((el, i) => {
          anchorOf.set(el, g.anchor);
          offsetOf.set(el, g.off[i]);
        });
      }
    }

    /** 弧上高度 y 处的横坐标 */
    const arcX = (y: number) => {
      const d = Math.abs(y - cy);
      const inside = R * R - d * d;
      return cx - Math.sqrt(inside > 0 ? inside : 0);
    };

    function measure() {
      H = body!.clientHeight;
      if (!H) return;
      const W = body!.clientWidth;
      apexX = W * APEX_RATIO;
      cy = H / 2;
      // 由「凸出量」和「半高」反推半径（推导见文件头）
      R = ((H / 2) * (H / 2) + BULGE * BULGE) / (2 * BULGE);
      cx = apexX + R;

      /*
        整条轴的像素长度完全由底部的比例尺决定：
          刻度固定 26px 一个，整条轴一共 V/26 个刻度，
          每个刻度代表 daysPerTick 天，乘起来要等于这条轴的总天数。
        于是「一刻度 = 一天」时 V 大得能铺开好几十屏，「一刻度 = 一年」时
        整个范围缩进几百像素、一眼看完。两种极端都不会算坏：弧线、刻度尺
        都是按「一屏对应多少参数」现推的，V 多大都自己适配。
      */
      V = Math.max(1, (TICK_STEP * totalDays) / daysPerTick(scale));

      // V 定了才能按屏幕距离判断谁和谁挤在一起，所以分组放在最后
      groupItems();
    }

    /**
     * 一段圆弧的 path。
     *
     * 采样点数是按**屏幕像素**定的（每 26px 一个点），不能写死：
     * 比例尺拉到「一天一格」时整条轴有好几千像素，固定 20 个点的话
     * 一屏里只落得下两三个点，弧线就成折线了；拉到「一年一格」时
     * 反过来，固定点数又全浪费在屏幕外面。上下都留个保险：
     * 至少 8 个点，最多 200 个（26px 一个点，弦切误差远小于一个像素）。
     */
    function arcD(t0: number, t1: number) {
      const n = Math.max(8, Math.min(200, Math.ceil((Math.abs(t1 - t0) * V) / 26)));
      let d = '';
      for (let i = 0; i <= n; i++) {
        const t = t0 + (t1 - t0) * (i / n);
        const y = H / 2 + (t - cur) * V;
        const x = arcX(y);
        d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
      }
      return d;
    }

    function paint() {
      if (!H) return;

      // 主弧线：盖住整屏还多一截，滚到两头也不会露出断口
      const over = (H * 0.6) / V;
      arcPath!.setAttribute('d', arcD(-over, 1 + over));

      /*
        刻度：等参数间距铺满整屏。滚轮滚的是 cur，刻度跟着一起走 ——
        所以这条尺子永远在动，看起来就像在量一条很长的带子。
      */
      let d = '';
      const stepT = TICK_STEP / V;
      const first = Math.floor((cur - H / 2 / V) / stepT) * stepT;
      for (let t = first; t <= cur + H / 2 / V + stepT; t += stepT) {
        const y = H / 2 + (t - cur) * V;
        if (y < -TICK || y > H + TICK) continue;
        const x = arcX(y);
        const nx = (x - cx) / R;
        const ny = (y - cy) / R;
        d += `M${x.toFixed(1)} ${y.toFixed(1)}L${(x + nx * TICK).toFixed(1)} ${(y + ny * TICK).toFixed(1)}`;
      }
      rulerPath!.setAttribute('d', d);

      // 时间段的带子：沿弧线走一段
      for (const el of bands) {
        const id = el.dataset.tlBand;
        const host = root.querySelector<HTMLElement>(`[data-tl-spanName="${id}"]`);
        const t0 = Number(host?.dataset.tlFrom ?? 'NaN');
        const t1 = Number(host?.dataset.tlTo ?? 'NaN');
        el.setAttribute('d', Number.isFinite(t0) && Number.isFinite(t1) ? arcD(t0, t1) : '');
      }

      /*
        事件：摆到弧上去，塔吊顺着半径朝外长。
        合并过的点共用组头的位置 —— 组里只有组头画塔吊，其余成员把图标藏起来、
        文字按 off 上下错开，于是「一个刻度上一个塔吊，旁边上下排着几行事件」。
      */
      for (const el of items) {
        const host = anchorOf.get(el) ?? el;
        const isAnchor = host === el;
        const t = Number(host.dataset.param);
        const y = H / 2 + (t - cur) * V;
        // 离屏太远就不摆（省得堆一堆看不见的元素）；整组用同一个 y，一起进一起出
        if (y < -80 || y > H + 80) {
          el.style.visibility = 'hidden';
          continue;
        }
        el.style.visibility = '';
        const x = arcX(y);
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;

        // 组内偏移：文字和它自己的悬停日期卡一起挪，免得指到哪条都对不上
        const off = offsetOf.get(el) ?? 0;
        const name = el.querySelector<HTMLElement>('.tl__name');
        if (name) name.style.transform = `translateY(calc(-50% + ${off}px))`;
        const tip = el.querySelector<HTMLElement>('.tl__tip');
        if (tip) tip.style.transform = `translate(-50%, -140%) translateY(${off}px)`;

        const crane = el.querySelector<HTMLElement>('.tl__crane');
        if (crane) {
          // 一组只留组头那一个塔吊
          crane.style.display = isAnchor ? '' : 'none';
          if (!isAnchor) continue;
          // 向外的径向单位向量（弧顶处指向正左）
          const nx = (x - cx) / R;
          const ny = (y - cy) / R;
          // 左侧的塔吊朝外（=径向），右侧的朝里（=反向）
          const rot =
            el.dataset.side === 'right' ? Math.atan2(-nx, ny) : Math.atan2(nx, -ny);
          crane.style.transform = `rotate(${rot}rad)`;
        }
      }

      /*
        时间段名字摆在带子中点。
        但缩到「一刻度 = 一年」那种程度时，整条轴才十几像素高，所有事件文字
        会叠成一摞，年代名很容易正好落进那一摞里 —— 两串字会连成一句读。
        所以这里让它找位：本侧这一行空着就照常摆；占了就翻到轴的另一侧
        （另一侧一般空着，名字照样贴着那条带子）；再不行才在本侧上下挪。
        位置算出来以后 left 用的是**挪完那个高度**在弧上的横坐标，
        所以名字始终落在弧线上，不会飘出去。
      */
      const HALF_TEXT = 8;
      const takenBySide: Record<string, Array<[number, number]>> = { left: [], right: [] };
      for (const g of groups) {
        const el = g.anchor;
        const y = Number.parseFloat(el.style.top);
        if (el.style.visibility === 'hidden' || !Number.isFinite(y)) continue;
        const half = ((g.members.length - 1) / 2) * LABEL_GAP + HALF_TEXT;
        (el.dataset.side === 'left' ? takenBySide.left : takenBySide.right).push([y - half, y + half]);
      }
      /*
        弧顶那个「当前日期」也算一行的占用：它就在轴左边贴着弧顶，
        时间段名翻到左侧时正撞在它身上（会读成「2022-12-30冰室元年」）。
      */
      if (nowBox) takenBySide.left.push([H / 2 - HALF_TEXT - 1, H / 2 + HALF_TEXT + 1]);
      const isFree = (side: string, y: number) =>
        !takenBySide[side].some((b) => y + HALF_TEXT > b[0] && y - HALF_TEXT < b[1]);
      const claim = (side: string, y: number) => takenBySide[side].push([y - HALF_TEXT, y + HALF_TEXT]);

      for (const el of spanNames) {
        const t0 = Number(el.dataset.tlFrom ?? 'NaN');
        const t1 = Number(el.dataset.tlTo ?? 'NaN');
        if (!Number.isFinite(t0) || !Number.isFinite(t1)) {
          el.style.visibility = 'hidden';
          continue;
        }
        const mid = (t0 + t1) / 2;
        let y = H / 2 + (mid - cur) * V;
        if (y < -40 || y > H + 40) {
          el.style.visibility = 'hidden';
          continue;
        }
        el.style.visibility = '';

        // 这条带子原本挂在哪一侧（翻过侧也要记住，下次从原侧重新算）
        const remembered = el.dataset.tlSide;
        const own: string =
          remembered === 'left' || remembered === 'right'
            ? remembered
            : el.dataset.side === 'left'
              ? 'left'
              : 'right';
        el.dataset.tlSide = own;
        let side = own;
        if (!isFree(own, y)) {
          const other = own === 'left' ? 'right' : 'left';
          const spots: Array<[string, number]> = [
            [other, y],
            [own, y + 16],
            [own, y - 16],
            [other, y + 16],
            [other, y - 16],
            [own, y + 32],
            [own, y - 32],
          ];
          const hit = spots.find(([s, yy]) => isFree(s, yy));
          if (hit) {
            side = hit[0];
            y = hit[1];
          }
        }
        claim(side, y);
        el.dataset.side = side;
        /*
          贴着弧线往两边让开 SPAN_GAP。右侧那列直接写 left；
          左侧那列写 left 再 translateX(-100%) 把文字右对齐过去 ——
          因为名字多长只有浏览器知道，用 right 会和行内 left 打架。
        */
        const x = arcX(y);
        if (side === 'right') {
          el.style.left = `${x + SPAN_GAP}px`;
          el.style.transform = 'translateY(-50%)';
        } else {
          el.style.left = `${x - SPAN_GAP}px`;
          el.style.transform = 'translate(-100%, -50%)';
        }
        el.style.top = `${y}px`;
      }

      // 弧顶那个点 + 当前日期
      if (nowBox) {
        nowBox.style.left = `${arcX(H / 2)}px`;
        nowBox.style.top = `${H / 2}px`;
      }
      if (nowDate) {
        const day = dayMin + cur * (dayMax - dayMin);
        const dt = new Date(Math.round(day) * 86400000);
        const p = (n: number) => String(n).padStart(2, '0');
        nowDate.textContent = `${dt.getUTCFullYear()}-${p(dt.getUTCMonth() + 1)}-${p(dt.getUTCDate())}`;
      }
    }

    /* ---------------- 和页面内容联动 ---------------- */

    /*
      页面上认领了时间点/时间段的成分都带 data-tl-param。
      取「最靠近视口中线」的那个，把弧顶挪过去 ——
      于是滚到某段文字/某个视频，轴就停在那一点。
    */
    const marked = Array.from(document.querySelectorAll<HTMLElement>('[data-tl-param]'));
    let activeEl: HTMLElement | null = null;

    function syncFromPage() {
      if (!open || !marked.length) return;
      const mid = window.innerHeight / 2;
      let best: HTMLElement | null = null;
      let bestD = Infinity;
      for (const el of marked) {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) continue;
        const d = Math.abs((r.top + r.bottom) / 2 - mid);
        if (d < bestD) {
          bestD = d;
          best = el;
        }
      }
      if (!best || best === activeEl) return;
      activeEl = best;
      const t = Number(best.dataset.tlParam);
      if (Number.isFinite(t)) {
        cur = t;
        paint();
      }
    }

    if (marked.length) {
      window.addEventListener('scroll', syncFromPage, { passive: true });
      window.addEventListener('resize', syncFromPage);
    }

    /* ---------------- 开合 ---------------- */

    function remember(on: boolean) {
      try {
        if (on) sessionStorage.setItem(KEY, tlId);
        else if (sessionStorage.getItem(KEY) === tlId) sessionStorage.removeItem(KEY);
      } catch {
        /* 私密模式等场景下不可用，忽略 */
      }
    }

    function setOpen(on: boolean, focus = true) {
      open = on;
      root.classList.toggle('is-open', on);
      panel!.hidden = !on;
      tab!.setAttribute('aria-expanded', on ? 'true' : 'false');
      remember(on);
      if (on) {
        // 面板刚显示出来才有尺寸，这时候才量得准
        measure();
        // 页面指定了默认位置就听页面的；没指定就用上面算好的 cur
        const def = Number(defAttr);
        if (Number.isFinite(def) && defAttr !== '' && defAttr !== undefined) cur = def;
        else if (!Number.isFinite(cur)) cur = 0.5;
        if (marked.length) {
          const mid = window.innerHeight / 2;
          let best: HTMLElement | null = null;
          let bestD = Infinity;
          for (const el of marked) {
            const r = el.getBoundingClientRect();
            const d = Math.abs((r.top + r.bottom) / 2 - mid);
            if (d < bestD) {
              bestD = d;
              best = el;
            }
          }
          const t = Number(best?.dataset.tlParam);
          if (best && Number.isFinite(t)) cur = t;
          activeEl = best;
        }
        paint();
        if (focus) panel!.focus?.();
      }
    }

    tab.addEventListener('click', () => setOpen(true));
    root.querySelector<HTMLButtonElement>('[data-tl-close]')?.addEventListener('click', () =>
      setOpen(false, false)
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) setOpen(false, false);
    });

    /* 滚轮滚刻度：面板里滚，页面不动 */
    body.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        /*
          滚多大一截，刻度就走多大一截：deltaY 是像素，除 V 换成参数。
          往上滚（deltaY 为负）→ 参数变小 → 看到更早的事件，
          同时事件整体往下走，和平时滚页面一个方向感。
        */
        cur = Math.max(0, Math.min(1, cur + e.deltaY / V));
        paint();
      },
      { passive: false }
    );

    // 拖也能滚：手机上没滚轮
    let drag: { id: number; y: number; cur: number } | null = null;
    body.addEventListener('pointerdown', (e) => {
      drag = { id: e.pointerId, y: e.clientY, cur };
      body.setPointerCapture(e.pointerId);
    });
    body.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      cur = Math.max(0, Math.min(1, drag.cur + (drag.y - e.clientY) / V));
      paint();
    });
    const endDrag = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      drag = null;
      try {
        body.releasePointerCapture(e.pointerId);
      } catch {
        /* 指针没了，忽略 */
      }
    };
    body.addEventListener('pointerup', endDrag);
    body.addEventListener('pointercancel', endDrag);

    /*
      比例尺：按在尺子上（或那颗塔吊上）横着拖。
      点哪儿就跳到哪儿，再接着拖 —— 和普通滑块一个手感。
      它不在 .tl__body 里，所以和上面那套「拖了滚刻度」不会打架。
    */
    if (rail && knob) {
      /** 手指/鼠标落在尺子宽度的百分之几上 */
      const fromPointer = (e: PointerEvent) => {
        const r = rail.getBoundingClientRect();
        if (!r.width) return;
        setScale((e.clientX - r.left) / r.width, false);
      };

      rail.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        scaleDrag = e.pointerId;
        rail.setPointerCapture(e.pointerId);
        fromPointer(e);
      });
      rail.addEventListener('pointermove', (e) => {
        if (scaleDrag !== e.pointerId) return;
        fromPointer(e);
      });
      const endScaleDrag = (e: PointerEvent) => {
        if (scaleDrag !== e.pointerId) return;
        scaleDrag = null;
        try {
          rail.releasePointerCapture(e.pointerId);
        } catch {
          /* 指针没了，忽略 */
        }
        // 松手才落盘：拖的过程中每帧都写一次 sessionStorage 没必要
        rememberScale();
      };
      rail.addEventListener('pointerup', endScaleDrag);
      rail.addEventListener('pointercancel', endScaleDrag);

      // 键盘也得能用（它是个 role=slider）；按住 Shift 步子大一点
      knob.addEventListener('keydown', (e: KeyboardEvent) => {
        const step = e.shiftKey ? 0.1 : 0.02;
        if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
          e.preventDefault();
          setScale(scale - step);
        } else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
          e.preventDefault();
          setScale(scale + step);
        } else if (e.key === 'Home') {
          e.preventDefault();
          setScale(0);
        } else if (e.key === 'End') {
          e.preventDefault();
          setScale(1);
        }
      });
    }

    /*
      进页面时要不要开着：看 sessionStorage 里记的是不是**这一条**时间轴。
      连着翻几个用同一条轴的页面，它就一直开着；
      换成别的轴（或没有轴的页面）自然就是关的。
      （比例尺的位置在 setScale/rememberScale 里单独记，开关面板不影响它。）
    */
    let recall = false;
    try {
      recall = sessionStorage.getItem(KEY) === tlId;
    } catch {
      recall = false;
    }

    paintScale();
    measure();
    setOpen(recall, false);
    if (!recall) paint(); // 关着也先排一次，打开时不用等

    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(() => {
        measure();
        paint();
      }).observe(body);
    }
  }
</script>
