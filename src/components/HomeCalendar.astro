---
/**
 * 首页的日历（挂在「甬城晴雨」下面）。
 *
 * 用户要的样子：最常见的月历，显示**当前这个月**和今天；每天是一个
 * **粉色带栅格的圆**（和地图图钉一个味道）加数字；有事件的那天换成
 * 蒸汽波日落橙黄、点得进对应页面；右下角一个小框写今天：
 * 没特殊日子就写「今天依然是等待篠雨的一天」，有就写「今天是xxx的生日」。
 *
 * 两个刻意的做法：
 *   1. **"今天"和"当前月"一律在浏览器里算**。站点是静态的，构建那天算出来的
 *      "今天"过两天就错了。所以日历格子由页面里那段脚本生成，构建期只把
 *      事件表（日期 -> 名字/链接）塞进去。
 *   2. 事件表来自 src/data/home-widgets.json，编辑器「日历」面板直接改它。
 *      事件里的 href 留空也没关系 —— 那天照样变色，只是点不动。
 */
import widgets from '../data/home-widgets.json';
import { withBase } from '../utils/url';

interface CalEvent {
  title?: string;
  href?: string;
  text?: string;
}
const cal = (widgets.calendar ?? {}) as {
  title?: string;
  idleText?: string;
  specialText?: string;
  events?: Record<string, CalEvent>;
};
const events = cal.events ?? {};
---

<section class="cal" id="home-cal" data-cal aria-labelledby="cal-title">
  <header class="cal__head">
    <h3 class="cal__title" id="cal-title">{cal.title || '日历'}</h3>
    <div class="cal__nav">
      <button class="cal__btn" type="button" data-cal-prev aria-label="上个月">‹</button>
      <span class="cal__month" data-cal-month></span>
      <button class="cal__btn" type="button" data-cal-next aria-label="下个月">›</button>
    </div>
  </header>

  <div class="cal__week" aria-hidden="true">
    {['一', '二', '三', '四', '五', '六', '日'].map((w) => <span class="cal__wd">{w}</span>)}
  </div>

  <div class="cal__grid" data-cal-grid role="grid" aria-label="月历"></div>

  {
    /*
      右下角那个小框：脚本会把今天的文案写进去（无特殊日子就用 idleText）。
      构建期先按今天渲染一遍，免得 JS 没跑到时是个空框。
    */
  }
  <p class="cal__today" data-cal-today>
    {cal.idleText || '今天依然是等待篠雨的一天'}
  </p>

  <script
    type="application/json"
    id="cal-data"
    set:html={JSON.stringify({
      events,
      idleText: cal.idleText || '今天依然是等待篠雨的一天',
      specialText: cal.specialText || '今天是{title}',
      base: withBase('/'),
    })}
  />
</section>

<script>
  /* ============================================================
     月历：格子全在浏览器里生成（"今天"和"当前月"必须按访问者的表算）
     ============================================================ */
  type CalEvent = { title?: string; href?: string; text?: string };
  const root = document.querySelector<HTMLElement>('[data-cal]');
  const dataEl = document.getElementById('cal-data');
  if (root && dataEl) {
    const cfg = JSON.parse(dataEl.textContent || '{}') as {
      events: Record<string, CalEvent>;
      idleText: string;
      specialText: string;
      base: string;
    };
    const grid = root.querySelector<HTMLElement>('[data-cal-grid]');
    const monthLab = root.querySelector<HTMLElement>('[data-cal-month]');
    const todayBox = root.querySelector<HTMLElement>('[data-cal-today]');

    /** 本地日期 -> YYYY-MM-DD（不能用 toISOString：那是 UTC，晚上会差一天） */
    const ymd = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    const now = new Date();
    let year = now.getFullYear();
    let month = now.getMonth(); // 0-11
    const todayKey = ymd(now);

    /*
      事件表按**月-日**匹配，年份不参与判断 —— 这就是编辑器「日历」面板里那句提示
      （「写 2024-06-04 就是每年的 6 月 4 日都会变色（不看年份）」）承诺的行为。

      ⚠ 以前这里是拿「当前年份 + 月日」去 events 里查**完整日期**，于是
      用户按"生日"填的 2004-07-14、2003-08-30 这些永远查不到 ——
      页面上那一天永远不变色（用户就是因此说"特殊日期的图标没有发生变化"）。
      现在建一张「月-日 → 事件」的表：同一天有好几条时，优先取"正好写的是今年"的那条。
    */
    const mdOf = (key: string) => String(key).slice(5); // YYYY-MM-DD -> MM-DD
    const byMd = new Map<string, { key: string; ev: CalEvent; exact: boolean }>();
    for (const [key, ev] of Object.entries(cfg.events)) {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(key)) continue;
      const md = mdOf(key);
      const exact = key.startsWith(`${now.getFullYear()}-`);
      const prev = byMd.get(md);
      if (!prev || (exact && !prev.exact)) byMd.set(md, { key, ev, exact });
    }
    /** 这一天有没有特殊日子（按 MM-DD 查） */
    const eventOn = (key: string) => byMd.get(mdOf(key)) ?? null;

    const paint = () => {
      if (!grid) return;
      const first = new Date(year, month, 1);
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      // 周一当第一列（getDay(): 0=周日），所以偏移量要 +6 再取模
      const lead = (first.getDay() + 6) % 7;

      const cells: string[] = [];
      for (let i = 0; i < lead; i++) cells.push('<span class="cal__pad"></span>');
      for (let day = 1; day <= daysInMonth; day++) {
        const key = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const hit = eventOn(key);
        const ev = hit?.ev;
        const isToday = key === todayKey;
        const cls = ['cal__day'];
        if (ev) cls.push('cal__day--event');
        if (isToday) cls.push('cal__day--today');
        const num = `<span class="cal__num">${day}</span>`;
        /*
          悬停/聚焦时弹的那句话（自绘的卡片，不是浏览器那个白底 title）。
          写法按用户要求：
            · 普通日  -> 就写这一天（2026-09-21）
            · 特殊日  -> 「{事件名} {填的那个日期}」，例如「桑芙的生日 2003-08-30」
          ⚠ **不要再把后端那串原样端出来**（以前是「2026-08-30 桑芙的生日（填的是 2003-08-30）」，
          又长又像 debug 输出；用户原话：「太赤裸太丑了」）。
        */
        const label = ev?.title ? (hit && hit.key !== key ? `${ev.title} ${hit.key}` : ev.title) : key;
        const tip = `<span class="cal__tip" aria-hidden="true">${label}</span>`;
        cells.push(
          ev?.href
            ? `<a class="${cls.join(' ')}" href="${ev.href}" aria-label="${label}">${num}${tip}</a>`
            : `<span class="${cls.join(' ')}" aria-label="${label}">${num}${tip}</span>`
        );
      }
      grid.innerHTML = cells.join('');
      if (monthLab) monthLab.textContent = `${year} 年 ${month + 1} 月`;

      if (todayBox) {
        const hit = eventOn(todayKey);
        const ev = hit?.ev;
        todayBox.textContent = ev
          ? (ev.text || cfg.specialText.replace('{title}', ev.title || ''))
          : cfg.idleText;
        todayBox.classList.toggle('cal__today--event', !!ev);
      }
    };

    root.querySelector('[data-cal-prev]')?.addEventListener('click', () => {
      month--;
      if (month < 0) ((month = 11), year--);
      paint();
    });
    root.querySelector('[data-cal-next]')?.addEventListener('click', () => {
      month++;
      if (month > 11) ((month = 0), year++);
      paint();
    });

    paint();
  }
</script>

<style>
  /*
    这一块要"比较扁"（用户要求：日历和甬城晴雨一样宽、但扁）：
    卡片宽度翻了一倍多，如果格子还按 aspect-ratio:1 随宽度长，整块会变成
    452×450 的方块。所以格子的直径改成按**屏幕宽度**给一个小值
    （--cal-cell，桌面 26px 上下），一行 6 个格子加起来才是这块的高度。
    卡片本身 height:100% 撑满格子 —— 于是"冰室冰山/每日精华和日历一样高"
    这件事是网格自己保证的，不靠写死数值。
  */
  .cal {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    /*
      图钉"头"的宽度。整枚图钉 = 头 + 下面 5px 的尖头，所以一排的高度是
      `--cal-cell + 5px`（行高 auto，由图钉自己撑）。
      ⚠ 固定 20px，不随卡片宽度长：卡片宽度是"和甬城晴雨一样宽"（452），
      图钉再跟着宽度长的话整块会变成大方块，一点不"扁"。
    */
    --cal-cell: 20px;
    /*
      下边距 2.75rem 是**给右下角那个小框留的位**：小框高约 28px、离底 0.65rem(10.4px)，
      两者加起来 38.4px —— 下边距小于它，最后一排格子就会压到小框上
      （实测踩过：2.1rem 时网格底边比小框顶边低 6px）。
    */
    padding: 0.55rem 0.7rem 2.75rem;
    border: 1px solid rgba(255, 120, 190, 0.4);
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(38, 6, 54, 0.86), rgba(20, 3, 32, 0.9));
    box-shadow: 0 14px 40px -22px rgb(0 0 0 / 0.8);
    backdrop-filter: blur(4px);
  }

  .cal__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
  }
  .cal__title {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.14em;
    color: #ffd9ef;
  }
  .cal__nav {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .cal__btn {
    width: 1.4rem;
    height: 1.4rem;
    padding: 0;
    border: 1px solid rgba(255, 120, 190, 0.45);
    border-radius: 8px;
    background: rgba(24, 3, 36, 0.85);
    color: #ffd9ef;
    font: inherit;
    line-height: 1;
    cursor: pointer;
  }
  .cal__btn:hover {
    background: rgba(255, 79, 163, 0.22);
    color: #fff;
  }
  .cal__month {
    min-width: 5.6em;
    text-align: center;
    font-size: 0.8rem;
    color: rgba(255, 226, 244, 0.8);
    font-variant-numeric: tabular-nums;
  }

  .cal__week,
  .cal__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.2rem 0.25rem;
  }
  .cal__week {
    flex: none;
  }
  /*
    行高交给图钉（`auto` 也行，但这里**写死 6 行**）：
    一个月最多跨 6 个星期，可 5 行的月份占的地方少一截 ——
    而这一行的高度是和「冰室冰山 / 每日精华」共用的，于是翻到 8 月（6 行）
    整排卡片一起长高、翻回 9 月又缩回去（用户实测到的）。
    把 6 行的高度**先占住**，翻月时这一屏一个像素都不动。
  */
  .cal__grid {
    flex: 0 1 auto;
    grid-template-rows: repeat(6, var(--cal-cell));
    grid-auto-rows: var(--cal-cell);
    margin-top: 0.2rem;
    min-height: 0;
  }
  .cal__wd {
    text-align: center;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    /* ⚠ 这块卡是深色底，别用浅色主题的 var(--c-text-faint)（那是深琥珀，压在这儿只有 2.3:1） */
    color: rgba(255, 226, 244, 0.6);
  }

  /*
    悬停那句话（自绘）：**照抄时间轴那块提示卡的皮**
    （.tl__tip：深紫底 + 粉边 + 粉字 + 7px 圆角），
    这样站上鼠标时弹出来的是"网页的一部分"，而不是浏览器那个白底 title。
    用户原话：「鼠标指针指到特殊日期和普通日期 都像时间轴一样弹出一个
    符合整体网页UI风格的日期 不要像现在这样是白板」。
  */
  :global(.cal__tip) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    transform: translateX(-50%);
    z-index: 6;
    padding: 0.2rem 0.55rem;
    border-radius: 7px;
    border: 1px solid rgba(255, 120, 190, 0.6);
    background: rgba(24, 3, 36, 0.96);
    color: #ffd9ef;
    font-size: 0.76rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.14s ease, visibility 0.14s ease;
  }
  /*
    ⚠ 这两条要整条写进 :global()。
    `.cal__tip` 和 `.cal__day` 一样是**脚本拼出来的**，身上没有 data-astro-cid-*；
    写成 `:global(.cal__day:hover) .cal__tip` 的话后半截仍然被作用域加上属性选择器，
    一个都命不中 —— 表现就是"卡片有、皮也对，但怎么指都不出来"（这一轮真踩到了）。
  */
  :global(.cal__day:hover .cal__tip),
  :global(.cal__day:focus-visible .cal__tip) {
    opacity: 1;
    visibility: visible;
  }
  :global(.cal__day--event .cal__tip) {
    border-color: rgba(255, 180, 70, 0.7);
    color: #ffe9c0;
  }
  /* 鼠标指到哪一格，那一格浮在上面（提示卡别被旁边的格子压住） */
  :global(.cal__day:hover),
  :global(.cal__day:focus-visible) {
    z-index: 5;
  }

  /*
    ⚠ 下面这些「一天」的样式必须写成 :global()。
    格子是**页面脚本**生成的（grid.innerHTML），生成出来的元素身上没有
    Astro 的 data-astro-cid-* 作用域属性，写成普通选择器一个都命不中 ——
    页面不报错，只是日历变成一堆没样式的数字（这个坑本站踩过一次）。

    一天 = 一枚小图钉的"头"，画法和**地图里的图钉完全一套**（用户要求：
    「把普通日期的样子改成地图里建筑图钉的样子 特殊日期改成区域图钉的样子」）：
      普通日  建筑图钉：粉色渐变 + 横向格栅的**方头**（border-radius 8px）
      特殊日  区域图钉：落日橙黄渐变 + **圆头**（border-radius 50%）
    数字写在"头"里（地图那边头里画的是一台塔吊）。
    ⚠ 用户后来要求**去掉向下的小尖头**，所以现在没有 ::after 那个三角了 ——
    一天就是一个 20×20 的头。
  */
  :global(.cal__day),
  :global(.cal__pad) {
    position: relative;
    /* --cal-cell 就是这一格的大小（宽 = 高） */
    width: var(--cal-cell);
    height: var(--cal-cell);
    justify-self: center;
    align-self: center;
    transition: transform 0.12s ease, filter 0.12s ease;
  }
  /* 头 */
  :global(.cal__day)::before {
    content: '';
    position: absolute;
    inset: 0;
    /* 建筑图钉那套粉（和 PageContent.astro 里 .pmap__pinArt::before 一模一样） */
    background: linear-gradient(180deg, #ffd9ef 0%, #ff9ad5 34%, #ff4fa3 68%, #a80058 100%);
    border-radius: 8px;
    /* 横向格栅：也是地图图钉头上那套 */
    -webkit-mask: repeating-linear-gradient(180deg, #000 0 2px, transparent 2px 3.2px);
    mask: repeating-linear-gradient(180deg, #000 0 2px, transparent 2px 3.2px);
  }
  /* 普通日：粉色那点投影（地图里建筑图钉也是这个） */
  :global(.cal__day) {
    --cal-shadow: drop-shadow(0 2px 5px rgba(255, 40, 130, 0.55));
    filter: var(--cal-shadow);
  }
  :global(.cal__day:hover) {
    transform: translateY(-2px);
  }

  /* 数字：写在"头"里，居中 */
  :global(.cal__num) {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--cal-cell);
    height: var(--cal-cell);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: #fff;
    text-shadow: 0 0 6px rgba(140, 0, 70, 0.9);
  }

  /* 今天：外面套一圈落日黄的光（不是描边圈 —— 头上有 mask，box-shadow 会被裁掉） */
  :global(.cal__day--today) {
    --cal-shadow: drop-shadow(0 2px 5px rgba(255, 40, 130, 0.55)) drop-shadow(0 0 4px #ffd447);
  }

  /*
    特殊日子 = 区域图钉：圆头 + 落日橙黄（粉→橙→黄）。
    这条要写在 .cal__day 那些规则**后面**（同特异性，靠顺序覆盖）。
  */
  :global(.cal__day--event)::before {
    background: linear-gradient(180deg, #fff2b8 0%, #ffd447 32%, #ff9d2e 66%, #e04a08 100%);
    border-radius: 50%;
  }
  :global(.cal__day--event) {
    --cal-shadow: drop-shadow(0 2px 5px rgba(255, 150, 40, 0.6));
  }
  :global(.cal__day--event.cal__day--today) {
    --cal-shadow: drop-shadow(0 2px 5px rgba(255, 150, 40, 0.6)) drop-shadow(0 0 4px #ffd447);
  }
  /* 特殊日子上的数字：黄底上用深色（不然白字压黄底几乎看不见） */
  :global(.cal__day--event .cal__num) {
    color: #4a1200;
    font-weight: 700;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.45);
  }

  /* 右下角那个小框 */
  .cal__today {
    position: absolute;
    right: 0.7rem;
    bottom: 0.65rem;
    max-width: calc(100% - 1.4rem);
    margin: 0;
    padding: 0.25rem 0.6rem;
    border: 1px solid rgba(255, 120, 190, 0.45);
    border-radius: 9px;
    background: rgba(24, 3, 36, 0.9);
    color: rgba(255, 226, 244, 0.9);
    font-size: 0.76rem;
    line-height: 1.5;
    text-align: right;
  }
  .cal__today--event {
    border-color: rgba(255, 212, 71, 0.8);
    color: #ffe9a8;
  }
</style>
