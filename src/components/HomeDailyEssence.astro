    margin: 0;
  }
  .daily__title {
    font-size: 1rem;
    letter-spacing: 0.14em;
    color: #ffd9ef;
    text-decoration: none;
    border-bottom: 1px dotted rgba(255, 120, 190, 0.6);
  }
  .daily__title:hover {
    color: #fff;
    border-bottom-color: #ff4fa3;
  }
  .daily__more {
    font-size: 0.76rem;
    /* 深色底：浅色主题那套令牌在这儿看不清（2.34:1） */
    color: rgba(255, 226, 244, 0.6);
    text-decoration: none;
  }
  .daily__more:hover {
    color: #ffb3dd;
  }

  /* ---------- 两个按钮（随机精华 / 回到每日精华） ----------
     这块卡片很窄（1440 下 190px、900 下只有 150px），两个带字的按钮在窄屏上必然
     换到第二行 —— 所以尺寸按"两行也尽量矮"来给：字号 0.7rem、上下 padding 各 0.1rem。 */
  .daily__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0 0 0.25rem;
    flex: none;
  }
  .daily__acts[hidden] {
    display: none;
  }
  /*
    ⚠ 这一条不能省：`.daily__act` 里写了 `display: inline-flex`，**作者样式压过浏览器
    自带的 `[hidden] { display: none }`** —— 只设 `btnBack.hidden = true` 的话按钮照样显示
    （用户就是这么发现的：「今天的每日精华上方还是有回到每日精华按钮」）。
    `.daily__acts[hidden]` 只保住了外面那一排，里头的按钮得自己再来一条。
  */
  .daily__act[hidden] {
    display: none;
  }
  .daily__act {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.1rem 0.45rem 0.1rem 0.35rem;
    font: inherit;
    font-size: 0.7rem;
    line-height: 1.35;
    letter-spacing: 0.03em;
    color: #ffd9ef;
