  /*
    ⚠ 卡片内部的样式一律 :global()：这块内容在"访问者当天 ≠ 构建那天"时
    会被页面脚本整段重写（card.innerHTML），重写出来的元素没有 Astro 的
    data-astro-cid-* 作用域属性 —— 写成普通选择器的话，第二天打开首页
    会看到一条**没样式**的精华（这个坑本站踩过一次，见 HOME 日历那边）。
  */
  :global(.daily__card) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
    min-height: 0;
    /* 卡片只有这一格这么高：内容一律在这块里裁掉，不许撑破卡片 */
    overflow: hidden;
    padding: 0.55rem 0.7rem 0.65rem;
    border: 1px solid rgba(255, 120, 190, 0.3);
    border-radius: 12px;
    background: rgba(12, 2, 20, 0.5);
    /* 整张卡是个链接（点它跳到精华页里这一条）：别带下划线、别换字色 */
    text-decoration: none;
    color: inherit;
    transition: border-color 0.14s ease, background 0.14s ease;
  }
  /*
    底下那道渐隐：这一格是定高的，长内容会被裁 —— 得让人看得出"还有"，
    而不是以为这条精华就这么多字（全文在悬停浮层里）。
  */
  :global(.daily__card)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 24px;
    background: linear-gradient(180deg, rgba(12, 2, 20, 0), rgba(12, 2, 20, 0.88));
    pointer-events: none;
  }
  /* 能点：指上去亮一下（和站里别的卡片一个手感） */
  :global(a.daily__card:hover),
  :global(a.daily__card:focus-visible) {
    border-color: rgba(255, 120, 190, 0.75);
    background: rgba(24, 3, 36, 0.72);
  }
  :global(a.daily__card:focus-visible) {
    outline: 2px solid rgba(255, 120, 190, 0.75);
    outline-offset: 2px;
  }
  :global(.daily__who) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84rem;
    flex: none;
  }
  /* 多个成员：头像叠着排（完美对话那种一条好几个人的） */
  :global(.daily__faces) {
    display: inline-flex;
    align-items: center;
    flex: none;
  }
  :global(.daily__face) {
    display: inline-flex;
    flex: none;
  }
  :global(.daily__face + .daily__face) {
    margin-left: -7px;
  }
  :global(.daily__avatar) {
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 120, 190, 0.5);
    background: rgba(24, 3, 36, 0.9);
  }
  :global(.daily__avatar--none) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffb3dd;
    font-size: 0.76rem;
  }
  :global(.daily__name) {
    color: #fff;
  }
  /*
    ⚠ 这张卡是**深色底**，文字不能再走浅色主题那套令牌：
    实测 var(--c-text) 压在这块底上只有 1.35:1（深琥珀压深紫，几乎看不见）、
    var(--c-text-faint) 2.34:1。这里逐个换成深色底上的颜色。
  */
  :global(.daily__time) {
    margin-left: auto;
    color: rgba(255, 226, 244, 0.6);
    font-variant-numeric: tabular-nums;
  }
  :global(.daily__text) {
    margin: 0;
    color: rgba(255, 236, 248, 0.9);
    font-size: 0.86rem;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
    /* 首页这一格高度是定死的：文字按行数裁，剩下的空间留给图片；全文看悬停浮层 */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 0 1 auto;
  }
  /*
    图片弹性吃掉剩下的高度（`flex: 1 1 60px` + `min-height: 0`）：
    卡片高就多显示一点，矮就少一点，但**永远不许把卡片撑高**。
  */
  :global(.daily__pic) {
    display: block;
    width: 100%;
    flex: 1 1 60px;
    min-height: 0;
    max-height: 150px;
    border: 1px solid rgba(255, 120, 190, 0.35);
    border-radius: 10px;
    object-fit: cover;
  }

  /* ==========================================================================
     悬停浮层：全文 + 全部图片（2026-10-06）
     --------------------------------------------------------------------------
     摆在这一格的**上方**、右对齐；`bottom: calc(100% - 12px)` 让它和卡片重叠 12px ——
     这样鼠标从卡片往上挪进浮层时不会经过一段"谁都不属于"的空隙（那样浮层会一闪就没了）。
     `absolute` 而不是 `fixed`：跟着卡片走，滚动也自然跟着（固定定位还得自己算位置）。
     ========================================================================== */
  .daily__pop {
    position: absolute;
    right: 0;
    bottom: calc(100% - 12px);
    z-index: 8;
    width: min(460px, calc(100vw - 2rem));
    max-height: min(72vh, 620px);
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0.8rem 0.95rem 0.9rem;
    border: 1px solid rgba(255, 120, 190, 0.55);
    border-radius: 14px;
    background: rgba(20, 3, 32, 0.985);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.45) inset,
      0 24px 60px -22px rgb(0 0 0 / 0.95);
    color: rgba(255, 236, 248, 0.92);
    font-size: 0.86rem;
    line-height: 1.7;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) scale(0.985);
    transform-origin: 100% 100%;
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  /*
    上面放不下时翻到卡片下面（`.is-below` 由脚本按实际空间加）。
    ⚠ 这一条必须写在下面那条 `:hover` 之前：两条权重相同（0-2-0），
    写在后面的话会把"打开时 transform: none"压掉，浮层就永远偏着。
  */
  .daily__pop.is-below {
    top: calc(100% - 12px);
    bottom: auto;
    transform-origin: 100% 0;
  }
  .dailyWrap:hover .daily__pop,
  .dailyWrap:focus-within .daily__pop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }
  :global(.daily__popHead) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84rem;
    margin-bottom: 0.45rem;
  }
  :global(.daily__popText) {
    white-space: pre-wrap;
    word-break: break-word;
  }
  :global(.daily__popPics) {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  /* 移到图上 → 视口正中浮出大图（见下面 .dailyZoom） */
  :global(.daily__popPic) {
    display: block;
    width: 100%;
    border: 1px solid rgba(255, 120, 190, 0.35);
    border-radius: 10px;
    cursor: zoom-in;
  }
  :global(.daily__popLink) {
    display: inline-block;
    margin-top: 0.7rem;
    color: #ffb3dd;
    font-size: 0.8rem;
    text-decoration: none;
    border-bottom: 1px dotted rgba(255, 120, 190, 0.6);
  }
  :global(.daily__popLink:hover) {
    color: #fff;
    border-bottom-color: #ff4fa3;
  }

  /* 窄屏：卡片是整幅宽，浮层跟着左右铺满 */
  @media (max-width: 760px) {
    /*
      ⚠ 窄屏必须把"内容绝对定位"这条**取消掉**（2026-10-06 踩到）：
      手机上三张卡是**各占一行**的（单列），谁也不挨着谁 —— 本来就顶不高日历和冰山。
      而内容一旦绝对定位，帧就没有固有高度了，它一个人一行 → 这一行高度成了 0，
      卡片被压成 2px（random-essence-check 在手机那一段量到的就是这个：
      「卡片 342×2」）。所以窄屏回到"按内容自然高度"。
    */
    .daily__box {
      position: static;
    }
    .daily__pop {
      left: 0;
      right: 0;
      width: auto;
      max-height: 62vh;
    }
  }
</style>

<style is:global>
  /*
    放大预览层。放在 <body> 上（JS 建的），所以这一条得是全局样式。
    `pointer-events: none` 是关键：它只是给你看一眼，不能接鼠标 ——
