  }

  /* ---------- 两个按钮（随机精华 / 回到每日精华） ----------
     这块卡片很窄（1440 下 190px、900 下只有 150px），两个带字的按钮在窄屏上必然
     换到第二行 —— 所以尺寸按"两行也尽量矮"来给：字号 0.7rem、上下 padding 各 0.1rem。 */
  .daily__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.22rem;
    margin: 0 0 0.08rem;
    flex: none;
  }
  .daily__acts[hidden] {
    display: none;
  }
  /*
    ⚠ 这一条不能省：`.daily__act` 里写了 `display: inline-flex`，**作者样式压过浏览器
    自带的 `[hidden] { display: none }`** —— 只设 `btnBack.hidden = true` 的话按钮照样显示
    （用户就是这么发现的：「今天的每日精华上方还是有回到每日精华按钮」）。
    `.daily__acts[hidden]` 只保住了外面那一排，里头的按钮得自己再来一条。
  */
  .daily__act[hidden] {
    display: none;
  }
  .daily__act {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.1rem 0.45rem 0.1rem 0.35rem;
    font: inherit;
    font-size: 0.7rem;
    line-height: 1.35;
    letter-spacing: 0.03em;
    color: #ffd9ef;
    cursor: pointer;
    border: 1px solid rgba(255, 120, 190, 0.45);
    border-radius: 999px;
    background: rgba(24, 3, 36, 0.72);
    transition: border-color 0.14s ease, background 0.14s ease, color 0.14s ease;
  }
  .daily__act:hover,
  .daily__act:focus-visible {
    color: #fff;
    border-color: rgba(255, 120, 190, 0.85);
    background: rgba(46, 8, 70, 0.85);
  }
  .daily__act:focus-visible {
    outline: 2px solid rgba(255, 120, 190, 0.75);
    outline-offset: 2px;
  }
  .daily__actIcon {
    width: 0.95em;
    height: 0.95em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /*
    ⚠ 卡片内部的样式一律 :global()：这块内容在"访问者当天 ≠ 构建那天"时
    会被页面脚本整段重写（card.innerHTML），重写出来的元素没有 Astro 的
    data-astro-cid-* 作用域属性 —— 写成普通选择器的话，第二天打开首页
    会看到一条**没样式**的精华（这个坑本站踩过一次，见 HOME 日历那边）。
  */
  :global(.daily__card) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    /*
      按内容长高，不硬撑满这一栏：
        原文是 `flex: 1`，短句的时候卡片照样拉满整栏，框里剩一大片空白
        （站长 2026-11-20 圈出来的就是那块）。
      现在 `flex: 0 1 auto` + `max-height: 100%`：
        · 短句 → 卡片就矮，框贴着字；
        · 长句 → 一直长到这一栏的高度为止，再多才由 line-clamp 收尾。
    */
    flex: 1 1 auto;
    max-height: 100%;
    min-height: 0;
    /* 卡片只有这一格这么高：内容一律在这块里裁掉，不许撑破卡片 */
    overflow: hidden;
    padding: 0.4rem 0.55rem 0.46rem;
    border: 1px solid rgba(255, 120, 190, 0.3);
    border-radius: 12px;
    background: rgba(12, 2, 20, 0.5);
    /* 整张卡是个链接（点它跳到精华页里这一条）：别带下划线、别换字色 */
    text-decoration: none;
    color: inherit;
    transition: border-color 0.14s ease, background 0.14s ease;
  }
  /*
    底下那道渐隐：这一格是定高的，长内容会被裁 —— 得让人看得出"还有"，
    而不是以为这条精华就这么多字（全文在悬停浮层里）。
  */
  :global(.daily__card)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 14px;
    background: linear-gradient(180deg, rgba(12, 2, 20, 0), rgba(12, 2, 20, 0.9));
    pointer-events: none;
  }
  /*
    圣经那张卡不要这道渐隐（2026-11-21）：它的正文和评语都按**整行**收（见 `fitComment`），
    永远不会有被切掉半截的字；留着渐隐只会把最后一整行字压暗（站长看到的就是"字在框边上发黑"）。
    截断由 clamp 自带的省略号表示。
  */
  :global(.daily__col--bible .daily__card)::after {
    content: none;
  }
  /* 能点：指上去亮一下（和站里别的卡片一个手感） */
  :global(a.daily__card:hover),
  :global(a.daily__card:focus-visible) {
    border-color: rgba(255, 120, 190, 0.75);
    background: rgba(24, 3, 36, 0.72);
  }
  :global(a.daily__card:focus-visible) {
    outline: 2px solid rgba(255, 120, 190, 0.75);
    outline-offset: 2px;
  }
  :global(.daily__who) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    flex: none;
  }
  /* 多个成员：头像叠着排（完美对话那种一条好几个人的） */
  :global(.daily__faces) {
    display: inline-flex;
    align-items: center;
    flex: none;
  }
  :global(.daily__face) {
    display: inline-flex;
    flex: none;
  }
  :global(.daily__face + .daily__face) {
    margin-left: -7px;
  }
  :global(.daily__avatar) {
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 120, 190, 0.5);
    background: rgba(24, 3, 36, 0.9);
  }
  :global(.daily__avatar--none) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffb3dd;
    font-size: 0.76rem;
  }
  :global(.daily__name) {
    color: #fff;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /*
    ⚠ 这张卡是**深色底**，文字不能再走浅色主题那套令牌：
    实测 var(--c-text) 压在这块底上只有 1.35:1（深琥珀压深紫，几乎看不见）、
    var(--c-text-faint) 2.34:1。这里逐个换成深色底上的颜色。
  */
  :global(.daily__time) {
    flex: none;
    margin-left: auto;
    color: rgba(255, 226, 244, 0.6);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }
  :global(.daily__text) {
    margin: 0;
    /*
      `flex: 1 1 auto` + `overflow: hidden`、**不写 min-height: 0**：
      短句时它自己撑满剩下的高度（框里不留空），长句时按内容长、超出卡片的部分由卡片裁掉。
      上一版写了 min-height: 0，正文会被压成 0 高、字溢到整个卡片外面（实测过）。
    */
    flex: 1 1 auto;
    overflow: hidden;
    color: rgba(255, 236, 248, 0.9);
    font-size: 0.85rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
    /* 首页这一格高度是定死的：文字按行数裁，剩下的空间留给图片；全文看悬停浮层 */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 0 1 auto;
  }
  /*
    图片弹性吃掉剩下的高度（`flex: 1 1 60px` + `min-height: 0`）：
    卡片高就多显示一点，矮就少一点，但**永远不许把卡片撑高**。
  */
  /*
    评语（只圣经卡有）：铃忆每天写的吐槽评析。小字 + 斜体，压在正文下面 ——
    站长原话：「评语是lingyibot的AI每天对其的吐槽评析 应用小的斜体写在下方部分」。
  */
  :global(.daily__comment) {
    margin: 0;
    flex: none;
    color: rgba(255, 226, 244, 0.72);
    font-size: 0.72rem;
    font-style: italic;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /*
    圣经那一栏和左边每日精华**同一个模子**：头像、成员名、时间的字号和间距一律不单独改，
    两栏的题头因此逐像素对齐、完全一样大 —— 站长 2026-11-21：
    「保证每日圣经的成员头像成员名时间等固定信息和每日精华的对齐且完全一样大」。
    一张卡里要多装一段评语，只在这两段的**行数**上安排：
      · 正文固定两行（字号和左边一样，行高也一样）；
      · 评语把剩下的地方**铺满** —— 行数由脚本按分到的高度算（见 `fitComment`），
        写死行数会在高的窗口里留下一片空、在矮的窗口里把一行字切成半截。
  */
  :global(.daily__col--bible .daily__text) {
    -webkit-line-clamp: 2;
    /*
      正文**不许被压扁**：这张卡比左边那张多一段评语，字号又和左边一样大，
      矮一点的窗口里 flex 会把它压缩到只剩 2~4px（实测 1000×760 下就是这样）。
      固定按两行给，压不下的部分交给卡片底部的渐隐收尾（全文在悬停浮层里）。
    */
    flex: none;
  }
  :global(.daily__col--bible .daily__comment) {
    font-size: 0.66rem;
    line-height: 1.4;
    /* 没跑脚本时的退路：两行；脚本会按实际空间改成整行数 */
    -webkit-line-clamp: 2;
    /*
      ⚠ 千万别写成 `flex: 1 1 0`（2026-11-21 踩过）：高度一旦被 flex 定死，
      `-webkit-line-clamp` 就不起作用了，只剩 `overflow: hidden` 硬切 —— 卡片底边会露出半截字。
      行数由脚本按空间算（`fitComment`），元素本身按内容高度排。
    */
    flex: none;
  }
  /*
    ⚠ 上面那条写了 `display: -webkit-box`，会压过浏览器自带的 `[hidden] { display: none }`
    —— 脚本判断"一行都放不下"时把评语收起来，得靠这一条才真的收得掉。
  */
  :global(.daily__col--bible .daily__comment[hidden]) {
    display: none;
  }
  /* 浮层里那份评语：不截断，字体还是小一号的斜体 */
  :global(.daily__popComment) {
    margin: 0.5rem 0 0;
    color: rgba(255, 226, 244, 0.75);
    font-size: 0.8rem;
    font-style: italic;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
  }
  :global(.daily__pic) {
    display: block;
    width: 100%;
    flex: 1 1 60px;
    min-height: 0;
    max-height: 150px;
    border: 1px solid rgba(255, 120, 190, 0.35);
    border-radius: 10px;
    object-fit: cover;
  }

  /* ==========================================================================
     悬停浮层：全文 + 全部图片（2026-10-06）
     --------------------------------------------------------------------------
     摆在这一格的**上方**、右对齐；`bottom: calc(100% - 12px)` 让它和卡片重叠 12px ——
     这样鼠标从卡片往上挪进浮层时不会经过一段"谁都不属于"的空隙（那样浮层会一闪就没了）。
     `absolute` 而不是 `fixed`：跟着卡片走，滚动也自然跟着（固定定位还得自己算位置）。
     ========================================================================== */
  .daily__pop {
    position: absolute;
    right: 0;
    bottom: calc(100% - 12px);
    z-index: 8;
    width: min(460px, calc(100vw - 2rem));
    max-height: min(72vh, 620px);
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0.8rem 0.95rem 0.9rem;
    border: 1px solid rgba(255, 120, 190, 0.55);
    border-radius: 14px;
    background: rgba(20, 3, 32, 0.985);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.45) inset,
      0 24px 60px -22px rgb(0 0 0 / 0.95);
    color: rgba(255, 236, 248, 0.92);
    font-size: 0.86rem;
    line-height: 1.7;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) scale(0.985);
    transform-origin: 100% 100%;
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  /*
    上面放不下时翻到卡片下面（`.is-below` 由脚本按实际空间加）。
    ⚠ 这一条必须写在下面那条 `:hover` 之前：两条权重相同（0-2-0），
    写在后面的话会把"打开时 transform: none"压掉，浮层就永远偏着。
  */
  .daily__pop.is-below {
    top: calc(100% - 12px);
    bottom: auto;
    transform-origin: 100% 0;
  }
  /*
    两栏各有一份浮层，指针在哪一栏就只浮那一栏的。
    **不用 :has()**：Astro 会给 scoped 选择器逐段加 `data-astro-cid`，
    `:has(.daily__col--bible:hover)` 这种写法被改写后不一定命中（实测没浮出来），
    所以改成脚本在这一层打一个 `data-pop` 标记（见文件末尾那段）。
  */
  .dailyWrap[data-pop='essence'] .daily__pop--essence,
  .dailyWrap[data-pop='bible'] .daily__pop--bible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }
  :global(.daily__popHead) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84rem;
    margin-bottom: 0.45rem;
  }
  :global(.daily__popText) {
    white-space: pre-wrap;
    word-break: break-word;
  }
  :global(.daily__popPics) {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  /* 移到图上 → 视口正中浮出大图（见下面 .dailyZoom） */
  :global(.daily__popPic) {
    display: block;
    width: 100%;
    border: 1px solid rgba(255, 120, 190, 0.35);
    border-radius: 10px;
    cursor: zoom-in;
  }
  :global(.daily__popLink) {
    display: inline-block;
    margin-top: 0.7rem;
    color: #ffb3dd;
    font-size: 0.8rem;
    text-decoration: none;
    border-bottom: 1px dotted rgba(255, 120, 190, 0.6);
  }
  :global(.daily__popLink:hover) {
    color: #fff;
    border-bottom-color: #ff4fa3;
  }

  /* 窄屏：卡片是整幅宽，浮层跟着左右铺满 */
  @media (max-width: 760px) {
    /*
      ⚠ 窄屏必须把"内容绝对定位"这条**取消掉**（2026-10-06 踩到）：
      手机上三张卡是**各占一行**的（单列），谁也不挨着谁 —— 本来就顶不高日历和冰山。
      而内容一旦绝对定位，帧就没有固有高度了，它一个人一行 → 这一行高度成了 0，
      卡片被压成 2px（random-essence-check 在手机那一段量到的就是这个：
      「卡片 342×2」）。所以窄屏回到"按内容自然高度"。
    */
    .daily__box {
      position: static;
    }
    .daily__pop {
      left: 0;
      right: 0;
      width: auto;
      max-height: 62vh;
    }
  }
</style>

<style is:global>
  /*
    放大预览层。放在 <body> 上（JS 建的），所以这一条得是全局样式。
    `pointer-events: none` 是关键：它只是给你看一眼，不能接鼠标 ——
    否则鼠标一移进去，图片的 :hover 就断了，大图立刻消失。
  */
  .dailyZoom {
    position: fixed;
    inset: 0;
    z-index: 9995;
    display: grid;
    place-items: center;
    padding: 1rem;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.16s ease, visibility 0.16s;
  }
  .dailyZoom.is-on {
    opacity: 1;
    visibility: visible;
  }
  .dailyZoom img {
    max-width: min(900px, 92vw);
    max-height: min(86vh, 900px);
    object-fit: contain;
    border: 1px solid rgba(255, 120, 190, 0.6);
    border-radius: 12px;
    background: rgba(12, 2, 20, 0.98);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.5) inset,
      0 26px 70px -20px rgb(0 0 0 / 0.95);
  }
</style>

<script>
  /*
    首页右栏那条「每日圣经」 —— 和左边「每日精华」一个模子：
      · 按**访问者当天**挑一条（构建期先渲一份，客户端拿 /bellie.json 再挑一次，
        同一天固定、隔天自动换，不用重新构建）；
      · ⟳ 随机圣经 / ← 回到每日圣经 两个按钮（拿不到清单就一直藏着，
        宁可没有，也不给一个点了没反应的按钮）；
      · 浮层和精华那份并列，指针在哪一栏就浮哪一栏（CSS 读 `data-pop` 标记）。

    和精华唯一的差别：一条圣经分**正文 + 评语**两段，评语小字斜体压在下面
    （站长 2026-11-20：「一张圣经卡片应分为正文和评语两个部分」）。

    ⚠ 这里只有 <script>，没有 export：Astro 会把这段打进页面。
  */
  import { dailyIndex, localDateKey } from '../utils/daily';
  import { withBase } from '../utils/url';

  type Person = { name: string; avatar: string };
  type Item = {
    id: string;
    member: string;
    avatar: string;
    members?: Person[];
    date: string;
    time: string;
    text: string;
    comment: string;
  };

  const root = document.querySelector<HTMLElement>('[data-daily]');
  const card = root?.querySelector<HTMLElement>('[data-bible-card]');
  const pop = root?.querySelector<HTMLElement>('[data-bible-pop]');
  const acts = root?.querySelector<HTMLElement>('[data-bible-acts]');
  const btnRandom = root?.querySelector<HTMLButtonElement>('[data-bible-random]');
  const btnBack = root?.querySelector<HTMLButtonElement>('[data-bible-back]');
  const built = root?.dataset.built || '';

  if (root && card && acts && btnRandom && btnBack) {
    const esc = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const escAttr = (s: string) => esc(s).replace(/"/g, '&quot;');

    const facesOf = (people: Person[]) =>
      people.length
        ? people
            .map((p) =>
              p.avatar
                ? `<span class="daily__face" title="${escAttr(p.name)}"><img class="daily__avatar" src="${escAttr(p.avatar)}" alt="" loading="lazy" decoding="async"></span>`
                : `<span class="daily__face" title="${escAttr(p.name)}"><span class="daily__avatar daily__avatar--none" aria-hidden="true">${esc(p.name.slice(0, 1))}</span></span>`
            )
            .join('')
        : '<span class="daily__face"><span class="daily__avatar daily__avatar--none" aria-hidden="true">群</span></span>';

    const peopleOf = (pick: Item): Person[] =>
      pick.members?.length ? pick.members : [{ name: pick.member, avatar: pick.avatar || '' }];

    const whenOf = (pick: Item) => `${esc(pick.date)}${pick.time ? ' ' + esc(pick.time) : ''}`;

    const bodyOf = (pick: Item) =>
      `<div class="daily__who"><span class="daily__faces">${facesOf(peopleOf(pick))}</span>` +
      `<b class="daily__name">${esc(pick.member)}</b><time class="daily__time">${whenOf(pick)}</time></div>` +
      `<blockquote class="daily__text">${esc(pick.text)}</blockquote>` +
      (pick.comment ? `<p class="daily__comment">${esc(pick.comment)}</p>` : '');

    const popOf = (pick: Item) =>
      `<header class="daily__popHead"><span class="daily__faces">${facesOf(peopleOf(pick))}</span>` +
      `<b class="daily__name">${esc(pick.member)}</b>` +
      `<time class="daily__time">${whenOf(pick)}</time></header>` +
      `<div class="daily__popText">${esc(pick.text)}</div>` +
      (pick.comment ? `<div class="daily__popComment">${esc(pick.comment)}</div>` : '') +
      `<a class="daily__popLink" href="${withBase('/bellie/')}#${escAttr(pick.id)}">去圣经页看这一条 ›</a>`;

    let list: Item[] | null = null;
    let dailyId = '';
    let curId = card.getAttribute('href')?.split('#')[1] || '';
    const dailyOf = (items: Item[]) => items[dailyIndex(localDateKey(), items.length)];

    const bibleCard = root.querySelector<HTMLElement>('.daily__col--bible .daily__card');

    /*
      评语要铺满卡片剩下的地方（站长 2026-11-21：
      「评语下面还有很多空白空间 完全不需要收 保证正文占一半评语占一半即可 一样尽量占满」）。
      `-webkit-line-clamp` 只认整行数，所以这里量一次：评语**真正露得出来**的高度能放几整行。
        · 不能按"评语盒子有多高"直接算：盒子是 flex 分到的高度，卡片一旦装不下，
          盒子会伸到卡片外面去，按它算就会多算一行，最后一行被卡片底边切成半截
          （站长 2026-11-21 圈出来的那半行字）。所以取「盒子高」和「卡片内边界到盒子上沿」
          两个里小的那个。
        · 写死行数也不行：窗口一高就留下一片空白，窗口一矮就切字。
        · 一行都放不下时整条收起（样式里有 `[hidden]` 那条配合），不留半截字。
    */
    const fitComment = () => {
      const body = root?.querySelector<HTMLElement>('.daily__col--bible .daily__text') ?? null;
      const note = root?.querySelector<HTMLElement>('.daily__col--bible .daily__comment') ?? null;
      if (!note || !bibleCard) return;
      const cs = getComputedStyle(bibleCard);
      const innerBottom =
        bibleCard.getBoundingClientRect().bottom -
        (parseFloat(cs.paddingBottom) || 0) -
        (parseFloat(cs.borderBottomWidth) || 0);
      const gap = parseFloat(cs.rowGap) || 0;
      const bodyTop = body ? body.getBoundingClientRect().top : innerBottom;
      /* 正文 + 那条缝 + 评语，一共能占多高（上沿由题头决定，所以这个数准） */
      const space = innerBottom - bodyTop;
      const lhN = parseFloat(getComputedStyle(note).lineHeight) || 15;
      const lhB = body ? parseFloat(getComputedStyle(body).lineHeight) || 20 : 0;

      /*
        正文 2/3、评语 1/3（站长 2026-11-21：
        「让正文可以占据2/3 而评语只能占据1/3 不要太喧宾夺主」）。
        只认整行：先按 1/3 算评语能放几整行，剩下的全给正文 —— 空间由正文吃满，评语再长也抢不过正文。
        （元素都是按内容高度排的，所以 `-webkit-line-clamp` 才真的生效；见样式里那段说明。）
      */
      const noteShare = Math.max(0, Math.floor((space / 3 + 0.5) / lhN));
      let bodyLines = Math.max(1, Math.floor((space - noteShare * lhN - gap + 0.5) / lhB));
      const noteLines = Math.min(noteShare, Math.max(0, Math.floor((space - bodyLines * lhB - gap + 0.5) / lhN)));
      if (noteLines < 1 && body) {
        /* 评语放不下就整条收起，空出来的地方全给正文 */
        bodyLines = Math.max(1, Math.floor((space + 0.5) / lhB));
      }
      if (body) body.style.webkitLineClamp = String(bodyLines);
      note.hidden = noteLines < 1;
      note.style.webkitLineClamp = String(Math.max(1, noteLines));
    };

    const paint = (pick: Item) => {
      card.innerHTML = bodyOf(pick);
      if (pop) pop.innerHTML = popOf(pick);
      card.setAttribute('href', `${withBase('/bellie/')}#${pick.id}`);
      card.setAttribute('aria-label', `跳到铃忆圣经里的这一条：${pick.member} ${pick.date}`);
      const isDaily = !!pick.id && pick.id === dailyId;
      root.dataset.bibleMode = isDaily ? 'daily' : 'random';
      btnBack.hidden = isDaily;
      fitComment();
    };

    const ensure = (): Promise<Item[]> => {
      if (list) return Promise.resolve(list);
      return fetch(withBase('/bellie.json'))
        .then((r) => (r.ok ? r.json() : null))
        .then((data: { entries?: Item[] } | null) => {
          list = data?.entries ?? [];
          /* 拿到清单才放出按钮 */
          if (list.length) {
            dailyId = dailyOf(list)?.id || '';
            acts.hidden = false;
            /* 按钮这一排放出来以后卡片变矮了，评语的行数要跟着重算 */
            fitComment();
          }
          return list;
        })
        .catch(() => []);
    };

    /* 访问者当天 ≠ 构建那天：按今天重挑一条 */
    if (built && localDateKey() !== built) {
      ensure().then((items) => {
        const pick = items.length ? dailyOf(items) : null;
        if (pick) paint(pick);
      });
    } else {
      ensure();
    }

    btnRandom.addEventListener('click', () => {
      ensure().then((items) => {
        if (!items.length) return;
        let idx = Math.floor(Math.random() * items.length);
        if (items.length > 1 && items[idx].id === curId) idx = (idx + 1) % items.length;
        const pick = items[idx];
        curId = pick.id;
        paint(pick);
      });
    });

    btnBack.addEventListener('click', () => {
      ensure().then((items) => {
        const pick = items.length ? dailyOf(items) : null;
        if (!pick) return;
        curId = pick.id;
        paint(pick);
      });
    });

    /*
      浮层开关：指针在哪一栏，就在这一层打哪个标记（CSS 读它决定浮哪一份）。
      不用 :has() 的原因见样式里那段说明。
    */
    const essenceCol = root.querySelector<HTMLElement>('.daily__col--essence');
    const bibleCol = root.querySelector<HTMLElement>('.daily__col--bible');
    const setPop = (which: string) => {
      root.dataset.pop = which;
    };
    const clearPop = () => {
      delete root.dataset.pop;
    };
    essenceCol?.addEventListener('pointerenter', () => setPop('essence'));
    bibleCol?.addEventListener('pointerenter', () => setPop('bible'));
    essenceCol?.addEventListener('focusin', () => setPop('essence'));
    bibleCol?.addEventListener('focusin', () => setPop('bible'));
    /*
      浮层什么时候收起：指针**既不在这一块里、也不在成员名片（含它上面放大的头像）上**时才收。
      为什么要放行 `.memlayer`（站长 2026-11-21）：
        浮层 / 卡片里的成员名一悬停，名片就会被搬到 `.memlayer`（挂在 body 上的 position:fixed 层）——
        它一出现，指针就"离开了这一块"。原来这里一离开就清标记，于是名片刚弹出、
        精华 / 圣经的浮层立刻没了；再往名片里那颗头像上挪，头像放大的浮层又把名片顶掉，
        一层套一层，最后什么都看不成。
        原话：「放大成员头像后不要关闭成员和精华/圣经窗口 鼠标移开头像区域后正常关闭成员头像」。
        名片和放大的头像都在 `.memlayer` 里，所以这里把那一层一起算成"还在里面"；
        指针挪到别处时下一条 pointermove 就把它收起来。
    */
    const inMemLayer = (t: Element | null) => !!(t && t.closest && t.closest('.memlayer'));
    document.addEventListener(
      'pointermove',
      (event) => {
        if (!root.dataset.pop) return;
        const t = event.target as Element | null;
        if (t && (root.contains(t) || inMemLayer(t))) return;
        clearPop();
      },
      { passive: true }
    );
    root.addEventListener('focusout', (e) => {
      if (!root.contains((e as FocusEvent).relatedTarget as Node | null)) clearPop();
    });

    /*
      评语的行数跟着卡片高度走：窗口缩放、按钮换行（「回到每日圣经」出来时会多占一行）、
      字体晚到……凡是卡片尺寸变了都得重量一次。`ResizeObserver` 一次看住全部这些情况，
      另外保留一条 resize 兜底（老浏览器没有 ResizeObserver）。`ensure()` 里放开按钮那一下也会改高度，那里再补一次。
    */
    fitComment();
    if (bibleCard && typeof ResizeObserver !== 'undefined') {
      /* 只在行数真的变了才写回，避免和观察器互相触发 */
      new ResizeObserver(() => fitComment()).observe(bibleCard);
    }
    window.addEventListener('resize', fitComment);
    /* 字体晚到会让行高量歪，等字体就绪再来一次 */
    void document.fonts?.ready.then(fitComment).catch(() => undefined);
  }
</script>
