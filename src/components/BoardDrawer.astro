---
/**
 * 右上角的三个固定控件：目录抽屉（三条杠）+ 回到顶部（塔吊图标）+ 音量（音箱）。
 *
 * 数据就是首页那两棵大板块树，所以它天然反映「当前在哪个板块」。
 * 常见文档站的目录树：点章节名跳转，点箭头展开/收起下一层。
 *
 * 音量键默认是 hidden 的，只有「这一页有歌单」时才由播放器脚本摘掉（见 MusicPlayer.astro）；
 * 没歌单的页面上那颗按钮根本不出现。
 *
 * 树是**递归**生成的，层数不设上限 —— 版块树本身能无限嵌套，
 * 早先这里手写了三层，树再深一层下面的节点就整个露不出来。
 * 递归出来的是字符串，用 set:html 塞进去，所以树那部分样式要写
 * :global()（注入的元素不带本组件的作用域标记）。
 *
 * 交互全在这个组件自己的一段小脚本里，不用任何框架 ——
 * 站里其他页面都是纯静态的，为这一个抽屉引入运行时依赖不划算。
 */
import site from '../site.config';
import { flattenBoards, visibleBoards, visibleChildren, type BoardNode } from '../utils/boards';
import { withBase } from '../utils/url';

interface Props {
  /** 当前页面路径，用来高亮位置并自动展开到它 */
  current: string;
}

const { current } = Astro.props;

const all = flattenBoards(site.homeBoards as BoardNode[]);

/** 当前路径上的所有节点 id，用来展开祖先 */
const onPath = new Set(
  all
    .filter((f) => current === f.url || current.startsWith(`${f.url}/`))
    .map((f) => f.node.id)
);

// 只把顶层大板块交给前端；子层在 HTML 里一次性铺好，用 hidden 控制显隐。
// 独立页面（standalone）不进目录树 —— 它们只能靠别处挂的链接点进去。
const boards = visibleBoards(site.homeBoards as BoardNode[]);

const urlOf = (id: string) => all.find((f) => f.node.id === id)?.url ?? '/';
/** 这一项是不是链接版块（点了跳外链，站里没有它的页面） */
const isExternal = (id: string) => all.find((f) => f.node.id === id)?.external === true;

/** 标题是用户数据，塞进 HTML 之前必须转义 */
const esc = (s: string) =>
  String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

/** 递归铺一层（返回 <li> 串） */
function renderNodes(nodes: BoardNode[]): string {
  return nodes
    .map((node) => {
      const url = urlOf(node.id);
      const ext = isExternal(node.id);
      // 子层同样滤掉独立页面（数据被手改时也不会冒出来）
      const kids = visibleChildren(node);
      const open = onPath.has(node.id);
      const caret = kids.length
        ? `<button type="button" class="tree__caret${open ? ' is-open' : ''}" data-toggle="${esc(node.id)}" aria-label="展开 ${esc(node.title)}" aria-expanded="${open}">▸</button>`
        : '<span class="tree__caret tree__caret--none" aria-hidden="true"></span>';
      // 链接版块：目录里也一样，新标签打开，别把站里的人带走
      const link =
        `<a class="tree__link" href="${ext ? esc(url) : withBase(url)}"` +
        (ext ? ' target="_blank" rel="noopener"' : '') +
        (current === url ? ' data-cur="1"' : '') +
        (open ? ' data-onpath="1"' : '') +
        `>${esc(node.title)}</a>`;
      const sub = kids.length
        ? `<ul class="tree__kids" data-kids="${esc(node.id)}"${open ? '' : ' hidden'}>${renderNodes(kids)}</ul>`
        : '';
      return `<li class="tree__item"><div class="tree__row">${caret}${link}</div>${sub}</li>`;
    })
    .join('');
}
---

<!--
  右上角两个固定控件：回到顶部 + 目录。
  套在同一个容器里，位置、间距、两个按钮的皮才好统一 ——
  分开各自 fixed 的话，改一个尺寸另一个就对不齐了。
-->
<div class="corner">
  <button type="button" class="corner__btn totop" id="totop" aria-label="回到顶部" title="回到顶部">
    <!-- 简约化的塔吊（本站的记号），不是箭头 -->
    <svg class="totop__crane" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <!-- 塔身两根主弦 + 腹杆 -->
      <path d="M8.6 20.6V7.4M11.4 20.6V7.4" />
      <path d="M8.6 12.4l2.8 3.6M11.4 12.4l-2.8 3.6M8.6 16h2.8" />
      <!-- 底座 -->
      <path d="M7 20.6h6" />
      <!-- 塔尖、横臂、两侧拉杆 -->
      <path d="M10 3.6v3.8M2 7.4h20" />
      <path d="M10 3.6 2 7.4M10 3.6l12 3.8" />
      <!-- 吊索 -->
      <path d="M18 7.4v3.6" />
      <!-- 配重（左）与吊钩（右） -->
      <rect x="2.1" y="7.5" width="2.4" height="2.6" rx="0.5" fill="currentColor" stroke="none" />
      <rect x="17.1" y="11" width="1.8" height="1.8" rx="0.4" fill="currentColor" stroke="none" />
    </svg>
  </button>

  <!--
    音量键（音箱 = 网页上最常见的那只音量图标），挨着回到顶部那颗按钮。
    默认 hidden：只有「这一页有歌单」时播放器脚本才会摘掉它 ——
    没歌单的页面上那段脚本根本不跑，这颗按钮就一直藏着。
  -->
  <div class="vol" id="music-vol" hidden>
    <button
      type="button"
      class="corner__btn vol__btn"
      id="music-vol-btn"
      aria-label="音量"
      aria-pressed="false"
      title="音量"
    >
      <svg class="vol__ico" viewBox="0 0 24 24" aria-hidden="true">
        <!-- 音箱：左边箱体 + 朝右张开的锥口 -->
        <path d="M3.3 9.5h3.1l5.3-3.8v12.6l-5.3-3.8H3.3z"></path>
        <!-- 音量弧线：越大声露得越多 -->
        <path class="vol__wave vol__wave--1" d="M15 9.6a4.3 4.3 0 0 1 0 4.8"></path>
        <path class="vol__wave vol__wave--2" d="M17.6 7.2a7.7 7.7 0 0 1 0 9.6"></path>
        <!-- 静音斜杠 -->
        <path class="vol__slash" d="M3.4 20.4 20.8 3.6"></path>
        <!--
          还没出声时（浏览器挡了自动播放 / 用户自己暂停了）右下角冒出这个 ▶，
          提示"点一下" —— 只把按钮调暗是不够的，没人知道要点它。
        -->
        <path class="vol__play" d="M15.4 15.4v6.2l5.6-3.1z"></path>
      </svg>
    </button>
    <!--
      按钮下方那一摞：音量条（悬停才出）+ 状态卡（只有"正在缓冲"时出）。
      竖着叠在一个容器里，所以两者同时出现时也不会互相压住。
    -->
    <div class="vol__pop">
      <div class="vol__panel">
        <input
          class="vol__range"
          id="music-vol-range"
          type="range"
          min="0"
          max="100"
          step="1"
          value="70"
          aria-label="音量大小"
        />
        <span class="vol__num" id="music-vol-num">70%</span>
      </div>
      <!-- 缓冲提示：播放器脚本控制 hidden；只在真的在等数据时弹出来 -->
      <div class="vol__status" id="music-status" hidden>缓冲中…</div>
    </div>
  </div>

  <button
    type="button"
    class="corner__btn drawer__toggle"
    id="drawer-toggle"
    aria-label="打开目录"
    aria-expanded="false"
    aria-controls="drawer-panel"
  >
    <span class="drawer__bars" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>
</div>

<div class="drawer__scrim" id="drawer-scrim" hidden></div>

<aside class="drawer" id="drawer-panel" hidden aria-label="目录">
  <div class="drawer__head">
    <span class="drawer__site">{site.title}</span>
    <button type="button" class="drawer__close" id="drawer-close" aria-label="关闭目录">×</button>
  </div>

  <nav class="drawer__body">
    {/* 嵌套的 ul 就是列表结构本身，不再挂 role="tree" —— 声明了 tree 却没有
        treeitem 子角色，读屏反而会念得乱七八糟 */}
    <ul class="tree" set:html={renderNodes(boards)} />
  </nav>
</aside>

<script is:inline>
  (() => {
    /*
      回到顶部。
      这里刻意不写 behavior：默认值 auto 会用元素的 scroll-behavior，
      也就是 global.css 里那条 —— 它在「减少动效」偏好下已经是 auto，
      所以不用在这儿再判断一次偏好，两边不会打架。
      放在抽屉那套逻辑之前，抽屉元素缺失时它照样能用。
    */
    const totop = document.getElementById('totop');
    if (totop) {
      totop.addEventListener('click', () => window.scrollTo({ top: 0 }));
    }

    const toggle = document.getElementById('drawer-toggle');
    const panel = document.getElementById('drawer-panel');
    const scrim = document.getElementById('drawer-scrim');
    const close = document.getElementById('drawer-close');
    if (!toggle || !panel || !scrim || !close) return;

    /*
      开合状态记在 sessionStorage 里，是为了让它扛得住跳转。
      本站是多页站点：点一次目录链接就是一次整页加载，这个组件会整个重新初始化，
      状态只放在内存里的话，翻一页就没了 —— 用户每跳一次都得重新点开。

      为什么用 sessionStorage 而不是 localStorage：
      这份状态属于「这一轮浏览」，标签页关掉就该忘掉，下次打开站点是干净的。
      两种存储都可能被浏览器策略拒绝，所以读写一律包在 try 里：
      拿不到就当没有记忆，功能照常，只是不记。
    */
    const KEY = 'drawer-open';
    const remember = (open) => {
      try {
        if (open) sessionStorage.setItem(KEY, '1');
        else sessionStorage.removeItem(KEY);
      } catch {
        /* 私密模式等场景下不可用，忽略 */
      }
    };
    const recalled = () => {
      try {
        return sessionStorage.getItem(KEY) === '1';
      } catch {
        return false;
      }
    };

    /** 只改状态和样式，不碰焦点 */
    const paint = (open) => {
      panel.hidden = !open;
      scrim.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.documentElement.classList.toggle('drawer-open', open);
    };

    const setOpen = (open, { focus = true } = {}) => {
      paint(open);
      remember(open);
      if (!focus) return;
      if (open) close.focus();
      else toggle.focus();
    };

    /*
      上一页开着，这一页就接着开着。
      这里刻意不抢焦点：页面刚加载完就把焦点丢到「关闭」按钮上，
      读屏会先念一遍「关闭目录」，键盘用户也会莫名其妙从抽屉里开始 Tab。
    */
    if (recalled()) paint(true);

    toggle.addEventListener('click', () => setOpen(panel.hidden));
    close.addEventListener('click', () => setOpen(false));
    // 点抽屉卡片以外的任何地方都关掉 —— 那块区域就是这层遮罩。
    // 遮罩盖住整屏，所以在外面点一下既关掉抽屉，也不会误触到后面的链接。
    scrim.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });

    // 展开 / 收起下一层。禁用 JS 时子层默认展开，靠 hidden 属性控制。
    panel.querySelectorAll('[data-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.toggle;
        const kids = panel.querySelector(`[data-kids="${key}"]`);
        if (!kids) return;
        const open = kids.hidden;
        kids.hidden = !open;
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.classList.toggle('is-open', open);
      });
    });

    // 进页面时把箭头方向摆正、并把当前项滚进视野
    panel.querySelectorAll('[data-toggle]').forEach((btn) => {
      const kids = panel.querySelector(`[data-kids="${btn.dataset.toggle}"]`);
      if (kids && !kids.hidden) btn.classList.add('is-open');
    });
    const here = panel.querySelector('[data-cur]');
    if (here && here.scrollIntoView) here.scrollIntoView({ block: 'center' });
  })();
</script>

<style>
  /* ---------- 右上角两个固定控件 ---------- */
  .corner {
    position: fixed;
    top: 0.85rem;
    right: clamp(0.9rem, 2.5vw, 1.8rem);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* 两个按钮共用这一套皮：一样的方角、边框、底色 */
  .corner__btn {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    padding: 0;
    border-radius: 11px;
    border: 1px solid var(--c-border-strong);
    background: var(--c-bg-raised);
    color: var(--c-text);
    cursor: pointer;
  }
  .corner__btn:hover {
    border-color: var(--c-accent);
  }

  .totop__crane {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /*
    抽屉拉开时把它藏掉：抽屉停在右边，这层 z-index 比抽屉高，
    不藏的话这个按钮会浮在抽屉面板上，和抽屉自己的关闭按钮挤在一起。
    用 visibility 而不是 display —— display:none 会让右边的目录按钮
    往右跳一格，看着像抖了一下。
    音量键同理：抽屉铺开时它也在抽屉底下，一起收掉（音乐照放）。
  */
  :global(.drawer-open) .totop,
  :global(.drawer-open) .vol {
    visibility: hidden;
  }

  /* ---------- 音量键（音箱） ---------- */
  .vol {
    position: relative;
    display: flex;
    align-items: center;
  }
  /*
    ⚠ 没有歌单的页面：播放器脚本根本不会跑（见 MusicPlayer.astro），那颗音量键就靠标记里那个
    `hidden` 一直藏着。但**作者样式里的 `display: flex` 会压过浏览器自带的
    `[hidden] { display: none }`** —— 少下面这一条的话，属性是设上了、按钮照样露在右上角，
    点下去还什么都不发生。2026-09-22 的体检（tools/checks/hidden-elements-check.mjs）
    在 /salon/、/iceberg/、/about-me/、/huaya/ 上量到的就是这个。
  */
  .vol[hidden] {
    display: none;
  }

  .vol__ico {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 两条音量弧线：默认只露一条淡淡的，音量大时两条都点亮 */
  .vol__wave {
    opacity: 0.3;
    transition: opacity var(--t-fast) var(--ease);
  }
  .vol__wave--2 {
    display: none;
  }
  .vol__btn.is-loud .vol__wave--1 {
    opacity: 1;
  }
  .vol__btn.is-loud .vol__wave--2 {
    display: block;
    opacity: 0.8;
  }

  /* 静音：弧线收掉，给它划一道 */
  .vol__slash {
    display: none;
    stroke: var(--c-accent);
    stroke-width: 1.7;
  }
  .vol__btn.is-muted .vol__wave {
    display: none;
  }
  .vol__btn.is-muted .vol__slash {
    display: block;
  }

  /* 浏览器不让自动出声时按钮会呼吸：点它一下就会响 */
  .vol__btn.is-paused {
    animation: vol-hint 2.4s ease-in-out infinite;
  }
  @keyframes vol-hint {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vol__btn.is-paused {
      animation: none;
      opacity: 0.7;
    }
  }

  /* ▶ 角标：只在还没出声时出现（实心三角，跟描边的音箱区分开） */
  .vol__play {
    display: none;
    fill: currentColor;
    stroke: none;
  }
  .vol__btn.is-paused .vol__play {
    display: block;
  }

  /*
    音量条：平时收着，鼠标移到按钮上（或键盘 tab 进来）才滑出来。
    用 visibility 而不是 display，好让 opacity 有过渡，
    收起时也不会挡住底下的东西。
  */
  /*
    按钮下面那一摞：音量条 + 缓冲状态卡，竖着排。
    整摞不接指针事件（pointer-events:none），只有音量条自己收回来 ——
    否则这块透明区域会挡住页面上的点击。
  */
  .vol__pop {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    pointer-events: none;
  }

  .vol__panel {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-bg-raised);
    box-shadow: var(--shadow-md);
    pointer-events: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.25rem);
    transition:
      opacity var(--t-fast) var(--ease),
      transform var(--t-fast) var(--ease),
      visibility var(--t-fast) linear;
  }
  .vol:hover .vol__panel,
  .vol:focus-within .vol__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* 缓冲提示：白框，音箱按钮正下方；只在等数据时出现，不接点击 */
  .vol__status {
    padding: 0.26rem 0.6rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-bg-raised);
    box-shadow: var(--shadow-md);
    color: var(--c-text-muted);
    font-size: 0.72rem;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
  }

  .vol__range {
    width: 96px;
    accent-color: var(--c-accent);
  }
  .vol__num {
    min-width: 2.4em;
    text-align: right;
    font-size: 0.72rem;
    color: var(--c-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- 三条杠按钮 ---------- */
  .drawer__bars {
    display: grid;
    gap: 4px;
    width: 19px;
  }
  .drawer__bars i {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--c-text);
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  /* 打开时变成叉 */
  :global(.drawer-open) .drawer__bars i:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  :global(.drawer-open) .drawer__bars i:nth-child(2) {
    opacity: 0;
  }
  :global(.drawer-open) .drawer__bars i:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* 深色页面（首页、板块页）上的按钮要反过来配色 */
  :global(body.is-home) .corner__btn,
  :global(body.is-board) .corner__btn {
    background: rgba(38, 4, 52, 0.72);
    border-color: rgba(255, 120, 190, 0.5);
    color: #ffd9ef;
    backdrop-filter: blur(4px);
  }
  :global(body.is-home) .drawer__bars i,
  :global(body.is-board) .drawer__bars i {
    background: #ffd9ef;
  }

  /* ---------- 遮罩 ---------- */
  .drawer__scrim {
    position: fixed;
    inset: 0;
    z-index: 58;
    background: rgba(10, 0, 12, 0.42);
  }

  /* ---------- 抽屉 ---------- */
  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 59;
    width: min(320px, 86vw);
    height: 100%;
    overflow-y: auto;
    background: var(--c-bg-raised);
    border-left: 1px solid var(--c-border);
    box-shadow: -14px 0 40px -18px rgb(0 0 0 / 0.4);
    padding: 0 0 2rem;
  }
  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--c-border);
    position: sticky;
    top: 0;
    background: var(--c-bg-raised);
  }
  .drawer__site {
    font-weight: 600;
    letter-spacing: 0.1em;
  }
