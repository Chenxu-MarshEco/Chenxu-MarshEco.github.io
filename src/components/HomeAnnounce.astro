---
/**
 * 首页「曼沫砾总线」—— 挂在「甬城晴雨」下面、日历上面。
 *
 * 用户 2026-10-06 的要求：
 *   「在甬城晴雨下方 涣源溪水钟上方插入新板块：曼沫砾总线 这个板块是本站的公告栏
 *    可以在编辑器内填写公告 填写后最新的几条可以显示在这个板块内 而点开板块则可以
 *    看到所有的历史公告 公告分为两种：事项公告和更新提醒公告。事项公告应当和文章
 *    手记一样 可以编写具体的内容 在鼠标点击标题后直接进入这一页公告文章内容
 *    而更新公告则是只有标题和跳转链接」
 *
 * 用户 2026-11-20 的要求（这一版）：
 *   「对曼沫砾总线卡片进行修改 内部分为左右两个小版块 左边是公告事项 放公告
 *    右边是近期更新 罗列板块适配板块高度条数的近期更新动态 更新动态格式直接参考
 *    编辑器里的推流动态 和编辑器里那个一模一样就好了」
 *
 *   「删掉类似：全站默认挂「花娅年代记」时间轴；涣愿终池页与文章手记页各换一套时间轴外壳
 *    这种AI描述的简介 不需要 只保留【站点源码、公告、页面 / 子版块、冰山图】这部分即可，
 *    但是这一部分需要更具体一些 尤其是页面子版块部分 鼠标移上去需要弹出卡片详细列出
 *    修改了哪些页面和子版块 冰山，精华等也是一样 …鼠标继续在卡片里停留可以选择这些
 *    详细条目并且直接跳转到对应的链接」
 *
 *   「板块高度千万不能变！！尽可能罗列是说尽可能好看地把板块填满而不是撑爆！！
 *    和之前的公告一样最多显示铺满板块的几条其他点进新页面看就可以了！！！！」
 *
 * 所以这一块是**左右两栏、高度封顶**：
 *   · 左：公告（一条不少；标题和右上角「全部公告 ›」都指向 /zongxian/）；
 *   · 右：近期更新 = 编辑器「协作」面板里那份推流动态（谁 · 什么时候 · 改了哪几块），
 *     只放能铺满卡片的那几条，多出来的去编辑器看（不往首页塞）。
 *     鼠标移上去弹一张卡片，列出这次到底改了哪些页面 / 子版块 / 冰山词条 / 精华条目，
 *     卡片里每一条都能点、直接跳到那个位置（明细见 utils/activity.ts）。
 *
 * 两栏各自滚；卡片 max-height 和右边「黎语堂」用**同一个 clamp**，
 * 所以内容再多也撑不高这一行 —— 首页那一屏严格对齐不会被这里破坏。
 */
import { announceBoard, announceExternal, announceHref, ANNOUNCE_KIND_LABEL, latestAnnounces } from '../utils/announce';
import { recentActivity } from '../utils/activity';
import ActivityList from './ActivityList.astro';
import { withBase } from '../utils/url';
/* 两句说明（「这条还没填跳转地址」悬停提示 / 「还没有公告」空状态）归「文案」面板 */
import { copy, text } from '../utils/site-copy';

const board = announceBoard();
const items = latestAnnounces();
const boardHref = withBase('/zongxian/');
/** 没填跳转地址那条的悬停提示（留空 = 不给提示） */
const missingHref = text(copy.announce?.missingHref);
/** 一条公告都没有时那句话（留空 = 整句不显示） */
const emptyText = text(copy.announce?.empty);
/** 日期在这一行上很短，只写 MM-DD（年份在公告栏那一页里看得到） */
const shortDate = (d: string) => (d.length === 10 ? d.slice(5) : d);

/* 右栏：推流动态（构建期读 git，见 utils/activity.ts；头像是问一次 GitHub 拿的） */
const feed = await recentActivity();
---

<section class="ann" id="home-announce" data-announce aria-labelledby="ann-title">
  <header class="ann__head">
    <h3 class="ann__titleWrap">
      <a class="ann__title" id="ann-title" href={boardHref}>{board.title}</a>
    </h3>
  </header>

  <div class="ann__cols">
    {/* ---------- 左：公告 ---------- */}
    <div class="ann__col ann__col--news">
      {
        items.length > 0 ? (
          <ul class="ann__list">
            {items.map((it) => {
              const href = announceHref(it);
              const external = announceExternal(it);
              const kind = ANNOUNCE_KIND_LABEL[it.kind];
              const inner = (
                <>
                  <span class:list={['ann__kind', it.kind === 'update' && 'ann__kind--update']}>{kind}</span>
                  <span class="ann__text">{it.title}</span>
                  {external ? (
                    <span class="ann__out" aria-hidden="true">↗</span>
                  ) : (
                    <time class="ann__date" datetime={it.date}>{shortDate(it.date)}</time>
                  )}
                </>
              );
              return (
                <li class="ann__row" data-announce-id={it.id} data-announce-kind={it.kind}>
                  {href ? (
                    <a
                      class="ann__link"
                      href={href}
                      title={external ? `去 ${it.href}` : it.title}
                      {...external ? { target: '_blank', rel: 'noopener' } : {}}
                    >
                      {inner}
                    </a>
                  ) : (
                    /* 更新提醒没填链接：照样列出来，只是点不动（页面上得说清是为什么） */
                    <span class="ann__link ann__link--dead" title={missingHref || undefined} data-copy="announce.missingHref">
                      {inner}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        ) : (
          emptyText && <p class="ann__empty" data-copy="announce.empty">{emptyText}</p>
        )
      }
      <div class="ann__foot">
        <a class="ann__more" href={boardHref}>全部公告 ›</a>
      </div>
    </div>

    {/* ---------- 右：近期更新（= 编辑器的推流动态） ---------- */}
    <div class="ann__col ann__col--feed">
      <div class="ann__scroll">
        <ActivityList items={feed} dense details />
      </div>
      <div class="ann__foot">
        <a class="ann__more" href={withBase('/feed/')}>推流动态 ›</a>
      </div>
    </div>
  </div>
</section>

<style>
  /*
    这一格和右边的「黎语堂」并排（见 HomeWidgets 的 .extras__grid），行高由高的那张决定。
    两样东西都写 clamp(190px, 24vh, 286px)：
      · min-height 保证两张卡都至少这么高；
      · **max-height 保证内容再多也撑不高** —— 站长 2026-11-20 的原话：
        「板块高度千万不能变！！尽可能罗列是说尽可能好看地把板块填满而不是撑爆！！」
        只写 min-height 的话，右栏那 30 条动态会把这一格撑到 2452px，整行跟着变高，
        首页那一屏严格对齐就全乱了（实测过）。
    多出来的内容在左右两列里各自滚。
  */
  .ann {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: clamp(190px, 24vh, 286px);
    max-height: clamp(190px, 24vh, 286px);
    overflow: hidden;
    padding: 0.42rem 0.62rem 0.44rem;
    border: 1px solid rgba(255, 120, 190, 0.4);
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(38, 6, 54, 0.86), rgba(20, 3, 32, 0.9));
    box-shadow: 0 14px 40px -22px rgb(0 0 0 / 0.8);
    backdrop-filter: blur(4px);
    min-width: 0;
  }

  .ann__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
    flex: none;
  }
  .ann__titleWrap {
    margin: 0;
    min-width: 0;
  }
  .ann__title {
    font-size: 1rem;
    letter-spacing: 0.14em;
    color: #ffd9ef;
    text-decoration: none;
    border-bottom: 1px dotted rgba(255, 120, 190, 0.6);
  }
  .ann__title:hover,
  .ann__title:focus-visible {
    color: #fff;
    border-bottom-color: #ff4fa3;
  }
  .ann__more {
    flex: none;
    font-size: 0.76rem;
    /* ⚠ 这是深色卡：别用浅色主题那套令牌（var(--c-text-muted) 压在这儿只有 2.3:1） */
    color: rgba(255, 226, 244, 0.6);
    text-decoration: none;
  }
  .ann__more:hover,
  .ann__more:focus-visible {
    color: #ffb3dd;
  }

  /*
    左右两栏：左边公告、右边近期更新，中间一条很淡的竖线分开
    （不加任何小标题 —— 本页不许自己写说明文案）。
    两栏各自滚，所以卡片高度只由 max-height 决定。
  */
  .ann__cols {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 0.5rem;
  }
  .ann__col {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .ann__col--feed {
    padding-left: 0.5rem;
    border-left: 1px solid rgba(255, 120, 190, 0.22);
  }

  /*
    条目列表：多了就在卡片里滚（`min-height: 0` 是关键 —— 不写的话 flex 子项
    的最小高度是内容高度，列表会把卡片顶破，max-height 那一行就白写了）。
  */
  .ann__list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
    scrollbar-width: thin;
    /*
      底下淡出：列表在卡片里滚，最后一条常常只露出半行 ——
      不给这一下，看着像"卡片把字切了"（手机端两栏叠起来时尤其明显）。
      这是纯视觉的遮罩，不是文案。
    */
    mask-image: linear-gradient(to bottom, #000 calc(100% - 14px), transparent);
  }
  .ann__row {
    min-width: 0;
  }
  .ann__link {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.24rem 0.42rem;
    border: 1px solid rgba(255, 120, 190, 0.22);
    border-radius: 9px;
    background: rgba(12, 2, 20, 0.42);
    color: rgba(255, 236, 248, 0.92);
    font-size: 0.84rem;
    line-height: 1.5;
    text-decoration: none;
    transition: border-color 0.14s ease, background 0.14s ease, color 0.14s ease;
  }
  a.ann__link:hover,
  a.ann__link:focus-visible {
    border-color: rgba(255, 120, 190, 0.75);
    background: rgba(24, 3, 36, 0.72);
    color: #fff;
  }
  a.ann__link:focus-visible {
    outline: 2px solid rgba(255, 120, 190, 0.75);
    outline-offset: 2px;
  }
  /* 没填链接的那条：照样看得见，只是不能点 */
  .ann__link--dead {
    opacity: 0.75;
    cursor: default;
  }

  .ann__kind {
    flex: none;
    padding: 0.02rem 0.26rem;
    border: 1px solid rgba(255, 120, 190, 0.55);
    border-radius: 999px;
    background: rgba(168, 0, 88, 0.35);
    color: #ffd9ef;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  /* 更新提醒：落日橙黄那套（和日历上的特殊日子同一组颜色） */
  .ann__kind--update {
    border-color: rgba(255, 180, 70, 0.6);
    background: rgba(224, 74, 8, 0.3);
    color: #ffe9c0;
  }

  /* 标题：一行放不下就省略号（这一条是卡片里最该让位给日期的） */
  .ann__text {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ann__date {
    flex: none;
    color: rgba(255, 226, 244, 0.55);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }
  .ann__out {
    flex: none;
    color: #ffb3dd;
    font-size: 0.8rem;
    line-height: 1;
  }
  .ann__empty {
    margin: 0;
    color: rgba(255, 226, 244, 0.62);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  /*
    右栏：近期更新的那一串在 ActivityList.astro 里（首页那 4 条和 /feed/ 整页共用一个组件），
    这里只给它一个会滚的框。
  */
  .ann__scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    /* 滚出卡片的那半行淡出，别看着像被切了 */
    mask-image: linear-gradient(to bottom, #000 calc(100% - 14px), transparent);
  }
  /* 每栏右下角那个「… ›」（站长 2026-11-20：全部公告挪到公告右下角、推流动态放推流右下角） */
  .ann__foot {
    flex: none;
    display: flex;
    justify-content: flex-end;
    padding-top: 0.04rem;
    line-height: 1.15;
  }

  /* 窄屏：两栏叠起来（公告在上、近期更新在下），各自滚 */
  @media (max-width: 760px) {
    .ann__cols {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    }
    .ann__col--feed {
      padding-left: 0;
      padding-top: 0.35rem;
      border-left: 0;
      border-top: 1px solid rgba(255, 120, 190, 0.22);
    }
    /*
      窄屏上两栏各只分到一半高度，行不收紧一点就只剩两行可看（站长要的是"填满"）。
      收紧的是间距和字号，不是内容 —— 条目一条不少，多出来的照样在框里滚。
    */
    .ann__link {
      padding: 0.14rem 0.3rem;
      font-size: 0.76rem;
      gap: 0.3rem;
    }
    .ann__kind {
      font-size: 0.6rem;
      padding: 0.02rem 0.24rem;
    }
    /* 手机上没有悬停的滚动条要留位置，别让它压着字 */
    .ann__list,
    .ann__scroll {
      scrollbar-width: none;
    }
    .ann__list::-webkit-scrollbar,
    .ann__scroll::-webkit-scrollbar {
      width: 0;
      height: 0;
    }
  }
</style>
