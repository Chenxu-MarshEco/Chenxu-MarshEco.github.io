---
/**
 * 首页「曼沫砾总线」—— 挂在「甬城晴雨」下面、日历上面。
 *
 * 用户 2026-10-06 的要求：
 *   「在甬城晴雨下方 涣源溪水钟上方插入新板块：曼沫砾总线 这个板块是本站的公告栏
 *    可以在编辑器内填写公告 填写后最新的几条可以显示在这个板块内 而点开板块则可以
 *    看到所有的历史公告 公告分为两种：事项公告和更新提醒公告。事项公告应当和文章
 *    手记一样 可以编写具体的内容 在鼠标点击标题后直接进入这一页公告文章内容
 *    而更新公告则是只有标题和跳转链接」
 *
 * 用户 2026-11-20 的要求（这一版）：
 *   「对曼沫砾总线卡片进行修改 内部分为左右两个小版块 左边是公告事项 放公告
 *    右边是近期更新 罗列板块适配板块高度条数的近期更新动态 更新动态格式直接参考
 *    编辑器里的推流动态 和编辑器里那个一模一样就好了」
 *
 *   「删掉类似：全站默认挂「花娅年代记」时间轴；涣愿终池页与文章手记页各换一套时间轴外壳
 *    这种AI描述的简介 不需要 只保留【站点源码、公告、页面 / 子版块、冰山图】这部分即可，
 *    但是这一部分需要更具体一些 尤其是页面子版块部分 鼠标移上去需要弹出卡片详细列出
 *    修改了哪些页面和子版块 冰山，精华等也是一样 …鼠标继续在卡片里停留可以选择这些
 *    详细条目并且直接跳转到对应的链接」
 *
 *   「板块高度千万不能变！！尽可能罗列是说尽可能好看地把板块填满而不是撑爆！！
 *    和之前的公告一样最多显示铺满板块的几条其他点进新页面看就可以了！！！！」
 *
 * 所以这一块是**左右两栏、高度封顶**：
 *   · 左：公告（一条不少；标题和右上角「全部公告 ›」都指向 /zongxian/）；
 *   · 右：近期更新 = 编辑器「协作」面板里那份推流动态（谁 · 什么时候 · 改了哪几块），
 *     只放能铺满卡片的那几条，多出来的去编辑器看（不往首页塞）。
 *     鼠标移上去弹一张卡片，列出这次到底改了哪些页面 / 子版块 / 冰山词条 / 精华条目，
 *     卡片里每一条都能点、直接跳到那个位置（明细见 utils/activity.ts）。
 *
 * 两栏各自滚；卡片 max-height 和右边「黎语堂」用**同一个 clamp**，
 * 所以内容再多也撑不高这一行 —— 首页那一屏严格对齐不会被这里破坏。
 */
import { announceBoard, announceExternal, announceHref, ANNOUNCE_KIND_LABEL, latestAnnounces } from '../utils/announce';
import { recentActivity } from '../utils/activity';
import { withBase } from '../utils/url';
/* 两句说明（「这条还没填跳转地址」悬停提示 / 「还没有公告」空状态）归「文案」面板 */
import { copy, text } from '../utils/site-copy';

const board = announceBoard();
const items = latestAnnounces();
const boardHref = withBase('/zongxian/');
/** 没填跳转地址那条的悬停提示（留空 = 不给提示） */
const missingHref = text(copy.announce?.missingHref);
/** 一条公告都没有时那句话（留空 = 整句不显示） */
const emptyText = text(copy.announce?.empty);
/** 日期在这一行上很短，只写 MM-DD（年份在公告栏那一页里看得到） */
const shortDate = (d: string) => (d.length === 10 ? d.slice(5) : d);

/* 右栏：推流动态（构建期读 git，见 utils/activity.ts） */
const feed = recentActivity();

/** 「刚刚 / 12 分钟前 / 昨天…」—— 和编辑器里那个 timeAgo 同一套说法 */
const timeAgo = (iso: string): string => {
  const t = Date.parse(String(iso || ''));
  if (!t) return '';
  const diff = Date.now() - t;
  if (diff < 0) return '刚刚';
  if (diff < 60e3) return '刚刚';
  if (diff < 3600e3) return `${Math.max(1, Math.floor(diff / 60e3))} 分钟前`;
  if (diff < 12 * 3600e3) return `${Math.floor(diff / 3600e3)} 小时前`;
  const d = new Date(t);
  const p = (n: number) => String(n).padStart(2, '0');
  const sameYear = d.getFullYear() === new Date().getFullYear();
  return `${sameYear ? '' : `${d.getFullYear()}-`}${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
};
/** 明细那三档的标记（新增 / 改动 / 删除） */
const CHANGE_MARK: Record<string, string> = { add: '+', edit: '~', del: '−' };
---

<section class="ann" id="home-announce" data-announce aria-labelledby="ann-title">
  <header class="ann__head">
    <h3 class="ann__titleWrap">
      <a class="ann__title" id="ann-title" href={boardHref}>{board.title}</a>
    </h3>
    <a class="ann__more" href={boardHref}>全部公告 ›</a>
  </header>

  <div class="ann__cols">
    {/* ---------- 左：公告 ---------- */}
    <div class="ann__col ann__col--news">
      {
        items.length > 0 ? (
          <ul class="ann__list">
            {items.map((it) => {
              const href = announceHref(it);
              const external = announceExternal(it);
              const kind = ANNOUNCE_KIND_LABEL[it.kind];
              const inner = (
                <>
                  <span class:list={['ann__kind', it.kind === 'update' && 'ann__kind--update']}>{kind}</span>
                  <span class="ann__text">{it.title}</span>
                  {external ? (
                    <span class="ann__out" aria-hidden="true">↗</span>
                  ) : (
                    <time class="ann__date" datetime={it.date}>{shortDate(it.date)}</time>
                  )}
                </>
              );
              return (
                <li class="ann__row" data-announce-id={it.id} data-announce-kind={it.kind}>
                  {href ? (
                    <a
                      class="ann__link"
                      href={href}
                      title={external ? `去 ${it.href}` : it.title}
                      {...external ? { target: '_blank', rel: 'noopener' } : {}}
                    >
                      {inner}
                    </a>
                  ) : (
                    /* 更新提醒没填链接：照样列出来，只是点不动（页面上得说清是为什么） */
                    <span class="ann__link ann__link--dead" title={missingHref || undefined} data-copy="announce.missingHref">
                      {inner}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        ) : (
          emptyText && <p class="ann__empty" data-copy="announce.empty">{emptyText}</p>
        )
      }
    </div>

    {/* ---------- 右：近期更新（= 编辑器的推流动态） ---------- */}
    <div class="ann__col ann__col--feed">
      <ul class="ann__feed" data-announce-feed>
        {feed.map((c) => (
          <li class:list={['ann__feedItem', c.mine && 'is-mine']} data-sha={c.short}>
            {/*
              头像位：构建期拿不到 GitHub 头像（那要联网），所以画名字首字 ——
              和编辑器里"拿不到头像就用名字首字画一个圆"是同一个兜底。
            */}
            <span class="ann__face" aria-hidden="true">{c.who.slice(0, 1).toUpperCase()}</span>
            <div class="ann__feedMain">
              <div class="ann__feedLine">
                <b class="ann__who">{c.who}</b>
                <span class="ann__when">{timeAgo(c.iso)}</span>
              </div>
              {/*
                「改了哪几块」：鼠标移上去弹明细卡片（脚本在下面，
                浮层机制和成员名片 MemberCard.astro 是同一套）。
              */}
              <div class="ann__what" tabindex="0" data-feed-detail={c.short}>
                {c.panels.length ? c.panels.join('、') : '（没列改了什么）'}
              </div>
            </div>

            {/*
              明细卡片：平时 display:none（不占位、不撑框）。
              鼠标移到上面那行时由脚本把它**搬进 .annlayer 浮层**里显示 ——
              照搬 MemberCard.astro 的做法：卡片在列表里会被 `overflow:auto` 裁掉一半，
              搬进 position:fixed 的浮层才不受任何祖先影响。
            */}
            <div class="ann__detail" data-feed-card={c.short}>
              {c.detail.length ? (
                c.detail.map((p) => (
                  <div class="ann__detailGroup">
                    <div class="ann__detailPanel">{p.panel}</div>
                    <ul class="ann__detailList">
                      {p.items.map((it) => (
                        <li class:list={['ann__detailRow', `is-${it.change}`]}>
                          {it.href ? (
                            <a class="ann__detailLink" href={it.href}>
                              <span class="ann__detailMark" aria-hidden="true">{CHANGE_MARK[it.change]}</span>
                              <span class="ann__detailText">{it.label}</span>
                            </a>
                          ) : (
                            <span class="ann__detailLink ann__detailLink--dead">
                              <span class="ann__detailMark" aria-hidden="true">{CHANGE_MARK[it.change]}</span>
                              <span class="ann__detailText">{it.label}</span>
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              ) : (
                <div class="ann__detailGroup">
                  <div class="ann__detailPanel">{c.panels.join('、') || '（没列改了什么）'}</div>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /*
    这一格和右边的「黎语堂」并排（见 HomeWidgets 的 .extras__grid），行高由高的那张决定。
    两样东西都写 clamp(190px, 24vh, 286px)：
      · min-height 保证两张卡都至少这么高；
      · **max-height 保证内容再多也撑不高** —— 站长 2026-11-20 的原话：
        「板块高度千万不能变！！尽可能罗列是说尽可能好看地把板块填满而不是撑爆！！」
        只写 min-height 的话，右栏那 30 条动态会把这一格撑到 2452px，整行跟着变高，
        首页那一屏严格对齐就全乱了（实测过）。
    多出来的内容在左右两列里各自滚。
  */
  .ann {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: clamp(190px, 24vh, 286px);
    max-height: clamp(190px, 24vh, 286px);
    overflow: hidden;
    padding: 0.55rem 0.7rem 0.6rem;
    border: 1px solid rgba(255, 120, 190, 0.4);
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(38, 6, 54, 0.86), rgba(20, 3, 32, 0.9));
    box-shadow: 0 14px 40px -22px rgb(0 0 0 / 0.8);
    backdrop-filter: blur(4px);
    min-width: 0;
  }

  .ann__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    flex: none;
  }
  .ann__titleWrap {
    margin: 0;
    min-width: 0;
  }
  .ann__title {
    font-size: 1rem;
    letter-spacing: 0.14em;
    color: #ffd9ef;
    text-decoration: none;
    border-bottom: 1px dotted rgba(255, 120, 190, 0.6);
  }
  .ann__title:hover,
  .ann__title:focus-visible {
    color: #fff;
    border-bottom-color: #ff4fa3;
  }
  .ann__more {
    flex: none;
    font-size: 0.76rem;
    /* ⚠ 这是深色卡：别用浅色主题那套令牌（var(--c-text-muted) 压在这儿只有 2.3:1） */
    color: rgba(255, 226, 244, 0.6);
    text-decoration: none;
  }
  .ann__more:hover,
  .ann__more:focus-visible {
    color: #ffb3dd;
  }

  /*
    左右两栏：左边公告、右边近期更新，中间一条很淡的竖线分开
    （不加任何小标题 —— 本页不许自己写说明文案）。
    两栏各自滚，所以卡片高度只由 max-height 决定。
  */
  .ann__cols {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 0.5rem;
  }
  .ann__col {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .ann__col--feed {
    padding-left: 0.5rem;
    border-left: 1px solid rgba(255, 120, 190, 0.22);
  }

  /*
    条目列表：多了就在卡片里滚（`min-height: 0` 是关键 —— 不写的话 flex 子项
    的最小高度是内容高度，列表会把卡片顶破，max-height 那一行就白写了）。
  */
  .ann__list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    scrollbar-width: thin;
    /*
      底下淡出：列表在卡片里滚，最后一条常常只露出半行 ——
      不给这一下，看着像"卡片把字切了"（手机端两栏叠起来时尤其明显）。
      这是纯视觉的遮罩，不是文案。
    */
    mask-image: linear-gradient(to bottom, #000 calc(100% - 14px), transparent);
  }
  .ann__row {
    min-width: 0;
  }
  .ann__link {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.24rem 0.42rem;
    border: 1px solid rgba(255, 120, 190, 0.22);
    border-radius: 9px;
    background: rgba(12, 2, 20, 0.42);
    color: rgba(255, 236, 248, 0.92);
    font-size: 0.84rem;
    line-height: 1.5;
    text-decoration: none;
    transition: border-color 0.14s ease, background 0.14s ease, color 0.14s ease;
  }
  a.ann__link:hover,
  a.ann__link:focus-visible {
    border-color: rgba(255, 120, 190, 0.75);
    background: rgba(24, 3, 36, 0.72);
    color: #fff;
  }
  a.ann__link:focus-visible {
    outline: 2px solid rgba(255, 120, 190, 0.75);
    outline-offset: 2px;
  }
  /* 没填链接的那条：照样看得见，只是不能点 */
  .ann__link--dead {
    opacity: 0.75;
    cursor: default;
  }

  .ann__kind {
    flex: none;
    padding: 0.02rem 0.26rem;
    border: 1px solid rgba(255, 120, 190, 0.55);
    border-radius: 999px;
    background: rgba(168, 0, 88, 0.35);
    color: #ffd9ef;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  /* 更新提醒：落日橙黄那套（和日历上的特殊日子同一组颜色） */
  .ann__kind--update {
    border-color: rgba(255, 180, 70, 0.6);
    background: rgba(224, 74, 8, 0.3);
    color: #ffe9c0;
  }

  /* 标题：一行放不下就省略号（这一条是卡片里最该让位给日期的） */
  .ann__text {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ann__date {
    flex: none;
    color: rgba(255, 226, 244, 0.55);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }
  .ann__out {
    flex: none;
    color: #ffb3dd;
    font-size: 0.8rem;
    line-height: 1;
  }
  .ann__empty {
    margin: 0;
    color: rgba(255, 226, 244, 0.62);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  /* ============================================================================
   *  右栏：近期更新（= 编辑器「协作」面板那份推流动态，长得和它一样）
   * ========================================================================= */
  .ann__feed {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin: 0;
    padding: 0;
    list-style: none;
    scrollbar-width: thin;
    /* 同 .ann__list：滚出卡片的那半行淡出，别看着像被切了 */
    mask-image: linear-gradient(to bottom, #000 calc(100% - 14px), transparent);
  }
  .ann__feedItem {
    display: flex;
    gap: 0.38rem;
    align-items: flex-start;
    padding: 0.03rem 0.05rem;
    border-bottom: 1px solid rgba(255, 120, 190, 0.16);
  }
  .ann__feedItem:last-child {
    border-bottom: none;
  }
  /* 自己的推流淡一点：重点是"别人刚推了什么"（和编辑器里同一个规矩） */
  .ann__feedItem.is-mine {
    opacity: 0.75;
  }
  .ann__face {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid rgba(255, 120, 190, 0.55);
    background: rgba(22, 3, 36, 0.9);
    color: #ffb3dd;
    font-size: 0.64rem;
    line-height: 1;
  }
  .ann__feedMain {
    min-width: 0;
    flex: 1 1 auto;
  }
  .ann__feedLine {
    display: flex;
    align-items: baseline;
    gap: 0.36rem;
  }
  .ann__who {
    color: #ffe6f6;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ann__when {
    flex: none;
    color: rgba(255, 226, 244, 0.5);
    font-size: 0.67rem;
    font-variant-numeric: tabular-nums;
  }
  /*
    「改了哪几块」那一行：鼠标移上去弹明细卡片。
    能点的暗示交给光标 + 底下那条虚线（和成员名一个手感）。
  */
  .ann__what {
    margin-top: 0.02rem;
    color: rgba(255, 236, 248, 0.86);
    font-size: 0.71rem;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: help;
    border-bottom: 1px dashed rgba(255, 120, 190, 0.4);
  }
  .ann__what:hover,
  .ann__what:focus-visible {
    color: #fff;
    border-bottom-color: #ff4fa3;
    outline: none;
  }

  /* 明细卡片：**平时不画**（不占位、不参与任何容器的滚动区），显示时由脚本搬进浮层 */
  .ann__detail {
    display: none;
  }
  .ann__detailGroup + .ann__detailGroup {
    margin-top: 0.4rem;
  }
  .ann__detailPanel {
    margin-bottom: 0.16rem;
    color: #ffb3dd;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }
  .ann__detailList {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
  }
  .ann__detailLink {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.08rem 0.3rem;
    border-radius: 6px;
    color: rgba(255, 236, 248, 0.9);
    font-size: 0.76rem;
    line-height: 1.45;
    text-decoration: none;
  }
  a.ann__detailLink:hover,
  a.ann__detailLink:focus-visible {
    background: rgba(255, 120, 190, 0.18);
    color: #fff;
  }
  a.ann__detailLink:focus-visible {
    outline: 2px solid rgba(255, 120, 190, 0.75);
    outline-offset: 1px;
  }
  .ann__detailLink--dead {
    opacity: 0.6;
    cursor: default;
  }
  .ann__detailMark {
    flex: none;
    width: 0.8em;
    color: rgba(255, 226, 244, 0.6);
    font-variant-numeric: tabular-nums;
  }
  .ann__detailRow.is-add .ann__detailMark {
    color: #7ef0b0;
  }
  .ann__detailRow.is-del .ann__detailMark {
    color: #ff8f8f;
  }
  .ann__detailText {
    min-width: 0;
    word-break: break-word;
  }

  /* 窄屏：两栏叠起来（公告在上、近期更新在下），各自滚 */
  @media (max-width: 760px) {
    .ann__cols {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    }
    .ann__col--feed {
      padding-left: 0;
      padding-top: 0.35rem;
      border-left: 0;
      border-top: 1px solid rgba(255, 120, 190, 0.22);
    }
    /*
      窄屏上两栏各只分到一半高度，行不收紧一点就只剩两行可看（站长要的是"填满"）。
      收紧的是间距和字号，不是内容 —— 条目一条不少，多出来的照样在框里滚。
    */
    .ann__link {
      padding: 0.14rem 0.3rem;
      font-size: 0.76rem;
      gap: 0.3rem;
    }
    .ann__kind {
      font-size: 0.6rem;
      padding: 0.02rem 0.24rem;
    }
    .ann__feedItem {
      gap: 0.3rem;
    }
    .ann__face {
      width: 17px;
      height: 17px;
      font-size: 0.58rem;
    }
    .ann__who {
      font-size: 0.71rem;
    }
    .ann__when {
      font-size: 0.64rem;
    }
    .ann__what {
      font-size: 0.67rem;
    }
    /*
      手机端那一格只有 60 多像素高，一行一条（名字 · 时间 · 改了哪几块）才排得下三条；
      两行一条只能露一条半，最后那半条看着就是被切了。
    */
    .ann__feedMain {
      display: flex;
      align-items: baseline;
      gap: 0.3rem;
    }
    .ann__feedLine {
      flex: none;
    }
    .ann__what {
      flex: 1 1 auto;
      min-width: 0;
      margin-top: 0;
    }
    /* 手机上没有悬停的滚动条要留位置，别让它压着字 */
    .ann__list,
    .ann__feed {
      scrollbar-width: none;
    }
    .ann__list::-webkit-scrollbar,
    .ann__feed::-webkit-scrollbar {
      width: 0;
      height: 0;
    }
  }
</style>

<script>
  /*
    明细卡片的浮层。
    ----------------------------------------------------------------------------
    站长 2026-11-20 的原话：
      「为什么推流动态的卡片停留手感这么奇怪 旁边每日精华的卡片不是有现成的模板吗
        为什么跟每日精华手感不一样 推流动态的卡片特别延迟」

    每日精华那张卡（HomeDailyEssence.astro 的 .daily__pop）的手感来自两件事：
      · 悬停**整张卡**就出来 —— 不是只有某个小字；
      · 出来/收起是 0.15s 的 CSS 过渡，没有任何计时器。

    这一版照着改（之前那版确实卡的三个原因，都记在这儿免得再犯）：
      ① 触发点只挂在「改了哪几块」那一行小字上 —— 目标太小，得瞄准；
      ② `pointermove` 里每次都调两遍 `getBoundingClientRect()` —— 每移动一像素强排一次版，
         越动越卡（这是"特别延迟"的主因）；
      ③ 收起是 220ms + 每 220ms 再重算一次的计时器 —— 移开以后还赖着不走。
    现在：整行都能触发、几何只在打开/滚动时算一次、收起宽限 120ms。

    ⚠ 为什么不能像每日精华那样纯 CSS `:hover`：这张卡在 `.ann__feed` 里，
      那个列表是 `overflow-y: auto`，卡一超出列表就被裁掉 —— 必须搬进
      position:fixed 的 `.annlayer`（和成员名片 MemberCard.astro 同一套做法）。
  */
  (() => {
    /** 浮层：铺满视口、不吃指针，只有里面的卡片吃 */
    let layer: HTMLElement | null = null;
    /** 当前显示的卡，以及它原本挂在哪个 li 上 */
    let card: HTMLElement | null = null;
    let home: HTMLElement | null = null;
    let hideTimer = 0;
    /**
     * 几何缓存：整行 + 卡片的外接矩形（打开和滚动时算一次）。
     * ⚠ 绝对不要在 pointermove 里重算 —— 那就是上一版的卡顿来源。
     */
    let zone: { l: number; t: number; r: number; b: number } | null = null;

    const ensureLayer = (): HTMLElement => {
      if (layer && layer.isConnected) return layer;
      layer = document.createElement('div');
      layer.className = 'annlayer';
      layer.setAttribute('aria-hidden', 'true');
      document.body.append(layer);
      return layer;
    };

    /** 把卡片摆到那一行上面（上面放不下才摆下面），左右夹在视口里 */
    const place = (row: HTMLElement, el: HTMLElement) => {
      const r = row.getBoundingClientRect();
      /* 先挪到屏幕外量尺寸，避免"在 0,0 处闪一下" */
      el.style.left = '-9999px';
      el.style.top = '0px';
      const cr = el.getBoundingClientRect();
      const pad = 8;
      const gap = 6;
      let left = r.left;
      left = Math.max(pad, Math.min(window.innerWidth - cr.width - pad, left));
      let top = r.top - cr.height - gap;
      if (top < pad) top = Math.min(window.innerHeight - cr.height - pad, r.bottom + gap);
      el.style.left = `${Math.round(left)}px`;
      el.style.top = `${Math.round(top)}px`;
      return { row: r, box: { l: left, t: top, r: left + cr.width, b: top + cr.height } };
    };

    /** 整行 + 卡片的外接矩形（宽一点：斜着挪过去也算在里面） */
    const measure = (row: HTMLElement, box: { l: number; t: number; r: number; b: number }) => {
      const r = row.getBoundingClientRect();
      zone = {
        l: Math.min(r.left, box.l) - 8,
        t: Math.min(r.top, box.t) - 8,
        r: Math.max(r.right, box.r) + 8,
        b: Math.max(r.bottom, box.b) + 8,
      };
    };

    const inZone = (x: number, y: number) =>
      !!zone && x >= zone.l && x <= zone.r && y >= zone.t && y <= zone.b;

    const hide = () => {
      window.clearTimeout(hideTimer);
      hideTimer = 0;
      const el = card;
      const back = home;
      card = null;
      home = null;
      zone = null;
      if (!el) return;
      el.removeAttribute('style');
      el.classList.remove('is-open');
      /* 搬回原来那个 li 里（标记保持"每条动态自己带一张卡"的形状） */
      if (back && back.isConnected) back.append(el);
      else el.remove();
    };

    const scheduleHide = () => {
      if (hideTimer) return;
      hideTimer = window.setTimeout(hide, 120);
    };

    const show = (li: HTMLElement) => {
      const el = li.querySelector<HTMLElement>('[data-feed-card]');
      if (!el) return;
      window.clearTimeout(hideTimer);
      hideTimer = 0;
      if (card === el) return;
      if (card) hide();
      ensureLayer().append(el);
      card = el;
      home = li;
      el.classList.add('is-open');
      const at = place(li, el);
      measure(li, at.box);
    };

    /*
      指针动一下就够判断了：只比数字，不碰布局。
      在"整行 ∪ 卡片"那块里就保持打开，出界 120ms 后收。
    */
    document.addEventListener(
      'pointermove',
      (event) => {
        if (!card) return;
        if (inZone(event.clientX, event.clientY)) {
          if (hideTimer) {
            window.clearTimeout(hideTimer);
            hideTimer = 0;
          }
        } else {
          scheduleHide();
        }
      },
      { passive: true }
    );

    /* 整行都能触发（比只认那一行小字好瞄得多） */
    document.addEventListener('pointerover', (event) => {
      const t = event.target as Element | null;
      if (!t || !t.closest) return;
      const li = t.closest('.ann__feedItem') as HTMLElement | null;
      if (li) {
        show(li);
        return;
      }
      if (card && !t.closest('.annlayer')) scheduleHide();
    });

    /* 键盘走到那行上也浮出来 */
    document.addEventListener('focusin', (event) => {
      const t = event.target as Element | null;
      if (!t || !t.closest) return;
      const li = t.closest('.ann__feedItem') as HTMLElement | null;
      if (li) show(li);
    });
    document.addEventListener('focusout', () => {
      if (card) scheduleHide();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && card) hide();
    });

    /*
      滚页面 / 滚内部列表 / 改窗口大小：位置会错，重新摆一次并重算几何。
      这是唯一会碰布局的时机（不是每个 pointermove）。
    */
    const reflow = () => {
      if (!card || !home || !home.isConnected) return;
      const at = place(home, card);
      measure(home, at.box);
    };
    window.addEventListener('scroll', reflow, { passive: true, capture: true });
    window.addEventListener('resize', reflow);
  })();
</script>
