---
/**
 * 导航表里的一串条目 —— 条目之间用一个**小塔吊**隔开。
 *
 * 为什么要这一层：条目本来排得紧（一行好几个），原来两条之间只有 2px 的间隙，
 * 字几乎黏在一起（「悦灵 雪傀儡 铁傀儡」看着像一句话）。用户要的就是
 * "每个条目之间用一个小塔吊符号隔开" —— 既是分界，又不打断
 * "这一行都是同一类东西" 的读法。
 *
 * 两个细节是刻意的：
 *   · 塔吊放在**条目外面**（不是条目里的 `::before`）—— 条目悬停时会整块染底色，
 *     塔吊在里面的话那个圆角底色会把前一个塔吊也吞进去，左右看着不对称。
 *   · 每一对「塔吊 + 条目」包一个小盒子（`.navblk__pair`）：窄屏换行只会在
 *     "对"之间发生，不会出现某一行末尾孤零零吊着一个塔吊。
 *
 * 塔吊用的是站点到处在用那一个 path（时间轴、地图图钉、首页天际线同一套）。
 *
 * 样式写在本文件里（不是 NavBlock 里）：Astro 的 scoped 样式只认自己模板里的元素，
 * 这个组件渲染出来的东西得由它自己的样式管，写在父组件里会失效。
 */
import NavItem from './NavItem.astro';
import type { NavItem as NavItemData } from '../utils/navs';

interface Props {
  items?: NavItemData[];
}

const { items = [] } = Astro.props;
---

{
  items.map((it, i) => (
    <span class="navblk__pair">
      {i > 0 && (
        <span class="navblk__sep" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M10.5 20.5V6.5M13.5 20.5V6.5M8.5 20.5h7M12 4v2.5M3.5 9h17M12 4 3.5 9M12 4l8.5 5M17.5 9v4" />
          </svg>
        </span>
      )}
      <NavItem {...it} />
    </span>
  ))
}

<style>
  /* 一对「塔吊 + 条目」：换行的最小单位 */
  .navblk__pair {
    display: inline-flex;
    align-items: center;
  }

  /*
    条目之间的小塔吊。左右各留一点空 —— 原来的毛病就是"字几乎黏在一起"，
    所以间隔本身也要给够，不能只放个符号。
  */
  .navblk__sep {
    flex: none;
    width: 0.86rem;
    height: 0.86rem;
    margin: 0 0.34rem;
    display: inline-flex;
    color: var(--c-accent);
    opacity: 0.55;
  }
  .navblk__sep svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
