---
/**
 * 黎语堂的「发言区」= 账号（注册 / 登录 / 待审核 / 头像）+ Twikoo 评论区。
 *
 * 用户 2026-10-07 的要求（原话）：
 *   「我要的不是每句话都给我审核 这样太累了 我要的是审核用户！！例如 A 在论坛上注册了
 *    两个号 一个叫 hoshi 一个叫 arcarlight 而我通过了 hoshi 这个账号的审核 那 hoshi 就可以
 *    随意在任何地方发贴发言 不再需要我的审核 而 arcarlight 因为我忘记审核了 所以它是注册了
 *    也不能发送任何东西的 一定要等到我同意这个账号过审了才能发东西」
 *
 * 所以这一块的规矩是：
 *   · **评论区默认藏着**（`hidden`）—— 只有「登录 + 已过审」才露出来；
 *   · 没登录 → 显示注册 / 登录表单；登录了但还没过审 → 显示「等站长审核」，发不了；
 *   · 过审了 → 评论区出现，提交时把账号令牌一起带上。服务端还会再验一遍
 *     （tools/liyutang-backend/index.js 里 COMMENT_SUBMIT 那道硬门槛）——
 *     所以绕开页面直接调接口也发不出去。
 *
 * ⚠ 2026-10-07 晚上：账号那一块搬去了 src/components/LiyutangAccount.astro +
 *   src/utils/liyutang-client.ts（发帖页也要用同一套界面）。这个组件现在只负责
 *   "听账号状态 → 露出评论区 → 启动 Twikoo"。搬家时踩过的那个坑（cfg 变量作用域）
 *   在 liyutang-client.ts 的注释里记着。
 *
 * 另外两个讲究：
 *  ① 后端地址就是 `forum.twikoo.envId` 里那条 HTTP 网关网址 —— 账号事件（LT_*）和评论事件
 *     走的是**同一个云函数**，不用第二处配置。
 *  ② 评论区的前端文件放本仓库（public/vendor/twikoo/，**all 版**自带腾讯云 SDK），
 *     不引国外 CDN；配置用 `<script type="application/json">` 传（和首页日历一个做法）。
 *  ③ `path` 可以指定"这条留言线算在哪一页名下"：**用户发的帖子**是动态渲染的，
 *     所有帖子共用 /liyutang/post/ 这一页，不给 path 的话全站帖子的回帖会挤在一个线程里。
 */
import LiyutangAccount from './LiyutangAccount.astro';
import { commentsReady, forum } from '../utils/liyutang';
import { withBase } from '../utils/url';

interface Props {
  /** 评论区上面那行小标题 */
  title?: string;
  /** 给一句说明 */
  hint?: string;
  /** 这条留言线的名字（默认按当前网址算；动态帖子要显式给一个） */
  path?: string;
}

const {
  title = '留言',
  hint = '留言要登录（账号得先让站长过审）。发帖在「发帖」那一页。',
  path = '',
} = Astro.props;
const f = forum();
const ready = commentsReady() && f.provider === 'twikoo';
const js = withBase('/vendor/twikoo/twikoo.all.min.js');
const css = withBase('/vendor/twikoo/twikoo.css');
const api = f.twikoo.envId;
---

{
  ready && (
    <section class="tkc" aria-label={title} data-twikoo data-env={f.twikoo.envId}>
      <h2 class="tkc__title">{title}</h2>
      {hint && <p class="tkc__hint">{hint}</p>}

      {/* 账号那一块（注册 / 登录 / 待审核 / 换头像）—— 逻辑在 LiyutangAccount 里 */}
      <LiyutangAccount />

      {/* 评论区：默认藏着，登录且过审之后才露出来 */}
      <div id="tcomment" class="tkc__box" hidden />

      <script
        type="application/json"
        id="twikoo-cfg"
        set:html={JSON.stringify({
          api,
          envId: f.twikoo.envId,
          region: f.twikoo.region,
          el: '#tcomment',
          title,
          path,
        })}
      />
      <link rel="stylesheet" href={css} />
      <script is:inline src={js} />
      <script>
        /* ---------------------------------------------------------------
           发言区：听账号状态 → 露出评论区 → 启动 Twikoo
           账号那条状态机在 liyutang-client.ts 里（LiyutangAccount 组件挂上去的），
           它每变一次就往 document 上发一个 lt-account 事件。
           --------------------------------------------------------------- */
        const cfgEl = document.getElementById('twikoo-cfg');
        const commentBox = document.getElementById('tcomment');
        let twikooStarted = false;

        /*
          ⚠ 配置要在**模块最外层**解析：`startTwikoo()` 定义在这一层，它要用 cfg ——
          塞进下面那个回调里就看不见了（2026-10-07 线上真踩到「ReferenceError: cfg is not defined」，
          表现是站长后门 #admin 和"已过审用户登录后"这两条路都起不来 Twikoo）。
        */
        const cfg = JSON.parse((cfgEl && cfgEl.textContent) || '{}') as {
          api: string;
          envId: string;
          region: string;
          el: string;
          title: string;
          path: string;
        };

        const token = () => {
          try {
            return localStorage.getItem('lt_token') || '';
          } catch {
            return '';
          }
        };

        /** 启动 Twikoo（只在第一次露出评论区时调；提交前把令牌塞进 payload） */
        const startTwikoo = () => {
          if (twikooStarted) return;
          const t = (window as unknown as { twikoo?: { init: (o: unknown) => void } }).twikoo;
          if (!t || typeof t.init !== 'function') {
            window.setTimeout(startTwikoo, 200);
            return;
          }
          twikooStarted = true;
          const state = (window as unknown as { __ltState?: { user?: { nick: string; mail: string } | null } })
            .__ltState;
          /*
            「这条留言线算在哪一页名下」：静态页按网址算（cfg.path 为空就是 Twikoo 的默认行为），
            **动态帖子页**则由页面自己在 <Twikoo> 之前把 window.__ltPostPath 钉上
            （所有帖子共用 /liyutang/post/ 一个网址，不给 path 的话全站帖子的回帖会挤成一个线程）。
            这一步是 2026-10-07 晚上写完帖子页才想明白的 —— tools/checks/liyutang-posts-check.mjs
            里有一条断言专门盯着它。
          */
          const postPath = (window as unknown as { __ltPostPath?: string }).__ltPostPath;
          t.init({
            envId: cfg.envId,
            el: cfg.el,
            region: cfg.region,
            path: cfg.path || postPath || undefined,
            /* 把账号令牌带上 —— 服务端拿它验「这个号过审了没有」 */
            onSubmit: (payload: Record<string, unknown>) => {
              payload.ltToken = token();
              const user = state?.user;
              if (user) {
                payload.nick = user.nick;
                if (user.mail) payload.mail = user.mail;
              }
            },
          });
        };

        const showComment = () => {
          if (commentBox) commentBox.hidden = false;
          startTwikoo();
        };

        /** 账号状态来了：过审（或站长 #admin）就把评论区露出来 */
        const onAccount = (state: string, fake: boolean) => {
          if (state === 'approved') showComment();
          else if (commentBox) commentBox.hidden = true;
          void fake;
        };

        document.addEventListener('lt-account', (ev) => {
          const d = (ev as CustomEvent).detail as { state?: string; fake?: boolean } | undefined;
          onAccount(String(d?.state ?? ''), !!d?.fake);
        });

        /* 兜底：账号区可能比这个脚本先跑完（fetch 很快、或者脚本顺序变了） */
        const early = (window as unknown as { __ltState?: { state?: string; fake?: boolean } }).__ltState;
        if (early?.state) onAccount(String(early.state), !!early.fake);

        /* Twikoo 的文件是 is:inline 加载的，可能比这个模块晚到 —— 等它一下 */
        if (document.readyState !== 'complete') {
          window.addEventListener('load', () => {
            const s = (window as unknown as { __ltState?: { state?: string; fake?: boolean } }).__ltState;
            if (s?.state === 'approved') showComment();
          });
        }
      </script>
    </section>
  )
}

<style>
  /*
    发言区：和文章页那个正文框（.crt-screen）一个味道 —— 半透明深底 + 落日橙黄描边 + 圆角。
    ⚠ Twikoo 自己的 CSS 是全局的（它按 .twikoo / .tk-* 选），这里只管外面这层壳和账号那块。
    2026-10-07 晚上：账号那块（表单 / 头像 / 提示）的样式搬去了 src/styles/forum.css，
    因为发帖页不在这个组件里也要用同一套（.tkc__* 那些类名没变，页面自己 @import forum.css）。
  */
  .tkc {
    margin: clamp(1.6rem, 4vh, 2.6rem) 0 0;
    padding: clamp(1rem, 2.4vw, 1.5rem);
    border: 1px solid rgba(255, 181, 71, 0.22);
    border-radius: 14px;
    background: rgba(18, 10, 32, 0.86);
    backdrop-filter: blur(6px);
    color: #f3edff;
  }
  .tkc__title {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    color: #fff3dc;
    text-shadow: 0 0 12px rgba(255, 181, 71, 0.35);
  }
  .tkc__hint {
    margin: 0 0 0.6rem;
    font-size: 0.84rem;
    line-height: 1.8;
    color: rgba(214, 201, 238, 0.85);
  }
  .tkc__box {
    min-height: 6rem;
  }
</style>
