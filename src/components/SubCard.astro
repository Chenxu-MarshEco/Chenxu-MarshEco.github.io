---
/**
 * 版块页里的一个「子页面入口」。
 *
 * 三处都在用它，所以单独抽出来：
 *   1. 花娅陌域那种分区面板里的清单
 *   2. 竖排页面上一条条占满整行的宽幅大卡
 *   3. 页面内容里插进来的「子页面」块
 *
 * 样式全在这个文件里 —— 用它的页面各自有自己的作用域样式，
 * Astro 的作用域选择器跨不进组件内部，卡片一多就容易出现
 * 「这里能改、那里改不动」的怪事。所以卡片的形状、大小、
 * 悬停效果统统归它自己管，外面只传参数。
 *
 * 两种基本形态：
 *   传了封面图 → 图铺满整块（微微半透明），名字压在正中
 *   没传封面图 → 不摆空图位，就是一条扁平的名字条
 * 都不放右箭头 —— 整块本来就是链接。
 */
import { coverUrl, coverUrlHd } from '../utils/images';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  url: string;
  image?: string;
  /**
   * 形状：
   *   row    默认，跟着内容走（面板里的清单用这个）
   *   wide / square / tall  按比例（页面内容里的子页面块用）
   */
  shape?: 'row' | 'wide' | 'square' | 'tall';
  /** 大小（最大宽度占容器的多少），row 永远占满 */
  size?: 'l' | 'm' | 's';
  /**
   * 链接版块：url 是站外地址（或站内锚点）。
   * 只是换个打开方式（新标签页，别把人从站里带走），
   * 卡片样子完全一样 —— 地址本身不显示在页面上。
   */
  external?: boolean;
  /**
   * 明确的像素宽高（可选）。填了就盖过 shape/size 那套档位 ——
   * 「这张卡改小一点」用具体数字最直接，也不像缩放那样把里面的字一起缩小。
   */
  width?: number;
  height?: number;
  /**
   * 这张卡认领的时间点/时间段在这条轴上的位置（0~1）。
   * 有值就写成 data-tl-param —— 滚到这张卡时右侧时间轴停到对应刻度。
   * 没认领、或者这一页压根没有时间轴，就是 null（不写这个属性）。
   */
  tlParam?: number | null;
}

const {
  title,
  url,
  image,
  shape = 'row',
  size = 'l',
  external = false,
  width,
  height,
  tlParam = null,
} = Astro.props;

/**
 * 像素宽高 + 封面图拼成一条内联样式。
 *
 * 封面给两条：
 *   --cover     单张 WebP（按 800 档），所有浏览器都认，是兜底
 *   --cover-hd  image-set 的 1x/2x（400 / 800），只有认 image-set 的浏览器用得上
 * 卡片在桌面上大概三百多 CSS px 宽，DPR1 的屏用 400 档就够（约 11KB），
 * 手机 DPR2 才需要 800 档。认不出 image-set 的浏览器拿 --cover 那张，照样有图。
 */
const cover = image ? coverUrl(image, 800) : null;
const coverHd = image ? coverUrlHd(image, 400, 800) : null;
const inlineStyle = [
  Number(width) > 0 ? `width:${Number(width)}px` : null,
  Number(height) > 0 ? `height:${Number(height)}px` : null,
  cover ? `--cover:${cover}` : null,
  coverHd ? `--cover-hd:${coverHd}` : null,
]
  .filter(Boolean)
  .join(';');
---

<a
  class:list={[
    'card',
    shape !== 'row' && `card--${shape}`,
    shape !== 'row' && `card--sz-${size}`,
    image && 'card--cover',
  ]}
  href={external ? url : withBase(url)}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
  style={inlineStyle || undefined}
  data-tl-param={tlParam === null ? undefined : String(tlParam)}
>
  <span class="card__label">{title}</span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
    min-height: 58px;
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 120, 190, 0.4);
    background: rgba(60, 8, 82, 0.5);
    text-align: center;
    text-decoration: none;
    color: #ffe6f6;
    /*
      让下面的 @container 能按「这张卡自己有多宽」来定字号。
      卡片是被栅格和面板摆布的：同一张卡在宽栏里占满一行、
      在窄栏里只剩一百来像素，用 vw 根本对不上号，
      只有容器查询问的是卡片本身的宽度。
      卡片本来就是 width:100%，所以这条尺寸包含不会改变它的宽度。
    */
    container-type: inline-size;
    transition:
      background 0.16s ease,
      border-color 0.16s ease,
      transform 0.16s ease;
  }

  /* 有封面图：整块就是一张图，比纯名字条高一些才有得看 */
  .card--cover {
    min-height: 92px;
    background-color: rgba(22, 2, 36, 0.9);
  }
  .card--cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--cover);
    background-size: cover;
    background-position: center;
    /* 微微半透明：底下的深色透上来一点，和整站的调子是一伙的 */
    opacity: 0.82;
    transition:
      opacity 0.18s ease,
      transform 0.4s ease;
  }
  /*
    认 image-set 的浏览器走这一条：按 DPR 在 400 / 800 两档里挑，
    桌面上就不用为了手机上那一份清晰度白白多下一倍。
    @supports 是必须的：--cover-hd 里是 image-set，浏览器不认它的话，
    直接写 `background-image: var(--cover-hd)` 会变成 IACVT 整条作废，
    连上面那条 --cover 兜底也一起没了（自定义属性不校验值，这是坑）。
  */
  @supports (background-image: image-set(url(a.png) 1x)) {
    .card--cover::before {
      background-image: var(--cover-hd);
    }
  }
  /* 再压一层很淡的暗底：名字要压在任意一张图上都读得清 */
  .card--cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      130% 130% at 50% 50%,
      rgba(12, 0, 20, 0.22) 0%,
      rgba(12, 0, 20, 0.62) 100%
    );
  }

  /*
    有形状的卡片（页面内容里的子页面块）。
    width:100% + aspect-ratio 必须成对写 —— 只给 aspect-ratio 的话，
    min-height 会反过来按比例把宽度撑出去（实测 1040 的容器里涨到 1120，溢出去）。
  */
  .card--wide {
    aspect-ratio: 16 / 3;
    min-height: clamp(120px, 18vw, 210px);
    padding: 0.9rem 1.2rem;
  }
  .card--square {
    aspect-ratio: 1 / 1;
    min-height: clamp(140px, 22vw, 260px);
    padding: 0.9rem 1.2rem;
  }
  .card--tall {
    aspect-ratio: 3 / 4;
    min-height: clamp(180px, 30vw, 340px);
    padding: 0.9rem 1.2rem;
  }
  .card--wide .card__label,
  .card--square .card__label,
  .card--tall .card__label {
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    letter-spacing: 0.12em;
  }

  /*
    大小 = 在「子页面」块那个六列栅格里占几列（见 PageContent 的 .pcards）。
    大 6 列一个人占一行、中 3 列两张一行、小 2 列三张一行 ——
    这样「大中小」在版面上真的看得出区别，而不是只有一条宽窄不同的条。

    不在栅格里的地方（面板清单、竖排页面）这两条 grid-column 是空转的，
    那里的卡片按自己的规则占满一行 —— 竖排本来就是「一律整行」。
  */
  .card--sz-l {
    grid-column: span 6;
  }
  .card--sz-m {
    grid-column: span 3;
  }
  .card--sz-s {
    grid-column: span 2;
  }

  .card__label {
    /* 压在图和暗底上面 */
    position: relative;
    z-index: 1;
    max-width: 100%;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    /*
      名字放不下就换行，不再用省略号截断。
      卡片名字本身就是导航 —— 「龙历院花娅…」等于没写，
      点进去之前根本不知道是哪一张。
      中文本来就能在任意字之间断行；overflow-wrap:anywhere 是给
      一长串没有空格的英文/数字留的后路，不然那种会顶破卡片。
      text-wrap:balance 让折成两行时断得均匀一点（老浏览器忽略即可）。
      再窄就交给下面的容器查询缩字号，而不是把字裁掉。
    */
    overflow-wrap: anywhere;
    text-wrap: balance;
    text-shadow:
      0 1px 6px rgba(10, 0, 18, 0.9),
      0 0 16px rgba(10, 0, 18, 0.7);
  }

  /*
    「显示不下就缩小字号」。
    按卡片自己的宽度分两档；用 .card .card__label（特异度 0,2,0）是为了
    压过上面 .card--square .card__label 那一组同特异度的字号规则 ——
    两边一样重，所以全靠写在后面取胜，这段必须留在它们下面。
    浏览器不认 @container 时整段忽略，退回「换行 + 原字号」，依然不截断。

    阈值取得偏小是故意的：@container 量的是**卡片的内容盒**，
    分区版式里那种窄栏卡在桌面宽度下卡片本身 192px，减掉
    .card--square 的左右内边距（各 1.2rem）只剩约 154px，
    而「龙历院花娅支部」这种七个字在 154px 里本来就放得下 ——
    阈值定高了会把本来放得下的字也缩小，白白改变观感。
    所以只有小到确实挤不下时才缩：换行仍是主力手段，缩字号只是兜底。
  */
  @container (max-width: 150px) {
    .card .card__label {
      font-size: 0.86rem;
      letter-spacing: 0.05em;
    }
  }
  @container (max-width: 110px) {
    .card .card__label {
      font-size: 0.78rem;
      letter-spacing: 0.02em;
    }
  }

  .card:hover,
  .card:focus-visible {
    border-color: #ffb3dd;
    color: #fff;
    transform: translateY(-1px);
  }
  .card:not(.card--cover):hover,
  .card:not(.card--cover):focus-visible {
    background: rgba(212, 0, 123, 0.72);
  }
  .card--cover:hover::before,
  .card--cover:focus-visible::before {
    opacity: 0.96;
    transform: scale(1.04);
  }

  @media (max-width: 46rem) {
    /*
      窄屏：栅格塌成一列，卡片一律铺满。
      三个档都要清 grid-column —— 只清中/小的话，大卡的 span 6
      会凭空造出 5 条隐式列，整行排成五六张一丁点宽的卡（实测
      430px 下「竖+小」那张只剩 40px）。
    */
    .card--sz-l,
    .card--sz-m,
    .card--sz-s {
      grid-column: auto;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover,
    .card:focus-visible {
      transform: none;
    }
  }
</style>
