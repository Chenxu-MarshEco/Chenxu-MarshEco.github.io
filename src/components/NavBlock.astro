---
/**
 * 导航块：把「导航分类库」里的几个**大分类**铺成一整块导航表。
 *
 * 数据在 src/data/navs.json（分类库），页面里只存分类 id 的列表 ——
 * 所以同一个大分类可以被好几个页面共用，改一次全都跟着变；
 * 条目里的链接指向哪一页都行（包括"独立页面"那种只能靠链接点进来的）。
 *
 * 结构照用户给的两张例图：
 *   顶上一行「分类：甲 · 乙」   —— 点一下跳到对应那一节
 *   每个大分类一节，可以整节收起 / 展开（原生 <details>，不引 JS）
 *   节里一行一个子分类：左边子分类名，右边一串「图标 + 文字」的条目
 *   条目文字点一下就跳到它填的地址（站内 / 站外都认）
 *
 * 折叠用原生 <details>：不写一行 JS 就有"展开 / 收起"，
 * 键盘（Tab + 回车）和读屏软件也天然认它。
 */
import { navCatsFor } from '../utils/navs';
import NavItems from './NavItems.astro';

interface Props {
  /** 这个块引用哪几个大分类（顺序就是显示顺序） */
  cats?: string[];
  /** 顶栏那行字，不写就叫「分类」 */
  text?: string;
  /**
   * 这个块的 id（页面块自带的那个）。
   * 只用来拼锚点：同一个大分类被两个块引到同一页时，
   * 光用分类 id 当锚点会出现重复 id，顶栏那两个跳转就会都跳到第一个去。
   */
  blockId?: string;
}

const { cats = [], text, blockId = '' } = Astro.props;
const list = navCatsFor(cats);
/** 这一块里某个大分类的锚点 id（分类 id 已经带 navcat- 前缀，这里不再重复加） */
const anchorOf = (catId: string) => `${blockId ? `${blockId}-` : ''}${catId}`;
/**
 * 顶上那行里，一个分类名点下去去哪、要不要做成链接。
 *
 * 默认是**页内锚点**（跳到下面自己那一节）—— 这是给「一块里挂了好几个分类」用的跳转索引。
 * 但一个分类时，那一节就在紧下面，点它等于什么都没发生：用户报的就是这个
 * （「这个导航二字旁边的纷湖 为什么可以点 点了根本没反应」）。
 * 所以：
 *   · 分类上填了 `link` → 真链接（站内 / 外链都认，外链开新标签）；
 *   · 没填、而且这一块里就它一个 → **不做成链接**，就是一行字（别装作能点）；
 *   · 没填、但有好几个分类 → 还是锚点链接（跳上跳下真有用）。
 */
const barHref = (cat: { link?: string }) => String(cat.link ?? '').trim();
const barIsLink = (i: number) => !!barHref(list[i]) || list.length > 1;
const isExternal = (href: string) => /^(https?:|mailto:|tel:)/i.test(href);
---

{
  list.length > 0 && (
    <section class="navblk">
      {/* 顶栏：这一页挂了哪几个大分类，点一下跳到那一节 */}
      <div class="navblk__bar">
        <span class="navblk__barLabel">{text || '分类'}</span>
        <span class="navblk__barList">
          {list.map((cat, i) => (
            <>
              {i > 0 && <span class="navblk__barDot">·</span>}
              {barIsLink(i) ? (
                <a
                  class="navblk__barLink"
                  href={barHref(cat) || `#${anchorOf(cat.id)}`}
                  {...isExternal(barHref(cat)) ? { target: '_blank', rel: 'noopener' } : {}}
                >
                  {cat.title}
                </a>
              ) : (
                /* 只有一个分类、又没填链接：这一行就是标题，不做成链接（点了也没反应的东西不该像链接） */
                <span class="navblk__barHere" title="这一块里只有这一个分类，它就在下面那一节">
                  {cat.title}
                </span>
              )}
            </>
          ))}
        </span>
      </div>

      {list.map((cat) => (
        <details class="navblk__cat" id={anchorOf(cat.id)} data-navcat={cat.id} open>
          <summary class="navblk__summary">
            <span class="navblk__catTitle">{cat.title}</span>
            {/* 收起 / 展开的提示：两个词都写出来，靠 details[open] 决定显示哪个 */}
            <span class="navblk__fold" aria-hidden="true">
              <span class="navblk__foldClose">收起</span>
              <span class="navblk__foldOpen">展开</span>
            </span>
          </summary>

          <div class="navblk__body">
            {cat.note && <p class="navblk__note">{cat.note}</p>}
            {cat.groups.length === 0 && <p class="navblk__note">（这个分类还没有子分类）</p>}
            {cat.groups.map((g) => (
              /*
                一个子分类。可能直接挂条目，也可能再细分一层
                （「友好生物」下面再分「无伤害能力 / 无攻击行为 / 攻击非玩家 / 条件敌对」）。
                两种都在时：先铺直接挂的条目（细分那层要缩进，所以它的标签留一格空），
                再铺细分类。父级名字在最左一列、纵跨整组 —— 和用户给的例图一个排法。
              */
              <div
                class:list={['navblk__row', (g.subgroups?.length ?? 0) > 0 && 'navblk__row--nest']}
                data-navgroup={g.id}
              >
                <div class="navblk__label">{g.title}</div>
                <div class="navblk__cells">
                  {g.items.length > 0 && (
                    <div class="navblk__cell">
                      {(g.subgroups?.length ?? 0) > 0 && <span class="navblk__sublabel" aria-hidden="true" />}
                      <div class="navblk__items">
                        <NavItems items={g.items} />
                      </div>
                    </div>
                  )}
                  {(g.subgroups ?? []).map((sg) => (
                    <div class="navblk__cell" data-navsubgroup={sg.id}>
                      <span class="navblk__sublabel">{sg.title}</span>
                      <div class="navblk__items">
                        {sg.items.length === 0 && <span class="navblk__empty">（空）</span>}
                        <NavItems items={sg.items} />
                      </div>
                    </div>
                  ))}
                  {g.items.length === 0 && (g.subgroups?.length ?? 0) === 0 && (
                    <div class="navblk__items">
                      <span class="navblk__empty">（空）</span>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </details>
      ))}
    </section>
  )
}

<style>
  /*
    一块导航表。配色跟着站点走（粉底 + 落日色强调），不照搬例图那个维基蓝 ——
    例图给的是**结构**：顶栏分类索引、可折叠的大分类、一行一个子分类、
    条目是「小图标 + 文字」、点文字跳转。这些都在，皮还是花涧堂自己的。
  */
  .navblk {
    margin: 1.4rem 0;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-bg-raised);
    overflow: hidden;
  }

  /* ---------- 顶栏：分类索引 ---------- */
  .navblk__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.45rem 0.8rem;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-bg-sunken);
    font-size: 0.82rem;
    color: var(--c-text-muted);
  }
  .navblk__barLabel {
    color: var(--c-accent);
    letter-spacing: 0.06em;
  }
  .navblk__barLink {
    color: var(--c-text);
    text-decoration: none;
    border-bottom: 1px dotted var(--c-border-strong);
  }
  .navblk__barLink:hover {
    color: var(--c-accent);
    border-bottom-color: var(--c-accent);
  }
  /*
    只有一个分类、又没填链接时这一行**不是链接**：不能长得像能点的东西 ——
    虚线底、hover 变色这些「可点」的暗示统统去掉（就是加粗一点的一行字）。
  */
  .navblk__barHere {
    color: var(--c-text);
    font-weight: 500;
    cursor: default;
  }
  .navblk__barDot {
    opacity: 0.55;
    margin: 0 0.1rem;
  }

  /* ---------- 大分类（可折叠） ---------- */
  .navblk__cat + .navblk__cat {
    border-top: 1px solid var(--c-border);
  }
  .navblk__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.8rem;
    cursor: pointer;
    list-style: none;
    background: var(--c-bg-sunken);
    font-size: 0.92rem;
    color: var(--c-text);
  }
  /* 收起浏览器默认那个三角，自己画一个跟着开合转 */
  .navblk__summary::-webkit-details-marker {
    display: none;
  }
  .navblk__summary::before {
    content: '▾';
    display: inline-block;
    color: var(--c-accent);
    transition: rotate var(--t-fast) var(--ease);
  }
  .navblk__cat:not([open]) .navblk__summary::before {
    rotate: -90deg;
  }
  .navblk__summary:hover {
    background: var(--c-accent-soft);
  }
  .navblk__summary:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: -2px;
  }
  .navblk__catTitle {
    letter-spacing: 0.08em;
  }
  .navblk__fold {
    margin-left: auto;
    font-size: 0.74rem;
    color: var(--c-text-faint);
  }
  .navblk__foldOpen {
    display: none;
  }
  .navblk__cat:not([open]) .navblk__foldClose {
    display: none;
  }
  .navblk__cat:not([open]) .navblk__foldOpen {
    display: inline;
  }

  /* ---------- 子分类一行 ---------- */
  .navblk__body {
    padding: 0.5rem 0.8rem 0.7rem;
  }
  .navblk__note {
    margin: 0 0 0.45rem;
    font-size: 0.82rem;
    color: var(--c-text-muted);
  }
  .navblk__row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.3rem 0;
  }
  .navblk__row + .navblk__row {
    border-top: 1px dashed var(--c-border);
  }
  .navblk__label {
    flex: none;
    width: 8.5rem;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--c-accent);
    letter-spacing: 0.04em;
  }

  /* ---------- 子分类再细分一层（友好生物 → 无伤害能力 / 攻击非玩家…） ---------- */
  /* 细分类竖着排成一列，父级名字在左边一列纵跨整组（和例图一个排法） */
  .navblk__cells {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .navblk__cell {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.12rem 0;
  }
  .navblk__cell + .navblk__cell {
    border-top: 1px dashed var(--c-border);
  }
  .navblk__sublabel {
    flex: none;
    width: 7rem;
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--c-text-muted);
    letter-spacing: 0.03em;
  }
  .navblk__items {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /*
      条目之间的横向间隔：条目本身排得紧，真正拉开距离的是那对小塔吊
      （`.navblk__sep` 自己带左右 margin，见 NavItems.astro）——
      以前这里是 0.15rem，两条之间只隔 2px，字看着就黏成一团了。
      纵向留 0.34rem：换行之后两行之间也要透气。
    */
    gap: 0.34rem 0.1rem;
  }
  .navblk__empty {
    font-size: 0.8rem;
    color: var(--c-text-faint);
  }

  /* 条目自己的样式在 NavItem.astro 里（谁渲染的元素谁管样式，见那边的说明） */

  /* 窄屏：子分类名单独占一行，别把条目挤成一条线（细分那层同理） */
  @media (max-width: 34rem) {
    .navblk__row {
      flex-direction: column;
      gap: 0.15rem;
    }
    .navblk__label {
      width: auto;
      line-height: 1.5;
    }
    .navblk__cell {
      flex-direction: column;
      gap: 0.1rem;
    }
    .navblk__sublabel {
      width: auto;
      line-height: 1.4;
    }
    /* 手机上窄，塔吊之间那点空收一收，一行好放下更多条目 */
    .navblk__items {
      gap: 0.3rem 0.06rem;
    }
  }
</style>
