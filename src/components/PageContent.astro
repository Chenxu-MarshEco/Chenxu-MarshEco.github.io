    margin: 0.4em 0;
  }
  .ptext :global(hr) {
    border: none;
    border-top: 1px solid rgba(255, 120, 190, 0.28);
    margin: 1.4em 0;
  }

  /* ---------- 图片 ---------- */
  .pfigure {
    margin: 0;
  }
  .pfigure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid rgba(255, 120, 190, 0.35);
    box-shadow: 0 14px 40px rgba(10, 0, 20, 0.45);
  }
  .pfigure figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: rgba(255, 226, 244, 0.6);
  }
  /* 宽度分档：窄的靠左 */
