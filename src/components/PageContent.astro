    color: #fff;
    letter-spacing: 0.08em;
    text-shadow: 0 0 12px rgba(255, 79, 163, 0.6);
  }
  .ptext :global(h2) {
    font-size: 1.3rem;
  }
  .ptext :global(h3) {
    font-size: 1.1rem;
  }

  /*
    目录点一条会跳到这里，跳过去时得给吸顶页头让出位置，
    不然标题正好被页头压住，看起来像「跳歪了」。
    5.5rem 和 global.css 里 .prose 用的是同一个值。
  */
  .ptext :global(h1),
  .ptext :global(h2),
  .ptext :global(h3),
  .ptext :global(h4),
  .pcols__col :global(h1),
  .pcols__col :global(h2),
  .pcols__col :global(h3),
  .pcols__col :global(h4) {
    scroll-margin-top: 5.5rem;
  }
  .ptext :global(a) {
    color: #ffb3dd;
    text-decoration: underline;
    text-decoration-color: rgba(255, 179, 221, 0.45);
    text-underline-offset: 0.2em;
  }
  .ptext :global(a:hover) {
    color: #fff;
  }
  .ptext :global(strong) {
    color: #fff;
  }
  .ptext :global(ul),
  .ptext :global(ol) {
