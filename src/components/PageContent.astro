---
/**
 * 版块页里「自己写的那段内容」。
 *
 * 数据是节点上的 page 数组，九种块：
 *   text      介绍文字（Markdown：段落、粗体、列表、行内链接、行内图片都能写；
 *             还支持 [[文字|图片地址|链接地址]] 这种悬停出图的写法）
 *   image     一张图，宽度可分档
 *   link      一个链接
 *   divider   一条横线，中间可以带一句话
 *   columns   左右两栏（各写一段 Markdown，窄屏自动叠起来）
 *   video     视频：视频文件直链，或 B 站 / YouTube 链接（自动变成播放器）
 *   posts     把归到这一页的文章列出来
 *   toc       这一页的目录：自动收集上面的小标题，做成可跳转的列表
 *   children  把这一层的子页面铺在这里，卡片的横竖比例和大小可分档
 *
 * 每个块外面都包了一层 [data-edit="pg-<id>"]：
 * 编辑器「排版」模式就是靠它把块拖走、缩放的。所以块 id 必须全站唯一。
 *
 * 没写 page 的页面不走这里 —— 它们仍然沿用老的「子版块自动铺开」。
 */
import { marked } from 'marked';
import SubCard from './SubCard.astro';
import { withBase } from '../utils/url';
import type { BlockItem, SubPost } from '../utils/boardPage';
import { isLinkUrl, type PageBlock } from '../utils/boards';

interface Props {
  blocks: PageBlock[];
  /** 这一层的子页面，供 children 块使用 */
  children: BlockItem[];
  /** 归到本节点的文章，供 posts 块使用 */
  posts: SubPost[];
}

const { blocks, children, posts } = Astro.props;

/*
  Markdown 用 marked 渲染。
  它装在 devDependencies 里（编辑器的实时预览也用同一个），
  而部署流程跑的是 pnpm install（不加 --prod），构建期拿得到。
  所以这里不用把它挪进 dependencies —— 挪了就得同步改 lockfile，
  而 CI 用的是 --frozen-lockfile，改不干净会直接把部署卡死。
*/
const renderText = (text: string) => marked.parse(text ?? '', { async: false }) as string;

/* ------------------------------------------------------------------
   目录（toc 块）

   它自己不写内容：把这一页里所有文字块 / 两栏块的小标题收集起来，
   编上号，做成一份能跳的列表。所以下面要先把整页渲染一遍再输出。
   ------------------------------------------------------------------ */

/** 目录里的一条 */
interface TocEntry {
  /** 2 = 一级，3 = 二级；目录只分两层，再深就看不清了 */
  depth: 2 | 3;
  slug: string;
  text: string;
}

/**
 * 标题文字 -> 锚点 id。
 * 中文原样留着（`## 常规行动` → `#常规行动`），空格变连字符，其余符号去掉。
 * 标题里可能写了 `**粗体**`，那会被渲染成标签，所以先剥一遍标签再算。
 */
function slugify(raw: string): string {
  const base = raw
    .replace(/<[^>]*>/g, '')
    .normalize('NFKC')
    .trim()
    .toLowerCase()
    .replace(/[\s\u3000]+/g, '-')
    .replace(/[^\p{L}\p{N}_-]+/gu, '')
    .replace(/-{2,}/g, '-')
    .replace(/^-+|-+$/g, '');
  return base || 'section';
}

/** 同一页里标题重名时依次加 -2、-3，保证 id 不撞 */
const usedSlugs = new Set<string>();
function uniqueSlug(raw: string): string {
  const base = slugify(raw);
  let slug = base;
  let n = 2;
  while (usedSlugs.has(slug)) slug = `${base}-${n++}`;
  usedSlugs.add(slug);
  return slug;
}

const hasToc = blocks.some((b) => b.type === 'toc');
const tocEntries: TocEntry[] = [];

/* ------------------------------------------------------------------
   悬停图片（文字指上去，上方弹出一张图；可以顺带挂一个链接）

   正文里直接写，两栏块里也一样：
     [[文字|图片地址]]             鼠标指上去，文字上方弹出这张图
     [[文字|图片地址|链接地址]]     同上，而且点文字会跳到这个地址

   为什么不用现成的 Markdown 语法：
   `[文字](地址)` 已经被链接占了，再往里面塞图片就没法区分
   「这张图是拿来悬停看的」还是「点了要打开这张图」。
   而 `[[ ]]` 在 Markdown 里本来就不是语法，以前是原样显示的，
   拿来用正好，也完全不影响已经写好的内容。
   ------------------------------------------------------------------ */

/** 往 HTML 属性里塞内容前必须转义，否则一个引号就能把标签撑破 */
const escAttr = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

/** 站内路径补上 base，站外原样 */
const asSrc = (raw: string) => (/^https?:\/\//i.test(raw) ? raw : withBase(raw));

function hoverCardHtml(label: string, img: string, href: string): string {
  const src = img.trim();
  if (!src) return '';
  // 文字里允许写 **粗体**、`代码` 这类行内标记，单独渲染一遍
  const text = marked.parseInline(label.trim(), { async: false }) as string;
  const picture = `<img class="phover__img" src="${escAttr(asSrc(src))}" alt="" loading="lazy" decoding="async" />`;

  const url = href.trim();
  /*
    没写链接（或地址不安全）就是一段纯文字。
    给它一个 tabindex：只认鼠标的话，键盘用户永远看不到这张图。
  */
  if (!url || !isLinkUrl(url)) {
    return `<span class="phover" tabindex="0"><span class="phover__label">${text}</span><span class="phover__pop">${picture}</span></span>`;
  }
  const external = /^https?:/i.test(url);
  const anchor = `<a class="phover__label" href="${escAttr(asSrc(url))}"${external ? ' target="_blank" rel="noopener"' : ''}>${text}</a>`;
  return `<span class="phover">${anchor}<span class="phover__pop">${picture}</span></span>`;
}

/*
  占位符用一对「私有区」字符包住序号：这俩码位是留给字体自定义的，
  正常文字里不会出现，marked 也认不出、不会去动它。
*/
const PH_OPEN = '\uE000';
const PH_CLOSE = '\uE001';
const PH_RE = new RegExp(`${PH_OPEN}(\\d+)${PH_CLOSE}`, 'g');
const HOVER_RE = /\[\[([^[\]|]+)\|([^[\]|]+)(?:\|([^[\]|]+))?\]\]/g;

/**
 * 先把 [[...]] 抽出来换成占位符。
 *
 * 必须在交给 marked **之前**做：marked 的自动链接会把写在里面的
 * `https://…` 变成 `<a>`，还顺手把后面的 `]]` 一起吞进链接文字里
 * （实测：`[[文字|图.png|https://example.com]]` 会被拆得认不出来）。
 * 先抽走、渲染完再换回来，才拿得到干净的结果。
 */
function takeHoverCards(text: string): { src: string; cards: string[] } {
  const cards: string[] = [];
  const src = (text ?? '').replace(HOVER_RE, (whole, label: string, img: string, href = '') => {
    const html = hoverCardHtml(label, img, href);
    if (!html) return whole;
    cards.push(html);
    return `${PH_OPEN}${cards.length - 1}${PH_CLOSE}`;
  });
  return { src, cards };
}

/**
 * 渲染一段 Markdown：先还原悬停卡片，再（按需要）给里面的小标题补 id 并记进目录。
 *
 * 为什么用正则改 HTML，而不是让 marked 自己吐 id：
 * marked 从 8 开始就不再自动生成标题 id 了，要自己写 renderer / walkTokens。
 * 而这里要的非常窄 —— 实测它输出的标题就是干干净净的 `<h2>…</h2>`
 * （没有属性、不会嵌套），一次 replace 既够用，又不会误伤正文里别的标签；
 * 走 walkTokens 反而得把整段 HTML 重拼一遍，更容易出错。
 *
 * collect 为 false 时跳过补 id：没放目录块的页面，DOM 和以前一样。
 */
function renderTracked(text: string, collect: boolean): string {
  const { src, cards } = takeHoverCards(text);
  let html = renderText(src);

  if (cards.length) {
    // 还原要在收集标题之前：标题里若写了悬停卡片，
    // 目录取的是剥完标签的文字，不能把占位符漏进去
    html = html.replace(PH_RE, (_, i: string) => cards[Number(i)] ?? '');
  }

  if (!collect) return html;

  return html.replace(/<(h[1-4])>([\s\S]*?)<\/\1>/g, (whole, tag: string, inner: string) => {
    const plain = inner.replace(/<[^>]*>/g, '').trim();
    if (!plain) return whole;
    const slug = uniqueSlug(plain);
    // h1/h2 当一级，h3/h4 当二级
    tocEntries.push({ depth: Number(tag[1]) <= 2 ? 2 : 3, slug, text: plain });
    return `<${tag} id="${slug}">${inner}</${tag}>`;
  });
}

/*
  两趟渲染。

  必须先把整页的文字过一遍：目录块经常排在正文开头，如果按顺序边渲染边收集，
  轮到它的时候标题还一条都没收到，目录就是空的。
  渲染结果按块的下标存下来，下面真正输出时直接取，不重复渲染。

  两栏块按「先左后右」收集 —— 那就是它们在页面上的先后顺序。
*/
const textHtml = new Map<number, string>();
const columnsHtml = new Map<number, { left: string; right: string }>();
blocks.forEach((b, i) => {
  if (b.type === 'text') {
    textHtml.set(i, renderTracked(b.text, hasToc));
  } else if (b.type === 'columns') {
    columnsHtml.set(i, {
      left: renderTracked(b.left, hasToc),
      right: renderTracked(b.right, hasToc),
    });
  }
});

/** 目录按「一级 + 它底下的二级」分好组，输出时不用再套一层嵌套循环 */
const tocGroups: { entry: TocEntry; children: TocEntry[] }[] = [];
for (const e of tocEntries) {
  // 第一个标题就是 h3 的话也让它当一级，免得整份目录被丢掉
  if (e.depth === 2 || tocGroups.length === 0) tocGroups.push({ entry: e, children: [] });
  else tocGroups[tocGroups.length - 1].children.push(e);
}

/**
 * 带子标题的那些组，一进来是展开还是收起。
 *
 * 默认收起：只要有一个小标题底下挂着一长串子标题，整份目录立刻长得没法看
 * （冰室那页就是「冰室会员」一个 ## 下面挂了 18 条 ###）。
 * 收起来之后目录只列小标题，点它右边的小三角才把它铺开。
 * 想让所有分组一进来就是展开的，把这里改成 true 即可。
 */
const TOC_SUB_OPEN = false;

/**
 * 视频地址 -> 怎么播。
 *
 * 三种情况：
 *   视频文件（mp4 / webm / mov…）→ 直接用浏览器自带的 <video>
 *   B 站 / YouTube 页面地址      → 换成它们各自的播放器 iframe
 *   其它（认不出来）             → 退回一个普通链接，别硬塞个播不了的框
 *
 * B 站的 iframe 播放器只要 bvid/aid，不需要登录；页面上也不会因此多出
 * 什么脚本，就是浏览器原生支持的一个框。
 */
type VideoPlan =
  | { kind: 'file'; src: string }
  | { kind: 'iframe'; src: string }
  | { kind: 'link'; src: string };

const videoOf = (raw: string): VideoPlan => {
  const url = (raw ?? '').trim();
  const bili = /bilibili\.com\/video\/(BV[0-9A-Za-z]+|av\d+)/.exec(url);
  if (bili) {
    const isBv = bili[1].startsWith('BV');
    const q = isBv ? `bvid=${bili[1]}` : `aid=${bili[1].slice(2)}`;
    // 关掉自动播放：静音自动播很烦，用户自己点
    return { kind: 'iframe', src: `https://player.bilibili.com/player.html?${q}&autoplay=0` };
  }
  const yt = /(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{6,})/.exec(url);
  if (yt) {
    return { kind: 'iframe', src: `https://www.youtube-nocookie.com/embed/${yt[1]}` };
  }
  if (/\.(mp4|webm|ogv|ogg|mov|m4v)(\?.*)?$/i.test(url)) {
    return { kind: 'file', src: url.startsWith('http') ? url : withBase(url) };
  }
  return { kind: 'link', src: url };
};

/** 子页面块里的卡片怎么排（整块的默认值） */
const cardsOf = (b: Extract<PageBlock, { type: 'children' }>) => ({
  shape: (b.shape ?? 'wide') as 'wide' | 'square' | 'tall',
  size: (b.size ?? 'l') as 'l' | 'm' | 's',
});
---

<div class="page">
  {
    blocks.map((b, bi) => {
      /* 单张卡自己的设置优先：子版块上设了 cardShape/cardSize 就用它，
         没设才用「子页面」块上的默认值 */
      const video = b.type === 'video' ? videoOf(b.src) : null;

      return (
        <div class="pblock" data-edit={`pg-${b.id}`} data-block-type={b.type}>
          {b.type === 'text' && <div class="ptext" set:html={textHtml.get(bi) ?? ''} />}

          {b.type === 'image' && (
            <figure class:list={['pfigure', `pfigure--${b.width ?? 'wide'}`]}>
              <img src={withBase(b.src)} alt={b.alt ?? ''} loading="lazy" decoding="async" />
              {b.alt && <figcaption>{b.alt}</figcaption>}
            </figure>
          )}

          {b.type === 'link' && (
            <a
              class="plink"
              href={b.href.startsWith('http') || b.href.startsWith('#') ? b.href : withBase(b.href)}
              {...b.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {}}
            >
              <span class="plink__text">{b.text}</span>
            </a>
          )}

          {b.type === 'divider' && (
            <div class="pdivider" role="separator">
              {b.text ? <span class="pdivider__text">{b.text}</span> : null}
            </div>
          )}

          {b.type === 'columns' && (
            <div class="pcols">
              <div class="pcols__col" set:html={columnsHtml.get(bi)?.left ?? ''} />
              <div class="pcols__col" set:html={columnsHtml.get(bi)?.right ?? ''} />
            </div>
          )}

          {b.type === 'video' && video && (
            <figure class="pvideo">
              {video.kind === 'file' && (
                <video class="pvideo__el" src={video.src} controls preload="metadata" playsinline>
                  你的浏览器不支持直接播放这个视频。
                </video>
              )}
              {video.kind === 'iframe' && (
                <iframe
                  class="pvideo__frame"
                  src={video.src}
                  title={b.caption || '视频'}
                  loading="lazy"
                  allowfullscreen
                  allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
                />
              )}
              {video.kind === 'link' && (
                <a class="plink" href={video.src} target="_blank" rel="noopener">
                  <span class="plink__text">{b.caption || b.src}</span>
                </a>
              )}
              {b.caption && video.kind !== 'link' && <figcaption>{b.caption}</figcaption>}
            </figure>
          )}

          {b.type === 'posts' && (
            <section class="pposts">
              {b.text ? <h2 class="pposts__title">{b.text}</h2> : null}
              {posts.length === 0 ? (
                <p class="pposts__empty">这一页还没有文章。</p>
              ) : (
                <ul class="pposts__list">
                  {posts.map((p) => (
                    <li>
                      {/* 有封面的给个小图（正文里的图不当封面） */}
                      {p.cover && (
                        <img class="pposts__cover" src={withBase(p.cover)} alt="" loading="lazy" decoding="async" />
                      )}
                      <a href={withBase(p.href)}>{p.title}</a>
                      <em>{p.date}</em>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )}

          {b.type === 'toc' &&
            (tocGroups.length === 0 ? (
              <p class="ptoc__empty">
                这一页还没有小标题。在上面加一个「文字」块，用 <code>## 小标题</code> 写一行，
                这里就会自动列出来。
              </p>
            ) : (
              <nav class="ptoc" aria-label={b.text || '目录'} data-toc>
                <p class="ptoc__title">
                  <span class="ptoc__label">{b.text || '目录'}</span>
                  <button class="ptoc__toggle" type="button" data-toc-toggle aria-expanded="true">
                    [隐藏]
                  </button>
                </p>
                <ol class="ptoc__list">
                  {tocGroups.map((g) => (
                    <li class="ptoc__item">
                      <a class="ptoc__link" href={`#${g.entry.slug}`} data-ptoc-slug={g.entry.slug}>
                        {g.entry.text}
                      </a>
                      {g.children.length > 0 && (
                        <>
                          {/*
                            展开 / 收起这一组底下的子标题。
                            刻意用 button 而不是链接：点它只开合、不跳转，
                            和小标题本身（点了是跳过去）互不干扰。
                            展开状态在 HTML 里就写死了，脚本没跑起来之前不会闪一下。
                          */}
                          <button
                            class:list={['ptoc__caret', TOC_SUB_OPEN && 'is-open']}
                            type="button"
                            data-ptoc-caret
                            aria-expanded={TOC_SUB_OPEN ? 'true' : 'false'}
                            aria-controls={`ptoc-sub-${g.entry.slug}`}
                            aria-label={`展开或收起「${g.entry.text}」的子标题`}
                            title="展开 / 收起子标题"
                          >
                            ▸
                          </button>
                          <ol
                            class="ptoc__sub"
                            id={`ptoc-sub-${g.entry.slug}`}
                            hidden={!TOC_SUB_OPEN}
                          >
                            {g.children.map((c) => (
                              <li class="ptoc__subitem">
                                <a class="ptoc__link" href={`#${c.slug}`} data-ptoc-slug={c.slug}>
                                  {c.text}
                                </a>
                              </li>
                            ))}
                          </ol>
                        </>
                      )}
                    </li>
                  ))}
                </ol>
              </nav>
            ))}

          {b.type === 'children' && (
            <div class="pcards" data-shape={cardsOf(b).shape} data-size={cardsOf(b).size}>
              {children.length === 0 && <p class="pcards__empty">这一层还没有子页面。</p>}
              {children.map((c) => (
                <SubCard
                  title={c.title}
                  url={c.url}
                  image={c.image}
                  shape={c.cardShape ?? cardsOf(b).shape}
                  size={c.cardSize ?? cardsOf(b).size}
                  external={c.external}
                  width={c.cardW}
                  height={c.cardH}
                />
              ))}
            </div>
          )}
        </div>
      );
    })
  }

  {/*
    没有 JS 时把子标题重新铺开。
    默认是收起的（见 TOC_SUB_OPEN），靠脚本展开；脚本要是不来，
    这些子标题就永远点不到了，所以这里补一段「强制显示」的样式。

    为什么用 set:html 而不是直接写 <style>：Astro 会把模板里普通的
    <style> 抽走、打包进样式表，那样这个 <noscript> 里就什么都不剩了。
    小三角也一并藏掉 —— 没有脚本时它按下去不会有任何反应。
  */}
  {hasToc && (
    <noscript
      set:html={'<style>.ptoc__sub[hidden]{display:block}.ptoc__caret{display:none}</style>'}
    />
  )}
</div>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.6rem);
  }

  /*
    每个块单独一层，才有东西给排版模式抓。
    transform 由 [data-edit] 上的 translate/scale 管，这里不要碰。
  */
  .pblock {
    min-width: 0;
  }

  /* ---------- 文字 ---------- */
  .ptext {
    font-size: 1rem;
    line-height: 1.9;
    color: rgba(255, 236, 248, 0.9);
    letter-spacing: 0.02em;
  }
  .ptext :global(p) {
    margin: 0 0 0.9em;
  }
  .ptext :global(p:last-child) {
    margin-bottom: 0;
  }
  .ptext :global(h2),
  .ptext :global(h3) {
    margin: 1.4em 0 0.5em;
    font-family: var(--font-display);
    color: #fff;
    letter-spacing: 0.08em;
    text-shadow: 0 0 12px rgba(255, 79, 163, 0.6);
  }
  .ptext :global(h2) {
    font-size: 1.3rem;
  }
  .ptext :global(h3) {
    font-size: 1.1rem;
  }

  /*
    目录点一条会跳到这里，跳过去时得给吸顶页头让出位置，
    不然标题正好被页头压住，看起来像「跳歪了」。
    5.5rem 和 global.css 里 .prose 用的是同一个值。
  */
  .ptext :global(h1),
  .ptext :global(h2),
  .ptext :global(h3),
  .ptext :global(h4),
  .pcols__col :global(h1),
  .pcols__col :global(h2),
  .pcols__col :global(h3),
  .pcols__col :global(h4) {
    scroll-margin-top: 5.5rem;
  }
  .ptext :global(a) {
    color: #ffb3dd;
    text-decoration: underline;
    text-decoration-color: rgba(255, 179, 221, 0.45);
    text-underline-offset: 0.2em;
  }
  .ptext :global(a:hover) {
    color: #fff;
  }
  .ptext :global(strong) {
    color: #fff;
  }
  .ptext :global(ul),
  .ptext :global(ol) {
    margin: 0 0 0.9em;
    padding-left: 1.4em;
  }
  .ptext :global(li) {
    margin: 0.25em 0;
  }
  .ptext :global(blockquote) {
    margin: 0 0 0.9em;
    padding: 0.2em 0 0.2em 1em;
    border-left: 3px solid rgba(255, 120, 190, 0.5);
    color: rgba(255, 226, 244, 0.72);
  }
  .ptext :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.35);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .ptext :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 0.4em 0;
  }
  .ptext :global(hr) {
    border: none;
    border-top: 1px solid rgba(255, 120, 190, 0.28);
    margin: 1.4em 0;
  }

  /* ---------- 图片 ---------- */
  .pfigure {
    margin: 0;
  }
  .pfigure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid rgba(255, 120, 190, 0.35);
    box-shadow: 0 14px 40px rgba(10, 0, 20, 0.45);
  }
  .pfigure figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: rgba(255, 226, 244, 0.6);
  }
  /* 宽度分档：窄的靠左 */
  .pfigure--full {
    width: 100%;
  }
  .pfigure--wide {
    width: min(100%, 44rem);
  }
  .pfigure--half {
    width: min(100%, 30rem);
  }
  .pfigure--third {
    width: min(100%, 20rem);
  }

  /* ---------- 链接 ---------- */
  .plink {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 120, 190, 0.5);
    background: rgba(60, 8, 82, 0.55);
    color: #ffd9ef;
    text-decoration: none;
    letter-spacing: 0.06em;
    transition:
      background 0.16s ease,
      border-color 0.16s ease,
      transform 0.16s ease;
  }
  .plink::after {
    content: '↗';
    font-size: 0.9em;
    color: #ffb3dd;
  }
  .plink:hover,
  .plink:focus-visible {
    background: rgba(212, 0, 123, 0.7);
    border-color: #ffb3dd;
    color: #fff;
    transform: translateY(-1px);
  }

  /* ---------- 分隔线 ---------- */
  .pdivider {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0.4rem 0;
  }
  /* 两边各一条线中间夹字；没写字时就是单独一条线 */
  .pdivider::before,
  .pdivider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 120, 190, 0.55), transparent);
  }
  .pdivider__text {
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    color: rgba(255, 226, 244, 0.7);
    white-space: nowrap;
  }

  /* ---------- 两栏 ---------- */
  .pcols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.9rem, 2vw, 1.8rem);
  }
  .pcols__col {
    min-width: 0;
    font-size: 0.98rem;
    line-height: 1.9;
    color: rgba(255, 236, 248, 0.9);
  }
  .pcols__col :global(p) {
    margin: 0 0 0.9em;
  }
  .pcols__col :global(p:last-child) {
    margin-bottom: 0;
  }
  .pcols__col :global(h2),
  .pcols__col :global(h3) {
    margin: 1.2em 0 0.4em;
    font-family: var(--font-display);
    color: #fff;
    letter-spacing: 0.08em;
  }
  .pcols__col :global(a) {
    color: #ffb3dd;
  }
  .pcols__col :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .pcols__col :global(ul),
  .pcols__col :global(ol) {
    margin: 0 0 0.9em;
    padding-left: 1.3em;
  }

  /* ---------- 视频 ---------- */
  .pvideo {
    margin: 0;
  }
  .pvideo__el,
  .pvideo__frame {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid rgba(255, 120, 190, 0.35);
    border-radius: 12px;
    background: rgba(10, 0, 18, 0.6);
    box-shadow: 0 14px 40px rgba(10, 0, 20, 0.45);
  }
  .pvideo figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: rgba(255, 226, 244, 0.6);
  }

  /* ---------- 文章列表 ---------- */
  .pposts {
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 120, 190, 0.3);
    background: rgba(38, 4, 52, 0.4);
  }
  .pposts__title {
    margin: 0 0 0.6rem;
    font-size: 0.98rem;
    letter-spacing: 0.14em;
    color: rgba(255, 236, 248, 0.85);
  }
  .pposts__empty {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(255, 226, 244, 0.6);
  }
  .pposts__list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 2px solid rgba(255, 120, 190, 0.35);
  }
  .pposts__list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.24rem 0;
  }
  /* 文章行左边的小封面 */
  .pposts__cover {
    flex: 0 0 auto;
    width: 54px;
    height: 36px;
    object-fit: cover;
    border-radius: 7px;
    border: 1px solid rgba(255, 120, 190, 0.3);
    background: rgba(20, 0, 30, 0.45);
  }
  .pposts__list a {
    flex: 1 1 auto;
    min-width: 0;
    color: #ffd9ef;
    text-decoration: none;
    font-size: 0.92rem;
  }
  .pposts__list a:hover {
    color: #fff;
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.9);
  }
  .pposts__list em {
    font-style: normal;
    font-size: 0.72rem;
    color: rgba(255, 226, 244, 0.55);
    white-space: nowrap;
  }

  /* ---------- 子页面 ---------- */
  /*
    六列栅格：卡片的「大小」档就是占几列（见 SubCard 的 .card--sz-*）。
    l 一列一行、m 两张一行、s 三张一行；窄屏塌成一列。
  */
  .pcards {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: start;
    gap: clamp(0.7rem, 1.4vw, 1.1rem);
  }
  .pcards__empty {
    grid-column: 1 / -1;
    margin: 0;
    color: rgba(255, 226, 244, 0.6);
    font-size: 0.9rem;
  }

  /* ---------- 悬停图片 ---------- */
  /*
    ⚠ 这一组元素是 set:html 注入进来的，身上没有 Astro 的作用域标记
    （data-astro-cid-…），所以每条都得写 :global()，否则编译出来的
    选择器是 .phover[data-astro-cid-…]，一条都匹配不上 ——
    表现是弹层永远摊在正文里、样式全无，而构建一点错都不报。
    这和本文件里 .ptext :global(h2) 是同一个原因。

    同时要锚在 .ptext / .pcols__col 下面：光写 :global(.phover)
    就变成全站通配了，别的组件万一也叫这个名会被牵连。
  */
  .ptext :global(.phover),
  .pcols__col :global(.phover) {
    /* inline-block 是必须的：弹层要相对这段文字定位，
       纯 inline 的话 absolute 的参照系会跑偏 */
    position: relative;
    display: inline-block;
  }

  /* 虚线在底下划一道：让人看出「这里指一下有东西」，和普通链接区分开 */
  .ptext :global(.phover__label),
  .pcols__col :global(.phover__label) {
    color: #ffb3dd;
    text-decoration: underline dashed;
    text-decoration-color: rgba(255, 179, 221, 0.55);
    text-underline-offset: 0.22em;
    cursor: help;
  }
  .ptext :global(a.phover__label),
  .pcols__col :global(a.phover__label) {
    cursor: pointer;
  }
  .ptext :global(.phover__label:hover),
  .pcols__col :global(.phover__label:hover) {
    color: #fff;
  }

  /*
    弹层在文字正上方。
    只改 opacity / transform / visibility —— 不占布局，
    所以指上去的时候底下的正文一个字都不会挪。
    pointer-events:none 免得它自己把鼠标吸走，导致抖个不停。
  */
  .ptext :global(.phover__pop),
  .pcols__col :global(.phover__pop) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.55rem);
    z-index: 30;
    padding: 6px;
    border: 1px solid rgba(255, 120, 190, 0.5);
    border-radius: 12px;
    background: rgba(24, 3, 38, 0.94);
    box-shadow: 0 16px 40px rgba(8, 0, 16, 0.6);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    pointer-events: none;
  }
  /* focus-within 一起管上：键盘 Tab 过来也能看到图 */
  .ptext :global(.phover:hover .phover__pop),
  .ptext :global(.phover:focus-within .phover__pop),
  .pcols__col :global(.phover:hover .phover__pop),
  .pcols__col :global(.phover:focus-within .phover__pop) {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .ptext :global(.phover__img),
  .pcols__col :global(.phover__img) {
    display: block;
    width: auto;
    /* 窄屏上别把弹层撑出屏幕 */
    max-width: min(320px, 70vw);
    max-height: 260px;
    border-radius: 8px;
  }

  /* ---------- 目录 ---------- */
  .ptoc {
    margin: 0;
    padding: clamp(0.9rem, 2vw, 1.3rem) clamp(1rem, 2.4vw, 1.5rem);
    border: 1px solid rgba(255, 120, 190, 0.42);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(46, 8, 70, 0.78), rgba(20, 3, 34, 0.78));
    box-shadow: 0 14px 40px rgba(10, 0, 20, 0.45);
  }

  .ptoc__title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.02rem;
    letter-spacing: 0.14em;
    text-shadow: 0 0 12px rgba(255, 79, 163, 0.6);
  }

  /* [隐藏] / [显示] 就是个朴素的小按钮，别抢标题的注意力 */
  .ptoc__toggle {
    padding: 0;
    border: 0;
    background: none;
    color: rgba(255, 179, 221, 0.78);
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .ptoc__toggle:hover {
    color: #fff;
  }

  /*
    序号用 CSS 计数器，而不是 <ol> 自带的编号：
    只有计数器才做得出「一级 1 2 3、二级跟着一级走成 4.1 4.2」这种编号，
    嵌套 <ol> 只会各数各的（一级 4、二级 1）。
  */
  .ptoc__list,
  .ptoc__sub {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ptoc__list {
    counter-reset: ptoc-l1;
  }
  .ptoc__item {
    counter-increment: ptoc-l1;
    /*
      两列网格：小标题在第一列，展开 / 收起的小三角在第二列（靠右）。
      用 grid 而不是中间插一层 div，是为了让上面那条
      `.ptoc__item > .ptoc__link::before` 继续成立 ——
      套了 wrapper 就得再多写一层选择器。
    */
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
  }
  .ptoc__sub {
    margin: 0.1rem 0 0.3rem 1.4rem;
    counter-reset: ptoc-l2;
    /* 子列表自己占一行、横跨两列，别挤到小三角那一列去 */
    grid-column: 1 / -1;
  }
  .ptoc__subitem {
    counter-increment: ptoc-l2;
  }

  /*
    展开 / 收起的小三角。只有这一组真带子标题时才渲染出来。
    展开状态就是把三角转 90 度朝下 —— 和右上角目录抽屉里的箭头一个手感。
  */
  .ptoc__caret {
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: rgba(255, 140, 200, 0.85);
    font-size: 0.72rem;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .ptoc__caret:hover {
    color: #fff;
  }
  .ptoc__caret.is-open {
    transform: rotate(90deg);
  }

  /* hidden 属性是 UA 样式里的 display:none，优先级很低，
     不显式写一条就会被下面的 display:block 盖掉、收起失效 */
  .ptoc__list[hidden] {
    display: none;
  }

  .ptoc__link {
    display: block;
    padding: 0.16rem 0;
    color: rgba(255, 226, 244, 0.86);
    font-size: 0.94rem;
    line-height: 1.6;
    text-decoration: none;
  }
  .ptoc__item > .ptoc__link::before {
    content: counter(ptoc-l1) ' ';
    color: rgba(255, 140, 200, 0.9);
  }
  .ptoc__subitem > .ptoc__link::before {
    content: counter(ptoc-l1) '.' counter(ptoc-l2) ' ';
    color: rgba(255, 140, 200, 0.72);
  }
  .ptoc__sub .ptoc__link {
    font-size: 0.86rem;
  }
  .ptoc__link:hover,
  .ptoc__link.is-active {
    color: #fff;
  }
  .ptoc__link.is-active {
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.85);
  }

  /* 插了目录块但页面里还没有小标题时，给编辑的人一句提示 */
  .ptoc__empty {
    margin: 0;
    padding: 0.7rem 0.95rem;
    border: 1px dashed rgba(255, 120, 190, 0.4);
    border-radius: 10px;
    color: rgba(255, 226, 244, 0.62);
    font-size: 0.88rem;
  }
  .ptoc__empty code {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.3);
    font-size: 0.92em;
  }

  /* 窄屏：两栏叠起来、卡片一律占满 */
  @media (max-width: 46rem) {
    .pcols {
      grid-template-columns: minmax(0, 1fr);
    }
    .pcards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plink {
      transition: none;
    }
    .plink:hover {
      transform: none;
    }
    /* 直接出现 / 直接消失，不做那个 4px 的位移和淡入 */
    .ptext :global(.phover__pop),
    .pcols__col :global(.phover__pop) {
      transition: none;
      transform: translate(-50%, 0);
    }
    /* 小三角开合时不要转，直接就位 */
    .ptoc__caret {
      transition: none;
    }
  }
</style>

<script>
  /*
    目录：[隐藏 / 显示] 开关 + 滚动时高亮当前所在的那一条。

    跳转本身不用脚本 —— 就是普通锚点（href="#slug"），
    交给浏览器原生处理，中键新开、右键复制链接都能用。
    平滑滚动也是 global.css 里 html{scroll-behavior:smooth} 管的。

    一个页面可能没有目录，也可能有不止一个块，所以整段按 [data-toc] 逐个处理；
    没有目录时下面这个循环一次都不进，等于没加载过。
  */
  for (const nav of document.querySelectorAll<HTMLElement>('[data-toc]')) {
    const toggle = nav.querySelector<HTMLButtonElement>('[data-toc-toggle]');
    const list = nav.querySelector<HTMLElement>('.ptoc__list');

    if (toggle && list) {
      toggle.addEventListener('click', () => {
        const collapsed = !list.hidden;
        list.hidden = collapsed;
        toggle.textContent = collapsed ? '[显示]' : '[隐藏]';
        toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      });
    }

    /*
      子标题的展开 / 收起：每个带子标题的小标题右边那个小三角。
      点它只开合自己这一组；小标题本身是链接，点了照旧跳转，两件事互不干扰。

      这段必须放在下面「一个锚点都找不到就 continue」之前 ——
      滚动高亮那边没活干时，开合也得照常能用。
    */
    for (const caret of nav.querySelectorAll<HTMLButtonElement>('[data-ptoc-caret]')) {
      // 小三角和它管的子列表同在一个 li 里，就地找，不必额外编 id
      const sub = caret.parentElement?.querySelector<HTMLElement>('.ptoc__sub');
      if (!sub) continue;
      caret.addEventListener('click', () => {
        // 现在藏着 = 这次要展开
        const open = sub.hidden;
        sub.hidden = !open;
        caret.classList.toggle('is-open', open);
        caret.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.ptoc__link'));
    /*
      锚点 id 从 data-ptoc-slug 上读，不去解析 href。
      标题是中文，href 里的 hash 会被浏览器按 URL 编码成 %E5%B8%B8…，
      再解码回来纯属绕远路，直接存一份原样的 slug 最省事。
    */
    const targets = links
      .map((link) => document.getElementById(link.dataset.ptocSlug ?? ''))
      .filter((el): el is HTMLElement => el !== null);
    if (targets.length === 0) continue;

    const setActive = (id: string) => {
      for (const link of links) {
        link.classList.toggle('is-active', link.dataset.ptocSlug === id);
      }
    };

    /*
      注意 rootMargin 的单位：IntersectionObserver 只认 px 和 %，
      写 rem 会当场抛 SyntaxError，整段脚本挂掉、高亮永远不生效，
      而且只在控制台留一行错，页面上完全看不出异常。
      所以按根字号把 5rem 换算成 px —— 顺手也跟着用户的字号设置走。
      5rem 是为了压过顶部吸顶页头那一段，和上面的 scroll-margin-top 一个用意见。
    */
    const remPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: `-${Math.round(remPx * 5)}px 0px -70% 0px`, threshold: 0 }
    );

    for (const target of targets) observer.observe(target);
  }
</script>
