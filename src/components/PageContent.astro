---
/**
 * 版块页里「自己写的那段内容」。
 *
 * 数据是节点上的 page 数组，十种块：
 *   text      介绍文字（Markdown：段落、粗体、列表、行内链接、行内图片都能写；
 *             还支持 [[文字|图片地址|链接地址]] 这种悬停出图的写法）
 *   image     一张图，宽度可分档
 *   link      一个链接
 *   divider   一条横线，中间可以带一句话
 *   columns   左右两栏（各写一段 Markdown，窄屏自动叠起来）
 *   video     视频：视频文件直链，或 B 站 / YouTube 链接（自动变成播放器）
 *   posts     把归到这一页的文章列出来
 *   toc       这一页的目录：自动收集上面的小标题，做成可跳转的列表
 *   map       一张能缩放、能拖的地图，上面钉着若干塔吊地标：
 *             鼠标移上去显示建筑名，点它跳到那一页；旁边还有开关可以把地标全藏起来
 *   children  把这一层的子页面铺在这里，卡片的横竖比例和大小可分档
 *
 * 每个块外面都包了一层 [data-edit="pg-<id>"]：
 * 编辑器「排版」模式就是靠它把块拖走、缩放的。所以块 id 必须全站唯一。
 *
 * 没写 page 的页面不走这里 —— 它们仍然沿用老的「子版块自动铺开」。
 */
import { marked } from 'marked';
import SubCard from './SubCard.astro';
import { withBase } from '../utils/url';
import type { BlockItem, SubPost } from '../utils/boardPage';
import { DEFAULT_LINE_COLOR, isLinkUrl, mapPages, type PageBlock } from '../utils/boards';
import { refParam, type Timeline } from '../utils/timelines';

interface Props {
  blocks: PageBlock[];
  /** 这一层的子页面，供 children 块使用 */
  children: BlockItem[];
  /** 归到本节点的文章，供 posts 块使用 */
  posts: SubPost[];
  /** 这一页用的时间轴；用来给认领了时间点/时间段的块标上 data-tl-param */
  timeline?: Timeline;
}

const { blocks, children, posts, timeline } = Astro.props;

/*
  Markdown 用 marked 渲染。
  它装在 devDependencies 里（编辑器的实时预览也用同一个），
  而部署流程跑的是 pnpm install（不加 --prod），构建期拿得到。
  所以这里不用把它挪进 dependencies —— 挪了就得同步改 lockfile，
  而 CI 用的是 --frozen-lockfile，改不干净会直接把部署卡死。
*/
const renderText = (text: string) => marked.parse(text ?? '', { async: false }) as string;

/* ------------------------------------------------------------------
   目录（toc 块）

   它自己不写内容：把这一页里所有文字块 / 两栏块的小标题收集起来，
   编上号，做成一份能跳的列表。所以下面要先把整页渲染一遍再输出。
   ------------------------------------------------------------------ */

/** 目录里的一条 */
interface TocEntry {
  /** 2 = 一级，3 = 二级；目录只分两层，再深就看不清了 */
  depth: 2 | 3;
  slug: string;
  text: string;
}

/**
 * 标题文字 -> 锚点 id。
 * 中文原样留着（`## 常规行动` → `#常规行动`），空格变连字符，其余符号去掉。
 * 标题里可能写了 `**粗体**`，那会被渲染成标签，所以先剥一遍标签再算。
 */
function slugify(raw: string): string {
  const base = raw
    .replace(/<[^>]*>/g, '')
    .normalize('NFKC')
    .trim()
    .toLowerCase()
    .replace(/[\s\u3000]+/g, '-')
    .replace(/[^\p{L}\p{N}_-]+/gu, '')
    .replace(/-{2,}/g, '-')
    .replace(/^-+|-+$/g, '');
  return base || 'section';
}

/** 同一页里标题重名时依次加 -2、-3，保证 id 不撞 */
const usedSlugs = new Set<string>();
function uniqueSlug(raw: string): string {
  const base = slugify(raw);
  let slug = base;
  let n = 2;
  while (usedSlugs.has(slug)) slug = `${base}-${n++}`;
  usedSlugs.add(slug);
  return slug;
}

const hasToc = blocks.some((b) => b.type === 'toc');
const tocEntries: TocEntry[] = [];

/* ------------------------------------------------------------------
   悬停图片（文字指上去，上方弹出一张图；可以顺带挂一个链接）

   正文里直接写，两栏块里也一样：
     [[文字|图片地址]]             鼠标指上去，文字上方弹出这张图
     [[文字|图片地址|链接地址]]     同上，而且点文字会跳到这个地址

   为什么不用现成的 Markdown 语法：
   `[文字](地址)` 已经被链接占了，再往里面塞图片就没法区分
   「这张图是拿来悬停看的」还是「点了要打开这张图」。
   而 `[[ ]]` 在 Markdown 里本来就不是语法，以前是原样显示的，
   拿来用正好，也完全不影响已经写好的内容。
   ------------------------------------------------------------------ */

/** 往 HTML 属性里塞内容前必须转义，否则一个引号就能把标签撑破 */
const escAttr = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

/** 站内路径补上 base，站外原样 */
const asSrc = (raw: string) => (/^https?:\/\//i.test(raw) ? raw : withBase(raw));

function hoverCardHtml(label: string, img: string, href: string): string {
  const src = img.trim();
  if (!src) return '';
  // 文字里允许写 **粗体**、`代码` 这类行内标记，单独渲染一遍
  const text = marked.parseInline(label.trim(), { async: false }) as string;
  const picture = `<img class="phover__img" src="${escAttr(asSrc(src))}" alt="" loading="lazy" decoding="async" />`;

  const url = href.trim();
  /*
    没写链接（或地址不安全）就是一段纯文字。
    给它一个 tabindex：只认鼠标的话，键盘用户永远看不到这张图。
  */
  if (!url || !isLinkUrl(url)) {
    return `<span class="phover" tabindex="0"><span class="phover__label">${text}</span><span class="phover__pop">${picture}</span></span>`;
  }
  const external = /^https?:/i.test(url);
  const anchor = `<a class="phover__label" href="${escAttr(asSrc(url))}"${external ? ' target="_blank" rel="noopener"' : ''}>${text}</a>`;
  return `<span class="phover">${anchor}<span class="phover__pop">${picture}</span></span>`;
}

/*
  占位符用一对「私有区」字符包住序号：这俩码位是留给字体自定义的，
  正常文字里不会出现，marked 也认不出、不会去动它。
*/
const PH_OPEN = '\uE000';
const PH_CLOSE = '\uE001';
const PH_RE = new RegExp(`${PH_OPEN}(\\d+)${PH_CLOSE}`, 'g');
const HOVER_RE = /\[\[([^[\]|]+)\|([^[\]|]+)(?:\|([^[\]|]+))?\]\]/g;

/**
 * 先把 [[...]] 抽出来换成占位符。
 *
 * 必须在交给 marked **之前**做：marked 的自动链接会把写在里面的
 * `https://…` 变成 `<a>`，还顺手把后面的 `]]` 一起吞进链接文字里
 * （实测：`[[文字|图.png|https://example.com]]` 会被拆得认不出来）。
 * 先抽走、渲染完再换回来，才拿得到干净的结果。
 */
function takeHoverCards(text: string): { src: string; cards: string[] } {
  const cards: string[] = [];
  const src = (text ?? '').replace(HOVER_RE, (whole, label: string, img: string, href = '') => {
    const html = hoverCardHtml(label, img, href);
    if (!html) return whole;
    cards.push(html);
    return `${PH_OPEN}${cards.length - 1}${PH_CLOSE}`;
  });
  return { src, cards };
}

/**
 * 渲染一段 Markdown：先还原悬停卡片，再（按需要）给里面的小标题补 id 并记进目录。
 *
 * 为什么用正则改 HTML，而不是让 marked 自己吐 id：
 * marked 从 8 开始就不再自动生成标题 id 了，要自己写 renderer / walkTokens。
 * 而这里要的非常窄 —— 实测它输出的标题就是干干净净的 `<h2>…</h2>`
 * （没有属性、不会嵌套），一次 replace 既够用，又不会误伤正文里别的标签；
 * 走 walkTokens 反而得把整段 HTML 重拼一遍，更容易出错。
 *
 * collect 为 false 时跳过补 id：没放目录块的页面，DOM 和以前一样。
 */
function renderTracked(text: string, collect: boolean): string {
  const { src, cards } = takeHoverCards(text);
  let html = renderText(src);

  if (cards.length) {
    // 还原要在收集标题之前：标题里若写了悬停卡片，
    // 目录取的是剥完标签的文字，不能把占位符漏进去
    html = html.replace(PH_RE, (_, i: string) => cards[Number(i)] ?? '');
  }

  if (!collect) return html;

  return html.replace(/<(h[1-4])>([\s\S]*?)<\/\1>/g, (whole, tag: string, inner: string) => {
    const plain = inner.replace(/<[^>]*>/g, '').trim();
    if (!plain) return whole;
    const slug = uniqueSlug(plain);
    // h1/h2 当一级，h3/h4 当二级
    tocEntries.push({ depth: Number(tag[1]) <= 2 ? 2 : 3, slug, text: plain });
    return `<${tag} id="${slug}">${inner}</${tag}>`;
  });
}

/*
  两趟渲染。

  必须先把整页的文字过一遍：目录块经常排在正文开头，如果按顺序边渲染边收集，
  轮到它的时候标题还一条都没收到，目录就是空的。
  渲染结果按块的下标存下来，下面真正输出时直接取，不重复渲染。

  两栏块按「先左后右」收集 —— 那就是它们在页面上的先后顺序。
*/
const textHtml = new Map<number, string>();
const columnsHtml = new Map<number, { left: string; right: string }>();
blocks.forEach((b, i) => {
  if (b.type === 'text') {
    textHtml.set(i, renderTracked(b.text, hasToc));
  } else if (b.type === 'columns') {
    columnsHtml.set(i, {
      left: renderTracked(b.left, hasToc),
      right: renderTracked(b.right, hasToc),
    });
  }
});

/** 目录按「一级 + 它底下的二级」分好组，输出时不用再套一层嵌套循环 */
const tocGroups: { entry: TocEntry; children: TocEntry[] }[] = [];
for (const e of tocEntries) {
  // 第一个标题就是 h3 的话也让它当一级，免得整份目录被丢掉
  if (e.depth === 2 || tocGroups.length === 0) tocGroups.push({ entry: e, children: [] });
  else tocGroups[tocGroups.length - 1].children.push(e);
}

/**
 * 带子标题的那些组，一进来是展开还是收起。
 *
 * 默认收起：只要有一个小标题底下挂着一长串子标题，整份目录立刻长得没法看
 * （冰室那页就是「冰室会员」一个 ## 下面挂了 18 条 ###）。
 * 收起来之后目录只列小标题，点它右边的小三角才把它铺开。
 * 想让所有分组一进来就是展开的，把这里改成 true 即可。
 */
const TOC_SUB_OPEN = false;

/**
 * 视频地址 -> 怎么播。
 *
 * 三种情况：
 *   视频文件（mp4 / webm / mov…）→ 直接用浏览器自带的 <video>
 *   B 站 / YouTube 页面地址      → 换成它们各自的播放器 iframe
 *   其它（认不出来）             → 退回一个普通链接，别硬塞个播不了的框
 *
 * B 站的 iframe 播放器只要 bvid/aid，不需要登录；页面上也不会因此多出
 * 什么脚本，就是浏览器原生支持的一个框。
 */
type VideoPlan =
  | { kind: 'file'; src: string }
  | { kind: 'iframe'; src: string }
  | { kind: 'link'; src: string };

const videoOf = (raw: string): VideoPlan => {
  const url = (raw ?? '').trim();
  const bili = /bilibili\.com\/video\/(BV[0-9A-Za-z]+|av\d+)/.exec(url);
  if (bili) {
    const isBv = bili[1].startsWith('BV');
    const q = isBv ? `bvid=${bili[1]}` : `aid=${bili[1].slice(2)}`;
    // 关掉自动播放：静音自动播很烦，用户自己点
    return { kind: 'iframe', src: `https://player.bilibili.com/player.html?${q}&autoplay=0` };
  }
  const yt = /(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{6,})/.exec(url);
  if (yt) {
    return { kind: 'iframe', src: `https://www.youtube-nocookie.com/embed/${yt[1]}` };
  }
  if (/\.(mp4|webm|ogv|ogg|mov|m4v)(\?.*)?$/i.test(url)) {
    return { kind: 'file', src: url.startsWith('http') ? url : withBase(url) };
  }
  return { kind: 'link', src: url };
};

/** 子页面块里的卡片怎么排（整块的默认值） */
const cardsOf = (b: Extract<PageBlock, { type: 'children' }>) => ({
  shape: (b.shape ?? 'wide') as 'wide' | 'square' | 'tall',
  size: (b.size ?? 'l') as 'l' | 'm' | 's',
});
---

<div class="page">
  {
    blocks.map((b, bi) => {
      /* 单张卡自己的设置优先：子版块上设了 cardShape/cardSize 就用它，
         没设才用「子页面」块上的默认值 */
      const video = b.type === 'video' ? videoOf(b.src) : null;
      /* 地图读成「页」的数组；老数据只有一页，见 utils/boards.ts 的 mapPages */
      const pages = b.type === 'map' ? mapPages(b) : [];

      return (
        <div
          class="pblock"
          data-edit={`pg-${b.id}`}
          data-block-type={b.type}
          data-tl-param={
            refParam(timeline, { point: b.timePoint, span: b.timeSpan }) === null
              ? undefined
              : String(refParam(timeline, { point: b.timePoint, span: b.timeSpan }))
          }
        >
          {b.type === 'text' && <div class="ptext" set:html={textHtml.get(bi) ?? ''} />}

          {b.type === 'image' && (
            <figure class:list={['pfigure', `pfigure--${b.width ?? 'wide'}`]}>
              <img src={withBase(b.src)} alt={b.alt ?? ''} loading="lazy" decoding="async" />
              {b.alt && <figcaption>{b.alt}</figcaption>}
            </figure>
          )}

          {b.type === 'link' && (
            <a
              class="plink"
              href={b.href.startsWith('http') || b.href.startsWith('#') ? b.href : withBase(b.href)}
              {...b.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {}}
            >
              <span class="plink__text">{b.text}</span>
            </a>
          )}

          {b.type === 'divider' && (
            <div class="pdivider" role="separator">
              {b.text ? <span class="pdivider__text">{b.text}</span> : null}
            </div>
          )}

          {b.type === 'columns' && (
            <div class="pcols">
              <div class="pcols__col" set:html={columnsHtml.get(bi)?.left ?? ''} />
              <div class="pcols__col" set:html={columnsHtml.get(bi)?.right ?? ''} />
            </div>
          )}

          {b.type === 'video' && video && (
            <figure class="pvideo">
              {video.kind === 'file' && (
                <video class="pvideo__el" src={video.src} controls preload="metadata" playsinline>
                  你的浏览器不支持直接播放这个视频。
                </video>
              )}
              {video.kind === 'iframe' && (
                <iframe
                  class="pvideo__frame"
                  src={video.src}
                  title={b.caption || '视频'}
                  loading="lazy"
                  allowfullscreen
                  allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
                />
              )}
              {video.kind === 'link' && (
                <a class="plink" href={video.src} target="_blank" rel="noopener">
                  <span class="plink__text">{b.caption || b.src}</span>
                </a>
              )}
              {b.caption && video.kind !== 'link' && <figcaption>{b.caption}</figcaption>}
            </figure>
          )}

          {b.type === 'posts' && (
            <section class="pposts">
              {b.text ? <h2 class="pposts__title">{b.text}</h2> : null}
              {posts.length === 0 ? (
                <p class="pposts__empty">这一页还没有文章。</p>
              ) : (
                <ul class="pposts__list">
                  {posts.map((p) => (
                    <li>
                      {/* 有封面的给个小图（正文里的图不当封面） */}
                      {p.cover && (
                        <img class="pposts__cover" src={withBase(p.cover)} alt="" loading="lazy" decoding="async" />
                      )}
                      <a href={withBase(p.href)}>{p.title}</a>
                      <em>{p.date}</em>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )}

          {b.type === 'toc' &&
            (tocGroups.length === 0 ? (
              <p class="ptoc__empty">
                这一页还没有小标题。在上面加一个「文字」块，用 <code>## 小标题</code> 写一行，
                这里就会自动列出来。
              </p>
            ) : (
              <nav class="ptoc" aria-label={b.text || '目录'} data-toc>
                <p class="ptoc__title">
                  <span class="ptoc__label">{b.text || '目录'}</span>
                  <button class="ptoc__toggle" type="button" data-toc-toggle aria-expanded="true">
                    [隐藏]
                  </button>
                </p>
                <ol class="ptoc__list">
                  {tocGroups.map((g) => (
                    <li class="ptoc__item">
                      {/*
                        展开 / 收起这一组底下的子标题，摆在小标题**左边**。
                        刻意用 button 而不是链接：点它只开合、不跳转，
                        和小标题本身（点了是跳过去）互不干扰。
                        展开状态在 HTML 里就写死了，脚本没跑起来之前不会闪一下。

                        没有子标题的条目也要占住这一格（一个空 span），
                        否则下面那一列编号会左右参差。
                      */}
                      {g.children.length > 0 ? (
                        <button
                          class:list={['ptoc__caret', TOC_SUB_OPEN && 'is-open']}
                          type="button"
                          data-ptoc-caret
                          aria-expanded={TOC_SUB_OPEN ? 'true' : 'false'}
                          aria-controls={`ptoc-sub-${g.entry.slug}`}
                          aria-label={`展开或收起「${g.entry.text}」的子标题`}
                          title="展开 / 收起子标题"
                        >
                          <span class="ptoc__caretArt" aria-hidden="true" />
                        </button>
                      ) : (
                        <span class="ptoc__caretGap" aria-hidden="true" />
                      )}

                      <a class="ptoc__link" href={`#${g.entry.slug}`} data-ptoc-slug={g.entry.slug}>
                        {g.entry.text}
                      </a>

                      {g.children.length > 0 && (
                        <ol
                          class="ptoc__sub"
                          id={`ptoc-sub-${g.entry.slug}`}
                          hidden={!TOC_SUB_OPEN}
                        >
                          {g.children.map((c) => (
                            <li class="ptoc__subitem">
                              <a class="ptoc__link" href={`#${c.slug}`} data-ptoc-slug={c.slug}>
                                {c.text}
                              </a>
                            </li>
                          ))}
                        </ol>
                      )}
                    </li>
                  ))}
                </ol>
              </nav>
            ))}

          {b.type === 'map' && pages.length > 0 && (
            <div class="pmap" data-pmap>
              {/*
                框里的层次：
                  frame  固定大小的取景框，overflow:hidden，拖拽和滚轮都作用在它上面
                  page   一页地图（多页时只有当前那页显示，其余 hidden）
                  stage  跟着 transform 走的那一层：图、划分线、图钉都在里面
                  pin    用百分比钉在图上；外面的缩放会由反向缩放抵消掉，
                         所以不管地图放多大，图钉在屏幕上始终是同样大小
              */}
              <div class="pmap__frame" data-pmap-frame>
                {pages.map((pg, pi) => (
                  <div class="pmap__page" data-pmap-page hidden={pi !== 0}>
                    <div class="pmap__stage" data-pmap-stage>
                      <img
                        class="pmap__img"
                        src={withBase(pg.src)}
                        alt={pg.alt ?? ''}
                        draggable="false"
                        decoding="async"
                      />

                      {/*
                        区域划分线画在一层 SVG 上。
                        viewBox 用 0~100，preserveAspectRatio=none —— 这样
                        「百分比坐标」直接就是 viewBox 坐标，不用换算。
                        线宽用 non-scaling-stroke：地图放大多少，线还是那么粗。
                        颜色是每条线自己存的（编辑器里用 RGB 色板挑的），
                        借 CSS 变量 --lc 传进样式，规则本身仍然写在 <style> 里。
                      */}
                      {pg.lines.length > 0 && (
                        <svg
                          class="pmap__lines"
                          viewBox="0 0 100 100"
                          preserveAspectRatio="none"
                          aria-hidden="true"
                        >
                          {pg.lines.map((l) => (
                            <g class="pmap__line" style={`--lc:${l.color ?? DEFAULT_LINE_COLOR}`}>
                              {/*
                                一条线拆成两层，为的是做成和图钉一样的「蒸汽波栅格」：
                                底下一根半透明实线当色带，上面压一根同色虚线，
                                虚线的空档横着切过色带 —— 就是图钉头上那种扫描线，
                                只是随着线的走向转了角度；两根都带 non-scaling-stroke，
                                所以条纹节奏在屏幕上是恒定的，放大也不会糊成一片。
                              */}
                              <line
                                class="pmap__lineBody"
                                x1={l.x1}
                                y1={l.y1}
                                x2={l.x2}
                                y2={l.y2}
                                vector-effect="non-scaling-stroke"
                              />
                              <line
                                class="pmap__lineDash"
                                x1={l.x1}
                                y1={l.y1}
                                x2={l.x2}
                                y2={l.y2}
                                vector-effect="non-scaling-stroke"
                              />
                            </g>
                          ))}
                        </svg>
                      )}

                      {pg.markers.map((m) => {
                        const external = /^https?:/i.test(m.href ?? '');
                        const Tag = m.href ? 'a' : 'span';
                        return (
                          <Tag
                            class:list={['pmap__pin', `pmap__pin--${m.kind}`]}
                            data-pmap-pin
                            data-pmap-kind={m.kind}
                            style={`left:${m.x}%;top:${m.y}%`}
                            href={m.href ? (external || m.href.startsWith('#') ? m.href : withBase(m.href)) : undefined}
                            {...external ? { target: '_blank', rel: 'noopener' } : {}}
                            {...m.href ? {} : { tabindex: '0' }}
                          >
                            <span class="pmap__pinBox">
                              <span class="pmap__pinArt" aria-hidden="true">
                                {/* 建筑那个头里画一台简约塔吊；区域是落日，圆头不另加图案 */}
                                {m.kind === 'building' && (
                                  <svg class="pmap__crane" viewBox="0 0 24 24">
                                    <path d="M10.5 20.5V6.5M13.5 20.5V6.5M8.5 20.5h7M12 4v2.5M3.5 9h17M12 4 3.5 9M12 4l8.5 5M17.5 9v4" />
                                  </svg>
                                )}
                              </span>
                              <span class="pmap__pinName">{m.title}</span>
                            </span>
                          </Tag>
                        );
                      })}
                    </div>
                  </div>
                ))}

                {/* 拖过之后想回到「整张图都看得见」就点它 */}
                <button class="pmap__reset" type="button" data-pmap-reset title="回到全图">
                  复位
                </button>
              </div>

              {/* 竖着贴在框右边的按钮：放大、缩小，以及三类东西各自的显示开关 */}
              <div class="pmap__rail">
                <button class="pmap__btn" type="button" data-pmap-zoom="in" aria-label="放大">＋</button>
                <button class="pmap__btn" type="button" data-pmap-zoom="out" aria-label="缩小">－</button>
                <button
                  class="pmap__btn pmap__btn--tag"
                  type="button"
                  data-pmap-tag="building"
                  aria-pressed="true"
                  title="显示 / 隐藏建筑图钉"
                >
                  建筑
                </button>
                <button
                  class="pmap__btn pmap__btn--tag"
                  type="button"
                  data-pmap-tag="region"
                  aria-pressed="true"
                  title="显示 / 隐藏区域图钉"
                >
                  区域
                </button>
                <button
                  class="pmap__btn pmap__btn--tag"
                  type="button"
                  data-pmap-tag="line"
                  aria-pressed="true"
                  title="显示 / 隐藏区域划分线"
                >
                  划线
                </button>
              </div>

              {/* 翻页：只有一页时整条不出现 */}
              {pages.length > 1 && (
                <div class="pmap__bar">
                  <button class="pmap__arrow" type="button" data-pmap-prev aria-label="上一张地图">
                    ‹
                  </button>
                  <span class="pmap__count" data-pmap-count>
                    1 / {pages.length}
                  </span>
                  <button class="pmap__arrow" type="button" data-pmap-next aria-label="下一张地图">
                    ›
                  </button>
                </div>
              )}

              {/* 每页自己的简介，跟着翻页一起换 */}
              {pages.map((pg, pi) =>
                pg.text ? (
                  <p class="pmap__intro" data-pmap-intro={pi} hidden={pi !== 0}>
                    {pg.text}
                  </p>
                ) : null
              )}
            </div>
          )}

          {b.type === 'children' && (
            <div class="pcards" data-shape={cardsOf(b).shape} data-size={cardsOf(b).size}>
              {children.length === 0 && <p class="pcards__empty">这一层还没有子页面。</p>}
              {children.map((c) => (
                <SubCard
                  title={c.title}
                  url={c.url}
                  image={c.image}
                  shape={c.cardShape ?? cardsOf(b).shape}
                  size={c.cardSize ?? cardsOf(b).size}
                  external={c.external}
                  width={c.cardW}
                  height={c.cardH}
                />
              ))}
            </div>
          )}
        </div>
      );
    })
  }

  {/*
    没有 JS 时把子标题重新铺开。
    默认是收起的（见 TOC_SUB_OPEN），靠脚本展开；脚本要是不来，
    这些子标题就永远点不到了，所以这里补一段「强制显示」的样式。

    为什么用 set:html 而不是直接写 <style>：Astro 会把模板里普通的
    <style> 抽走、打包进样式表，那样这个 <noscript> 里就什么都不剩了。
    小三角也一并藏掉 —— 没有脚本时它按下去不会有任何反应。
  */}
  {hasToc && (
    <noscript
      set:html={'<style>.ptoc__sub[hidden]{display:block}.ptoc__caret{display:none}</style>'}
    />
  )}
</div>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.6rem);
  }

  /*
    每个块单独一层，才有东西给排版模式抓。
    transform 由 [data-edit] 上的 translate/scale 管，这里不要碰。
  */
  .pblock {
    min-width: 0;
  }

  /* ---------- 文字 ---------- */
  .ptext {
    font-size: 1rem;
    line-height: 1.9;
    color: rgba(255, 236, 248, 0.9);
    letter-spacing: 0.02em;
  }
  .ptext :global(p) {
    margin: 0 0 0.9em;
  }
  .ptext :global(p:last-child) {
