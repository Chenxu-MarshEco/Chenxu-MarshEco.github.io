  }

  /* ---------- 链接 ---------- */
  .plink {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 120, 190, 0.5);
    background: rgba(60, 8, 82, 0.55);
    color: #ffd9ef;
    text-decoration: none;
    letter-spacing: 0.06em;
    transition:
      background 0.16s ease,
      border-color 0.16s ease,
      transform 0.16s ease;
  }
  .plink::after {
    content: '↗';
    font-size: 0.9em;
    color: #ffb3dd;
  }
  .plink:hover,
  .plink:focus-visible {
    background: rgba(212, 0, 123, 0.7);
    border-color: #ffb3dd;
    color: #fff;
    transform: translateY(-1px);
  }

  /* ---------- 分隔线 ---------- */
  .pdivider {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0.4rem 0;
  }
  /* 两边各一条线中间夹字；没写字时就是单独一条线 */
  .pdivider::before,
  .pdivider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 120, 190, 0.55), transparent);
  }
  .pdivider__text {
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    color: rgba(255, 226, 244, 0.7);
    /*
      这里不能 nowrap：中间一句话长过一行时，两边的 flex:1 先缩到 0，
      然后再没得缩，整句话就被顶出容器（不是被裁掉，是溢出）。
      让它换行才是稳的。
    */
    overflow-wrap: anywhere;
  }

  /* ---------- 两栏 ---------- */
  .pcols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.9rem, 2vw, 1.8rem);
  }
  .pcols__col {
    min-width: 0;
    font-size: 0.98rem;
    line-height: 1.9;
    color: rgba(255, 236, 248, 0.9);
  }
  .pcols__col :global(p) {
    margin: 0 0 0.9em;
  }
  .pcols__col :global(p:last-child) {
    margin-bottom: 0;
  }
  .pcols__col :global(h2),
  .pcols__col :global(h3) {
    margin: 1.2em 0 0.4em;
    font-family: var(--font-display);
    color: #fff;
    letter-spacing: 0.08em;
  }
  .pcols__col :global(a) {
    color: #ffb3dd;
  }
  .pcols__col :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .pcols__col :global(ul),
  .pcols__col :global(ol) {
    margin: 0 0 0.9em;
    padding-left: 1.3em;
  }

  /* ---------- 视频 ---------- */
  .pvideo {
    margin: 0;
  }
  .pvideo__el,
  .pvideo__frame {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid rgba(255, 120, 190, 0.35);
    border-radius: 12px;
    background: rgba(10, 0, 18, 0.6);
    box-shadow: 0 14px 40px rgba(10, 0, 20, 0.45);
  }
  .pvideo figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: rgba(255, 226, 244, 0.6);
  }

  /* ---------- 文章列表 ---------- */
  .pposts {
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 120, 190, 0.3);
    background: rgba(38, 4, 52, 0.4);
  }
  .pposts__title {
    margin: 0 0 0.6rem;
    font-size: 0.98rem;
    letter-spacing: 0.14em;
    color: rgba(255, 236, 248, 0.85);
  }
  .pposts__empty {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(255, 226, 244, 0.6);
  }
  .pposts__list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 2px solid rgba(255, 120, 190, 0.35);
  }
  .pposts__list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.24rem 0;
  }
  /* 文章行左边的小封面 */
  .pposts__cover {
    flex: 0 0 auto;
    width: 54px;
    height: 36px;
    object-fit: cover;
    border-radius: 7px;
    border: 1px solid rgba(255, 120, 190, 0.3);
    background: rgba(20, 0, 30, 0.45);
  }
  .pposts__list a {
    flex: 1 1 auto;
    min-width: 0;
    color: #ffd9ef;
    text-decoration: none;
    font-size: 0.92rem;
  }
  .pposts__list a:hover {
    color: #fff;
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.9);
  }
  .pposts__list em {
    font-style: normal;
    font-size: 0.72rem;
    color: rgba(255, 226, 244, 0.55);
    white-space: nowrap;
  }

  /* ---------- 地图 ---------- */
  /*
    左边是取景框，右边竖着一条按钮栏。
    地图本身不用 aspect-ratio 定高，用一个高度档 —— 地图多半是宽图，
    框矮一点才看得见全貌，剩下的交给缩放和拖动。
  */
  .pmap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: start;
  }

  .pmap__frame {
    position: relative;
    overflow: hidden;
    height: clamp(300px, 54vh, 620px);
    border: 1px solid rgba(255, 120, 190, 0.42);
    border-radius: 14px;
    background: rgba(12, 1, 22, 0.72);
    cursor: grab;
    /*
      touch-action 只留纵向：手机上在图里竖着划仍然滚页面，
      横着划才是拖地图。全禁掉的话整页就没法滚了。
    */
    touch-action: pan-y;
  }
  .pmap.is-dragging .pmap__frame {
    cursor: grabbing;
  }

  .pmap__stage {
    position: absolute;
    top: 0;
    left: 0;
    /* 缩放的原点放在左上角：平移量是按「左上角挪了多少」算的，这样最好推 */
    transform-origin: 0 0;
    transform: translate(var(--tx, 0px), var(--ty, 0px)) scale(var(--z, 1));
    will-change: transform;
  }
  .pmap__img {
    display: block;
    width: 100%;
    height: 100%;
    /* 拖动时别让浏览器顺手把图拖走 */
    user-select: none;
    -webkit-user-drag: none;
  }

  /*
    一页地图。多页时几页叠在框里，只有当前那页显示。
    用 absolute 铺满取景框，是为了让「隐藏」不影响其它页的尺寸计算。
  */
  .pmap__page {
    position: absolute;
    inset: 0;
  }

  /*
    区域划分线。
    viewBox 定成 0~100、preserveAspectRatio=none，于是存的百分比坐标
    直接就是 viewBox 坐标；线宽靠 non-scaling-stroke 保持恒定，
    地图放大多少倍，线都还是那么粗。
  */
  .pmap__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  /*
    划分线的颜色：--lc 是每条线自己在行内塞进来的，没写就用老那版橙色兜底。
    （var() 的兜底值只在变量「没定义」时生效，所以这里两层保险。）
  */
  .pmap__line {
    --lc: #ffb43c;
  }
  .pmap__lineBody,
  .pmap__lineDash {
    stroke: var(--lc, #ffb43c);
    stroke-width: 3;
    stroke-linecap: butt;
  }
  /*
    色带层：压得很淡，只用来把这条线「连起来看」。
    它存在的意义是：条纹在缩到很小时会变成一串点，底下垫一层淡色
    才不至于让人以为线断了。
  */
  .pmap__lineBody {
    opacity: 0.34;
  }
  /*
    条纹层：虚线当扫描线用。non-scaling-stroke 下 dasharray 也是按屏幕
    像素算的，所以不管地图放到几倍，条纹的疏密都和图钉头上那套一致
    （图钉是 2px 实 / 1.2px 空，这里按线宽 3 放大到 3.4 / 2.1）。
    光晕用它自己的颜色，不是固定橙 —— 挑成蓝的线就该发蓝光。
  */
  .pmap__lineDash {
    stroke-dasharray: 3.4 2.1;
    filter: drop-shadow(0 0 5px var(--lc, #ffb43c));
  }

  /*
    图钉。
    外层是零尺寸的一个「锚点」，left/top 的百分比把它钉在图上那一点；
    真正看得见的是里面那层，它反向缩放（--zi）抵消掉地图的放大，
    这样地图放到 6 倍，图钉在屏幕上还是原来那么大。
    反向缩放的原点放在底边中点、再左移自身一半宽 —— 于是图钉的尖端
    永远正好落在锚点上（缩放是绕底边中点做的，那个点不动）。
  */
  .pmap__pin {
    position: absolute;
    width: 0;
    height: 0;
    text-decoration: none;
  }
  .pmap__pinBox {
    position: absolute;
    left: 0;
    bottom: 0;
    display: block;
    transform: translateX(-50%) scale(var(--zi, 1));
    transform-origin: bottom center;
  }

  .pmap__pinArt {
    position: relative;
    display: block;
    width: 24px;
    height: 32px;
    margin: 0 auto;
    transition: transform 0.14s ease;
  }
  /* 头：横向格栅 + 下面那套渐变的底，两种图钉只有颜色和形状不一样 */
  .pmap__pinArt::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 24px;
    height: 24px;
    /*
      渐变顶端特意不用接近纯白的粉：地图往往浅一块深一块，
      顶端太淡的话图钉压到浅色区域就糊没了。现在最淡的一档
      也仍然明显带色，压在什么底色上都认得出。
    */
    background: linear-gradient(180deg, #ffd9ef 0%, #ff9ad5 34%, #ff4fa3 68%, #a80058 100%);
    border-radius: 8px;
    -webkit-mask: repeating-linear-gradient(180deg, #000 0 2px, transparent 2px 3.2px);
    mask: repeating-linear-gradient(180deg, #000 0 2px, transparent 2px 3.2px);
  }
  /* 下面那个小箭头：尖头朝下，指向图上那一点 */
  .pmap__pinArt::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 20px;
    margin-left: -4.5px;
    width: 0;
    height: 0;
    border-left: 4.5px solid transparent;
    border-right: 4.5px solid transparent;
    border-top: 10px solid #ff4fa3;
  }
  .pmap__pin--building .pmap__pinArt {
    filter: drop-shadow(0 2px 5px rgba(255, 40, 130, 0.55));
  }

  /*
    区域图钉：同样的形制，换成蒸汽波落日那套橙黄，头做成圆的
    （圆的就是那颗落日），一眼能和建筑那颗方的区分开。
  */
  .pmap__pin--region .pmap__pinArt::before {
    background: linear-gradient(180deg, #fff2b8 0%, #ffd447 32%, #ff9d2e 66%, #e04a08 100%);
    border-radius: 50%;
  }
  .pmap__pin--region .pmap__pinArt::after {
    border-top-color: #ff9d2e;
  }
  .pmap__pin--region .pmap__pinArt {
    filter: drop-shadow(0 2px 5px rgba(255, 150, 40, 0.6));
  }
  .pmap__pin--region .pmap__pinName {
    border-color: rgba(255, 180, 70, 0.6);
  }

  /* 建筑那颗头里那台简约塔吊：白描，压在粉色和格栅上都看得清 */
  .pmap__crane {
    position: absolute;
    left: 50%;
    top: 4px;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 2px rgba(120, 0, 60, 0.85));
  }

  /* 名字：默认藏着，指上去（或键盘聚焦）才出来 */
  .pmap__pinName {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 1px);
    transform: translateX(-50%);
    padding: 0.15rem 0.5rem;
    border-radius: 7px;
    border: 1px solid rgba(255, 120, 190, 0.55);
    background: rgba(22, 3, 36, 0.94);
    color: #ffe6f6;
    font-size: 0.78rem;
    line-height: 1.5;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.14s ease, visibility 0.14s ease;
  }
  .pmap__pin:hover .pmap__pinName,
  .pmap__pin:focus-visible .pmap__pinName {
    opacity: 1;
    visibility: visible;
  }
  .pmap__pin:hover .pmap__pinArt,
  .pmap__pin:focus-visible .pmap__pinArt {
    transform: scale(1.12);
  }
  .pmap__pin:focus-visible {
    outline: none;
  }
  .pmap__pin:focus-visible .pmap__pinArt::before {
    box-shadow: 0 0 0 2px #5ff0ff;
  }

  /*
    三个开关：建筑图钉 / 区域图钉 / 区域划分线，各管各的。
    关掉某个类别只是把它藏起来，不删数据。
  */
  .pmap.is-off-building .pmap__pin--building,
  .pmap.is-off-region .pmap__pin--region,
  .pmap.is-off-line .pmap__lines {
    display: none;
  }

  .pmap__reset {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgba(255, 120, 190, 0.45);
    border-radius: 8px;
    background: rgba(22, 3, 36, 0.8);
    color: #ffd9ef;
    font-size: 0.76rem;
    cursor: pointer;
    backdrop-filter: blur(3px);
  }
  .pmap__reset:hover {
    color: #fff;
    border-color: #ffb3dd;
  }

  .pmap__rail {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .pmap__btn {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 120, 190, 0.45);
    border-radius: 10px;
    background: rgba(38, 4, 52, 0.72);
    color: #ffd9ef;
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
  }
  .pmap__btn:hover {
    border-color: #ffb3dd;
    color: #fff;
    background: rgba(212, 0, 123, 0.5);
  }
  /* 「建筑 / 区域 / 划线」两个字的开关：竖排塞进 40px 的方按钮 */
  .pmap__btn--tag {
    height: auto;
    padding: 0.5rem 0.35rem;
    font-size: 0.78rem;
    line-height: 1.25;
    writing-mode: vertical-rl;
    letter-spacing: 0.1em;
  }
  /* 关掉的那一类：压暗、描边变虚，一眼看出它现在是关着的 */
  .pmap__btn--tag[aria-pressed='false'] {
    opacity: 0.45;
    border-style: dashed;
    background: rgba(38, 4, 52, 0.4);
    color: rgba(255, 217, 239, 0.7);
  }

  /* ---- 翻页 ---- */
  .pmap__bar {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
  }
  .pmap__arrow {
    width: 36px;
    height: 32px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 120, 190, 0.45);
    border-radius: 9px;
    background: rgba(38, 4, 52, 0.72);
    color: #ffd9ef;
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
  }
  .pmap__arrow:hover {
    border-color: #ffb3dd;
    color: #fff;
    background: rgba(212, 0, 123, 0.5);
  }
  .pmap__count {
    min-width: 4.5rem;
    text-align: center;
    color: rgba(255, 226, 244, 0.75);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }

  /* 每页自己的简介 */
  .pmap__intro {
    grid-column: 1 / -1;
    margin: 0;
    color: rgba(255, 226, 244, 0.78);
    font-size: 0.88rem;
    line-height: 1.75;
  }

  /* 窄屏：按钮栏移到地图下面横着排 */
  @media (max-width: 46rem) {
    .pmap {
      grid-template-columns: minmax(0, 1fr);
    }
    .pmap__rail {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .pmap__btn--tag {
      width: auto;
      height: 40px;
      writing-mode: horizontal-tb;
      padding: 0 0.7rem;
    }
  }

  /* ---------- 子页面 ---------- */
  /*
    六列栅格：卡片的「大小」档就是占几列（见 SubCard 的 .card--sz-*）。
    l 一列一行、m 两张一行、s 三张一行；窄屏塌成一列。
  */
  .pcards {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: start;
    gap: clamp(0.7rem, 1.4vw, 1.1rem);
  }
  .pcards__empty {
    grid-column: 1 / -1;
    margin: 0;
    color: rgba(255, 226, 244, 0.6);
    font-size: 0.9rem;
  }

  /* ---------- 悬停图片 ---------- */
  /*
    ⚠ 这一组元素是 set:html 注入进来的，身上没有 Astro 的作用域标记
    （data-astro-cid-…），所以每条都得写 :global()，否则编译出来的
    选择器是 .phover[data-astro-cid-…]，一条都匹配不上 ——
    表现是弹层永远摊在正文里、样式全无，而构建一点错都不报。
    这和本文件里 .ptext :global(h2) 是同一个原因。

    同时要锚在 .ptext / .pcols__col 下面：光写 :global(.phover)
    就变成全站通配了，别的组件万一也叫这个名会被牵连。
  */
  .ptext :global(.phover),
  .pcols__col :global(.phover) {
    /* inline-block 是必须的：弹层要相对这段文字定位，
       纯 inline 的话 absolute 的参照系会跑偏 */
    position: relative;
    display: inline-block;
  }

  /* 虚线在底下划一道：让人看出「这里指一下有东西」，和普通链接区分开 */
  .ptext :global(.phover__label),
  .pcols__col :global(.phover__label) {
    color: #ffb3dd;
    text-decoration: underline dashed;
    text-decoration-color: rgba(255, 179, 221, 0.55);
    text-underline-offset: 0.22em;
    cursor: help;
  }
  .ptext :global(a.phover__label),
  .pcols__col :global(a.phover__label) {
    cursor: pointer;
  }
  .ptext :global(.phover__label:hover),
  .pcols__col :global(.phover__label:hover) {
    color: #fff;
  }

  /*
    弹层在文字正上方。
    只改 opacity / transform / visibility —— 不占布局，
    所以指上去的时候底下的正文一个字都不会挪。
    pointer-events:none 免得它自己把鼠标吸走，导致抖个不停。
  */
  .ptext :global(.phover__pop),
  .pcols__col :global(.phover__pop) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.55rem);
    z-index: 30;
    padding: 6px;
    border: 1px solid rgba(255, 120, 190, 0.5);
    border-radius: 12px;
    background: rgba(24, 3, 38, 0.94);
    box-shadow: 0 16px 40px rgba(8, 0, 16, 0.6);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    pointer-events: none;
  }
  /* focus-within 一起管上：键盘 Tab 过来也能看到图 */
  .ptext :global(.phover:hover .phover__pop),
  .ptext :global(.phover:focus-within .phover__pop),
  .pcols__col :global(.phover:hover .phover__pop),
  .pcols__col :global(.phover:focus-within .phover__pop) {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .ptext :global(.phover__img),
  .pcols__col :global(.phover__img) {
    display: block;
    width: auto;
    /* 窄屏上别把弹层撑出屏幕 */
    max-width: min(320px, 70vw);
    max-height: 260px;
    border-radius: 8px;
  }

  /* ---------- 目录 ---------- */
  .ptoc {
    margin: 0;
    padding: clamp(0.9rem, 2vw, 1.3rem) clamp(1rem, 2.4vw, 1.5rem);
    border: 1px solid rgba(255, 120, 190, 0.42);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(46, 8, 70, 0.78), rgba(20, 3, 34, 0.78));
    box-shadow: 0 14px 40px rgba(10, 0, 20, 0.45);
  }

  .ptoc__title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.02rem;
    letter-spacing: 0.14em;
    text-shadow: 0 0 12px rgba(255, 79, 163, 0.6);
  }

  /* [隐藏] / [显示] 就是个朴素的小按钮，别抢标题的注意力 */
  .ptoc__toggle {
    padding: 0;
    border: 0;
    background: none;
    color: rgba(255, 179, 221, 0.78);
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .ptoc__toggle:hover {
    color: #fff;
  }

  /*
    序号用 CSS 计数器，而不是 <ol> 自带的编号：
    只有计数器才做得出「一级 1 2 3、二级跟着一级走成 4.1 4.2」这种编号，
    嵌套 <ol> 只会各数各的（一级 4、二级 1）。
  */
  .ptoc__list,
  .ptoc__sub {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ptoc__list {
    counter-reset: ptoc-l1;
  }
  .ptoc__item {
    counter-increment: ptoc-l1;
    /*
      两列网格：展开箭头（或占位）在第一列，小标题在第二列。
      箭头必须紧挨着标题 —— 推到整行最右边的话，眼睛根本扫不到，
      看不出这一组还能展开（之前就是那么摆的，等于白做）。
      用 grid 而不是中间插一层 div，是为了让上面那条
      `.ptoc__item > .ptoc__link::before` 继续成立 ——
      套了 wrapper 就得再多写一层选择器。
    */
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 0.35rem;
  }
  .ptoc__sub {
    /*
      子标题往里缩，缩到跟小标题的**文字**对齐为止。
      原来是 1.6rem，那正好是「跟小标题的编号对齐」—— 于是
      2.1、2.2 和 2 看着是同一级，从属关系读不出来。
      现在再让出编号那一格：箭头列 20px + 列间距 0.35rem + 编号盒 1.15em，
      加起来差不多 2.7rem，子标题就落在小标题文字的正下方。
    */
    margin: 0.1rem 0 0.35rem 2.7rem;
    counter-reset: ptoc-l2;
    /* 子列表自己占一行、横跨两列，别挤到箭头那一列去 */
    grid-column: 1 / -1;
  }
  .ptoc__subitem {
    counter-increment: ptoc-l2;
  }

  /*
    箭头的「可点范围」画得比图形本身大一圈，好按；
    图形在里面的 .ptoc__caretArt 上。
    没有子标题的条目用 .ptoc__caretGap 占同样大的位置，
    这样下面那一列编号才对得齐。
  */
  .ptoc__caret,
  .ptoc__caretGap {
    width: 20px;
    height: 20px;
  }
  .ptoc__caret {
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /*
    蒸汽波落日箭头：用落日那套配色（浅黄 → 金 → 橙 → 砖红）填满一个三角，
    再横着切出栅格条纹 —— 和首页那个被横条切开的落日是同一个语汇。

    用 clip-path + mask 画，不引 SVG：SVG 的渐变和遮罩都要靠 id 引用，
    一个页面放两个目录块就会撞 id。mask 的条纹是「透明处挖空」，
    所以 #000 那段留下、transparent 那段切掉。
  */
  .ptoc__caretArt {
    width: 13px;
    height: 13px;
    /* 收起时朝右 */
    clip-path: polygon(14% 0%, 100% 50%, 14% 100%);
    background: linear-gradient(180deg, #fff6b0 0%, #ffd23f 26%, #ff9d2e 60%, #ff5200 100%);
    -webkit-mask: repeating-linear-gradient(180deg, #000 0 1.6px, transparent 1.6px 2.7px);
    mask: repeating-linear-gradient(180deg, #000 0 1.6px, transparent 1.6px 2.7px);
    filter: drop-shadow(0 0 3px rgba(255, 130, 60, 0.6));
    transition: clip-path 0.15s ease, filter 0.15s ease;
  }
  /*
    展开时改成朝下。
    这里换 clip-path 而不是把整个图形转 90 度 —— 一转，那条纵向的
    落日渐变会跟着躺倒，配色就不再是「落日」了。
    两个多边形的顶点数一样，所以还能补间过去。
  */
  .ptoc__caret.is-open .ptoc__caretArt {
    clip-path: polygon(0% 14%, 100% 14%, 50% 100%);
  }
  .ptoc__caret:hover .ptoc__caretArt,
  .ptoc__caret:focus-visible .ptoc__caretArt {
    filter: drop-shadow(0 0 7px rgba(255, 160, 70, 0.95));
  }

  /* hidden 属性是 UA 样式里的 display:none，优先级很低，
     不显式写一条就会被下面的 display:block 盖掉、收起失效 */
  .ptoc__list[hidden] {
    display: none;
  }

  .ptoc__link {
    display: block;
    padding: 0.16rem 0;
    color: rgba(255, 226, 244, 0.86);
    font-size: 0.94rem;
    line-height: 1.6;
    text-decoration: none;
  }
  .ptoc__item > .ptoc__link::before {
    content: counter(ptoc-l1) ' ';
    color: rgba(255, 140, 200, 0.9);
    /*
      编号占一个固定宽度。这套字体里「1」比「3」窄几个像素，不固定的话
      第一条的标题会往左错开，整列标题就参差不齐（实测差 4px）。
      试过 font-variant-numeric: tabular-nums —— 对这个字体没用，
      它没有等宽数字那个 OpenType 特性，只能自己给个盒子。
      1.15em 刚好够两位数字，所以 1~99 的编号都能对齐。
    */
    display: inline-block;
    min-width: 1.15em;
  }
  .ptoc__subitem > .ptoc__link::before {
    content: counter(ptoc-l1) '.' counter(ptoc-l2) ' ';
    color: rgba(255, 140, 200, 0.72);
  }
  .ptoc__sub .ptoc__link {
    font-size: 0.86rem;
  }
  .ptoc__link:hover,
  .ptoc__link.is-active {
    color: #fff;
  }
  .ptoc__link.is-active {
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.85);
  }

  /* 插了目录块但页面里还没有小标题时，给编辑的人一句提示 */
  .ptoc__empty {
    margin: 0;
    padding: 0.7rem 0.95rem;
    border: 1px dashed rgba(255, 120, 190, 0.4);
    border-radius: 10px;
    color: rgba(255, 226, 244, 0.62);
    font-size: 0.88rem;
  }
  .ptoc__empty code {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.3);
    font-size: 0.92em;
  }

  /* 窄屏：两栏叠起来、卡片一律占满 */
  @media (max-width: 46rem) {
    .pcols {
      grid-template-columns: minmax(0, 1fr);
    }
    .pcards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plink {
      transition: none;
    }
    .plink:hover {
      transform: none;
    }
    /* 直接出现 / 直接消失，不做那个 4px 的位移和淡入 */
    .ptext :global(.phover__pop),
    .pcols__col :global(.phover__pop) {
      transition: none;
      transform: translate(-50%, 0);
    }
    /* 箭头开合时不要补间，直接就位 */
    .ptoc__caretArt {
      transition: none;
    }
  }
</style>

<script>
  /* ============================================================
     地图：分页 / 缩放 / 拖动 / 三类东西各自的开关

     为什么手写而不用现成的地图库：这边只是「一张图 + 几个钉在百分比
     坐标上的图钉和几条线」，库（几百 KB）能做的多得多，但这里一样也用不上，
     而整站一直是零运行时依赖的（见 README「依赖说明」）。

     坐标怎么算：图片先按「整张都看得见」放进框里，得到一个基准尺寸
     fitW/fitH；缩放 z 和平移 tx/ty 都是在这个基准上做。
     图钉和线不用重算 —— 它们钉在图片的百分比位置上，跟着 stage 一起动，
     图钉再各自反向缩放（--zi）把大小还原。
     ============================================================ */
  const MIN_Z = 1;
  const MAX_Z = 6;
  /** 每一页各自记自己的缩放和位置，翻回去还是刚才看的样子 */
  type MapPageState = {
    el: HTMLElement;
    stage: HTMLElement;
    img: HTMLImageElement;
    z: number;
    tx: number;
    ty: number;
    fitW: number;
    fitH: number;
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-pmap]')) {
    const frame = root.querySelector<HTMLElement>('[data-pmap-frame]');
    if (!frame) continue;

    const pages: MapPageState[] = [];
    for (const el of root.querySelectorAll<HTMLElement>('[data-pmap-page]')) {
      const stage = el.querySelector<HTMLElement>('[data-pmap-stage]');
      const img = stage?.querySelector<HTMLImageElement>('img');
      if (!stage || !img) continue;
      pages.push({ el, stage, img, z: 1, tx: 0, ty: 0, fitW: 0, fitH: 0 });
    }
    if (!pages.length) continue;

    /**
     * 一根轴上的平移量该怎么夹。
     * 内容比框小 → 固定居中（拖不动，也不该拖得动）；
     * 比框大 → 卡在 [框 - 内容, 0]，也就是「边缘不许拖进框里」。
     */
    const clampAxis = (f: number, s: number, t: number) =>
      s <= f ? (f - s) / 2 : Math.min(0, Math.max(f - s, t));

    function clampPan(p: MapPageState) {
      const fw = frame!.clientWidth;
      const fh = frame!.clientHeight;
      p.tx = clampAxis(fw, p.fitW * p.z, p.tx);
      p.ty = clampAxis(fh, p.fitH * p.z, p.ty);
    }

    function apply(p: MapPageState) {
      p.stage.style.setProperty('--tx', `${p.tx}px`);
      p.stage.style.setProperty('--ty', `${p.ty}px`);
      p.stage.style.setProperty('--z', String(p.z));
      // 图钉反向缩放，地图放大多少它就缩回多少，屏幕上始终一样大。
      // 挂在 root 上，几页共用同一个值。
      root!.style.setProperty('--zi', String(1 / p.z));
    }

    /** 按「整张图都看得见」量一次基准尺寸，然后重新夹一次平移 */
    function layout(p: MapPageState) {
      const fw = frame!.clientWidth;
      const fh = frame!.clientHeight;
      if (!fw || !fh) return;
      const nw = p.img.naturalWidth || 1;
      const nh = p.img.naturalHeight || 1;
      const ratio = nw / nh;
      let w = fw;
      let h = w / ratio;
      if (h > fh) {
        h = fh;
        w = h * ratio;
      }
      p.fitW = w;
      p.fitH = h;
      p.stage.style.width = `${w}px`;
      p.stage.style.height = `${h}px`;
      clampPan(p);
      apply(p);
    }

    /** 以框内某一点为锚点缩放：那个点在缩放前后停在原地 */
    function zoomAt(p: MapPageState, px: number, py: number, factor: number) {
      const old = p.z;
      const next = Math.min(MAX_Z, Math.max(MIN_Z, old * factor));
      if (next === old) return false;
      const k = next / old;
      p.tx = px - (px - p.tx) * k;
      p.ty = py - (py - p.ty) * k;
      p.z = next;
      clampPan(p);
      apply(p);
      return true;
    }

    /* ---- 翻页 ---- */
    let cur = 0;
    const count = root.querySelector<HTMLElement>('[data-pmap-count]');
    const intros = Array.from(root.querySelectorAll<HTMLElement>('[data-pmap-intro]'));

    function show(i: number) {
      cur = ((i % pages.length) + pages.length) % pages.length;
      pages.forEach((p, k) => {
        p.el.hidden = k !== cur;
      });
      // 隐藏着的时候量不到框的尺寸，显示出来之后重量一次
      layout(pages[cur]);
      if (count) count.textContent = `${cur + 1} / ${pages.length}`;
      for (const el of intros) el.hidden = Number(el.dataset.pmapIntro) !== cur;
    }

    root.querySelector<HTMLButtonElement>('[data-pmap-prev]')?.addEventListener('click', () => show(cur - 1));
    root.querySelector<HTMLButtonElement>('[data-pmap-next]')?.addEventListener('click', () => show(cur + 1));

    /* ---- 缩放 ---- */
    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-pmap-zoom]')) {
      btn.addEventListener('click', () => {
        const p = pages[cur];
        zoomAt(p, frame.clientWidth / 2, frame.clientHeight / 2, btn.dataset.pmapZoom === 'in' ? 1.4 : 1 / 1.4);
      });
    }

    root.querySelector<HTMLButtonElement>('[data-pmap-reset]')?.addEventListener('click', () => {
      const p = pages[cur];
      p.z = 1;
      clampPan(p);
      apply(p);
    });

    /* ---- 三类东西各自的显示开关 ---- */
    const CLASS_OF: Record<string, string> = {
      building: 'is-off-building',
      region: 'is-off-region',
      line: 'is-off-line',
    };
    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-pmap-tag]')) {
      btn.addEventListener('click', () => {
        const cls = CLASS_OF[btn.dataset.pmapTag ?? ''];
        if (!cls) return;
        // aria-pressed 表示「现在是不是显示着」，关掉就是 false
        const shown = !root.classList.toggle(cls);
        btn.setAttribute('aria-pressed', shown ? 'true' : 'false');
      });
    }

    /*
      滚轮直接缩放（用户要求鼠标放上去就能滚）。
      但滚到头了就把滚轮还给页面 —— 不然鼠标从地图上划过去，
      页面就再也滚不动了，长页面会很难受。
    */
    frame.addEventListener(
      'wheel',
      (e) => {
        const p = pages[cur];
        const factor = Math.exp(-e.deltaY * 0.0016);
        const next = Math.min(MAX_Z, Math.max(MIN_Z, p.z * factor));
        if (next === p.z) return; // 已经到顶/到底，交给浏览器滚页面
        e.preventDefault();
        const rect = frame.getBoundingClientRect();
        zoomAt(p, e.clientX - rect.left, e.clientY - rect.top, factor);
      },
      { passive: false }
    );

    /* ---- 拖动 ---- */
    let drag: { id: number; x: number; y: number; tx: number; ty: number } | null = null;

    frame.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      // 按在图钉上就别开始拖了，那一下是给它自己点的
      if ((e.target as HTMLElement).closest('[data-pmap-pin]')) return;
      const p = pages[cur];
      drag = { id: e.pointerId, x: e.clientX, y: e.clientY, tx: p.tx, ty: p.ty };
      root.classList.add('is-dragging');
      frame.setPointerCapture(e.pointerId);
    });

    frame.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const p = pages[cur];
      p.tx = drag.tx + (e.clientX - drag.x);
      p.ty = drag.ty + (e.clientY - drag.y);
      clampPan(p);
      apply(p);
    });

    const endDrag = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      drag = null;
      root.classList.remove('is-dragging');
      try {
        frame.releasePointerCapture(e.pointerId);
      } catch {
        /* 指针已经没了，忽略 */
      }
    };
    frame.addEventListener('pointerup', endDrag);
    frame.addEventListener('pointercancel', endDrag);

    /*
      图没量到尺寸之前 layout 算不出来，等它 load。
      每页的图都要等自己的 —— 翻到第 3 页时那张图可能才刚下载完。
    */
    for (const p of pages) {
      if (p.img.complete && p.img.naturalWidth) layout(p);
      else p.img.addEventListener('load', () => layout(p), { once: true });
    }
    show(0);

    /*
      框的大小变了（转屏、拉窗口、字体加载完）要重新量。
      量的是 frame 而不是 stage —— stage 的尺寸是 layout 自己写的，
      盯着它会被自己的改动反复触发。
    */
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(() => layout(pages[cur])).observe(frame);
    }
  }

  /*
    目录：[隐藏 / 显示] 开关 + 滚动时高亮当前所在的那一条。

    跳转本身不用脚本 —— 就是普通锚点（href="#slug"），
    交给浏览器原生处理，中键新开、右键复制链接都能用。
    平滑滚动也是 global.css 里 html{scroll-behavior:smooth} 管的。

    一个页面可能没有目录，也可能有不止一个块，所以整段按 [data-toc] 逐个处理；
    没有目录时下面这个循环一次都不进，等于没加载过。
  */
  for (const nav of document.querySelectorAll<HTMLElement>('[data-toc]')) {
    const toggle = nav.querySelector<HTMLButtonElement>('[data-toc-toggle]');
    const list = nav.querySelector<HTMLElement>('.ptoc__list');

    if (toggle && list) {
      toggle.addEventListener('click', () => {
        const collapsed = !list.hidden;
        list.hidden = collapsed;
        toggle.textContent = collapsed ? '[显示]' : '[隐藏]';
        toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      });
    }

    /*
      子标题的展开 / 收起：每个带子标题的小标题右边那个小三角。
      点它只开合自己这一组；小标题本身是链接，点了照旧跳转，两件事互不干扰。

      这段必须放在下面「一个锚点都找不到就 continue」之前 ——
      滚动高亮那边没活干时，开合也得照常能用。
    */
    for (const caret of nav.querySelectorAll<HTMLButtonElement>('[data-ptoc-caret]')) {
      // 小三角和它管的子列表同在一个 li 里，就地找，不必额外编 id
      const sub = caret.parentElement?.querySelector<HTMLElement>('.ptoc__sub');
      if (!sub) continue;
      caret.addEventListener('click', () => {
        // 现在藏着 = 这次要展开
        const open = sub.hidden;
        sub.hidden = !open;
        caret.classList.toggle('is-open', open);
        caret.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.ptoc__link'));
    /*
      锚点 id 从 data-ptoc-slug 上读，不去解析 href。
      标题是中文，href 里的 hash 会被浏览器按 URL 编码成 %E5%B8%B8…，
      再解码回来纯属绕远路，直接存一份原样的 slug 最省事。
    */
    const targets = links
      .map((link) => document.getElementById(link.dataset.ptocSlug ?? ''))
      .filter((el): el is HTMLElement => el !== null);
    if (targets.length === 0) continue;

    const setActive = (id: string) => {
      for (const link of links) {
        link.classList.toggle('is-active', link.dataset.ptocSlug === id);
      }
    };

    /*
      注意 rootMargin 的单位：IntersectionObserver 只认 px 和 %，
      写 rem 会当场抛 SyntaxError，整段脚本挂掉、高亮永远不生效，
      而且只在控制台留一行错，页面上完全看不出异常。
      所以按根字号把 5rem 换算成 px —— 顺手也跟着用户的字号设置走。
      5rem 是为了压过顶部吸顶页头那一段，和上面的 scroll-margin-top 一个用意见。
    */
    const remPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: `-${Math.round(remPx * 5)}px 0px -70% 0px`, threshold: 0 }
    );

    for (const target of targets) observer.observe(target);
  }
</script>
