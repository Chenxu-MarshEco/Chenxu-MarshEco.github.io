---
/**
 * 「涣愿终池」的核心区 —— 页面里那一块会被**每天换内容**的板块。
 *
 * 用户 2026-11-17 的原话：
 *   「跳转到一个独立的页面：涣愿终池 …… 要保留一块核心功能区：显示每一年的这一天的
 *    冰室事件和精华 …… 四个板块 …… 这个页面每天都会更新」
 *   「把核心板块从上往下划开变成四个部分 分别就是精华 冰山 时刻 冰室日记四个板块部分
 *    如果今天没有 就写一个历史上的今天还没有XX占位」
 *   「时刻里的时间轴上的点用原有塔吊图标（且原轴是黄色的就用黄的 原轴是粉的就用粉的）
 *    点了不要跳转到原时间轴 而是看这个刻度在原时间轴里有没有写对应的跳转链接
 *    没有就不用管有就一样跳转到那个链接」
 *
 * 所以从上往下一共五个板块，每个板块一个标题（精华 / 圣经 / 冰山 / 时刻 / 冰室日记）：
 *   · 精华 —— 照 /salon/ 那一条的格式平铺；
 *   · 圣经 —— 2026-11-21 加的，照精华那条的取法（站长：「在涣愿终池的精华下加一条圣经
 *     显示历史上的今天出现过的群圣经 参考精华在涣愿终池里的引用方法」）；
 *     比精华多一段评语（小字斜体，和 /bellie/ 那页一个规矩）；
 *   · 冰山 —— 有完备描述就整段铺开；
 *   · 时刻 —— 时间轴上的点，用原来那颗塔吊（时刻黄、事件粉），点了去那个刻度自己填的链接；
 *   · 冰室日记 —— 跳转卡片。
 * 哪一块这天没东西，就只显示那一句占位（「历史上的今天还没有精华」这种，站长点的原话）。
 *
 * ⚠ 除此之外**不许有任何自己写的说明句**（站规 2026-11-17）：HTML 里只有空盘子，
 * 内容全在浏览器里按"今天"从 `/cistern.json` 挑。
 */
import { withBase } from '../utils/url';

interface Props {
  /**
   * 核心区的标题（面板里能改）。
   * **留空就不渲染** —— 这一页的页头本来已经写着标题了，别再重复一遍。
   */
  text?: string;
  /**
   * 可选的实景底图（站内 /img/… 或站外地址）。
   * 不填就是默认的 Frutiger Aero 场景：天空 / 水面 / 丁达尔光 / 泡泡。
   */
  bg?: string;
}

const { text = '', bg = '' } = Astro.props;
const title = String(text ?? '').trim();
const asSrc = (raw: string) => (/^https?:\/\//i.test(raw) ? raw : withBase(raw));

/**
 * 五个板块。`name` 就是站长给的那几个词（标题 + 占位句都用它，
 * 占位句是站长原话「历史上的今天还没有XX」——除了这几个字，一个字都不加）。
 * 圣经排第二：站长 2026-11-21 的原话是「在涣愿终池的精华下加一条圣经」。
 */
const SECTIONS = [
  { key: 'essences', name: '精华' },
  { key: 'bibles', name: '圣经' },
  { key: 'iceberg', name: '冰山' },
  { key: 'points', name: '时刻' },
  { key: 'notes', name: '冰室日记' },
] as const;
---
<section
  class="cist"
  data-cist
  data-cist-bg={bg ? asSrc(bg) : undefined}
  aria-labelledby={title ? 'cist-title' : undefined}
>
  {/* ---------- FA 布景：天空、太阳、丁达尔光、水面、泡泡 ---------- */}
  <div class="cist__scene" aria-hidden="true">
    <div class="cist__sky"></div>
    <div class="cist__sun"></div>
    <div class="cist__rays"></div>
    <div class="cist__haze"></div>
    <div class="cist__sea">
      <div class="cist__wave cist__wave--1"></div>
      <div class="cist__wave cist__wave--2"></div>
      <div class="cist__wave cist__wave--3"></div>
      <div class="cist__glint"></div>
    </div>
    <div class="cist__bubbles" data-cist-bubbles></div>
    <div class="cist__vignette"></div>
  </div>

  <div class="cist__inner">
    <header class="cist__head">
      {title && <h2 class="cist__title" id="cist-title">{title}</h2>}
      <p class="cist__when">
        <b data-cist-day></b>
      </p>
    </header>

    {
      SECTIONS.map((s) => (
        <section class="cist__sec" data-cist-flat={s.key}>
          <h3 class="cist__h">{s.name}</h3>
          <div class="cist__list" data-cist-list={s.key} data-cist-empty={`历史上的今天还没有${s.name}`} />
        </section>
      ))
    }
  </div>

  {/*
    配置：这份 JSON 的地址 + 构建时的基础路径。
    内容一律去 /cistern.json 取 —— 数据两百多 KB，塞进 HTML 会让每页都变胖。
  */}
  <script
    type="application/json"
    id="cist-cfg"
    set:html={JSON.stringify({ json: withBase('/cistern.json') })}
  />
</section>

<script>
  /* ============================================================
     涣愿终池：按**访问者本地的那一天**把四个板块填满
     ============================================================ */
  type Essence = {
    id: string;
    date: string;
    time: string;
    member: string;
    avatar: string;
    text: string;
    image: string;
    href: string;
  };
  type Point = {
    id: string;
    timeline: string;
    timelineId: string;
    date: string;
    label: string;
    kind: string;
    href: string;
    showAxis: boolean;
  };
  /** 群圣经（2026-11-21 加）：和精华一条相比只多一段评语 */
  type Bible = {
    id: string;
    date: string;
    time: string;
    member: string;
    avatar: string;
    text: string;
    comment: string;
    href: string;
  };
  type Ice = {
    id: string;
    date: string;
    name: string;
    desc: string;
    layer: string;
    category: string;
    emoji: string;
    href: string;
  };
  type Note = { id: string; date: string; title: string; href: string };
  type Day = { key: string; essences: Essence[]; bibles: Bible[]; points: Point[]; iceberg: Ice[]; notes: Note[] };
  type Index = { days: Record<string, Day>; dayCount: number };

  const root = document.querySelector<HTMLElement>('[data-cist]');
  const cfgEl = document.getElementById('cist-cfg');
  if (root && cfgEl) {
    const cfg = JSON.parse(cfgEl.textContent || '{}') as { json?: string };
    const base = '';
    const dayOf = (d: Date = new Date()) =>
      `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const WEEK = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
    /** 原来那颗塔吊的线条（照抄 Timeline.astro 里那个 24×24 的图标） */
    const CRANE = 'M10.5 20.5V6.5M13.5 20.5V6.5M8.5 20.5h7M12 4v2.5M3.5 9h17M12 4 3.5 9M12 4l8.5 5M17.5 9v4';

    let index: Index | null = null;
    let painted = '';

    /* ---------- 泡泡（画一次就够；位置固定，免得每次换天都跳一下） ---------- */
    const bubbles = root.querySelector<HTMLElement>('[data-cist-bubbles]');
    if (bubbles && !bubbles.childElementCount) {
      for (let i = 0; i < 16; i += 1) {
        const b = document.createElement('span');
        b.className = 'cist__bubble';
        b.style.setProperty('--x', `${((i * 61.803) % 100).toFixed(2)}%`);
        b.style.setProperty('--s', `${8 + ((i * 17) % 46)}px`);
        b.style.setProperty('--d', `${16 + ((i * 7) % 14)}s`);
        b.style.setProperty('--delay', `${-((i * 2.7) % 20)}s`);
        b.style.setProperty('--drift', `${((i % 5) - 2) * 18}px`);
        bubbles.appendChild(b);
      }
    }

    /* ---------- 小工具 ---------- */
    const esc = (s: string) =>
      String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    const abs = (href: string) => (!href ? '' : base + href);
    /** `2026-09-16` → `2026 年 9 月 16 日`（只转格式，不加字） */
    const when = (iso: string) => {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso ?? ''));
      return m ? `${Number(m[1])} 年 ${Number(m[2])} 月 ${Number(m[3])} 日` : String(iso ?? '');
    };
    const el = (tag: string, cls: string) => {
      const n = document.createElement(tag);
      n.className = cls;
      return n;
    };
    const anchor = (href: string, cls: string) => {
      const a = document.createElement('a');
      a.className = cls;
      a.href = abs(href);
      if (/^https?:/i.test(href)) {
        a.target = '_blank';
        a.rel = 'noopener';
      }
      return a;
    };
    /** 这一块这天没东西 → 那一句占位（站长原话），别的一句都不许补 */
    function emptyNotice(host: HTMLElement) {
      const notice = el('p', 'cist__empty');
      notice.textContent = host.dataset.cistEmpty || '';
      host.append(notice);
    }

    /* ---------- 精华（照 /salon/ 那一条的格式） ---------- */
    function paintEssences(host: HTMLElement, items: Essence[]) {
      for (const e of items) {
        const card = el('article', 'cist__item');
        const face = e.avatar
          ? `<img class="cist__avatar" src="${esc(e.avatar)}" alt="" loading="lazy" decoding="async">`
          : `<span class="cist__avatar cist__avatar--none"></span>`;
        const text = e.text ? `<p class="cist__bq">${esc(e.text).replace(/\n/g, '<br>')}</p>` : '';
        const pic = e.image
          ? `<img class="cist__pic" src="${esc(e.image)}" alt="" loading="lazy" decoding="async">`
          : '';
        card.innerHTML =
          `<div class="cist__who"><span class="cist__face">${face}</span>` +
          `<b class="cist__name">${esc(e.member)}</b>` +
          `<time class="cist__time">${esc(when(e.date))}${e.time ? ` ${esc(e.time)}` : ''}</time></div>` +
          text +
          pic;
        if (e.href) {
          const a = anchor(e.href, 'cist__hit');
          a.setAttribute('aria-label', `${e.member} ${e.date}`);
          a.append(card);
          host.append(a);
        } else {
          host.append(card);
        }
      }
    }

    /* ---------- 群圣经（2026-11-21 加：照精华那一条的格式，多一段评语） ---------- */
    /*
      站长：「在涣愿终池的精华下加一条圣经 显示历史上的今天出现过的群圣经
             参考精华在涣愿终池里的引用方法」。
      所以取法、落点（`/bellie/#<id>`）、卡片骨架都照上面精华那份；
      唯一多出来的是评语 —— /bellie/ 那页的规矩也是"正文正常字号、评语小字斜体压下面"。
    */
    function paintBibles(host: HTMLElement, items: Bible[]) {
      for (const b of items) {
        const card = el('article', 'cist__item cist__item--bible');
        const face = b.avatar
          ? `<img class="cist__avatar" src="${esc(b.avatar)}" alt="" loading="lazy" decoding="async">`
          : `<span class="cist__avatar cist__avatar--none"></span>`;
        const text = b.text ? `<p class="cist__bq">${esc(b.text).replace(/\n/g, '<br>')}</p>` : '';
        const comment = b.comment ? `<p class="cist__comment">${esc(b.comment).replace(/\n/g, '<br>')}</p>` : '';
        card.innerHTML =
          `<div class="cist__who"><span class="cist__face">${face}</span>` +
          `<b class="cist__name">${esc(b.member)}</b>` +
          `<time class="cist__time">${esc(when(b.date))}${b.time ? ` ${esc(b.time)}` : ''}</time></div>` +
          text +
          comment;
        if (b.href) {
          const a = anchor(b.href, 'cist__hit');
          a.setAttribute('aria-label', `${b.member} ${b.date}`);
          a.append(card);
          host.append(a);
        } else {
          host.append(card);
        }
      }
    }

    /* ---------- 冰山词条（有完备描述就整段铺开） ---------- */
    function paintIceberg(host: HTMLElement, items: Ice[]) {
      for (const it of items) {
        const card = el('article', 'cist__item cist__item--ice');
        const meta = [it.layer, it.category].filter(Boolean).map(esc).join(' · ');
        const body = it.desc
          ? `<p class="cist__bq cist__bq--full">${esc(it.desc).replace(/\n/g, '<br>')}</p>`
          : '';
        card.innerHTML =
          `<div class="cist__who"><b class="cist__name">${it.emoji ? `<span class="cist__emoji">${esc(it.emoji)}</span>` : ''}${esc(it.name)}</b>` +
          `<time class="cist__time">${esc(when(it.date))}</time></div>` +
          (meta ? `<p class="cist__meta">${meta}</p>` : '') +
          body;
        if (it.href && it.href !== '/iceberg/') {
          const a = anchor(it.href, 'cist__hit');
          a.setAttribute('aria-label', it.name);
          a.append(card);
          host.append(a);
        } else {
          host.append(card);
        }
      }
    }

    /* ---------- 时刻：原来那颗塔吊（时刻黄 / 事件粉），点了去那个刻度自己的链接 ---------- */
    function paintPoints(host: HTMLElement, items: Point[]) {
      for (const p of items) {
        /* 主轴里有的不带前缀；只有分轴里有的，名字前面写上是哪条轴 */
        const name = p.showAxis && p.timeline ? `${p.timeline}·${p.label}` : p.label;
        const row = p.href ? anchor(p.href, 'cist__tick') : el('div', 'cist__tick');
        row.dataset.kind = p.kind === 'event' ? 'event' : 'moment';
        if (p.href) row.setAttribute('aria-label', name);
        row.innerHTML =
          `<span class="cist__crane" aria-hidden="true">` +
          `<svg viewBox="0 0 24 24"><path d="${CRANE}"></path></svg></span>` +
          `<span class="cist__tickText">` +
          `<b class="cist__tickName">${esc(name)}</b>` +
          `<time class="cist__tickWhen">${esc(when(p.date))}</time>` +
          `</span>`;
        host.append(row);
      }
    }

    /* ---------- 冰室日记：跳转卡片（不搬全文） ---------- */
    function paintNotes(host: HTMLElement, items: Note[]) {
      for (const n of items) {
        const a = anchor(n.href, 'cist__jump');
        a.innerHTML = `<b>铃忆的冰室日记</b><em>${esc(when(n.date))}</em>`;
        host.append(a);
      }
    }

    /* ---------- 把这一天的五个板块全画一遍 ---------- */
    function paint(key: string) {
      const day: Day = index?.days?.[key] ?? { key, essences: [], bibles: [], points: [], iceberg: [], notes: [] };
      const now = new Date();
      const dayEl = root!.querySelector<HTMLElement>('[data-cist-day]');
      if (dayEl) dayEl.textContent = `${now.getMonth() + 1} 月 ${now.getDate()} 日 · ${WEEK[now.getDay()]}`;

      const paints = [
        ['essences', day.essences, paintEssences],
        ['bibles', day.bibles, paintBibles],
        ['iceberg', day.iceberg, paintIceberg],
        ['points', day.points, paintPoints],
        ['notes', day.notes, paintNotes],
      ] as const;
      for (const [name, list, paintOne] of paints) {
        const host = root!.querySelector<HTMLElement>(`[data-cist-list="${name}"]`);
        if (!host) continue;
        host.textContent = '';
        if (list.length) (paintOne as (h: HTMLElement, l: unknown[]) => void)(host, list as unknown[]);
        else emptyNotice(host);
      }

      painted = key;
      root!.dataset.cistCurrent = key;
      root!.dataset.cistReady = '1';
    }

    /* ---------- 取数据 ---------- */
    const load = async (): Promise<Index | null> => {
      if (index) return index;
      try {
        const res = await fetch(String(cfg.json || '/cistern.json'), { headers: { accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        index = (await res.json()) as Index;
        return index;
      } catch {
        /* 取不到就空着（站规：不写"池子打不开"那种句子） */
        return null;
      }
    };

    void (async () => {
      await load();
      paint(dayOf());
      window.setInterval(() => {
        const key = dayOf();
        if (key !== painted) paint(key);
      }, 600_000);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          const key = dayOf();
          if (key !== painted) paint(key);
        }
      });
    })();
  }
</script>

<style is:global>
  /*
    ⚠ 样式全在 `src/styles/cistern.css`（BoardLayout 只在这一页注入）：
    卡片是脚本 createElement 建的，节点上没有 `data-astro-cid` ——
    组件作用域的样式一条都匹配不上。
  */
</style>
