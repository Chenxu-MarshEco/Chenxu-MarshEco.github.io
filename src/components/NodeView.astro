---
/**
 * 大板块树里任意一个节点的页面内容。
 *
 * 两种路由（/[board]/ 和 /[board]/[...path]/）共用这个组件，
 * 免得同样的渲染逻辑写两遍。
 *
 * 页面上有三块：
 *   1. 面包屑 —— 让人知道自己在树的哪一层
 *   2. 子版块框 —— 下一层入口（下面详述）
 *   3. 归到本节点的文章
 *
 * ## 子版块为什么是「框」而不是一排等大的卡片
 *
 * 设计稿（花娅陌域）要的是：左上一块大的，左下、中间、右边各一块，
 * 每块里面竖着铺子版块的条目。所以子版块分两种形态：
 *
 *   有下级  → 一个面板：标题 + 里面可独立滚动的条目清单
 *   没有下级 → 一整张封面大卡，整块可点，直接进它自己的页面
 *
 * 版面按「子版块个数」切换：够 4 个才排成设计稿那三列（左列上下两块、
 * 中右各跨两行）；不到 4 个就用普通自适应网格 —— 甬城晴雨只有一个子版块，
 * 硬套三列会留出一大片空白。
 *
 * URL 全部由调用方在服务端算好传进来 —— 组件里不要去推路径，
 * 推导逻辑只有一处（utils/boards.ts），放两处迟早对不上。
 */
import { withBase } from '../utils/url';
import SubCard from './SubCard.astro';
import PageContent from './PageContent.astro';
import type { BlockItem } from '../utils/boardPage';
import type { PageBlock } from '../utils/boards';

interface SubPost {
  title: string;
  href: string;
  date: string;
}

interface Crumb {
  title: string;
  /** 最后一项没有 url，表示「当前所在」 */
  url?: string;
}

interface Props {
  trail: Crumb[];
  children: BlockItem[];
  posts: SubPost[];
  /** 版式：'region' = 设计稿那套三列分区（只有花娅陌域用），其它一律竖排 */
  layout?: string;
  /** 这一页自己写的内容；有内容就整段顶掉「子版块自动铺开」 */
  page?: PageBlock[];
}

const { trail, children, posts, layout: wantLayout, page: blocks = [] } = Astro.props;

/*
  这一页自己写了「文章」块吗？
  写了就由那个块负责列文章，页面底部不再自动重复列一遍。
*/
const hasPostsBlock = blocks.some((b) => b.type === 'posts');

/*
  版面分两种，由数据里的 layout 字段决定：

    region（花娅陌域）→ 设计稿那套三列分区：左列上下两块、中右各跨两行。
                        每块是一个「框」，框里再竖着铺子版块。
    其它（默认）      → **竖排**：子页面一条一条占满整行，就是宽幅大卡。
                        子页面自己还有下级的，仍然给一个带清单的面板，
                        免得在这一层就看不到它下面有什么。

  默认必须是竖排：三列分区是给花娅陌域专门设计的，别的页面套上去
  就会变成「前四块被塞进三列、后面的挤在下面」，很乱。
  另外 region 只在子版块够 4 个时才启用 —— 只有两块的话，
  三列里会有整整一列空着。
*/
const layout = wantLayout === 'region' && children.length >= 4 ? 'region' : 'stack';
---

{trail.length > 1 && (
  <nav class="crumbs" aria-label="位置" data-edit="crumbs">
    {trail.map((c, i) => (
      <>
        {i > 0 && (
          <span class="crumbs__sep" aria-hidden="true">
            ›
          </span>
        )}
        {c.url ? (
          <a href={withBase(c.url)}>{c.title}</a>
        ) : (
          <span class="crumbs__here" aria-current="page">
            {c.title}
          </span>
        )}
      </>
    ))}
  </nav>
)}

{
  blocks.length > 0 && <PageContent blocks={blocks} children={children} posts={posts} />
}

{
  blocks.length === 0 && children.length > 0 && (
    <div class="blocks" data-layout={layout} data-edit="children">
      {children.map((c) =>
        c.kids.length > 0 ? (
          <section class="block" data-edit={`block-${c.id}`} data-href={withBase(c.url)}>
            <header class="block__head">
              <a class="block__name" href={withBase(c.url)}>
                {c.title}
              </a>
              {c.subtitle && <span class="block__sub">{c.subtitle}</span>}
              <span class="block__enter" aria-hidden="true">
                进入 ›
              </span>
            </header>
            {/* 这一层单独滚动：里面会放很多条子版块，不能把整页撑长 */}
            <div class="block__scroll">
              <ul class="block__list">
                {c.kids.map((k) => (
                  <li>
                    <SubCard title={k.title} url={k.url} image={k.image} />
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ) : layout === 'region' ? (
          /* 分区版式里，没有下级的这一块是「一整张大封面」 */
          <a
            class="block block--leaf"
            data-edit={`block-${c.id}`}
            href={withBase(c.url)}
            style={c.image ? `--cover:url(${withBase(c.image)})` : undefined}
          >
            <span class="block__name">{c.title}</span>
            {c.subtitle && <span class="block__sub">{c.subtitle}</span>}
          </a>
        ) : (
          /* 竖排版式里，子页面就是整整一条宽幅大卡（图铺满 / 没图就是扁平名字条） */
          <div class="stack" data-edit={`block-${c.id}`}>
            <SubCard title={c.title} url={c.url} image={c.image} shape="wide" size="l" />
          </div>
        )
      )}
    </div>
  )
}

{
  posts.length > 0 && !hasPostsBlock && (
    <>
      <h2 class="node__h2">这里的文章</h2>
      <ul class="subposts subposts--page">
        {posts.map((p) => (
          <li>
            <a href={withBase(p.href)}>{p.title}</a>
            <em>{p.date}</em>
          </li>
        ))}
      </ul>
    </>
  )
}

{
  blocks.length === 0 && children.length === 0 && posts.length === 0 && (
    <p class="node__empty">
      这一层还没有内容。可以在编辑器里给它加子版块，或把文章归到这里。
    </p>
  )
}

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    margin-bottom: 1.2rem;
  }
  .crumbs a {
    color: #ffd9ef;
    text-decoration: none;
  }
  .crumbs a:hover {
    color: #fff;
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.9);
  }
  .crumbs__sep {
    color: rgba(255, 226, 244, 0.45);
  }
  .crumbs__here {
    color: rgba(255, 226, 244, 0.7);
  }

  /* ------------------------------------------------------------
     子版块的「框」
     ------------------------------------------------------------ */

  .blocks {
    display: grid;
    gap: clamp(0.9rem, 1.8vw, 1.5rem);
    /*
      默认竖排：一条一条占满整行。
      这是「带多个子页面的页面」的统一版面 —— 一条一张宽幅大卡。
    */
    grid-template-columns: minmax(0, 1fr);
  }

  /*
    设计稿那套：左列上下两块（大块 + 宽块），中、右各一块跨两行。
    列宽比取自设计稿（391 : 160 : 161 ≈ 2.44 : 1 : 1）。
  */
  .blocks[data-layout='region'] {
    grid-template-columns: minmax(0, 2.44fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
  }
  .blocks[data-layout='region'] > :nth-child(1) {
    grid-area: 1 / 1;
  }
  .blocks[data-layout='region'] > :nth-child(2) {
    grid-area: 2 / 1;
  }
  .blocks[data-layout='region'] > :nth-child(3) {
    grid-area: 1 / 2 / span 2 / span 1;
  }
  .blocks[data-layout='region'] > :nth-child(4) {
    grid-area: 1 / 3 / span 2 / span 1;
  }
  /* 第五块起：整行铺开，别把格子挤坏 */
  .blocks[data-layout='region'] > :nth-child(n + 5) {
    grid-column: 1 / -1;
  }

  /* 面板式：标题 + 可滚动的条目清单 */
  .block {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(255, 120, 190, 0.42);
    background: rgba(38, 4, 52, 0.55);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.3) inset,
      0 14px 40px rgba(10, 0, 20, 0.45);
    backdrop-filter: blur(3px);
  }

  .block__head {
    position: relative;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.2rem 0.55rem;
    padding: 0.85rem 1rem 0.65rem;
    border-bottom: 1px solid rgba(255, 120, 190, 0.22);
  }

  /*
    标题那行整行都能点：把链接的 ::after 拉满表头。
    表头里除了标题还有副标题和右边的「进入 ›」，以前只有标题那几个字
    是热区，用户说的「点击冰室板块就进这一页」其实点空白是没反应的。
  */
  a.block__name::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* 右边那行小提示，鼠标移到框上才亮起来 */
  .block__enter {
    margin-left: auto;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    /*
      别调得太淡：这个 0.72 是算出来的 —— 面板底色 rgb(34,5,50) 上
      对比度 8.2:1（AA 要 4.5:1）。一开始用了 0.5，只有 3.6:1，
      无障碍审计直接报出来。
    */
    color: rgba(255, 226, 244, 0.72);
    transition:
      color 0.16s ease,
      transform 0.16s ease;
  }
  .block:hover .block__enter,
  .block:focus-within .block__enter {
    color: #ffd9ef;
    transform: translateX(2px);
  }

  /*
    框里除了卡片以外的空白也能点进去（脚本见文件末尾的 <script>）。
    指针给个手型，让人知道这儿能点。
  */
  .block[data-href] {
    cursor: pointer;
  }

  .block__name {
    font-size: 1.02rem;
    letter-spacing: 0.1em;
    color: #fff;
    text-decoration: none;
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.85);
  }
  a.block__name:hover {
    color: #fff;
    text-shadow:
      0 0 10px rgba(255, 79, 163, 1),
      0 0 26px rgba(212, 0, 123, 0.9);
  }

  .block__sub {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: rgba(255, 226, 244, 0.6);
  }

  /*
    滚动区。
    scrollbar-gutter: stable 让滚动条的位置一直留着，
    条目多起来时里面的宽度不会突然跳一下。
  */
  .block__scroll {
    overflow-y: auto;
    max-height: clamp(180px, 34vh, 360px);
    scrollbar-gutter: stable;
    padding: 0.65rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 120, 190, 0.85) rgba(255, 255, 255, 0.07);
  }

  .block__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /*
    卡片的样子归 SubCard.astro 管 —— 面板里的清单、竖排的大卡、
    页面内容里插的子页面，三处都在用它，样式集中一处才不会
    「这里能改、那里改不动」。这里只留位置相关的东西。
    竖排里每条卡外面包一层 .stack，它同时是排版模式的锚点。
  */
  .stack {
    min-width: 0;
  }

  /*
    右侧那根能拖着走的滚动条。
    只对 WebKit 生效（Chrome / Edge / Safari）；Firefox 走上面的
    scrollbar-width / scrollbar-color。做成实心渐变的粗条，
    一眼能看出是可以抓的。
  */
  .block__scroll::-webkit-scrollbar {
    width: 12px;
  }
  .block__scroll::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 999px;
    margin: 2px;
  }
  .block__scroll::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: linear-gradient(180deg, #ff8ecb, #d4007b);
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  .block__scroll::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #ffb3dd, #ff2e8b);
    background-clip: padding-box;
  }

  /* 没有下级：整块就是一张封面大卡，名字居中 */
  .block--leaf {
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: clamp(170px, 26vh, 280px);
    padding: 1.2rem;
    text-decoration: none;
    color: #fff;
    /* 没传封面图时就是这层渐变 —— 它不是「缺图的占位」，是这块自己的底色 */
    background-image: linear-gradient(135deg, rgba(96, 12, 118, 0.8), rgba(30, 4, 48, 0.95));
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  /* 传了封面图：图铺满整块、微微半透明，和框里的卡片一个做法 */
  .block--leaf::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--cover, none);
    background-size: cover;
    background-position: center;
    opacity: 0.82;
  }
  /* 压一层暗底，保证名字在任何封面/底色上都读得清 */
  .block--leaf::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(14, 2, 24, 0.32) 0%,
      rgba(14, 2, 24, 0.5) 55%,
      rgba(10, 0, 18, 0.78) 100%
    );
  }
  .block--leaf > * {
    position: relative;
    z-index: 1;
  }
  .block--leaf .block__name {
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    letter-spacing: 0.14em;
  }
  .block--leaf .block__sub {
    margin-top: 0.35rem;
    color: rgba(255, 226, 244, 0.78);
  }
  .block--leaf:hover,
  .block--leaf:focus-visible {
    transform: translateY(-3px);
    border-color: #ffb3dd;
    box-shadow:
      0 0 34px rgba(255, 62, 165, 0.45),
      0 20px 52px rgba(10, 0, 20, 0.55);
  }

  .node__h2 {
    font-size: 1rem;
    letter-spacing: 0.14em;
    color: rgba(255, 226, 244, 0.72);
    margin: 2rem 0 0.8rem;
  }

  .subposts {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 2px solid rgba(255, 120, 190, 0.35);
  }
  .subposts--page {
    padding-left: 1.1rem;
  }
  .subposts li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.24rem 0;
  }
  .subposts a {
    color: #ffd9ef;
    text-decoration: none;
    font-size: 0.92rem;
  }
  .subposts a:hover {
    color: #fff;
    text-shadow: 0 0 10px rgba(255, 79, 163, 0.9);
  }
  .subposts em {
    font-style: normal;
    font-size: 0.72rem;
    color: rgba(255, 226, 244, 0.55);
    white-space: nowrap;
  }

  .node__empty {
    color: rgba(255, 226, 244, 0.6);
    font-size: 0.9rem;
  }

  /* 窄屏：三列分区塌成一列，顺序仍然是「大块 → 它的邻居 → 中 → 右」 */
  @media (max-width: 46rem) {
    .blocks[data-layout='region'] {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }
    .blocks[data-layout='region'] > :nth-child(n) {
      grid-area: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .block--leaf {
      transition: none;
    }
    .card:hover,
    .block--leaf:hover {
      transform: none;
    }
  }
</style>

<script is:inline>
  /*
    面板（有下级的那个框）整块可点：点空白处就进这一页自己的页面。
    标题那行已经由 CSS 拉伸的链接管住了，这里补的是清单外面的空白 ——
    框内边距、条目底下的空地。清单里的卡片自己是链接，点到就交给它。

    三个「不算」的情形：
      1. 点在卡片 / 按钮 / 输入框上（那是它们自己的事）
      2. 点在滚动条上（点那儿是为了拖，不能把人带走）
      3. 正在选文字，或者按了修饰键（那是想开新标签页 / 选内容）
    另外排版模式下整体跳过 —— 编辑器在 iframe 里靠点击选元素，
    跳转了就没法调版式了（__layoutApi 是编辑器注入的标记）。
  */
  document.addEventListener('click', (e) => {
    if (window.__layoutApi) return;
    if (e.defaultPrevented || e.button !== 0) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

    const panel = e.target.closest?.('.block[data-href]');
    if (!panel) return;
    if (e.target.closest('a, button, input, select, textarea')) return;

    const scroller = e.target.closest('.block__scroll');
    if (scroller) {
      const r = scroller.getBoundingClientRect();
      // 横向超出内容宽度 = 点在滚动条上
      if (e.clientX - r.left >= scroller.clientWidth) return;
    }

    if (String(window.getSelection?.() ?? '').length) return;
    location.href = panel.dataset.href;
  });
</script>
