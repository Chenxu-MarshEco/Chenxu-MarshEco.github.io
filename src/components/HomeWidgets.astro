---
/**
 * 首页这一屏（挂在两个大板块**下面**，一行两块，一共三行）。
 *
 * 位置按用户历轮的要求排（原话见 README）：
 *   第一行 · 曼沫砾总线（公告栏）在「甬城晴雨」正下方
 *          · 黎语堂在「花娅陌域」正下方
 *   第二行 · 日历（涣源溪水钟）在「甬城晴雨」正下方，**和甬城晴雨一样宽**，而且比较扁
 *          · 冰室冰山 / 每日精华 **和日历一样高**
 *          · 冰室冰山的左边对齐「花娅陌域」的左边
 *          · 每日精华的右边对齐「花娅陌域」的右边
 *   第三行（2026-11-18 改）· 左 = 涣愿终池（占**大卡**那一格，和日历同宽同高）
 *                          · 右 = 预留卡 + 花娅远位面（两张小卡，和冰山 / 精华同宽同高）
 *
 * 2026-11-18 站长原话：
 *   「把涣愿终池挪到它左边那个大卡片上 后面要给这张卡片做特效 稍后再说
 *    原位置的小卡就留占位符」
 * 所以原来「日历下方一张大预留卡 + 下面一行两张小卡」变成了**一行**：
 * 涣愿终池搬进左边那张大卡，预留卡退到原来涣愿终池那张小卡的位置。
 *
 * ⚠ 2026-10-06 加第一行时**没有动第二行的任何一条规则**：`.extras__pair` 还是那一套、
 * 日历还是 height:100%，所以「日历 / 冰山 / 每日精华 三张一样高」这个关系一点没变 ——
 * 新增的第一行是独立的一行，行高由公告卡和黎语堂卡自己决定，不会往下传染。
 *
 * 怎么保证"对齐"这件事不靠眼睛：这一屏的列定义和大板块那一行**一模一样**
 * （`repeat(2, minmax(0,1fr))` + 同样的 13% 列间距），所以第一格天然就是
 * 甬城晴雨那一列、第二格天然就是花娅陌域那一列；第二格里面再分成两张。
 *
 * 另外大板块那行被编辑器"排版"模式挪过一点（layout.json 里 boards 的 dx/dy），
 * 这里把同一个偏移也接过来 —— 用户在编辑器里左右拖板块，这一屏跟着走。
 * ⚠ dy 必须换成**像素**再接过来（见文件末尾那段脚本）：百分比是相对元素自身尺寸的，
 * 大板块高 340px、这一屏高 785px，同一个 3.5% 会差出一倍多，接过来反而更不对齐。
 */
import HomeAnnounce from './HomeAnnounce.astro';
import HomeLiyutang from './HomeLiyutang.astro';
import HomeCalendar from './HomeCalendar.astro';
import HomePlaceholder from './HomePlaceholder.astro';
import HomeIceberg from './HomeIceberg.astro';
import HomeDailyEssence from './HomeDailyEssence.astro';
import HomeCistern from './HomeCistern.astro';
import HomeFarland from './HomeFarland.astro';
import { editVars } from '../utils/layout';

/** 只跟随大板块的**横向**微调（竖向由脚本换成像素再补，见末尾） */
const boardDx = (() => {
  const v = editVars('home', 'boards');
  const m = v ? /--dx:([^;]+)/.exec(v) : null;
  return m ? `--dx:${m[1]}` : undefined;
})();
---

<section
  class="extras"
  aria-label="首页：曼沫砾总线 / 黎语堂 / 涣源溪水钟 / 冰室冰山 / 每日精华 / 涣愿终池 / 预留卡 / 花娅远位面"
>
  <div class="extras__grid" style={boardDx}>
    {/*
      第一行：公告栏（左，甬城晴雨那一列）+ 黎语堂（右，花娅陌域那一列）。
      顺序就是 DOM 顺序 —— 栅格自动铺行，所以"在甬城晴雨下方、日历上方"这件事
      是由这两行的先后决定的，不需要任何定位。
    */}
    <HomeAnnounce />
    <HomeLiyutang />
    {/* 第二行：日历 + 冰室冰山/每日精华（和加这两块之前一模一样） */}
    <HomeCalendar />
    <div class="extras__pair">
      <HomeIceberg />
      <HomeDailyEssence />
    </div>
    {/*
      第三行（2026-11-18）：涣愿终池占左边那张大卡（和日历同宽同高），
      右边并排两张小卡：预留卡（原来涣愿终池那一格）+ 花娅远位面。
    */}
    <HomeCistern />
    <div class="extras__pair extras__pair--under">
      <HomePlaceholder />
      <HomeFarland />
    </div>
  </div>
</section>

<style>
  /*
    这一屏所有"行与行之间"的缝都用同一个值 —— 站长 2026-11-18 指出的
    「甬城晴雨和曼沫砾总线之间的缝隙 和曼沫砾总线和涣源溪水钟之间的缝隙高度不一样」，
    根子就是这里原来一个写 margin-top、一个写 row-gap，两个数不一样。
    现在只留一个 --home-gap，两处都读它。
  */
  .extras {
    --home-gap: clamp(0.9rem, 2vw, 1.6rem);
    margin-top: var(--home-gap);
  }
  /*
    列定义必须和 .boards 那一行完全一致（同一个容器宽度 + 同样的 13% 列间距），
    这是"日历经度 = 甬城晴雨、右侧格 = 花娅陌域"的唯一保证。
    行间距和上面那条 margin-top 用同一个值（见 .extras 里的 --home-gap）。

    2026-10-06 起这里是**两行**：公告栏 + 黎语堂 / 日历 + 冰山 + 每日精华。
    2026-11-18 起是**三行**（第三行 = 涣愿终池 + 预留卡/花娅远位面）。
    三行共用同一套列定义，所以每一块都和上下两个大板块严格同列。
  */
  .extras__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 13%;
    row-gap: var(--home-gap);
    align-items: stretch;
    /*
      横向：和大板块同一个百分比（两边一样宽，所以百分比换算出来的像素也一样）。
      竖向：--extras-dy 是脚本按大板块的**实际像素**位移写进来的 ——
      大板块被排版模式往下挪了多少，这一屏就跟着挪多少，
      于是「大板块 → 第一行」的缝和「第一行 → 第二行」的缝一样宽。
    */
    transform: translate(var(--dx, 0), var(--extras-dy, 0));
  }
  /* 第二格（花娅陌域那一列）里并排两张：左边那张贴左、右边那张贴右 */
  .extras__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.8vw, 1.5rem);
    align-items: stretch;
    min-width: 0;
  }
  /* 同一行里的卡一样高：格子撑开 → 卡片 height:100% */
  .extras__grid > *,
  .extras__pair > * {
    min-width: 0;
    min-height: 0;
  }

  /*
    第三行要和**上面那一行**一样高：站长原话「同尺寸的卡片」「一样大且对齐」。
    高度由脚本量出来、**直接写成行内 min-height**（见文件末尾那段）——
    日历是 5 行还是 6 行会差 20px，写死一个数换个月就对不齐了；
    而 CSS 里没有"让这一行和上一行一样高"的写法。
    ⚠ 不能在这里写 `min-height: var(--under-h)`：上面那条
    `.extras__grid > *` 的 `min-height: 0` 权重更高（两个类 + 两个 scope 属性），
    会把这条压掉（实测：写在这儿量出来还是 62px）。行内样式才压得住。
  */

  /*
    窄屏：和大板块保持同一个断点（760px 以下大板块也是单列）。
    单列时不要求对齐，卡片按自己的自然高度堆着 —— 脚本在窄屏下也不写那个高度：
    手机上日历是整幅宽、比桌面高得多，硬拉成一样高只会多出两块空盒子。
  */
  @media (max-width: 760px) {
    .extras__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .extras__pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  /*
    两件事，都在这一屏上：
      ① 把「日历那一行」的高度量出来，交给下面那一行（涣愿终池 + 预留卡/花娅远位面）。
         为什么不用纯 CSS：日历的高度取决于这个月排 5 行还是 6 行（差 20px），
         写死一个数换个月就对不齐了；而 CSS 里没有"让这一行和上一行一样高"的写法。
      ② 把大板块的竖向微调（layout.json 里 boards 的 dy）换成**像素**补到这一屏上。
         百分比是相对元素自身尺寸的：大板块高 340px、这一屏高 785px，
         同一个 3.5% 差出一倍多，直接抄百分比反而会把缝拉得更歪。
    量一次 + 窗口变化时再量一次就够，代价可以忽略。
  */
  (() => {
    const grid = document.querySelector<HTMLElement>('.extras__grid');
    const boards = document.querySelector<HTMLElement>('.boards');
    const cal = document.querySelector<HTMLElement>('#home-cal');
    const targets = [
      document.querySelector<HTMLElement>('#home-cistern'),
      document.querySelector<HTMLElement>('.extras__pair--under'),
    ].filter((n): n is HTMLElement => !!n);
    if (!cal || !targets.length) return;

    /* 大板块往下挪了多少像素 —— 这一屏跟着挪同样多，缝才一样宽 */
    const syncDy = () => {
      if (!grid || !boards) return;
      const raw = getComputedStyle(boards).getPropertyValue('--dy').trim();
      const pct = /^(-?[\d.]+)%$/.exec(raw);
      const px = pct ? (parseFloat(pct[1]) / 100) * boards.offsetHeight : 0;
      if (px) grid.style.setProperty('--extras-dy', `${px.toFixed(2)}px`);
      else grid.style.removeProperty('--extras-dy');
    };

    const sync = () => {
      /* 窄屏是单列，不要求一样高（见样式里那条 @media） */
      const narrow = window.matchMedia('(max-width: 760px)').matches;
      const h = narrow ? 0 : Math.round(cal.getBoundingClientRect().height);
      for (const el of targets) {
        if (h > 0) el.style.minHeight = `${h}px`;
        else el.style.removeProperty('min-height');
      }
      syncDy();
    };

    sync();
    /* 日历换月会多一行 / 少一行，高度跟着变 —— 盯着它 */
    if (typeof ResizeObserver === 'function') new ResizeObserver(sync).observe(cal);
    window.addEventListener('resize', sync);
  })();
</script>
