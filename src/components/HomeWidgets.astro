---
/**
 * 首页这一屏（挂在两个大板块**下面**，一行两块，一共四行）。
 *
 * 位置按用户历轮的要求排（原话见 README）：
 *   第一行 · 曼沫砾总线（公告栏）在「甬城晴雨」正下方
 *          · 黎语堂在「花娅陌域」正下方
 *   第二行 · 日历（涣源溪水钟）在「甬城晴雨」正下方，**和甬城晴雨一样宽**，而且比较扁
 *          · 冰室冰山 / 每日精华 **和日历一样高**
 *          · 冰室冰山的左边对齐「花娅陌域」的左边
 *          · 每日精华的右边对齐「花娅陌域」的右边
 *   第三行（2026-11-17 加）· 日历正下方一张**同尺寸的预留卡**（先空着占位）
 *   第四行（2026-11-17 加）· 冰室冰山 / 每日精华正下方再并排两张同尺寸的卡：
 *                          左 = 涣愿终池入口（可传封面图），右 = 花娅远位面
 *                          （照搬 /huaya 上那一块，随版块树同步）
 *
 * ⚠ 2026-10-06 加第一行时**没有动第二行的任何一条规则**：`.extras__pair` 还是那一套、
 * 日历还是 height:100%，所以「日历 / 冰山 / 每日精华 三张一样高」这个关系一点没变 ——
 * 新增的第一行是独立的一行，行高由公告卡和黎语堂卡自己决定，不会往下传染。
 * 2026-11-17 加的两行同理：都是独立的一行，行高由自己那一行决定。
 *
 * 怎么保证"对齐"这件事不靠眼睛：这一屏的列定义和大板块那一行**一模一样**
 * （`repeat(2, minmax(0,1fr))` + 同样的 13% 列间距），所以第一格天然就是
 * 甬城晴雨那一列、第二格天然就是花娅陌域那一列；第二格里面再分成两张。
 *
 * 另外大板块那行被编辑器"排版"模式挪过一点（layout.json 里 boards 的 dx），
 * 这里把同一个横向偏移也接过来 —— 用户在编辑器里左右拖板块，这一屏跟着走。
 */
import HomeAnnounce from './HomeAnnounce.astro';
import HomeLiyutang from './HomeLiyutang.astro';
import HomeCalendar from './HomeCalendar.astro';
import HomePlaceholder from './HomePlaceholder.astro';
import HomeIceberg from './HomeIceberg.astro';
import HomeDailyEssence from './HomeDailyEssence.astro';
import HomeCistern from './HomeCistern.astro';
import HomeFarland from './HomeFarland.astro';
import { editVars } from '../utils/layout';

/** 只跟随大板块的**横向**微调（竖向按自己这一屏的节奏排） */
const boardDx = (() => {
  const v = editVars('home', 'boards');
  const m = v ? /--dx:([^;]+)/.exec(v) : null;
  return m ? `--dx:${m[1]}` : undefined;
})();
---

<section
  class="extras"
  aria-label="首页：曼沫砾总线 / 黎语堂 / 涣源溪水钟 / 冰室冰山 / 每日精华 / 涣愿终池 / 花娅远位面"
>
  <div class="extras__grid" style={boardDx}>
    {/*
      第一行：公告栏（左，甬城晴雨那一列）+ 黎语堂（右，花娅陌域那一列）。
      顺序就是 DOM 顺序 —— 栅格自动铺行，所以"在甬城晴雨下方、日历上方"这件事
      是由这两行的先后决定的，不需要任何定位。
    */}
    <HomeAnnounce />
    <HomeLiyutang />
    {/* 第二行：日历 + 冰室冰山/每日精华（和加这两块之前一模一样） */}
    <HomeCalendar />
    <div class="extras__pair">
      <HomeIceberg />
      <HomeDailyEssence />
    </div>
    {/*
      第三行（2026-11-17）：日历正下方那张预留卡。
      它只占左列，右列这一行空着 —— 站长要的就是"日历下方一张同尺寸的卡"。
    */}
    <HomePlaceholder />
    {/*
      第四行（2026-11-17）：冰室冰山 / 每日精华正下方再并排两张。
      左 = 涣愿终池入口，右 = 花娅远位面（照搬 /huaya 上那一块）。
    */}
    <div class="extras__pair extras__pair--under">
      <HomeCistern />
      <HomeFarland />
    </div>
  </div>
</section>

<style>
  .extras {
    margin-top: clamp(1rem, 2.4vh, 1.8rem);
  }
  /*
    列定义必须和 .boards 那一行完全一致（同一个容器宽度 + 同样的 13% 列间距），
    这是"日历经度 = 甬城晴雨、右侧格 = 花娅陌域"的唯一保证。
    行间距按自己这一屏的节奏给（不是 13%，那会变成一大段空白）。

    2026-10-06 起这里是**两行**：公告栏 + 黎语堂 / 日历 + 冰山 + 每日精华。
    两行共用同一套列定义，所以第一行两块也和上下两个大板块严格同列。
  */
  .extras__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 13%;
    row-gap: clamp(0.9rem, 2vw, 1.6rem);
    align-items: stretch;
    transform: translate(var(--dx, 0), 0);
  }
  /* 第二格（花娅陌域那一列）里并排两张：左边那张贴左、右边那张贴右 */
  .extras__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.8vw, 1.5rem);
    align-items: stretch;
    min-width: 0;
  }
  /* 三张卡一样高：格子撑开 → 卡片 height:100% */
  .extras__grid > *,
  .extras__pair > * {
    min-width: 0;
    min-height: 0;
  }

  /*
    第三行那两张（预留卡 / 涣愿终池 + 花娅远位面）要和**上面那一行**一样高：
    站长原话「同尺寸的卡片」「和上面冰山精华的小卡片一样大且对齐」。
    高度由脚本量出来、**直接写成行内 min-height**（见文件末尾那段）——
    日历是 5 行还是 6 行会差 20px，写死一个数换个月就对不齐了；
    而 CSS 里没有"让这一行和上一行一样高"的写法。
    ⚠ 不能在这里写 `min-height: var(--under-h)`：上面那条
    `.extras__grid > *` 的 `min-height: 0` 权重更高（两个类 + 两个 scope 属性），
    会把这条压掉（实测：写在这儿量出来还是 62px）。行内样式才压得住。
  */

  /*
    窄屏：和大板块保持同一个断点（760px 以下大板块也是单列）。
    单列时不要求对齐，卡片按自己的自然高度堆着 —— 脚本在窄屏下也不写那个高度：
    手机上日历是整幅宽、比桌面高得多，硬拉成一样高只会多出两块空盒子。
  */
  @media (max-width: 760px) {
    .extras__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .extras__pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  /*
    把「日历那一行」的高度量出来，交给下面那一行（预留卡 / 涣愿终池 + 花娅远位面）。
    为什么不用纯 CSS：日历的高度取决于这个月排 5 行还是 6 行（差 20px），
    写死一个数换个月就对不齐了；而 CSS 里没有"让这一行和上一行一样高"的写法。
    量一次 + 窗口变化时再量一次就够，代价可以忽略。
  */
  (() => {
    const cal = document.querySelector<HTMLElement>('#home-cal');
    const targets = [
      document.querySelector<HTMLElement>('#home-placeholder'),
      document.querySelector<HTMLElement>('.extras__pair--under'),
    ].filter((n): n is HTMLElement => !!n);
    if (!cal || !targets.length) return;

    const sync = () => {
      /* 窄屏是单列，不要求一样高（见样式里那条 @media） */
      const narrow = window.matchMedia('(max-width: 760px)').matches;
      const h = narrow ? 0 : Math.round(cal.getBoundingClientRect().height);
      for (const el of targets) {
        if (h > 0) el.style.minHeight = `${h}px`;
        else el.style.removeProperty('min-height');
      }
    };

    sync();
    /* 日历换月会多一行 / 少一行，高度跟着变 —— 盯着它 */
    if (typeof ResizeObserver === 'function') new ResizeObserver(sync).observe(cal);
    window.addEventListener('resize', sync);
  })();
</script>
